function led_state() {
    if (!IT_VAL[29])   { set_rgb(0, 0, 0);       return; }
    if (menu_on)       { set_rgb(255, 255, 255); return; }
    if (!IT_VAL[0])    { set_rgb(40, 14, 0);     return; }
    set_rgb(255, 176, 0);
}

combo green_hold {
    wait(ag_delay);
    ag_on = 1;
    wait(ag_ms);
    ag_on = 0;
    wait(40);
}


combo tempo_flick {
    set_val(PS4_RY, (tp_dir * 3) / 4);
    wait(tp_step);
    set_val(PS4_RY, (tp_dir * 2) / 4);
    wait(tp_step);
    set_val(PS4_RY, tp_dir / 4);
    wait(tp_step);
    set_val(PS4_RY, 0);
    wait(tp_step);
    set_val(PS4_RY, (0 - tp_dir) / 4);
    wait(tp_step);
    set_val(PS4_RY, ((0 - tp_dir) * 2) / 4);
    wait(tp_step);
    set_val(PS4_RY, ((0 - tp_dir) * 3) / 4);
    wait(tp_step);
    set_val(PS4_RY, 0 - tp_dir);
    wait(tp_hold);
    set_val(PS4_RY, 0);
}

combo qs_kill {
    qs_on = 1;
    wait(qs_dur);
    qs_on = 0;
}

combo fb_tick  { set_rumble(RUMBLE_A, 25);  wait(28);  set_rumble(RUMBLE_A, 0); }
combo fb_click { set_rumble(RUMBLE_A, 60);  wait(55);  set_rumble(RUMBLE_A, 0); }
combo fb_ok    { set_rumble(RUMBLE_A, 90);  wait(70);  set_rumble(RUMBLE_A, 0);
                 wait(60);
                 set_rumble(RUMBLE_A, 90);  wait(70);  set_rumble(RUMBLE_A, 0); }

int ns_i, ns_div, ns_go, ns_v;
int nl_v, nl_s;

function num_len(f_v) {
    nl_v = f_v;
    nl_s = 0;
    if (nl_v < 0) { nl_v = 0 - nl_v; nl_s = 1; }
    if (nl_v < 10)   { return nl_s + 1; }
    if (nl_v < 100)  { return nl_s + 2; }
    if (nl_v < 1000) { return nl_s + 3; }
    return nl_s + 4;
}

function draw_num(f_x, f_y, f_font, f_val, f_col) {
    ns_i = 1;
    ns_v = f_val;
    if (ns_v < 0) { putc_oled(ns_i, 45); ns_i = ns_i + 1; ns_v = abs(ns_v); }
    ns_div = 1000;
    ns_go  = 0;
    while (ns_div > 0) {
        if ((ns_v / ns_div) > 0 || ns_go || ns_div == 1) {
            putc_oled(ns_i, 48 + (ns_v / ns_div));
            ns_i = ns_i + 1;
            ns_go = 1;
        }
        ns_v   = ns_v % ns_div;
        ns_div = ns_div / 10;
    }
    puts_oled(f_x, f_y, f_font, ns_i - 1, f_col);
}

function center_x(f_chars, f_font_w) {
    return (OLED_WIDTH / 2) - ((f_chars * f_font_w) / 2);
}

int tw_k;

function draw_marquee(f_y, f_src, f_len, f_off) {
    for (tw_k = 0; tw_k < MARQ_COLS; tw_k++) {
        putc_oled(tw_k + 1, duint8(f_src + ((f_off + tw_k) % f_len)));
    }
    puts_oled(center_x(MARQ_COLS, OLED_FONT_SMALL_WIDTH), f_y, OLED_FONT_SMALL, MARQ_COLS, INK);
}

function glyph_S(x, y, w, h, t) {
    rect_oled(x,         y,               w,     t,       1, INK);
    rect_oled(x,         y,               t,     h / 2,   1, INK);
    rect_oled(x,         y + (h/2) - t,   w,     t,       1, INK);
    rect_oled(x + w - t, y + (h/2),       t,     h - (h/2), 1, INK);
    rect_oled(x,         y + h - t,       w,     t,       1, INK);
}
function glyph_L(x, y, w, h, t) {
    rect_oled(x,         y,               t,     h,       1, INK);
    rect_oled(x,         y + h - t,       w,     t,       1, INK);
}
function glyph_E(x, y, w, h, t) {
    rect_oled(x,         y,               t,     h,       1, INK);
    rect_oled(x,         y,               w,     t,       1, INK);
    rect_oled(x,         y + (h/2) - t,   w - 3, t,       1, INK);
    rect_oled(x,         y + h - t,       w,     t,       1, INK);
}
int gm_k, gm_mx, gm_my;
function glyph_M(x, y, w, h, t) {
    rect_oled(x,         y,               t,     h,       1, INK);
    rect_oled(x + w - t, y,               t,     h,       1, INK);
    gm_mx = x + (w / 2);
    gm_my = y + ((h * 55) / 100);
    for (gm_k = 0; gm_k < t; gm_k++) {
        line_oled(x + t - 1 + gm_k, y, gm_mx - 1 + gm_k, gm_my, 1, INK);
        line_oled(x + w - t + gm_k, y, gm_mx - 1 + gm_k, gm_my, 1, INK);
    }
}

function wm_gap(w) { if ((w * 30) / 100 < 3) { return 3; } return (w * 30) / 100; }
function wm_width(w) { return (w * 4) + (wm_gap(w) * 3); }

function wordmark_at(x, y, w, h, t, f_reveal) {
    wm_g = wm_gap(w);
    if (f_reveal >= 1) { glyph_S(x,                 y, w, h, t); }
    if (f_reveal >= 2) { glyph_L(x + (w + wm_g),       y, w, h, t); }
    if (f_reveal >= 3) { glyph_E(x + ((w + wm_g) * 2), y, w, h, t); }
    if (f_reveal >= 4) { glyph_M(x + ((w + wm_g) * 3), y, w, h, t); }
}

