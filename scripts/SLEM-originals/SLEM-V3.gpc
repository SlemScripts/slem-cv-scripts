define ITEMS   = 31;
define SECS    = 5;

define T_NUM    = 0;
define T_ONOFF  = 1;
define T_ACTION = 2;
define T_BTN    = 3;
define T_STAM   = 4;
define T_FAT    = 5;
define T_SB2    = 6;
define T_RMP    = 7;
define T_CUT    = 8;

define BOOT_MS  = 5400;
define FRAME_MS = 33;
define IDLE_MS  = 30;
define MENU_MS  = 16;
define LEAN_MEM  = 800;
define LEAN_HOLD = 8000;
define LAYOUT    = 3;

define REPEAT_DELAY = 400;
define REPEAT_RATE  = 110;

const string SEC_NAME[] = { "GREEN", "TEMPO", "MOVE", "DEF", "SYS" };

const string IT_NAME[] = {
    "ENABLE", "BUTTON", "STAND MS", "MOVE L MS", "MOVE R MS",
    "FADE L MS", "FADE R MS", "DEADZONE", "FATIGUE",
    "QUICKSTOP", "QS SETTLE", "QS EXTRA", "STEAL BTN", "DUNK BTN",
    "ENABLE", "BUTTON", "FLICK MS", "HOLD MS",
    "FADE SPLIT", "FLICK L MS", "FLICK R MS",
    "QUICKSTOP", "QS SETTLE", "REMAP X",
    "STAMINA", "GROUND %",
    "CUTOFF",
    "RUMBLE", "STATIC", "LED", "RESET"
};

const string ON_OFF[]  = { "OFF", "ON" };
const string ACT_N[]    = { "HOLD R2" };
const string BTN_N[]    = { "X", "LB", "LS", "RS", "B", "RB" };
const string SB2_N[]    = { "X", "LB" };
const string RMP_N[]    = { "LS", "RS" };
const string CUT_N[]    = { "OFF", "BOOST", "MIRROR" };
const string STAM_N[]   = { "OFF", "SOFT", "RAMP" };
const string FAT_N[]    = { "OFF", "LOW", "MED", "HIGH" };
const string SAVED[]    = { "SAVED" };
const string SLASH[]    = { "/" };
const string MENU_T[]   = { "SETTINGS" };
const string MARQ[]     = { "TIKTOK/SLEM_2K   -   discord.gg/m9sH6FQVzU   -   NBA 2K27   -   " };
define MARQ_LEN = 64;
define MARQ_COLS = 18;

define INK   = OLED_WHITE;
define FIELD = OLED_BLACK;

int IT_SEC[ITEMS];
int IT_TYPE[ITEMS];
int IT_MIN[ITEMS];
int IT_MAX[ITEMS];
int IT_STEP[ITEMS];
int IT_VAL[ITEMS];

int boot_t;
int frame_t;
int anim_t;
int menu_on;
int cursor;
int rpt_t;
int rpt_dir;
int rpt_axis;
int toast_t;

int i;
int dfx, dfy;
int menu_lvl;
int menu_dirty;
int idle_dirty;
int toast_was;
int sec_cur;
int sf_i;
int sv_step;
int wm_g;
int str_n;
int ag_btn, ag_ms, ag_on, ag_delay;
int tp_btn;
int qs_on, qs_hit, qs_lock;
int sh_dz;
int bp_used[6];
int bp_i, bp_k;
int st_btn, dk_btn, rm_btn;
int ft_load, ft_add, ft_cap;
int ln_x, ln_side, ln_ax, ln_ay, ln_mx, ln_my, ln_t;
int fd_x, fd_y, fd_thr;
int mf_x, mf_y;
int ft_x, ft_y;
int qs_dur;
int tp_held, tp_dir, tp_step, tp_hold, tp_ms, tp_fade;
int sh_ax, sh_ay;
int gc_cur, gc_t;

function screen_clear() {
    cls_oled(0);
    rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, 1, FIELD);
}

function str_len(f_off) {
    str_n = 0;
    while (duint8(f_off++)) { str_n = str_n + 1; }
    return str_n;
}

init {
    table_build();
    rain_tables();
    if (get_pvar(SPVAR_31, 0, 99, 0) == LAYOUT) {
        load_all();
    } else {
        table_defaults();
        save_all();
    }
    boot_t  = 0;
    menu_on = 0;
    idle_dirty = 1;
    cursor  = 0;
}

main {

    anim_t = anim_t + get_rtime();
    if (anim_t > 3600000) { anim_t = 0; }

    if (boot_t < BOOT_MS) {
        boot_t = boot_t + get_rtime();
        set_rgb(255, 90, 0);
        frame_t = frame_t + get_rtime();
        if (frame_t >= FRAME_MS) { frame_t = 0; draw_boot(); }

    } else {

        if (toast_t > 0) { toast_t = toast_t - get_rtime(); }

        if (get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            if (menu_on) { save_all(); toast(); }
            menu_on = !menu_on;
            menu_lvl = 0;
            menu_dirty = 1;
            idle_dirty = 1;
            rpt_axis = 0;
            if (IT_VAL[27]) { combo_run(fb_click); }
        }
        if (get_val(PS4_L2) && menu_on) { set_val(PS4_OPTIONS, 0); }

        if (menu_on) { menu_input(); }

        frame_t = frame_t + get_rtime();

        if (toast_t > 0) { toast_was = 1; }
        else if (toast_was) { toast_was = 0; menu_dirty = 1; }

        if (!busy()) {
            if (menu_on) {
                if (menu_dirty && frame_t >= MENU_MS) {
                    frame_t = 0;
                    menu_dirty = 0;
                    draw_menu();
                }
            } else if (!IT_VAL[28]) {
                if (frame_t >= IDLE_MS) {
                    frame_t = 0;
                    draw_idle();
                }
            } else if (idle_dirty) {
                idle_dirty = 0;
                draw_idle();
            }
        }

        shot_input();
        if (IT_VAL[24]) { stamina(); } else { gc_t = 0; }
        if (IT_VAL[26]) { cutoff_boost(); }

        led_state();
    }
}



function btn_id(f_n) {
    if (f_n == 0) { return PS4_SQUARE; }
    if (f_n == 1) { return PS4_L1; }
    if (f_n == 2) { return PS4_L3; }
    if (f_n == 3) { return PS4_R3; }
    if (f_n == 4) { return PS4_CIRCLE; }
    return PS4_R1;
}

function claim(f_i) {
    for (bp_k = 0; bp_k < 6; bp_k++) {
        if (!bp_used[IT_VAL[f_i]]) { bp_k = 6; }
        else {
            IT_VAL[f_i] = IT_VAL[f_i] + 1;
            if (IT_VAL[f_i] > 5) { IT_VAL[f_i] = 0; }
        }
    }
    bp_used[IT_VAL[f_i]] = 1;
}

function resolve_btns(f_keep) {
    for (bp_i = 0; bp_i < 6; bp_i++) { bp_used[bp_i] = 0; }
    bp_used[IT_VAL[1]]  = 1;
    bp_used[IT_VAL[15]] = 1;
    if (f_keep == 12) { bp_used[IT_VAL[12]] = 1; claim(13); }
    else if (f_keep == 13) { bp_used[IT_VAL[13]] = 1; claim(12); }
    else { claim(12); claim(13); }
}

function busy() {
    if (tp_held) { return 1; }
    if (combo_running(tempo_flick)) { return 1; }
    if (combo_running(green_hold)) { return 1; }
    if (combo_running(qs_kill))    { return 1; }
    return 0;
}

function lean_track() {
    ln_ax = get_val(PS4_LX);
    if (ln_ax > 25 || ln_ax < -25) {
        ln_t = 0;
        ln_x = ln_x + ((ln_ax * get_rtime()) / 100);
        if (ln_x >  4000) { ln_x =  4000; }
        if (ln_x < -4000) { ln_x = -4000; }
    } else if (ln_x != 0) {
        ln_t = ln_t + get_rtime();
        if (ln_t >= LEAN_HOLD) {
            ln_t = 0;
            ln_x = 0;
        }
    }
}

function side_of() {
    ln_ax = get_val(PS4_LX);
    ln_ay = get_val(PS4_LY);
    ln_mx = ln_ax;
    ln_my = ln_ay;
    if (ln_mx < 0) { ln_mx = 0 - ln_mx; }
    if (ln_my < 0) { ln_my = 0 - ln_my; }
    if (ln_mx + ln_my >= 40) {
        if (ln_ax >  8) { return  1; }
        if (ln_ax < -8) { return -1; }
    }
    if (ln_x < (0 - LEAN_MEM)) { return -1; }
    if (ln_x >      LEAN_MEM)  { return  1; }
    return 0;
}

function fatigue_track() {
    ft_x = get_val(PS4_LX);
    ft_y = get_val(PS4_LY);
    if (ft_x < 0) { ft_x = 0 - ft_x; }
    if (ft_y < 0) { ft_y = 0 - ft_y; }
    if (get_val(PS4_R2) > 20 && (ft_x > 40 || ft_y > 40)) {
        ft_load = ft_load + get_rtime();
        if (ft_load > 8000) { ft_load = 8000; }
    } else {
        ft_load = ft_load - (get_rtime() / 2);
        if (ft_load < 0) { ft_load = 0; }
    }
    if (IT_VAL[8] == 0)      { ft_cap =  0; }
    else if (IT_VAL[8] == 1) { ft_cap = 20; }
    else if (IT_VAL[8] == 2) { ft_cap = 40; }
    else                     { ft_cap = 60; }
    ft_add = (ft_load * ft_cap) / 8000;
}

function pick_ms() {
    sh_dz = IT_VAL[7];
    if (qs_hit) {
        ag_ms = IT_VAL[2] + IT_VAL[11];
    } else if (is_fade()) {
        ln_side = side_of();
        if (ln_side < 0) { ag_ms = IT_VAL[5]; }
        else             { ag_ms = IT_VAL[6]; }
    } else {
        sh_ax = get_val(PS4_LX);
        sh_ay = get_val(PS4_LY);
        if (sh_ax > (0 - sh_dz) && sh_ax < sh_dz
         && sh_ay > (0 - sh_dz) && sh_ay < sh_dz) {
            ag_ms = IT_VAL[2];
        } else {
            ln_side = side_of();
            if (ln_side < 0)      { ag_ms = IT_VAL[3]; }
            else if (ln_side > 0) { ag_ms = IT_VAL[4]; }
            else if (sh_ax < 0)   { ag_ms = IT_VAL[3]; }
            else                  { ag_ms = IT_VAL[4]; }
        }
    }
    ag_ms = ag_ms + ft_add;
}

function is_fade() {
    if (get_val(PS4_R2) < 30) { return 0; }
    fd_thr = IT_VAL[7] + 20;
    if (fd_thr < 40) { fd_thr = 40; }
    fd_x = get_val(PS4_LX);
    fd_y = get_val(PS4_LY);
    if (fd_x < 0) { fd_x = 0 - fd_x; }
    if (fd_y < 0) { fd_y = 0 - fd_y; }
    if (fd_x > fd_thr || fd_y > fd_thr) { return 1; }
    return 0;
}

function moving_fast() {
    mf_x = get_val(PS4_LX);
    mf_y = get_val(PS4_LY);
    if (mf_x < 0) { mf_x = 0 - mf_x; }
    if (mf_y < 0) { mf_y = 0 - mf_y; }
    if (mf_x > 50 || mf_y > 50) { return 1; }
    return 0;
}

function arm_quickstop(f_on, f_settle) {
    qs_hit = 0;
    if (!f_on)          { return; }
    if (!moving_fast()) { return; }
    qs_dur = f_settle;
    if (qs_dur < 20) { qs_dur = 20; }
    combo_run(qs_kill);
    qs_hit  = 1;
    qs_lock = 2;
}

function shot_input() {

    fatigue_track();
    lean_track();

    ag_btn = btn_id(IT_VAL[1]);
    tp_btn = btn_id(IT_VAL[15]);
    st_btn = btn_id(IT_VAL[12]);
    dk_btn = btn_id(IT_VAL[13]);

    if (IT_VAL[14]) {
        if (get_val(tp_btn) && !(menu_on && get_val(PS4_L2))) {
            if (!tp_held) {
                tp_held = 1;
                arm_quickstop(IT_VAL[21], IT_VAL[22]);
                tp_fade = 0;
                ln_side = 0;
                if (qs_hit) {
                    tp_dir = 100;
                } else if (is_fade()) {
                    tp_dir  = -100;
                    tp_fade = 1;
                    ln_side = side_of();
                } else {
                    tp_dir = 100;
                }
            }
            if (!qs_on) { set_val(PS4_RY, tp_dir); }
        } else {
            if (tp_held) {
                tp_held = 0;
                tp_ms = IT_VAL[16];
                if (IT_VAL[18] && tp_fade) {
                    if (ln_side < 0)      { tp_ms = IT_VAL[19]; }
                    else if (ln_side > 0) { tp_ms = IT_VAL[20]; }
                }
                tp_step = tp_ms / 7;
                if (tp_step < 1) { tp_step = 1; }
                tp_hold = IT_VAL[17];
                combo_run(tempo_flick);
            }
        }
        set_val(tp_btn, 0);

        if (IT_VAL[23] == 0) { rm_btn = PS4_L3; }
        else                 { rm_btn = PS4_R3; }
        if (get_val(rm_btn)) {
            set_val(rm_btn, 0);
            set_val(tp_btn, 100);
        }
    }

    if (IT_VAL[0]) {
        if (event_press(ag_btn) && !busy() && !(menu_on && get_val(PS4_L2))) {
            arm_quickstop(IT_VAL[9], IT_VAL[10]);
            pick_ms();
            if (qs_hit) { ag_delay = IT_VAL[10]; } else { ag_delay = 1; }
            combo_run(green_hold);
        }
        if (ag_on) { set_val(ag_btn, 100); }
        else       { set_val(ag_btn, 0); }
    }

    if (qs_lock) {
        set_val(PS4_LX, 0);
        set_val(PS4_LY, 0);
        set_val(PS4_RX, 0);
        set_val(PS4_R2, 0);
        if (qs_on) { qs_lock = 1; }
        else if (qs_lock == 1 && !ag_on && !tp_held && !busy()) { qs_lock = 0; }
    }

    if (IT_VAL[0] && st_btn != PS4_SQUARE && get_val(st_btn)) {
        set_val(st_btn, 0);
        set_val(PS4_SQUARE, 100);
    }

    if (IT_VAL[0] && dk_btn != PS4_CIRCLE && get_val(dk_btn)) {
        set_val(dk_btn, 0);
        set_val(PS4_CIRCLE, 100);
    }
}

function stamina() {
    if (busy())  { return; }
    if (qs_lock) { return; }
    sh_ax = get_val(PS4_LX);
    sh_ay = get_val(PS4_LY);
    if (sh_ax < 0) { sh_ax = 0 - sh_ax; }
    if (sh_ay < 0) { sh_ay = 0 - sh_ay; }
    if (sh_ax > 20 || sh_ay > 20) {
        gc_t = gc_t + get_rtime();
        if (IT_VAL[24] == 1) {
            gc_cur = IT_VAL[25];
        } else {
            if (gc_t <= 800)       { gc_cur = 100; }
            else if (gc_t <= 1800) { gc_cur = 100 - (((100 - IT_VAL[25]) * (gc_t - 800)) / 1000); }
            else                   { gc_cur = IT_VAL[25]; }
        }
        set_val(PS4_LX, (get_val(PS4_LX) * gc_cur) / 100);
        set_val(PS4_LY, (get_val(PS4_LY) * gc_cur) / 100);
    } else {
        gc_t = 0;
        gc_cur = 100;
    }
}

function cutoff_boost() {
    if (busy())   { return; }
    if (qs_lock)  { return; }
    if (get_val(PS4_L2) < 20) { return; }
    if (get_val(PS4_R2) < 20) { return; }
    if (IT_VAL[26] == 1) {
        set_val(PS4_RY, (get_val(PS4_RY) * 13) / 10);
    } else {
        set_val(PS4_RX, get_val(PS4_LX));
        set_val(PS4_RY, get_val(PS4_LY));
    }
}









function menu_input() {

    if (!get_val(PS4_L2)) { rpt_axis = 0; return; }

    set_val(PS4_UP, 0);
    set_val(PS4_DOWN, 0);
    set_val(PS4_LEFT, 0);
    set_val(PS4_RIGHT, 0);

    if (event_press(PS4_R1)) {
        if (menu_lvl) { menu_lvl = 0; }
        menu_dirty = 1;
        rpt_axis = 0;
        if (IT_VAL[27]) { combo_run(fb_click); }
    }

    if (menu_lvl == 0 && event_press(PS4_R2)) {
        menu_lvl = 1;
        cursor = sec_first(sec_cur);
        menu_dirty = 1;
        rpt_axis = 0;
        if (IT_VAL[27]) { combo_run(fb_click); }
    }

    if (menu_lvl && IT_TYPE[cursor] == T_ACTION && event_press(PS4_R2)) {
        menu_dirty = 1;
        do_action();
        if (IT_VAL[27]) { combo_run(fb_ok); }
    }

    if (event_press(PS4_UP))    { move_cursor(-1); rpt_axis = 1; rpt_dir = -1; rpt_t = 0; }
    if (event_press(PS4_DOWN))  { move_cursor( 1); rpt_axis = 1; rpt_dir =  1; rpt_t = 0; }

    if (menu_lvl) {
        if (event_press(PS4_LEFT))  { step_value(-1); rpt_axis = 2; rpt_dir = -1; rpt_t = 0; }
        if (event_press(PS4_RIGHT)) { step_value( 1); rpt_axis = 2; rpt_dir =  1; rpt_t = 0; }
    }

    if (event_release(PS4_UP) || event_release(PS4_DOWN)
        || event_release(PS4_LEFT) || event_release(PS4_RIGHT)) {
        rpt_axis = 0;
    }

    if (rpt_axis) {
        rpt_t = rpt_t + get_rtime();
        if (rpt_t > REPEAT_DELAY) {
            if (rpt_t - REPEAT_DELAY > REPEAT_RATE) {
                rpt_t = REPEAT_DELAY;
                if (rpt_axis == 1) { move_cursor(rpt_dir); }
                else               { step_value(rpt_dir); }
            }
        }
    }
}

function sec_first(f_s) {
    for (sf_i = 0; sf_i < ITEMS; sf_i++) {
        if (IT_SEC[sf_i] == f_s) { return sf_i; }
    }
    return 0;
}

function sec_end(f_s) {
    for (sf_i = 0; sf_i < ITEMS; sf_i++) {
        if (IT_SEC[ITEMS - 1 - sf_i] == f_s) { return ITEMS - 1 - sf_i; }
    }
    return 0;
}

function move_cursor(f_d) {
    if (menu_lvl == 0) {
        sec_cur = sec_cur + f_d;
        if (sec_cur < 0)      { sec_cur = SECS - 1; }
        if (sec_cur > SECS-1) { sec_cur = 0; }
    } else {
        cursor = cursor + f_d;
        if (cursor < sec_first(sec_cur)) { cursor = sec_end(sec_cur); }
        if (cursor > sec_end(sec_cur))   { cursor = sec_first(sec_cur); }
    }
    menu_dirty = 1;
    if (IT_VAL[27]) { combo_run(fb_tick); }
}

function step_value(f_d) {
    if (IT_TYPE[cursor] == T_ACTION) { return; }
    if (get_val(PS4_R2)) { sv_step = IT_STEP[cursor]; }
    else                 { sv_step = 1; }
    IT_VAL[cursor] = IT_VAL[cursor] + (f_d * sv_step);
    if (IT_VAL[cursor] < IT_MIN[cursor]) { IT_VAL[cursor] = IT_MIN[cursor]; }
    if (IT_VAL[cursor] > IT_MAX[cursor]) { IT_VAL[cursor] = IT_MAX[cursor]; }
    if (IT_TYPE[cursor] == T_BTN || IT_TYPE[cursor] == T_SB2) { resolve_btns(cursor); }
    menu_dirty = 1;
    if (cursor ==  0 && IT_VAL[ 0]) { IT_VAL[14] = 0; }
    if (cursor == 14 && IT_VAL[14]) { IT_VAL[ 0] = 0; }
    if (IT_VAL[27]) { combo_run(fb_tick); }
}

function do_action() {

    if (cursor == 30) { table_defaults(); }
    save_all();
    toast();
}

function toast() { toast_t = 700; menu_dirty = 1; }

function set_item(f_i, f_sec, f_type, f_min, f_max, f_step) {
    IT_SEC[f_i]  = f_sec;
    IT_TYPE[f_i] = f_type;
    IT_MIN[f_i]  = f_min;
    IT_MAX[f_i]  = f_max;
    IT_STEP[f_i] = f_step;
}

