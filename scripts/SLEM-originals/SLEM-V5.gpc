function screen_clear() {
    cls_oled(0);
    rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, 1, FIELD);
}

function str_len(f_off) {
    str_n = 0;
    while (duint8(f_off++)) { str_n = str_n + 1; }
    return str_n;
}

init {
    table_build();
    rain_tables();
    if (get_pvar(SPVAR_29, 0, 99, 0) == LAYOUT) {
        load_all();
    } else {
        table_defaults();
        save_all();
    }
    boot_t  = 0;
    menu_on = 0;
    idle_dirty = 1;
    cursor  = 0;
}

main {

    anim_t = anim_t + get_rtime();
    if (anim_t > 3600000) { anim_t = 0; }

    if (boot_t < BOOT_MS) {
        boot_t = boot_t + get_rtime();
        set_rgb(255, 90, 0);
        frame_t = frame_t + get_rtime();
        if (frame_t >= FRAME_MS) { frame_t = 0; draw_boot(); }

    } else {

        if (toast_t > 0) { toast_t = toast_t - get_rtime(); }

        if (tn_on) { tune_run(); }

        if (get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            if (tn_on) { tune_stop(); }
            if (menu_on) { save_all(); toast(); }
            menu_on = !menu_on;
            menu_lvl = 0;
            menu_dirty = 1;
            idle_dirty = 1;
            rpt_axis = 0;
            if (IT_VAL[39]) { combo_run(fb_click); }
        }
        if (get_val(PS4_L2) && menu_on) { set_val(PS4_OPTIONS, 0); }

        if (menu_on) { menu_input(); }

        frame_t = frame_t + get_rtime();

        if (toast_t > 0) { toast_was = 1; }
        else if (toast_was) { toast_was = 0; menu_dirty = 1; }

        if (!busy()) {
            if (menu_on) {
                if ((menu_dirty || frame_t >= 90) && frame_t >= MENU_MS) {
                    frame_t = 0;
                    menu_dirty = 0;
                    draw_menu();
                }
            } else if (tn_on) {
                if (tn_dirty) {
                    tn_dirty = 0;
                    draw_tune();
                }
            } else if (!IT_VAL[40]) {
                if (frame_t >= IDLE_MS) {
                    frame_t = 0;
                    draw_idle();
                }
            } else if (idle_dirty) {
                idle_dirty = 0;
                draw_idle();
            }
        }

        shot_input();
        if (!tn_on) {
            if (IT_VAL[29]) { stamina(); }
            if (IT_VAL[33]) { cutoff_boost(); }
            dribble();
        }

        led_state();
    }
}

function btn_id(f_n) {
    if (f_n == 0) { return PS4_SQUARE; }
    if (f_n == 1) { return PS4_L1; }
    if (f_n == 2) { return PS4_L3; }
    if (f_n == 3) { return PS4_R3; }
    if (f_n == 4) { return PS4_CIRCLE; }
    return PS4_R1;
}

function claim(f_i) {
    if (!IT_VAL[f_i]) { return; }
    for (bp_k = 0; bp_k < 6; bp_k++) {
        if (!bp_used[IT_VAL[f_i] - 1]) { bp_k = 6; }
        else {
            IT_VAL[f_i] = IT_VAL[f_i] + 1;
            if (IT_VAL[f_i] > 6) { IT_VAL[f_i] = 1; }
        }
    }
    bp_used[IT_VAL[f_i] - 1] = 1;
}

function dr_scale() {
    dr_a = (90 * IT_VAL[31]) / 100;
    dr_e = (45 * IT_VAL[31]) / 100;
    if (dr_a < 10) { dr_a = 10; }
    if (dr_e < 10) { dr_e = 10; }
}

function dr_stop() {
    combo_stop(DR_CRAB);
    combo_stop(DR_CURRY_X);
    combo_stop(DR_MOMENTUM);
    combo_stop(DR_HESI);
    combo_stop(DR_SNATCH);
    combo_stop(DR_SPIN);
    dr_mv = 0;
}

function dr_busy() {
    if (combo_running(DR_CRAB))     { return 1; }
    if (combo_running(DR_CURRY_X))  { return 1; }
    if (combo_running(DR_MOMENTUM)) { return 1; }
    if (combo_running(DR_HESI))     { return 1; }
    if (combo_running(DR_SNATCH))   { return 1; }
    if (combo_running(DR_SPIN))     { return 1; }
    return 0;
}

function dribble() {

    if (!IT_VAL[30] || busy() || (menu_on && get_val(PS4_L2))) {
        if (dr_mv) { dr_stop(); }
        return;
    }

    dr_dir = 0;
    if (get_val(PS4_LEFT))       { dr_dir = 1; dr_s = -1; }
    else if (get_val(PS4_RIGHT)) { dr_dir = 2; dr_s =  1; }
    else if (get_val(PS4_UP))    { dr_dir = 3; }

    if (!dr_dir) {
        if (dr_mv) { dr_stop(); }
        return;
    }

    if (dr_dir == 1) { set_val(PS4_LEFT,  0); }
    if (dr_dir == 2) { set_val(PS4_RIGHT, 0); }
    if (dr_dir == 3) { set_val(PS4_UP,    0); }

    dr_mv = dr_dir;

    if (!dr_busy()) {
        dr_scale();
        dr_set = IT_VAL[32];
        if (dr_dir == 3) {
            if (dr_set == 0)      { combo_run(DR_CURRY_X); }
            else if (dr_set == 1) { combo_run(DR_HESI); }
            else                  { combo_run(DR_SPIN); }
        } else {
            if (dr_set == 0)      { combo_run(DR_CRAB); }
            else if (dr_set == 1) { combo_run(DR_MOMENTUM); }
            else                  { combo_run(DR_SNATCH); }
        }
    }
}

function ld_save(f_n) {
    if (f_n == 0) {
        set_pvar(SPVAR_30, IT_VAL[2]);
        set_pvar(SPVAR_31, IT_VAL[3]);
        set_pvar(SPVAR_32, IT_VAL[13]);
        set_pvar(SPVAR_33, IT_VAL[25]);
    }
    else if (f_n == 1) {
        set_pvar(SPVAR_34, IT_VAL[2]);
        set_pvar(SPVAR_35, IT_VAL[3]);
        set_pvar(SPVAR_36, IT_VAL[13]);
        set_pvar(SPVAR_37, IT_VAL[25]);
    }
    else if (f_n == 2) {
        set_pvar(SPVAR_38, IT_VAL[2]);
        set_pvar(SPVAR_39, IT_VAL[3]);
        set_pvar(SPVAR_40, IT_VAL[13]);
        set_pvar(SPVAR_41, IT_VAL[25]);
    }
}

function ld_load(f_n) {
    if (f_n == 0) {
        IT_VAL[2] = get_pvar(SPVAR_30, 7, 350, 40);
        IT_VAL[3] = get_pvar(SPVAR_31, 20, 500, 150);
        IT_VAL[13] = get_pvar(SPVAR_32, 200, 1500, 700);
        IT_VAL[25] = get_pvar(SPVAR_33, 200, 1500, 740);
    }
    else if (f_n == 1) {
        IT_VAL[2] = get_pvar(SPVAR_34, 7, 350, 40);
        IT_VAL[3] = get_pvar(SPVAR_35, 20, 500, 150);
        IT_VAL[13] = get_pvar(SPVAR_36, 200, 1500, 700);
        IT_VAL[25] = get_pvar(SPVAR_37, 200, 1500, 740);
    }
    else if (f_n == 2) {
        IT_VAL[2] = get_pvar(SPVAR_38, 7, 350, 40);
        IT_VAL[3] = get_pvar(SPVAR_39, 20, 500, 150);
        IT_VAL[13] = get_pvar(SPVAR_40, 200, 1500, 700);
        IT_VAL[25] = get_pvar(SPVAR_41, 200, 1500, 740);
    }
}

function ld_switch() {
    ld_save(ld_prev);
    ld_load(IT_VAL[38]);
    ld_prev = IT_VAL[38];
}

function only_one(f_keep) {
    if (f_keep !=  0) { IT_VAL[0] = 0; }
    if (f_keep != 11) { IT_VAL[11] = 0; }
    if (f_keep != 23) { IT_VAL[23] = 0; }
}

function normalize_mode() {
    if (IT_VAL[0])      { only_one( 0); }
    else if (IT_VAL[11]) { only_one(11); }
    else if (IT_VAL[23]) { only_one(23); }
}

function tempo_on() {
    if (tn_on) { return 0; }
    if (IT_VAL[0]) { return 1; }
    return 0;
}

function green_on() {
    if (tn_on) { return 0; }
    if (IT_VAL[11]) { return 1; }
    if (IT_VAL[23]) { return 1; }
    return 0;
}

function resolve_btns(f_keep) {
    for (bp_i = 0; bp_i < 6; bp_i++) { bp_used[bp_i] = 0; }
    bp_used[IT_VAL[1]] = 1;
    bp_used[IT_VAL[12]] = 1;
    bp_used[IT_VAL[24]] = 1;
    if (IT_VAL[9]) { bp_used[IT_VAL[9] + 1] = 1; }
    if (IT_VAL[21]) { bp_used[IT_VAL[21] + 1] = 1; }
    if (IT_VAL[27]) { bp_used[IT_VAL[27] + 1] = 1; }
    claim(7);
}

function busy() {
    if (tp_held) { return 1; }
    if (combo_running(tempo_flick)) { return 1; }
    if (combo_running(green_hold)) { return 1; }
    if (combo_running(qs_shot))    { return 1; }
    return 0;
}

function lean_track() {
    ln_ax = get_val(PS4_LX);
    if (ln_ax > 25 || ln_ax < -25) {
        ln_t = 0;
        ln_x = ln_x + ((ln_ax * get_rtime()) / 100);
        if (ln_x >  4000) { ln_x =  4000; }
        if (ln_x < -4000) { ln_x = -4000; }
    } else if (ln_x != 0) {
        ln_t = ln_t + get_rtime();
        if (ln_t >= LEAN_HOLD) {
            ln_t = 0;
            ln_x = 0;
        }
    }
}

function side_of() {
    ln_ax = get_val(PS4_LX);
    ln_ay = get_val(PS4_LY);
    ln_mx = ln_ax; ln_my = ln_ay;
    if (ln_mx < 0) { ln_mx = 0 - ln_mx; }
    if (ln_my < 0) { ln_my = 0 - ln_my; }
    if (ln_mx >= 45) {
        if (ln_ax > 0) { return  1; }
        return -1;
    }
    ln_tot = ln_mx + ln_my;
    if (ln_tot >= 40) {
        ln_thr = 8 + (ln_tot / 12);
        if (ln_ax >  ln_thr)       { return  1; }
        if (ln_ax < (0 - ln_thr))  { return -1; }
    }
    if (ln_x < (0 - LEAN_MEM)) { return -1; }
    if (ln_x >      LEAN_MEM)  { return  1; }
    return 0;
}

function lean_side() {
    ln_sd = side_of();
    if (IT_VAL[37]) { return 0 - ln_sd; }
    return ln_sd;
}

function fatigue_track() {
    ft_x = get_val(PS4_LX);
    ft_y = get_val(PS4_LY);
    if (ft_x < 0) { ft_x = 0 - ft_x; }
    if (ft_y < 0) { ft_y = 0 - ft_y; }
    if (get_val(PS4_R2) > 20 && (ft_x > 40 || ft_y > 40)) {
        ft_load = ft_load + get_rtime();
        if (ft_load > 8000) { ft_load = 8000; }
    } else {
        ft_load = ft_load - (get_rtime() / 2);
        if (ft_load < 0) { ft_load = 0; }
    }
    if (IT_VAL[19] == 0)      { ft_cap =  0; }
    else if (IT_VAL[19] == 1) { ft_cap =  4; }
    else if (IT_VAL[19] == 2) { ft_cap =  9; }
    else                      { ft_cap = 16; }
    ft_add = (ft_load * ft_cap) / 8000;
}

function tn_item() {
    if (tn_on == 1) {
        if (tn_stage == 0) { return  2; }
        if (tn_stage == 1) { return  5; }
        return 6;
    }
    if (tn_on == 2) {
        if (tn_stage == 0) { return 13; }
        if (tn_stage == 1) { return 14; }
        if (tn_stage == 2) { return 15; }
        if (tn_stage == 3) { return 16; }
        return 17;
    }
    if (tn_on == 3) { return 25; }
    return 13;
}


function tune_stop() {
    if (tn_on) {
        if (tn_prev == 1)      { IT_VAL[0] = 1; }
        else if (tn_prev == 2) { IT_VAL[11] = 1; }
        else if (tn_prev == 3) { IT_VAL[23] = 1; }
        tn_prev = 0;
    }
    tn_on    = 0;
    tn_stage = 0;
    tn_n     = 0;
    tn_ph    = 0;
    tn_meas  = 0;
    tn_arm   = 0;
    tn_t     = 0;
    tn_last  = 0;
    idle_dirty = 1;
    menu_dirty = 1;
}

function tune_start(f_mode, f_end) {
    tune_stop();
    tn_prev = 0;
    if (IT_VAL[0])      { tn_prev = 1; }
    else if (IT_VAL[11]) { tn_prev = 2; }
    else if (IT_VAL[23]) { tn_prev = 3; }
    IT_VAL[0] = 0;
    IT_VAL[11] = 0;
    IT_VAL[23] = 0;
    tn_on    = f_mode;
    tn_end   = f_end;
    tn_dirty = 1;
}

function tn_push(f_v) {
    if (tn_n >= TN_N) { return; }
    tn_buf[tn_n] = f_v;
    tn_last = f_v;
    tn_n = tn_n + 1;
    tn_dirty = 1;
    if (tn_n >= TN_N) { tn_calc(); tn_ph = 1; }
}

function tn_calc() {
    for (tn_i = 1; tn_i < TN_N; tn_i++) {
        tn_sw = tn_buf[tn_i];
        tn_j  = tn_i - 1;
        while (tn_j >= 0 && tn_buf[tn_j] > tn_sw) {
            tn_buf[tn_j + 1] = tn_buf[tn_j];
            tn_j = tn_j - 1;
        }
        tn_buf[tn_j + 1] = tn_sw;
    }
    tn_med  = tn_buf[TN_N / 2];
    tn_band = tn_med / 6;
    if (tn_band < 10) { tn_band = 10; }
    tn_sum = 0;
    tn_cnt = 0;
    for (tn_k = 0; tn_k < TN_N; tn_k++) {
        tn_i = tn_buf[tn_k] - tn_med;
        if (tn_i < 0) { tn_i = 0 - tn_i; }
        if (tn_i <= tn_band) {
            tn_sum = tn_sum + tn_buf[tn_k];
            tn_cnt = tn_cnt + 1;
        }
    }
    if (tn_cnt > 0) { tn_res = tn_sum / tn_cnt; }
    else            { tn_res = tn_med; }
    tn_i = tn_item();
    if (tn_res < IT_MIN[tn_i]) { tn_res = IT_MIN[tn_i]; }
    if (tn_res > IT_MAX[tn_i]) { tn_res = IT_MAX[tn_i]; }
}

function tn_accept() {
    tn_i = tn_item();
    IT_VAL[tn_i] = tn_res;
    if (tn_on == 1 && tn_stage > 0) { IT_VAL[4] = 1; }
    if (tn_stage >= tn_end) {
        tn_ph = 2;
        tn_t  = 3000;
    } else {
        tn_stage = tn_stage + 1;
        tn_n     = 0;
        tn_ph    = 0;
        tn_last  = 0;
        tn_meas  = 0;
        tn_arm   = 0;
        tn_t     = 0;
    }
    tn_dirty = 1;
}

function tn_redo() {
    tn_n     = 0;
    tn_ph    = 0;
    tn_meas  = 0;
    tn_arm   = 0;
    tn_t     = 0;
    tn_last  = 0;
    tn_dirty = 1;
}

function tn_watch_hold() {
    if (tn_on == 3) { tn_btn = btn_id(IT_VAL[24]); }
    else            { tn_btn = btn_id(IT_VAL[12]); }
    if (get_val(tn_btn)) {
        tn_meas = 1;
        tn_t    = tn_t + get_rtime();
        if (tn_t > 2000) { tn_meas = 0; tn_t = 0; }
    } else if (tn_meas) {
        tn_meas = 0;
        if (tn_t >= 150) { tn_push(tn_t); }
        tn_t = 0;
    }
}

function tn_watch_flick() {
    tn_ry = get_val(PS4_RY);
    if (tn_ry >= 60) {
        tn_arm  = 1;
        tn_meas = 0;
        tn_t    = 0;
    } else if (tn_arm) {
        tn_meas = 1;
        tn_t    = tn_t + get_rtime();
        if (tn_ry <= -60) {
            tn_arm  = 0;
            tn_meas = 0;
            if (tn_t >= 7) { tn_push(tn_t); }
            tn_t = 0;
        } else if (tn_t > 600) {
            tn_arm  = 0;
            tn_meas = 0;
            tn_t    = 0;
        }
    }
}

function tune_run() {
    if (menu_on) { return; }
    if (tn_ph == 2) {
        tn_t = tn_t - get_rtime();
        if (tn_t <= 0) { tune_stop(); save_all(); }
        return;
    }
    if (tn_ph == 1) {
        if (event_press(PS4_CROSS))  { set_val(PS4_CROSS, 0);  tn_accept(); }
        else if (event_press(PS4_CIRCLE)) { set_val(PS4_CIRCLE, 0); tn_redo(); }
        set_val(PS4_CROSS, 0);
        set_val(PS4_CIRCLE, 0);
        return;
    }
    if (tn_on >= 2) { tn_watch_hold(); }
    else            { tn_watch_flick(); }
}

function pick_ms() {
    sh_dz = IT_VAL[18];
    if (sp_hit) {
        ag_ms = IT_VAL[8];
    } else if (IT_VAL[23]) {
        ag_ms = IT_VAL[25];
    } else if (is_fade()) {
        if (!IT_VAL[20]) {
            ag_ms = IT_VAL[17];
        } else {
            ln_side = lean_side();
            if (ln_side < 0) { ag_ms = IT_VAL[16]; }
            else             { ag_ms = IT_VAL[17]; }
        }
    } else if (!IT_VAL[20]) {
        ag_ms = IT_VAL[13];
    } else {
        sh_ax = get_val(PS4_LX);
        sh_ay = get_val(PS4_LY);
        if (sh_ax > (0 - sh_dz) && sh_ax < sh_dz
         && sh_ay > (0 - sh_dz) && sh_ay < sh_dz) {
            ag_ms = IT_VAL[13];
        } else {
            ln_side = lean_side();
            if (ln_side < 0)      { ag_ms = IT_VAL[14]; }
            else if (ln_side > 0) { ag_ms = IT_VAL[15]; }
            else if (sh_ax < 0)   { ag_ms = IT_VAL[14]; }
            else                  { ag_ms = IT_VAL[15]; }
        }
    }
    if (sp_hit)          { ag_lat = IT_VAL[10]; }
    else if (IT_VAL[23]) { ag_lat = IT_VAL[28]; }
    else                 { ag_lat = IT_VAL[22]; }
    ag_ms = ag_ms + ft_add + ag_lat;
    if (ag_ms < 100) { ag_ms = 100; }
}

function is_fade() {
    if (get_val(PS4_R2) < 30) { return 0; }
    fd_thr = IT_VAL[18] + 20;
    if (fd_thr < 40) { fd_thr = 40; }
    fd_x = get_val(PS4_LX);
    fd_y = get_val(PS4_LY);
    if (fd_x < 0) { fd_x = 0 - fd_x; }
    if (fd_y < 0) { fd_y = 0 - fd_y; }
    if (fd_x > fd_thr || fd_y > fd_thr) { return 1; }
    return 0;
}




function shot_input() {

    if (tn_on) { return; }

    fatigue_track();
    lean_track();

    if (IT_VAL[23]) { ag_btn = btn_id(IT_VAL[24]); }
    else            { ag_btn = btn_id(IT_VAL[12]); }
    tp_btn = btn_id(IT_VAL[1]);
    if (IT_VAL[7]) { sp_btn = btn_id(IT_VAL[7] - 1); }
    else           { sp_btn = 0; }

    if (tempo_on()) {
        if (get_val(tp_btn) && !(menu_on && get_val(PS4_L2))) {
            if (!tp_held) {
                tp_held = 1;
                tp_fade = 0;
                ln_side = 0;
                if (is_fade()) {
                    tp_dir  = -100;
                    tp_fade = 1;
                    ln_side = lean_side();
                } else {
                    tp_dir = 100;
                }
            }
            set_val(PS4_RY, tp_dir);
        } else {
            if (tp_held) {
                tp_held = 0;
                tp_ms   = IT_VAL[2];
                tp_hold = IT_VAL[3];
                if (IT_VAL[4] && tp_fade) {
                    if (ln_side < 0)      { tp_ms = IT_VAL[5]; }
                    else if (ln_side > 0) { tp_ms = IT_VAL[6]; }
                }
                tp_ms = tp_ms + IT_VAL[10];
                if (tp_ms < 7) { tp_ms = 7; }
                tp_step = tp_ms / 7;
                if (tp_step < 1) { tp_step = 1; }
                combo_run(tempo_flick);
            }
        }
        set_val(tp_btn, 0);

        if (IT_VAL[7]) {
            if (sp_btn != tp_btn && event_press(sp_btn) && !busy()
             && !(menu_on && get_val(PS4_L2))) {
                sp_hit = 1;
                pick_ms();
                sp_hit = 0;
                ag_delay = 1;
                ag_tgt = tp_btn;
                combo_run(green_hold);
            }
            if (sp_btn != tp_btn) { set_val(sp_btn, 0); }
        }
    }

    if (green_on()) {
        if (event_press(ag_btn) && !busy() && !(menu_on && get_val(PS4_L2))) {
            sp_hit = 0;
            pick_ms();
            ag_tgt = ag_btn;
            if (IT_VAL[23]) {
                qs_wait = IT_VAL[26];
                if (qs_wait < 1) { qs_wait = 1; }
                combo_run(qs_shot);
            }
            else            { ag_delay = 1; combo_run(green_hold); }
        }
    }

    if (combo_running(qs_shot)) {
        set_val(PS4_LX, 0);
        set_val(PS4_LY, 0);
        set_val(PS4_R2, 0);
    }

    if (ag_on)           { set_val(ag_tgt, 100); }
    else if (green_on()) { set_val(ag_btn, 0); }

    rm_src = 0;
    if (IT_VAL[0])      { rm_src = IT_VAL[9]; }
    else if (IT_VAL[11]) { rm_src = IT_VAL[21]; }
    else if (IT_VAL[23]) { rm_src = IT_VAL[27]; }
    if (rm_src) {
        if (rm_src == 1) { rm_btn = PS4_L3; }
        else             { rm_btn = PS4_R3; }
        if (get_val(rm_btn)) {
            set_val(rm_btn, 0);
            set_val(PS4_SQUARE, 100);
        }
    }



}

function stamina() {
    if (busy())  { return; }
    if (IT_VAL[29] == 1) { gc_cur = 85; }
    else                 { gc_cur = 70; }
    sh_ax = get_val(PS4_LX);
    sh_ay = get_val(PS4_LY);
    if (sh_ax < 0) { sh_ax = 0 - sh_ax; }
    if (sh_ay < 0) { sh_ay = 0 - sh_ay; }
    if (sh_ax > 20 || sh_ay > 20) {
        set_val(PS4_LX, (get_val(PS4_LX) * gc_cur) / 100);
        set_val(PS4_LY, (get_val(PS4_LY) * gc_cur) / 100);
    }
}

function cutoff_boost() {
    if (busy())   { return; }
    if (get_val(PS4_L2) < 20) { return; }
    if (get_val(PS4_R2) < 20) { return; }
    if (IT_VAL[33] == 1) {
        set_val(PS4_RY, (get_val(PS4_RY) * 13) / 10);
    } else {
        set_val(PS4_RX, get_val(PS4_LX));
        set_val(PS4_RY, get_val(PS4_LY));
    }
}

function menu_input() {

    if (!get_val(PS4_L2)) { rpt_axis = 0; return; }

    set_val(PS4_UP, 0);
    set_val(PS4_DOWN, 0);
    set_val(PS4_LEFT, 0);
    set_val(PS4_RIGHT, 0);

    if (event_press(PS4_R1)) {
        if (menu_lvl) { menu_lvl = 0; }
        menu_dirty = 1;
        rpt_axis = 0;
        if (IT_VAL[39]) { combo_run(fb_click); }
    }

    if (menu_lvl == 0 && event_press(PS4_R2)) {
        menu_lvl = 1;
        cursor = sec_first(sec_cur);
        menu_dirty = 1;
        rpt_axis = 0;
        if (IT_VAL[39]) { combo_run(fb_click); }
    }

    if (menu_lvl && IT_TYPE[cursor] == T_ACTION && event_press(PS4_R2)) {
        menu_dirty = 1;
        do_action();
        if (IT_VAL[39]) { combo_run(fb_ok); }
    }

    if (event_press(PS4_UP))    { move_cursor(-1); rpt_axis = 1; rpt_dir = -1; rpt_t = 0; }
    if (event_press(PS4_DOWN))  { move_cursor( 1); rpt_axis = 1; rpt_dir =  1; rpt_t = 0; }

    if (menu_lvl) {
        if (event_press(PS4_LEFT))  { step_value(-1); rpt_axis = 2; rpt_dir = -1; rpt_t = 0; }
        if (event_press(PS4_RIGHT)) { step_value( 1); rpt_axis = 2; rpt_dir =  1; rpt_t = 0; }
    }

    if (event_release(PS4_UP) || event_release(PS4_DOWN)
        || event_release(PS4_LEFT) || event_release(PS4_RIGHT)) {
        rpt_axis = 0;
    }

    if (rpt_axis) {
        rpt_t = rpt_t + get_rtime();
        if (rpt_t > REPEAT_DELAY) {
            if (rpt_t - REPEAT_DELAY > REPEAT_RATE) {
                rpt_t = REPEAT_DELAY;
                if (rpt_axis == 1) { move_cursor(rpt_dir); }
                else               { step_value(rpt_dir); }
            }
        }
    }
}

function sec_first(f_s) {
    for (sf_i = 0; sf_i < ITEMS; sf_i++) {
        if (IT_SEC[sf_i] == f_s) { return sf_i; }
    }
    return 0;
}

function sec_end(f_s) {
    for (sf_i = 0; sf_i < ITEMS; sf_i++) {
        if (IT_SEC[ITEMS - 1 - sf_i] == f_s) { return ITEMS - 1 - sf_i; }
    }
    return 0;
}

function move_cursor(f_d) {
    if (menu_lvl == 0) {
        sec_cur = sec_cur + f_d;
        if (sec_cur < 0)      { sec_cur = SECS - 1; }
        if (sec_cur > SECS-1) { sec_cur = 0; }
    } else {
        cursor = cursor + f_d;
        if (cursor < sec_first(sec_cur)) { cursor = sec_end(sec_cur); }
        if (cursor > sec_end(sec_cur))   { cursor = sec_first(sec_cur); }
    }
    menu_dirty = 1;
    if (IT_VAL[39]) { combo_run(fb_tick); }
}

function step_value(f_d) {
    if (IT_TYPE[cursor] == T_ACTION) { return; }
    if (get_val(PS4_R2)) { sv_step = IT_STEP[cursor]; }
    else                 { sv_step = 1; }
    IT_VAL[cursor] = IT_VAL[cursor] + (f_d * sv_step);
    if (IT_VAL[cursor] < IT_MIN[cursor]) { IT_VAL[cursor] = IT_MIN[cursor]; }
    if (IT_VAL[cursor] > IT_MAX[cursor]) { IT_VAL[cursor] = IT_MAX[cursor]; }
    if (IT_TYPE[cursor] == T_SPOT || IT_TYPE[cursor] == T_SB2
     || IT_TYPE[cursor] == T_RMP) { resolve_btns(cursor); }
    if (cursor == 0 || cursor == 11 || cursor == 23) {
        if (IT_VAL[cursor]) { only_one(cursor); }
    }
    if (cursor == 38) { ld_switch(); }
    menu_dirty = 1;
    if (IT_VAL[39]) { combo_run(fb_tick); }
}

function do_action() {

    if (cursor >= 34 && cursor <= 36) {
        menu_on = 0;
        save_all();
        if (cursor == 34)      { tune_start(1, 2); }
        else if (cursor == 35) { tune_start(2, 4); }
        else                   { tune_start(3, 0); }
        return;
    }

    if (cursor == 42) {
        table_defaults();
        normalize_mode();
        resolve_btns(7);
        ld_prev  = IT_VAL[38];
        tune_stop();
    }
    save_all();
    toast();
}

function toast() { toast_t = 700; menu_dirty = 1; }

function set_item(f_i, f_sec, f_type, f_min, f_max, f_step) {
    IT_SEC[f_i]  = f_sec;
    IT_TYPE[f_i] = f_type;
    IT_MIN[f_i]  = f_min;
    IT_MAX[f_i]  = f_max;
    IT_STEP[f_i] = f_step;
}

function table_build() {
    set_item( 0, 0, T_ONOFF,       0,     1,  1);
    set_item( 1, 0, T_SB2,         0,     1,  1);
    set_item( 2, 0, T_NUM,         7,   350,  7);
    set_item( 3, 0, T_NUM,        20,   500, 10);
    set_item( 4, 0, T_ONOFF,       0,     1,  1);
    set_item( 5, 0, T_NUM,         7,   350,  7);
    set_item( 6, 0, T_NUM,         7,   350,  7);
    set_item( 7, 0, T_SPOT,        0,     6,  1);
    set_item( 8, 0, T_NUM,       200,  1500, 10);
    set_item( 9, 0, T_RMP,         0,     2,  1);
    set_item(10, 0, T_NUM,       -80,    80,  5);
    set_item(11, 1, T_ONOFF,       0,     1,  1);
    set_item(12, 1, T_SB2,         0,     1,  1);
    set_item(13, 1, T_NUM,       200,  1500, 10);
    set_item(14, 1, T_NUM,       200,  1500, 10);
    set_item(15, 1, T_NUM,       200,  1500, 10);
    set_item(16, 1, T_NUM,       200,  1500, 10);
    set_item(17, 1, T_NUM,       200,  1500, 10);
    set_item(18, 1, T_NUM,         5,    45,  5);
