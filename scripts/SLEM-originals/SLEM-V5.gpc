    set_item(39, 8, T_ONOFF,       0,     1,  1);
    set_item(40, 8, T_ONOFF,       0,     1,  1);
    set_item(41, 8, T_ONOFF,       0,     1,  1);
    set_item(42, 8, T_ACTION,      0,     0,  1);
}

function table_defaults() {
    IT_VAL[ 0]=1    IT_VAL[ 1]=0    IT_VAL[ 2]=40   IT_VAL[ 3]=150 
    IT_VAL[ 4]=0    IT_VAL[ 5]=70   IT_VAL[ 6]=69   IT_VAL[ 7]=0   
    IT_VAL[ 8]=700  IT_VAL[ 9]=0    IT_VAL[10]=0    IT_VAL[11]=0   
    IT_VAL[12]=0    IT_VAL[13]=700  IT_VAL[14]=680  IT_VAL[15]=680 
    IT_VAL[16]=850  IT_VAL[17]=850  IT_VAL[18]=30   IT_VAL[19]=0   
    IT_VAL[20]=0    IT_VAL[21]=0    IT_VAL[22]=0    IT_VAL[23]=0   
    IT_VAL[24]=0    IT_VAL[25]=740  IT_VAL[26]=260  IT_VAL[27]=0   
    IT_VAL[28]=0    IT_VAL[29]=0    IT_VAL[30]=0    IT_VAL[31]=100 
    IT_VAL[32]=0    IT_VAL[33]=0    IT_VAL[34]=0    IT_VAL[35]=0   
    IT_VAL[36]=0    IT_VAL[37]=0    IT_VAL[38]=0    IT_VAL[39]=0   
    IT_VAL[40]=0    IT_VAL[41]=1    IT_VAL[42]=0   
}

function load_all() {
    pk_a = get_pvar(SPVAR_1, 0, 255, 1);
    pk_b = get_pvar(SPVAR_2, 0, 255, 16);
    IT_VAL[ 0] = (pk_a) % 2;
    IT_VAL[ 1] = (pk_a / 2) % 2;
    IT_VAL[ 4] = (pk_a / 4) % 2;
    IT_VAL[11] = (pk_a / 8) % 2;
    IT_VAL[12] = (pk_a / 16) % 2;
    IT_VAL[20] = (pk_a / 32) % 2;
    IT_VAL[23] = (pk_a / 64) % 2;
    IT_VAL[24] = (pk_a / 128) % 2;
    IT_VAL[30] = (pk_b) % 2;
    IT_VAL[37] = (pk_b / 2) % 2;
    IT_VAL[39] = (pk_b / 4) % 2;
    IT_VAL[40] = (pk_b / 8) % 2;
    IT_VAL[41] = (pk_b / 16) % 2;
    IT_VAL[ 2] = get_pvar(SPVAR_3,     7,   350,    40);
    IT_VAL[ 3] = get_pvar(SPVAR_4,    20,   500,   150);
    IT_VAL[ 5] = get_pvar(SPVAR_5,     7,   350,    70);
    IT_VAL[ 6] = get_pvar(SPVAR_6,     7,   350,    69);
    IT_VAL[ 7] = get_pvar(SPVAR_7,     0,     6,     0);
    IT_VAL[ 8] = get_pvar(SPVAR_8,   200,  1500,   700);
    IT_VAL[ 9] = get_pvar(SPVAR_9,     0,     2,     0);
    IT_VAL[10] = get_pvar(SPVAR_10,   -80,    80,     0);
    IT_VAL[13] = get_pvar(SPVAR_11,   200,  1500,   700);
    IT_VAL[14] = get_pvar(SPVAR_12,   200,  1500,   680);
    IT_VAL[15] = get_pvar(SPVAR_13,   200,  1500,   680);
    IT_VAL[16] = get_pvar(SPVAR_14,   200,  1500,   850);
    IT_VAL[17] = get_pvar(SPVAR_15,   200,  1500,   850);
    IT_VAL[18] = get_pvar(SPVAR_16,     5,    45,    30);
    IT_VAL[19] = get_pvar(SPVAR_17,     0,     3,     0);
    IT_VAL[21] = get_pvar(SPVAR_18,     0,     2,     0);
    IT_VAL[22] = get_pvar(SPVAR_19,   -80,    80,     0);
    IT_VAL[25] = get_pvar(SPVAR_20,   200,  1500,   740);
    IT_VAL[26] = get_pvar(SPVAR_21,     0,   600,   260);
    IT_VAL[27] = get_pvar(SPVAR_22,     0,     2,     0);
    IT_VAL[28] = get_pvar(SPVAR_23,   -80,    80,     0);
    IT_VAL[29] = get_pvar(SPVAR_24,     0,     2,     0);
    IT_VAL[31] = get_pvar(SPVAR_25,    50,   200,   100);
    IT_VAL[32] = get_pvar(SPVAR_26,     0,     2,     0);
    IT_VAL[33] = get_pvar(SPVAR_27,     0,     2,     0);
    IT_VAL[38] = get_pvar(SPVAR_28,     0,     2,     0);
    normalize_mode();
    resolve_btns(7);
    ld_prev = IT_VAL[38];
}

function save_all() {
    pk_a = 0;
    pk_b = 0;
    if (IT_VAL[ 0]) { pk_a = pk_a + 1; }
    if (IT_VAL[ 1]) { pk_a = pk_a + 1 * 2; }
    if (IT_VAL[ 4]) { pk_a = pk_a + 1 * 4; }
    if (IT_VAL[11]) { pk_a = pk_a + 1 * 8; }
    if (IT_VAL[12]) { pk_a = pk_a + 1 * 16; }
    if (IT_VAL[20]) { pk_a = pk_a + 1 * 32; }
    if (IT_VAL[23]) { pk_a = pk_a + 1 * 64; }
    if (IT_VAL[24]) { pk_a = pk_a + 1 * 128; }
    if (IT_VAL[30]) { pk_b = pk_b + 1; }
    if (IT_VAL[37]) { pk_b = pk_b + 1 * 2; }
    if (IT_VAL[39]) { pk_b = pk_b + 1 * 4; }
    if (IT_VAL[40]) { pk_b = pk_b + 1 * 8; }
    if (IT_VAL[41]) { pk_b = pk_b + 1 * 16; }
    set_pvar(SPVAR_1, pk_a);
    set_pvar(SPVAR_2, pk_b);
    set_pvar(SPVAR_3, IT_VAL[ 2]);
    set_pvar(SPVAR_4, IT_VAL[ 3]);
    set_pvar(SPVAR_5, IT_VAL[ 5]);
    set_pvar(SPVAR_6, IT_VAL[ 6]);
    set_pvar(SPVAR_7, IT_VAL[ 7]);
    set_pvar(SPVAR_8, IT_VAL[ 8]);
    set_pvar(SPVAR_9, IT_VAL[ 9]);
    set_pvar(SPVAR_10, IT_VAL[10]);
    set_pvar(SPVAR_11, IT_VAL[13]);
    set_pvar(SPVAR_12, IT_VAL[14]);
    set_pvar(SPVAR_13, IT_VAL[15]);
    set_pvar(SPVAR_14, IT_VAL[16]);
    set_pvar(SPVAR_15, IT_VAL[17]);
    set_pvar(SPVAR_16, IT_VAL[18]);
    set_pvar(SPVAR_17, IT_VAL[19]);
    set_pvar(SPVAR_18, IT_VAL[21]);
    set_pvar(SPVAR_19, IT_VAL[22]);
    set_pvar(SPVAR_20, IT_VAL[25]);
    set_pvar(SPVAR_21, IT_VAL[26]);
    set_pvar(SPVAR_22, IT_VAL[27]);
    set_pvar(SPVAR_23, IT_VAL[28]);
    set_pvar(SPVAR_24, IT_VAL[29]);
    set_pvar(SPVAR_25, IT_VAL[31]);
    set_pvar(SPVAR_26, IT_VAL[32]);
    set_pvar(SPVAR_27, IT_VAL[33]);
    set_pvar(SPVAR_28, IT_VAL[38]);
    ld_save(IT_VAL[38]);
    set_pvar(SPVAR_29, LAYOUT);
}

function led_state() {
    if (!IT_VAL[41])   { set_rgb(0, 0, 0);       return; }
    if (menu_on)       { set_rgb(255, 255, 255); return; }
    set_rgb(255, 176, 0);
}

combo green_hold {
    wait(ag_delay);
    ag_on = 1;
    wait(ag_ms);
    ag_on = 0;
    wait(40);
}

combo tempo_flick {
    set_val(PS4_RY, (tp_dir * 3) / 4);
    wait(tp_step);
    set_val(PS4_RY, (tp_dir * 2) / 4);
    wait(tp_step);
    set_val(PS4_RY, tp_dir / 4);
    wait(tp_step);
    set_val(PS4_RY, 0);
    wait(tp_step);
    set_val(PS4_RY, (0 - tp_dir) / 4);
    wait(tp_step);
    set_val(PS4_RY, ((0 - tp_dir) * 2) / 4);
    wait(tp_step);
    set_val(PS4_RY, ((0 - tp_dir) * 3) / 4);
    wait(tp_step);
    set_val(PS4_RY, 0 - tp_dir);
    wait(tp_hold);
    set_val(PS4_RY, 0);
}

combo DR_CRAB {
    set_val(PS4_R2, 100); set_val(PS4_RX, 70 * dr_s); set_val(PS4_RY, -70); wait(dr_a);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0);         set_val(PS4_RY, 0);   wait(dr_e);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0);         set_val(PS4_RY, 100); wait(dr_a);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0);         set_val(PS4_RY, 0);   wait(dr_e);
}

combo DR_MOMENTUM {
    set_val(PS4_R2, 100); set_val(PS4_RX, 70 * dr_s);  set_val(PS4_RY, 0);   wait(dr_a);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0);          set_val(PS4_RY, 0);   wait(dr_e);
    set_val(PS4_R2, 100); set_val(PS4_RX, -70 * dr_s); set_val(PS4_RY, 0);   wait(dr_a);
