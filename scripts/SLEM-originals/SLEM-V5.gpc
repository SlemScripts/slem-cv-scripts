int RNX[18]; int RNY[18]; int RNL[18];
int rn_i, rn_x, rn_x2, rn_y, rn_s;

function rain_tables() {
    RNX[0]=6;   RNX[1]=19;  RNX[2]=31;  RNX[3]=44;  RNX[4]=57;  RNX[5]=70;
    RNX[6]=83;  RNX[7]=96;  RNX[8]=109; RNX[9]=122; RNX[10]=13; RNX[11]=38;
    RNX[12]=63; RNX[13]=88; RNX[14]=113;RNX[15]=25; RNX[16]=50; RNX[17]=101;
    RNY[0]=3;   RNY[1]=41;  RNY[2]=17;  RNY[3]=55;  RNY[4]=9;   RNY[5]=33;
    RNY[6]=49;  RNY[7]=21;  RNY[8]=37;  RNY[9]=11;  RNY[10]=58; RNY[11]=5;
    RNY[12]=45; RNY[13]=27; RNY[14]=52; RNY[15]=13; RNY[16]=61; RNY[17]=29;
    RNL[0]=2;   RNL[1]=3;   RNL[2]=2;   RNL[3]=3;   RNL[4]=2;   RNL[5]=3;
    RNL[6]=2;   RNL[7]=3;   RNL[8]=3;   RNL[9]=2;   RNL[10]=3;  RNL[11]=2;
    RNL[12]=3;  RNL[13]=3;  RNL[14]=2;  RNL[15]=3;  RNL[16]=2;  RNL[17]=3;
}

function rain_streak(f_x, f_y, f_len, f_clip, f_col) {
    for (rn_s = 0; rn_s <= f_len * 2; rn_s++) {
        rn_y = f_y + rn_s;
        rn_x2 = f_x - (rn_s / 2);
        if (rn_y >= 0 && rn_y < f_clip && rn_x2 >= 0 && rn_x2 < OLED_WIDTH) {
            pixel_oled(rn_x2, rn_y, f_col);
        }
    }
}

function rain(f_t, f_clip, f_col) {
    for (rn_i = 0; rn_i < 18; rn_i++) {
        rn_y = ((RNY[rn_i] + (f_t / 26) + (rn_i * 7)) % 74) - 6;
        rn_x = RNX[rn_i] - (rn_y / 3);
        while (rn_x < 0)   { rn_x = rn_x + 128; }
        while (rn_x > 127) { rn_x = rn_x - 128; }
        rain_streak(rn_x, rn_y, RNL[rn_i], f_clip, f_col);
    }

    rn_s = (f_t / 8) % 300;
    if (rn_s < 64) {
        rain_streak(118 - ((rn_s * 14) / 10), rn_s - 10, 9, f_clip, f_col);
    }
}

define WING_W  = 104;
define WING_H  = 40;
define WING_X  = 12;
define WING_Y  = 3;
define WM_Y    = 48;
define OUTRO_AT = 4400;
define OUTRO_MS = 1000;

int bt_rev, bt_sh, bt_k, bt_n, bt_p, bt_wy, bt_w, bt_h, bt_th, bt_my;

function draw_boot() {
    screen_clear();

    bt_p = 0;
    if (boot_t > OUTRO_AT) {
        bt_p = ((boot_t - OUTRO_AT) * 1000) / OUTRO_MS;
        if (bt_p > 1000) { bt_p = 1000; }
    }

    bt_wy = WING_Y - ((bt_p * (WING_Y + WING_H + 6)) / 1000);

    if (boot_t > 300 && bt_wy > (0 - WING_H)) {
        image_oled(WING_X, bt_wy, TRUE, FALSE, WINGS[0]);

        bt_rev = 0;
        if (boot_t > 400) {
            bt_rev = boot_t - 400;
            if (bt_rev > 1500) { bt_rev = 1500; }
            bt_rev = (bt_rev * 1000) / 1500;
            bt_rev = 1000 - (((1000 - bt_rev) * (1000 - bt_rev)) / 1000);
            bt_rev = (bt_rev * 52) / 1000;
        }
        if (bt_rev < 52 && bt_wy >= 0) {
            rect_oled(WING_X, bt_wy, 52 - bt_rev, WING_H, 1, FIELD);
            rect_oled(64 + bt_rev, bt_wy, 52 - bt_rev, WING_H, 1, FIELD);
        }
    }

    if (boot_t > 1950) {
        bt_n = ((boot_t - 1950) / 110) + 1;
        if (bt_n > 4) { bt_n = 4; }
        bt_w  =  9 + (((20 - 9)  * bt_p) / 1000);
        bt_h  = 12 + (((26 - 12) * bt_p) / 1000);
        bt_th =  2 + (((4 - 2)   * bt_p) / 1000);
        bt_my = WM_Y + (((12 - WM_Y) * bt_p) / 1000);
        wordmark_at((OLED_WIDTH - wm_width(bt_w)) / 2, bt_my, bt_w, bt_h, bt_th, bt_n);
    }

    rain(anim_t, 64, INK);

    if (boot_t > 2500 && bt_p == 0) {
        bt_sh = (boot_t - 2500) % 1800;
        if (bt_sh < 700) {
            bt_sh = ((bt_sh * 170) / 700) - 20;
            for (bt_k = 0; bt_k < 3; bt_k++) {
                line_oled(bt_sh + bt_k, 0, bt_sh + bt_k - 22, 63, 1, FIELD);
            }
        }
    }
}

define FOOT_Y = 50;

int id_sh, id_band, id_k;


function draw_tune() {
    screen_clear();

    if (tn_ph == 2) {
        print(center_x(str_len(TN_DONE[0]), OLED_FONT_MEDIUM_WIDTH), 26,
              OLED_FONT_MEDIUM, INK, TN_DONE[0]);
        return;
    }

    if (tn_on == 1) {
        print(center_x(str_len(TNT_N[tn_stage]), OLED_FONT_SMALL_WIDTH), 3,
              OLED_FONT_SMALL, INK, TNT_N[tn_stage]);
    } else if (tn_on == 2) {
        print(center_x(str_len(TNG_N[tn_stage]), OLED_FONT_SMALL_WIDTH), 3,
              OLED_FONT_SMALL, INK, TNG_N[tn_stage]);
    } else {
        print(center_x(str_len(TNS_N[0]), OLED_FONT_SMALL_WIDTH), 3,
              OLED_FONT_SMALL, INK, TNS_N[0]);
    }
    line_oled(0, 13, 127, 13, 1, INK);

    if (tn_ph == 1) {
        draw_num(center_x(num_len(tn_res), OLED_FONT_MEDIUM_WIDTH), 22,
                 OLED_FONT_MEDIUM, tn_res, INK);
        print(center_x(str_len(TN_OK[0]), OLED_FONT_SMALL_WIDTH), 46,
              OLED_FONT_SMALL, INK, TN_OK[0]);
        return;
    }

    if (tn_last > 0) {
        td_w = (str_len(TN_LAST[0]) * OLED_FONT_SMALL_WIDTH) + 5
             + (num_len(tn_last) * OLED_FONT_MEDIUM_WIDTH);
        td_x = (OLED_WIDTH - td_w) / 2;
        print(td_x, 24, OLED_FONT_SMALL, INK, TN_LAST[0]);
        draw_num(td_x + (str_len(TN_LAST[0]) * OLED_FONT_SMALL_WIDTH) + 5, 20,
                 OLED_FONT_MEDIUM, tn_last, INK);
    } else {
        print(center_x(str_len(TN_SHOOT[0]), OLED_FONT_SMALL_WIDTH), 22,
              OLED_FONT_SMALL, INK, TN_SHOOT[0]);
    }

    td_w = (num_len(tn_n) * OLED_FONT_SMALL_WIDTH)
         + (str_len(TN_OF[0]) * OLED_FONT_SMALL_WIDTH) + 4;
    td_x = (OLED_WIDTH - td_w) / 2;
    draw_num(td_x, 40, OLED_FONT_SMALL, tn_n, INK);
    print(td_x + (num_len(tn_n) * OLED_FONT_SMALL_WIDTH) + 4, 40,
          OLED_FONT_SMALL, INK, TN_OF[0]);

    rect_oled(3, 52, 122, 6, 0, INK);
    if (tn_n > 0) { rect_oled(4, 53, (tn_n * 120) / TN_N, 4, 1, INK); }
}

function draw_idle() {
    screen_clear();

    if (IT_VAL[40]) {
        dfx = 0;
        dfy = 0;
    } else {
        dfx = ((anim_t / 2600) % 7) - 3;
        dfy = ((anim_t / 4100) % 5) - 2;
        rain(anim_t, FOOT_Y, INK);
    }

    wordmark_at(((OLED_WIDTH - wm_width(20)) / 2) + dfx, 12 + dfy, 20, 26, 4, 4);

    if (!IT_VAL[40]) {
        id_sh = anim_t % 3600;
        if (id_sh < 750) {
            id_band = ((OLED_WIDTH - wm_width(20)) / 2) + dfx - 16
                      + ((id_sh * (wm_width(20) + 34)) / 750);
            for (id_k = 0; id_k < 4; id_k++) {
                line_oled(id_band + id_k,      11 + dfy,
                          id_band + id_k - 14, 39 + dfy, 1, FIELD);
            }
        }
    }

    line_oled(0, FOOT_Y, 127, FOOT_Y, 1, INK);

    if (IT_VAL[40]) { draw_marquee(53, MARQ[0], MARQ_LEN, 0); }
    else            { draw_marquee(53, MARQ[0], MARQ_LEN, (anim_t / 130) % MARQ_LEN); }
}

int mn_w, mn_x, mn_frac, mn_n, mn_bw, mn_j, mn_pos, mn_cnt;

function sec_pos() {
    mn_pos = 0;
    mn_cnt = 0;
    for (i = 0; i < ITEMS; i++) {
        if (IT_SEC[i] == IT_SEC[cursor]) {
            mn_cnt = mn_cnt + 1;
            if (i < cursor) { mn_pos = mn_pos + 1; }
        }
    }
    mn_pos = mn_pos + 1;
}

function draw_menu() {
    screen_clear();

    if (menu_lvl == 0) {
        draw_hint(1, HINT_S[0], HINT_S_LEN, (anim_t / 320) % HINT_S_LEN);
        mn_pos = sec_cur + 1;
        mn_cnt = SECS;
        mn_w = (num_len(mn_pos) + 1 + num_len(mn_cnt)) * OLED_FONT_SMALL_WIDTH;
        mn_x = OLED_WIDTH - mn_w - 2;
        draw_num(mn_x, 1, OLED_FONT_SMALL, mn_pos, INK);
        mn_x = mn_x + (num_len(mn_pos) * OLED_FONT_SMALL_WIDTH);
        print(mn_x, 1, OLED_FONT_SMALL, INK, SLASH[0]);
        mn_x = mn_x + OLED_FONT_SMALL_WIDTH;
        draw_num(mn_x, 1, OLED_FONT_SMALL, mn_cnt, INK);
        line_oled(0, 10, 127, 10, 1, INK);
        print(center_x(str_len(SEC_NAME[sec_cur]), OLED_FONT_MEDIUM_WIDTH), 26,
              OLED_FONT_MEDIUM, INK, SEC_NAME[sec_cur]);
        for (mn_j = 0; mn_j < SECS; mn_j++) {
            if (mn_j == sec_cur) { rect_oled(((OLED_WIDTH - (SECS * 9)) / 2) + (mn_j * 9), 58, 7, 4, 1, INK); }
            else                 { rect_oled(((OLED_WIDTH - (SECS * 9)) / 2) + (mn_j * 9), 59, 7, 2, 1, INK); }
        }
        if (toast_t > 0) {
            rect_oled(26, 20, 76, 22, 1, FIELD);
            rect_oled(26, 20, 76, 22, 0, INK);
            print(center_x(str_len(SAVED[0]), OLED_FONT_MEDIUM_WIDTH), 26,
                  OLED_FONT_MEDIUM, INK, SAVED[0]);
        }
        return;
    }

    sec_pos();

    draw_hint(1, HINT_I[0], HINT_I_LEN, (anim_t / 320) % HINT_I_LEN);

    mn_w = (num_len(mn_pos) + 1 + num_len(mn_cnt)) * OLED_FONT_SMALL_WIDTH;
    mn_x = OLED_WIDTH - mn_w - 2;
    draw_num(mn_x, 1, OLED_FONT_SMALL, mn_pos, INK);
    mn_x = mn_x + (num_len(mn_pos) * OLED_FONT_SMALL_WIDTH);
    print(mn_x, 1, OLED_FONT_SMALL, INK, SLASH[0]);
    mn_x = mn_x + OLED_FONT_SMALL_WIDTH;
    draw_num(mn_x, 1, OLED_FONT_SMALL, mn_cnt, INK);

    line_oled(0, 10, 127, 10, 1, INK);

    print(center_x(str_len(IT_NAME[cursor]), OLED_FONT_SMALL_WIDTH), 15,
          OLED_FONT_SMALL, INK, IT_NAME[cursor]);

    if (IT_TYPE[cursor] == T_ACTION) {
        print(center_x(str_len(ACT_N[0]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, ACT_N[0]);
    } else if (IT_TYPE[cursor] == T_ONOFF) {
        print(center_x(str_len(ON_OFF[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, ON_OFF[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_SB2) {
        print(center_x(str_len(SB2_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, SB2_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_LOAD) {
        print(center_x(str_len(LOAD_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, LOAD_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_MODE) {
        print(center_x(str_len(MODE_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, MODE_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_CUT) {
        print(center_x(str_len(CUT_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, CUT_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_RMP) {
        print(center_x(str_len(RMP_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, RMP_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_SPOT) {
        print(center_x(str_len(SPT_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, SPT_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_FAT) {
        print(center_x(str_len(FAT_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, FAT_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_STAM) {
        print(center_x(str_len(STAM_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, STAM_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_SET) {
        print(center_x(str_len(SET_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, SET_N[IT_VAL[cursor]]);
        } else if (IT_TYPE[cursor] == T_HAND) {
        print(center_x(str_len(HAND_N[IT_VAL[cursor]]), OLED_FONT_MEDIUM_WIDTH), 28,
              OLED_FONT_MEDIUM, INK, HAND_N[IT_VAL[cursor]]);
        } else {
        draw_num(center_x(num_len(IT_VAL[cursor]), OLED_FONT_MEDIUM_WIDTH), 28,
                 OLED_FONT_MEDIUM, IT_VAL[cursor], INK);
    }

    if (IT_TYPE[cursor] == T_NUM) {
        mn_frac = ((IT_VAL[cursor] - IT_MIN[cursor]) * 120)
                  / (IT_MAX[cursor] - IT_MIN[cursor]);
        rect_oled(3, 48, 122, 6, 0, INK);
        if (mn_frac > 0) { rect_oled(4, 49, mn_frac, 4, 1, INK); }
    } else if (IT_TYPE[cursor] != T_ACTION) {
        mn_n = IT_MAX[cursor] + 1;
        mn_bw = 120 / mn_n;
        for (mn_j = 0; mn_j < mn_n; mn_j++) {
            if (mn_j == IT_VAL[cursor]) {
                rect_oled(4 + (mn_j * mn_bw), 48, mn_bw - 4, 6, 1, INK);
            } else {
                rect_oled(4 + (mn_j * mn_bw), 48, mn_bw - 4, 6, 0, INK);
            }
        }
    }

    for (mn_j = 0; mn_j < SECS; mn_j++) {
        if (mn_j == IT_SEC[cursor]) { rect_oled(((OLED_WIDTH - (SECS * 9)) / 2) + (mn_j * 9), 58, 7, 4, 1, INK); }
        else                        { rect_oled(((OLED_WIDTH - (SECS * 9)) / 2) + (mn_j * 9), 59, 7, 2, 1, INK); }
    }

    if (toast_t > 0) {
        rect_oled(26, 20, 76, 22, 1, FIELD);
        rect_oled(26, 20, 76, 22, 0, INK);
        print(center_x(str_len(SAVED[0]), OLED_FONT_MEDIUM_WIDTH), 26,
              OLED_FONT_MEDIUM, INK, SAVED[0]);
    }
}
