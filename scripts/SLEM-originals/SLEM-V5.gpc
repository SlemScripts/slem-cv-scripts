define FRAME_MS = 33;
define IDLE_MS  = 30;
define MENU_MS  = 16;
define LEAN_MEM  = 800;
define LEAN_HOLD = 8000;
define LAYOUT    = 19;
define QS_FLICK  = 50;
define TN_N      = 3;

define REPEAT_DELAY = 400;
define REPEAT_RATE  = 110;

const string SEC_NAME[] = { "TEMPO", "GREEN", "QS GREEN", "MOVE", "DEF",
                            "TUNE TEMPO", "TUNE GREEN", "TUNE QSGRN", "SYS" };

