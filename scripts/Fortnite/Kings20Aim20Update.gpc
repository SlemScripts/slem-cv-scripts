define AMOUNT_OF_VALNAME_IDX = 19; 
define MAX_MODS_COUNT = 12;                          
int modName_idx;  
  int antirecoil_onoff = 1 ; 
  int ToggleBattsStickyAim = 0 ; 
  int sweet_evil_onoff = 0 ; 
  int Head_Assist_onoff = 1 ; 
  int USE_HAIR_TRIGGER = 0 ; 
  int IntroTime_onoff = 0 ; 
  int ToggleStrafeShot = 1 ; 
  int aim_abuse_onoff = 0 ; 
