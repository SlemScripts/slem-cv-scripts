  int burst_fire_onoff = 0 ; 
  int smart_fire_onoff = 0 ; 
  int dynamic_fire_onoff = 0 ; 
  int rapidfire_onoff = 0 ; 
  const string ANTIRECOIL           = "Antirecoil" ; 
