			}
	PP19 = (PP19 + PP3) % PP2;
	return PP19;
	}
function PP40(PP39) {
	if (PP39 >= Off) {
		return (PP39 + PP8 >> On) / PP8;
			}
// discord.gg/orla
	return (PP39 - PP8 >> On) / PP8;
	}
function PP41(PP37,PP38,PP39) {
	return PP43((PP8 - PP39),PP37) + PP43(PP39,PP38);
	}
function PP42(PP39) {
	return PP39 * PP8;
	}
function PP43(PP44,PP45) {
	return ((PP44 >> PP5) * (PP45 >> PP5));
	}
function GetShapes(f_var) {
	if (!SpiralPosition1) {
		InnerSpiral -= 1;
		if (InnerSpiral < TaylorRadiusMin) SpiralPosition1 = True;
			}
	else {
		InnerSpiral += 1;
		if (InnerSpiral > f_var) SpiralPosition1 = False;
			}
	if (!SpiralPosition2) {
// discord.gg/orla
		OuterSpiral -= 1;
		if (OuterSpiral < TaylorRadiusMin) SpiralPosition2 = True;
			}
	else {
		OuterSpiral += 1;
		if (OuterSpiral > f_var) SpiralPosition2 = False;
			}
	if (ToggleTaylorAssist == TRUE) {
		RY1 = (get_val(PS4_RY)) + ((SinAngle * f_var)) / 100;
		RX1 = (get_val(PS4_RX)) + ((CosAngle * f_var)) / 100;
			}
	set_val(PS4_RX, RX1);
	set_val(PS4_RY, RY1);
	}
function AXRL(AxisXY, AxisVal) {
	if (abs(get_ival(AxisXY)) <= ExpoStrength) return AxisVal;
	return get_ival(AxisXY);
	}
combo Aim_Expo {
	set_val(RY, AXRL(RY, ExpoStrength));
// discord.gg/orla
	wait(8);
	set_val(RX, AXRL(RX, ExpoStrength));
	wait(8);
	set_val(LX, AXRL(LX, ExpoStrength));
	wait(8);
	set_val(RY, AXRL(RY, -ExpoStrength));
	wait(8);
	set_val(RX, AXRL(RX, -ExpoStrength));
	wait(8);
	set_val(LX, AXRL(LX, -ExpoStrength));
	wait(8);
	}
combo Aim_Expo_Accuracy {
	set_val(RY, AXRL(RY, 27));
	wait(8);
// discord.gg/orla
	set_val(RX, AXRL(RX, ExpoStrength));
// build anbhz5802mus.c660fb4f89
	wait(8);
	set_val(RY, AXRL(RY, -ExpoStrength));
	wait(8);
	set_val(RX, AXRL(RX, -ExpoStrength));
	wait(8);
	}
function AutotrackingOn() {
	set_rgb(234, 0, 255);
	StrafeShot = TRUE;
	}
function AutotrackingOff() {
	
	StrafeShot = FALSE;
	}
combo AA1 {
	set_val(PS4_RX,AA1)wait(DDD)set_val(PS4_RY,AA1) set_val(PS4_RX,-AA1)wait(DDD)set_val(PS4_RY,-AA1)
}
combo AA2 {
	set_val(PS4_RX,AA2) set_val(PS4_RY,AA2) set_val(PS4_RX,-AA2)wait(DDD)set_val(PS4_RY,-AA2)
}
