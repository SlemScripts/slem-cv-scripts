combo PickupMacroCombo {
	set_val(Interact, 100);
	wait(1);
	set_val(Interact, 0);
// discord.gg/orla
	wait(1);
	}
combo Dropshot {
	set_val(Crouch, 100);
	wait(DropshotWaitTime);
	set_val(Crouch, 0);
	wait(DropshotWaitTime);
	}
combo AntiRecoil {
	AntirecoilVertical = get_ival(PS4_RY) + AntiRecoilStrength;
	if (AntirecoilVertical > 100) AntirecoilVertical = 100;
	if (abs(get_val(PS4_RY)) < abs(AntiRecoilStrength) + 5) set_val(PS4_RY, (AntirecoilVertical));
	}
combo ExponentialAimSlightOffset {
	set_val(PS4_RX, Feature1);
	wait(1);
	set_val(PS4_RY, Feature1);
	wait(1);
	set_val(PS4_RX, -Feature1);
	wait(1);
	set_val(PS4_RY, -Feature1);
// discord.gg/orla
	wait(1);
	}
combo ExponentialAimSlightOffset2 {
	set_val(PS4_RX, Feature1);
	wait(1);
	set_val(PS4_RY, Feature1);
	wait(1);
	set_val(PS4_RX, -Feature1);
	wait(1);
	set_val(PS4_RY, -Feature1);
	wait(1);
	}
combo AdsAimAssist {
	set_val(XB1_RY, get_ival(XB1_RY) + inv(strength));
	wait(delay);
	set_val(XB1_RX, get_ival(XB1_RX) + (strength));
	wait(delay);
	set_val(XB1_RY, get_ival(XB1_RY) + (strength));
	wait(delay);
	set_val(XB1_RX, get_ival(XB1_RX) + inv(strength));
	wait(delay);
	}
combo HipfireStickyAim {
	offset2(PS4_RY, HipAimAssistSize);
	wait(HipfireAimAssistTime);
	offset2(PS4_RX, HipAimAssistSize);
// discord.gg/orla
	offset2(PS4_LX, HipAimAssistSize);
	wait(HipfireAimAssistTime);
	offset2(PS4_RY, inv(HipAimAssistSize));
	wait(HipfireAimAssistTime);
	offset2(PS4_RX, inv(HipAimAssistSize));
	offset2(PS4_LX, inv(HipAimAssistSize));
	wait(HipfireAimAssistTime);
	}
combo AdsStickyAim {
	offset2(PS4_RY, AdsAimAssistSize);
	wait(AdsAimAssistTime);
	offset2(PS4_RX, AdsAimAssistSize);
	offset2(PS4_LX, AdsAimAssistSize);
	wait(AdsAimAssistTime);
	offset2(PS4_RY, inv(AdsAimAssistSize));
	wait(AdsAimAssistTime);
// discord.gg/orla
	offset2(PS4_RX, inv(AdsAimAssistSize));
	offset2(PS4_LX, inv(AdsAimAssistSize));
	wait(AdsAimAssistTime);
	}
combo SlightStutterAA {
	set_val(PS4_RX, AimAssist_Strength);
	set_val(PS4_RY, AimAssist_Strength);
	wait(1);
	set_val(PS4_RX, -AimAssist_Strength);
	set_val(PS4_RY, -AimAssist_Strength);
	wait(1);
	}
combo AimAssistThree {
	set_val(LX, -100 + get_ival(LX));
	wait(15);
	set_val(LX, 100 + get_ival(LX));
	wait(15);
	}
combo HeadAssist_cmb {
	set_val(RY, inv(Head) + get_ival(RY));
	}
// discord.gg/orla
combo StrafeShot {
	set_val(XB1_LX, -100 + get_ival(PS4_LX));
	wait(1);
	set_val(XB1_LX, 100 + get_ival(PS4_LX));
	wait(1);
	}
