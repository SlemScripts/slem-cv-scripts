int undefined1,undefined2// 20 values for each value on array to match the 20ms update of in game aim assist
int undefined3,undefined4,undefined5,undefined6,undefined7,undefined8,undefined9,undefined10,undefined11,SAA,GAA;//discord.gg/orla
//varibles I don't recommend changing
init {
	//mod menu stuff
	SAA = TRUE;
	AntiRecoilStrength = get_pvar(SPVAR_1,  0, 50, 15);
	Dropshot = get_pvar(SPVAR_2, 0, 2, 0);
	DropshotWaitTime = get_pvar(SPVAR_3, 1, 100, 25);
	PickupMacro = get_pvar(SPVAR_4, 0, 1, 1);
	StrafeShuffle = get_pvar(SPVAR_5, 0, 1, 0);
	StrafeShuffleDistance = get_pvar(SPVAR_5, 3, 12, 6);
// discord.gg/orla
	if (Linear) {
		PolarAdsAA = TRUE;
		AdsAimAssist = TRUE;
		ToggleBattsStickyAim = TRUE;
		StickAssistLinearV2_LS = 1;
		StickAssistLinearV1_RS = TRUE;
		GAA = FALSE;
			}
	else {
		AimAssistExpo = TRUE;
		GAA = FALSE;
			}
	AutotrackingOn();
	defaultScreen();
	}
main {
	vm_tctrl(-9);
	if(!modMenuActive && get_val(MOD_MENU_TOGGLE_HOLD) && event_press(MOD_MENU_TOGGLE_PRESS)) {
		// Toggle mod menu activation
		modMenuActive = TRUE;
		display_mod_menu();
			}
	if(modMenuActive) {
		if(event_press(MOD_NEXT)) {
			// Navigate to next mod
			if((currentMod + 1) < modAmount) currentMod++;
			else currentMod = 0;
			display_mod_menu();
					}
		if(event_press(MOD_PREVIOUS)) {
// discord.gg/orla
			// Navigate to previous mod
			if(currentMod > 0) currentMod--;
			else currentMod = modAmount - 1;
			display_mod_menu();
					}
		if(currentMod == 0) {
			if(event_press(MOD_INCREASE) && AntiRecoilStrength < 50) {
				AntiRecoilStrength++;
				display_mod_menu();
				set_pvar(SPVAR_1, AntiRecoilStrength);
							}
			if(event_press(MOD_DECREASE) && AntiRecoilStrength > 0) {
				AntiRecoilStrength--;
				display_mod_menu();
				set_pvar(SPVAR_1, AntiRecoilStrength);
							}
					}
		if(currentMod == 1 && (event_press(MOD_SELECT) || event_press(MOD_INCREASE))) {
			// Toggle AutoJump
			if(Dropshot > 1) Dropshot = 0;
// discord.gg/orla
			else Dropshot++;
			display_mod_menu();
			if(Dropshot == 0){
				set_pvar(SPVAR_2, 0);
							}
			else if (Dropshot == 1) {
				set_pvar(SPVAR_2, 1);
							}
			else {
				set_pvar(SPVAR_2, 2);
							}
					}
		if(currentMod == 1  && event_press(MOD_DECREASE)){
			// Toggle AutoJump
			if(Dropshot < 1) Dropshot = 2;
			else Dropshot--;
			display_mod_menu();
			if(Dropshot == 0){
				set_pvar(SPVAR_2, 0);
// discord.gg/orla
							}
			else if (Dropshot == 1) {
				set_pvar(SPVAR_2, 1);
							}
			else {
				set_pvar(SPVAR_2, 2);
							}
					}
		if(currentMod == 2) {
			if(event_press(MOD_INCREASE) && DropshotWaitTime < 100) {
				DropshotWaitTime++;
				display_mod_menu();
				set_pvar(SPVAR_3, DropshotWaitTime);
							}
			if(event_press(MOD_DECREASE) && DropshotWaitTime > 0) {
				DropshotWaitTime--;
				display_mod_menu();
				set_pvar(SPVAR_3, DropshotWaitTime);
// discord.gg/orla
							}
					}
		if(currentMod == 3) {
			if(event_press(MOD_INCREASE) || event_press(MOD_SELECT)) {
				if(PickupMacro == 2) PickupMacro = 0;
				else PickupMacro++;
				if(event_press(MOD_DECREASE)){
					if(PickupMacro == 0) PickupMacro = 2;
					else PickupMacro--;
									}
				display_mod_menu();
				set_pvar(SPVAR_4, PickupMacro);
							}
					}
		if(currentMod == 4) {
			if(event_press(MOD_INCREASE) || event_press(MOD_DECREASE) || event_press(MOD_SELECT)) {
				if(StrafeShuffle == 0) StrafeShuffle = 1;
				else if (StrafeShuffle == 1) StrafeShuffle = 0;
// discord.gg/orla
				display_mod_menu();
				set_pvar(SPVAR_5, StrafeShuffle);
