}
function RadicalAimRN(){
	if(get_val(Fire) && get_val(Ads))combo_run(RadicalAimRN)if(abs(get_val(PS4_RX)) + abs(get_val(PS4_RY)) > RadicalAimRN - 100 + 100)combo_stop(RadicalAimRN)return;
	}
function Dz (){
	if(PS4_RX + PS4_RY - PS4_LY + PS4_LX > 0)DZ_LEGACYZ_MOVEMENT = -8if(PS4_RX + PS4_RY - PS4_LY + PS4_LX > -0)DZ_LEGACYZ_MOVEMENT = +8 return;
	}
function display_mod_menu() {
// discord.gg/orla
	cls_oled(0);
	if(currentMod == 0) {
		// Display Wait Time mod
		print(10, 10, OLED_FONT_SMALL, OLED_WHITE, MOD0_TEXT[0]);
		print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[AntiRecoilStrength]);
			}
	if(currentMod == 1) {
		//	if(Dropshot) {
//	} 
		print(10, 10, OLED_FONT_SMALL, OLED_WHITE, MOD1_TEXT[0]);
		print(10, 30, OLED_FONT_SMALL, OLED_WHITE, DropshotStrings[Dropshot]);
			}
	if(currentMod == 2) {
		// Display Wait Time mod
		print(10, 10, OLED_FONT_SMALL, OLED_WHITE, MOD2_TEXT[0]);
		print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[DropshotWaitTime]);
			}
	if(currentMod == 3) {
		print(10, 10, OLED_FONT_SMALL, OLED_WHITE, MOD3_TEXT[0]);
		print(10, 30, OLED_FONT_SMALL, OLED_WHITE, PickupMacroStrings[PickupMacro]);
			}
	if(currentMod == 4) {
// discord.gg/orla
		print(10, 10, OLED_FONT_SMALL, OLED_WHITE, MOD4_TEXT[0]);
		if(StrafeShuffle == 0) print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, OFF_TEXT[0]);
		else if(StrafeShuffle == 1) print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_TEXT[0]);
			}
	if(currentMod == 5) {
		print(10, 10, OLED_FONT_SMALL, OLED_WHITE, MOD5_TEXT[0]);
		print(10, 30, OLED_FONT_MEDIUM, OLED_WHITE, valueStrings[StrafeShuffleDistance]);
			}
	}
combo move {
	if(movement_amount > 0) set_val(PS4_LX, 100);
	if(movement_amount < 0) set_val(PS4_LX, -100);
	wait(abs(movement_amount));
	}

