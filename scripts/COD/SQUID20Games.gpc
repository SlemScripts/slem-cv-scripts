	// Sub menu:
	MenuItemCanEdit = 0, MenuItemEditStart, MenuItemRelation, MenuItemDepth, MenuItemMinimum, MenuItemMaximum
}

// Variables:
int Button[0x0a]; 	// Controller configuration
int Display[0x11]; 	// Display data (increased for screen saver text variables)
int Menu[8]; 		// Menu data
int Settings[0x5d]; // User configuration
int State[10]; 		// Script state (HoldingADS..YYSpamActive = 10 indices)
int Stick[4]; 		// Joystick data
int i; 				// Iterator
int OutputTempValue; // Temporary variable for Output function optimization
int OutputTempAbs;  // Temporary variable for Output function optimization
// Raw aim stick (read before deadzone, for Sticky Aim / BIG MAMA aim assist)
int RawAimX, RawAimY;
// Sticky Aim (BIG MAMA) state
int Sticky_filtered_x, Sticky_filtered_y;
int Sticky_history_x[5], Sticky_history_y[5];
int Sticky_history_index;
int Sticky_variance_x, Sticky_variance_y;
int Sticky_smooth_ratio, Sticky_assist_mult;
int Sticky_old_str_x, Sticky_old_str_y, Sticky_new_str_x, Sticky_new_str_y;
int Sticky_direction_changed, Sticky_dch;
int Sticky_asa, Sticky_ama, Sticky_apx, Sticky_apy, Sticky_pdx, Sticky_pdy;
int Sticky_lvx, Sticky_lvy, Sticky_pcf, Sticky_lv1, Sticky_lv2;
int Sticky_stk, Sticky_bsk, Sticky_lox, Sticky_loy, Sticky_lcx, Sticky_lcy;
int Sticky_drx, Sticky_dry, Sticky_aph, Sticky_apt, Sticky_psx, Sticky_psy;
int Sticky_pcx, Sticky_pcy, Sticky_scx, Sticky_scy, Sticky_cox, Sticky_coy;
int Sticky_srx, Sticky_sry, Sticky_vlx, Sticky_vly, Sticky_bmg, Sticky_pls;
int Sticky_tmp1, Sticky_tmp2;
int Sticky_ads_frames; // Frames since entering ADS (for warm-up blend)
int Sticky_raw_mag;   // Raw stick magnitude for adaptive flick/small detection
// BIG MAMA splash screens (AAGGS, SQUID AIM, AIM ASSIST GOOD GAME)
int SplashPhase, SplashLix, SplashLxp, SplashHcd, SplashInit, SplashTimer;
int SplashStarX[6], SplashStarY[6]; // Shooting stars (head position; trail drawn behind)
int SplashTmpX, SplashTmpY; // Temp for DrawSplashStars (avoids reusing Sticky vars)
int SplashWavePhase; // Drives glitch timing
int SplashGlitchX, SplashGlitchY; // Text jitter only between screens
int MenuShakeFrames, MenuGlitchX, MenuGlitchY; // Quick small shake when navigating menu, then back to same spot
// Raid Fire (rapid fire from BIG MAMA) - SMART mode state
int RaidFire_smart_active, RaidFire_last_press_time, RaidFire_fire_released;
// Aim curve (response curve: big movement = more responsive, small = current speed)
int AimCurveMag, AimCurveMult, AimCurveNewMag;
// ADS wiggle: small L-R on right stick when ADS pressed to activate tracking
int AdsWiggleFrames;

init {
	Display[Buffer] = 1; // Required, changing this will throw off the display
	Display[Update] = TRUE; // Immediately update the display
	Menu[Minimum] = 0;
	Menu[Maximum] = 11;
	Settings[ARGroundLoot] = TRUE; // We are using GroundLoot by default
	State[CurrentProfile] = GroundLoot; // Set CurrentProfile to GroundLoot (will toggle back to Primary by default)
	SetLEDColor(Purple); // Script begins on GroundLoot profile
	LoadSettings(); // Load user configuration data
	Settings[AimCurve] = 100; // Aim curve always on at full (menu removed, functionality kept)
	vm_tctrl(iif(get_controller() == PIO_XB1, -2, -6)); // Set appropriate VM speed (8ms for Xbox, 4ms for PlayStation)
	SetControllerConfig(); // Set controller config
	SetCurrentWeaponData(); // Set current weapon data
	combo_run(Combo_OverwriteSystemText); // Clear any system text after a delay
	RotationAssistAngle = 0; // Initialize rotation assist angle
	ShakeAssistAngle = 0; // Initialize shake assist angle
	// Sticky Aim (BIG MAMA) init
	Sticky_filtered_x = 0; Sticky_filtered_y = 0; Sticky_history_index = 0;
	Sticky_smooth_ratio = 93; Sticky_assist_mult = 100;
	Sticky_old_str_x = 0; Sticky_old_str_y = 0; Sticky_new_str_x = 0; Sticky_new_str_y = 0;
	Sticky_direction_changed = 0; Sticky_dch = 0; Sticky_asa = 25; Sticky_ama = 0;
	Sticky_apx = 0; Sticky_apy = 0; Sticky_psx = 0; Sticky_psy = 0;
	Sticky_pcx = 0; Sticky_pcy = 0; Sticky_scx = 0; Sticky_scy = 0;
	Sticky_lox = 0; Sticky_loy = 0; Sticky_lcx = 0; Sticky_lcy = 0;
	Sticky_aph = 0; Sticky_apt = 0; Sticky_lvx = 0; Sticky_lvy = 0;
	Sticky_pcf = 0; Sticky_lv1 = 0; Sticky_lv2 = 0; Sticky_stk = 0; Sticky_bsk = 0;
	Sticky_ads_frames = 0;
	// Splash screen state (AAGGS / SQUID AIM / AIM ASSIST GOOD GAME)
	SplashPhase = 0; SplashLix = 0; SplashLxp = 127; SplashHcd = 0; SplashInit = 0; SplashTimer = 0; SplashWavePhase = 0;
	SplashStarX[0]=118;SplashStarY[0]=3;SplashStarX[1]=68;SplashStarY[1]=19;SplashStarX[2]=98;SplashStarY[2]=0;SplashStarX[3]=82;SplashStarY[3]=24;SplashStarX[4]=105;SplashStarY[4]=11;SplashStarX[5]=75;SplashStarY[5]=28;
	RaidFire_smart_active = 0; RaidFire_last_press_time = 0; RaidFire_fire_released = 0;
}

main {
	
	// Check which display is showing and handle the user input accordingly
	if(Display[Depth] == DisplayHome) {
		
		// Check for display update
		if(Display[Update]) {
			cls_oled(OLED_BLACK); // Clear screen
			SetControllerConfig(); // Set controller config
			SetCurrentWeaponData(); // Set current weapon data
			Display[Update] = FALSE; // Disable display update
			Display[ScreenSaver] = FALSE; // Reset screensaver
			Display[ScreenSaverCounter] = 0; // Reset screensaver counter
			SplashTimer = 0; // Reset splash so next frame draws splash
			SetLEDColor(iif(State[CurrentProfile] == Primary, Blue, iif(State[CurrentProfile] == Secondary, Green, Purple)));
			
		} else if(event_press(Button[Weapon]) && !(State[CurrentProfile] & GroundLoot)) {
			State[CurrentProfile] = (State[CurrentProfile] + 1) % 2;
			SetCurrentWeaponData();
			combo_stop(Combo_SwitchLoadOut); // Just in case user spams the controls
			cls_oled(OLED_BLACK);
			combo_restart(Combo_SwitchProfile);
			SetLEDColor(State[CurrentProfile] + 1);
			
		} else {
		
			if(get_ival(XB1_LT)) {
			
				// Check for menu actions (enter menu, enable GroundLoot, enable LoadOut)
				if(event_press(XB1_MENU)) {
				
					set_hsb(0, 0, 0); // Set LED color
					Display[Depth]++; // Increase display depth (entering menu)
					Display[Update] = TRUE; // Update screen next iteration
					
					
				} else {
				
					if(!(State[CurrentProfile] & GroundLoot)) {
					
						if(event_press(XB1_RIGHT)) {
						
							// Can only switch to GroundLoot if user is on LoadOut
							Settings[ARGroundLoot] = TRUE; // We are using GroundLoot
							State[CurrentProfile] = (State[CurrentProfile] | GroundLoot & ~(Primary | Secondary)); // Enable Ground Loot profile
							SetLEDColor(Purple);
							combo_stop(Combo_SwitchLoadOut); // Just in case user spams the controls
							combo_stop(Combo_SwitchProfile); // Just in case user spams the controls
							cls_oled(OLED_BLACK);
							combo_run(Combo_SwitchGroundLoot); // Notify user of current profile
							
						}
					}
					
				}
				
				// Block only menu shortcut buttons (MENU, RIGHT for Ground Loot); allow Ping (often D-pad Up) and D-pad Down while ADS
				set_val(XB1_MENU, 0);
				set_val(XB1_RIGHT, 0);
			
			}
		}
		
		// Read raw aim stick (physical hardware) before any script changes - for Sticky Aim; scale to -100..100
		RawAimX = get_ival(Stick[AimX]) * 100 / 0x7fff;
		RawAimY = get_ival(Stick[AimY]) * 100 / 0x7fff;
		// Execute script options
		CheckOptions();
		CheckAssist();
		// Small L-R wiggle on right stick while ADS and/or Fire (activates tracking); bigger and faster
		if(State[HoldingADS] || State[HoldingFire]) {
			OutputTempValue = get_val(Stick[AimX]);
			if(AdsWiggleFrames % 2) OutputTempValue = OutputTempValue - (7 * STICK_SCALE);
			else OutputTempValue = OutputTempValue + (7 * STICK_SCALE);
			set_val(Stick[AimX], clamp(OutputTempValue, 0xffff8000, 0x7fff));
			AdsWiggleFrames = AdsWiggleFrames + 1;
		}
		// Splash screens (AAGGS, SQUID AIM, AIM ASSIST GOOD GAME) - animate every 60ms when at home
		if(!Display[Update]) {
			SplashTimer = SplashTimer + get_rtime();
			if(SplashTimer >= 60) {
				SplashTimer = 0;
				DrawSplash();
			}
		}
		// Block weapon resync
		if(get_ival(XB1_LT)) {
			set_val(XB1_Y, 0);
		}
		
		// Block weapon switching when anti-recoil is active
		if(Settings[ARGroundLoot] && State[HoldingADS] && State[HoldingFire]) {
			set_val(Button[Weapon], 0); // Always block weapon button when anti-recoil is active
		}
		
	} else {
		
		if(Display[Depth] == DisplayMenu) {
	
			// Determine if the menu must be redrawn
			if(Display[Update]) {
				DisplayMenu(); // Display edit menu
			} else {
				CheckMenuAction(); // Check for a menu action
			}
			
		} else {
		
			// Determine if the menu must be redrawn
			if(Display[Update]) {
				DisplayEditMenu(); // Display edit menu
			} else {
				CheckSubMenuAction(); // Check for sub menu action
			}
			
		}
	
		// While in menus, block all inputs
		block_all_inputs();
		
	}
}

function CheckAssist()
{
	// Check for Batts Sticky Aim:
	if(Settings[BattsStickyAim]) {
		if(State[HoldingFire]) {
			combo_run(Combo_BattsStickyAim);
		} else {
			combo_stop(Combo_BattsStickyAim);
		}
	}
	
	// Check for Headshot Assist
	if(Settings[HeadshotAssist]) {
		if(State[HoldingFire] && (get_ptime(Button[Fire]) < Settings[HeadshotTime])) {
			Output(Stick[AimY], (Settings[HeadshotStrength] * STICK_SCALE) * iif(Settings[Inverted], 1, 0xffffffff));
		}
	}
	
	
	// Check for Sticky Aim (BIG MAMA aim assist) - when ADS, run full smoothing/slowdown/pull (run before AR so anti-recoil can add on top)
	if(Settings[StickyAimAssist] && State[HoldingADS]) {
		ExecuteStickyAimAssist();
	} else if(!State[HoldingADS]) {
		Sticky_aph = 0; Sticky_apt = 0; Sticky_asa = 25; Sticky_ama = 0;
		Sticky_lox = 0; Sticky_loy = 0; Sticky_lcx = 0; Sticky_lcy = 0;
		Sticky_drx = 0; Sticky_dry = 0; Sticky_psx = 0; Sticky_psy = 0;
		Sticky_pcx = 0; Sticky_pcy = 0; Sticky_scx = 0; Sticky_scy = 0;
		Sticky_filtered_x = 0; Sticky_filtered_y = 0;
		Sticky_old_str_x = 0; Sticky_old_str_y = 0; Sticky_new_str_x = 0; Sticky_new_str_y = 0;
		Sticky_ads_frames = 0; // Reset warm-up when leaving ADS
	}

	// Check for AR Ground Loot Anti-Recoil (after Sticky Aim so Output() adds on top of stick)
	if(Settings[ARGroundLoot] && State[HoldingADS] && State[HoldingFire]) {
		set_val(Button[Weapon], 0); // Block weapon switching when anti-recoil is active
		ExecuteAntiRecoil();
	} else {
		AntiRecoilMaxX = 0;
		AntiRecoilMaxY = 0;
		AntiRecoilStepX = 0;
		AntiRecoilStepY = 0;
		AntiRecoilCounterX = 0;
		AntiRecoilCounterY = 0;
	}
	// Check for Shake Assist (only when ADS, not firing, and not using Sticky Aim)
	if(Settings[ShakeAssist] && State[HoldingADS] && !State[HoldingFire] && !Settings[StickyAimAssist]) {
		ExecuteShakeAssist();
	}
	
	// Check for Rotation Assist:
	if((Settings[RotationAssist] && (Settings[RotationAssist] == (State[HoldingFire] > 0) | ((State[HoldingADS] > 0) << 1))) || (Settings[RotationAssist] == Activation_ADSOrFire && ((State[HoldingFire] > 0) || (State[HoldingADS] > 0)))) {
		ExecuteRotationAssist();
	}
	
	// Check for YY Spam
	if(Settings[YYSpam]) {
		// Only run YY spam if anti-recoil is not active (ADS and Fire not both held)
		if(!(Settings[ARGroundLoot] && State[HoldingADS] && State[HoldingFire])) {
			// Check if sprint button is pressed (Focus button - usually left stick click)
			if(get_val(Button[Focus])) {
				if(!State[YYSpamActive]) {
					State[YYSpamActive] = TRUE;
				}
				// Continuously run the combo while button is held
				combo_run(Combo_YYSpam);
			} else {
				if(State[YYSpamActive]) {
					State[YYSpamActive] = FALSE;
					combo_stop(Combo_YYSpam);
				}
			}
		} else {
			// Anti-recoil is active, stop YY spam
			if(State[YYSpamActive]) {
				State[YYSpamActive] = FALSE;
				combo_stop(Combo_YYSpam);
			}
			set_val(Button[Weapon], 0); // Release weapon button
		}
	}
}

function CheckOptions()
{
	// Get ADS and Fire state
	State[HoldingADS] = get_val(Button[ADS]);
	State[HoldingFire] = get_val(Button[Fire]);
	// Check whether or not to allow rumbles
	if(!Settings[ControllerRumbles]) {
		block_rumble();	
	}
		
	// Apply deadzone
	if(Settings[Deadzone]) {

		// Check movement stick
		if(isqrt(pow(get_ival(Stick[MoveX]), 2) + pow(get_ival(Stick[MoveY]), 2)) <= (Settings[DeadzoneLeft] * STICK_SCALE)) {
			set_val(Stick[MoveX], 0);
			set_val(Stick[MoveY], 0);
		}
		
		// Check aimer stick
		if(isqrt(pow(get_ival(Stick[AimX]), 2) + pow(get_ival(Stick[AimY]), 2)) <= (Settings[DeadzoneRight] * STICK_SCALE)) {
			set_val(Stick[AimX], 0);
			set_val(Stick[AimY], 0);
		}
	
	}
	
	// Aim curve: big stick movement = more responsive, small movement = current (slower) speed
	if(Settings[AimCurve] > 0) {
		AimCurveMag = isqrt(pow(get_ival(Stick[AimX]), 2) + pow(get_ival(Stick[AimY]), 2));
		if(AimCurveMag > 8192) {
			AimCurveMult = 100 + (AimCurveMag - 8192) * 35 * Settings[AimCurve] / 100 / 24575;
			if(AimCurveMult > 135) AimCurveMult = 135;
		} else {
			AimCurveMult = 100;
		}
		if(AimCurveMag > 0) {
			AimCurveNewMag = AimCurveMag * AimCurveMult / 100;
			if(AimCurveNewMag > 32767) AimCurveNewMag = 32767;
			AimCurveMult = AimCurveNewMag * 1000 / AimCurveMag;
			set_val(Stick[AimX], get_ival(Stick[AimX]) * AimCurveMult / 1000);
			set_val(Stick[AimY], get_ival(Stick[AimY]) * AimCurveMult / 1000);
		}
	}
	
	// Check for hair triggers
	if(Settings[HairTriggers]) {
	
		// Check ADS trigger
		if(State[HoldingADS] > 0) {
			set_val(Button[ADS], 0x64);
		}
		
		// Check Fire trigger
		if(State[HoldingFire] > 0) {
			set_val(Button[Fire], 0x64);
		}
	}

	// Check for movement actions:
	//
	// Check for Auto Slide
	if(Settings[AutoSlide]) {
		if(get_brtime(Button[Action]) < 176) {
			combo_run(Combo_AutoSlide);
		}
	}
	
	// Check for fire actions:
	//
	// Check for Hold Breath first since it could be used with other mods
	if(Settings[HoldBreath]) {
		if(State[HoldingADS]) {
			combo_run(Combo_HoldBreath);
		} else {
			combo_stop(Combo_HoldBreath);
		}
	}
	
	// Check for Drop Shot:
	if(Settings[DropShot] && (Settings[DropShot] == (State[HoldingFire] > 0) | ((State[HoldingADS] > 0) << 1))) {
		combo_run(Combo_DropShot);
	} else {
		combo_stop(Combo_DropShot);
	}
	
	// Check for Strafe Assist:
	if((Settings[StrafeAssist] && (Settings[StrafeAssist] == (State[HoldingFire] > 0) | ((State[HoldingADS] > 0) << 1))) || (Settings[StrafeAssist] == Activation_ADSOrFire && ((State[HoldingFire] > 0) || (State[HoldingADS] > 0)))) {
		combo_run(Combo_StrafeAssist);
	} else {
		combo_stop(Combo_StrafeAssist);
	}
	
	// Check for Auto Ping
	if(Settings[AutoPing] && get_ival(Button[ADS]) && event_press(Button[Fire])) {
		combo_run(Combo_AutoPing);
	}
	
	// Raid Fire (rapid fire from BIG MAMA): OFF, ON, or SMART (activates on quick re-press within 500ms)
	if(Settings[RaidFire] == RaidFire_Smart) {
		if(event_press(Button[Fire])) {
			if(RaidFire_fire_released && RaidFire_last_press_time < 500) {
				RaidFire_smart_active = 1;
			}
			RaidFire_fire_released = 0;
			RaidFire_last_press_time = 0;
		} else if(event_release(Button[Fire])) {
			RaidFire_fire_released = 1;
			RaidFire_smart_active = 0;
			RaidFire_last_press_time = 0;
		} else if(RaidFire_fire_released) {
			RaidFire_last_press_time = RaidFire_last_press_time + get_rtime();
			if(RaidFire_last_press_time >= 500) {
				RaidFire_fire_released = 0;
				RaidFire_last_press_time = 0;
			}
		}
	}
	if((Settings[RaidFire] == RaidFire_On || (Settings[RaidFire] == RaidFire_Smart && RaidFire_smart_active)) && State[HoldingADS] && State[HoldingFire]) {
		combo_run(Combo_RaidFire);
	}
	
	// Check for Reload Cancel
	if(Settings[ReloadCancel]) {
		// Only start timer if not already active (prevents resetting timer on multiple X presses)
		if(event_press(XB1_X) && !State[ReloadCancelActive]) {
			// Start reload cancel timer (1 second = 1000ms)
			State[ReloadCancelTimer] = 1000;
			State[ReloadCancelActive] = TRUE;
		}
		
		// Check if reload cancel timer is active
		if(State[ReloadCancelActive]) {
			// Check if fire button is pressed during reload timer
			if(event_press(Button[Fire])) {
				// Cancel reload by switching weapon twice
				combo_run(Combo_ReloadCancel);
				State[ReloadCancelActive] = FALSE;
				State[ReloadCancelTimer] = 0;
			} else {
				// Decrease timer
				State[ReloadCancelTimer] -= get_rtime();
				
				// Check if timer expired
				if(State[ReloadCancelTimer] <= 0) {
					State[ReloadCancelActive] = FALSE;
					State[ReloadCancelTimer] = 0;
				}
			}
		}
	}
	
}

combo Combo_AutoPing {
	set_val(Button[Ping], 100);
	wait(32);
}

combo Combo_RaidFire {
	set_val(Button[Fire], 100);
	wait(iif(55 - (Settings[RaidFireRate] * 5) < 5, 5, 55 - (Settings[RaidFireRate] * 5)));
	set_val(Button[Fire], 0);
	wait(iif(60 - (Settings[RaidFireRate] * 5) < 5, 5, 60 - (Settings[RaidFireRate] * 5)));
}

// Checks for a menu action
function CheckMenuAction()
{
	
	// Determine user action
	if(event_press(XB1_UP)) {
		
		// Increment menu index and update display
		Menu[Index] = ValidateRange(Menu[Index], 0xffffffff, Menu[Minimum], Menu[Maximum], TRUE, TRUE);
		MenuShakeFrames = 5;
		Display[Update] = TRUE;
		
	} else if(event_press(XB1_DOWN)) {
	
		// Decrement menu index and update display
		Menu[Index] = ValidateRange(Menu[Index], 1, Menu[Minimum], Menu[Maximum], TRUE, TRUE);
		MenuShakeFrames = 5;
		Display[Update] = TRUE;
		
	} else if(event_press(XB1_RIGHT)) {
		
		// Increment the selection and update display
		Settings[Menu[EditValue]] = ValidateRange(Settings[Menu[EditValue]], 1, Menu[EditValueMinimum], Menu[EditValueMaximum], FALSE, TRUE);
		MenuShakeFrames = 5;
		Display[Update] = TRUE;
		
	} else if(event_press(XB1_LEFT)) {
	
		// Decrement the selection and update display
		Settings[Menu[EditValue]] = ValidateRange(Settings[Menu[EditValue]], 0xffffffff, Menu[EditValueMinimum], Menu[EditValueMaximum], FALSE, TRUE);
		MenuShakeFrames = 5;
		Display[Update] = TRUE;
		
	} else if(event_press(XB1_A)) {
	
		// Check if user can enter a sub menu
		if(MenuItems[Menu[Index]][MenuItemCanEdit]) {
			combo_run(Combo_ChangeSuccess);
			Display[Depth]++;
			Display[Update] = TRUE;
		}
		
	} else if(event_release(XB1_B)) {
		
		// Reduce our depth back to home screen
		Display[Depth]--;
		
		// Clear the screen
		cls_oled(OLED_BLACK);
		SetLEDColor(Blue);
		SetCurrentWeaponData();
		
		// Execute combo to notify user
		combo_run(Combo_SaveSettings);
	}
	
}

// Checks for a sub menu action
function CheckSubMenuAction()
{
	if(get_ival(XB1_LT)) {
		if(event_press(XB1_RIGHT)) {
			Settings[Menu[EditValue]] = ValidateRange(Settings[Menu[EditValue]], 1, Menu[EditValueMinimum], Menu[EditValueMaximum], FALSE, TRUE);
			MenuShakeFrames = 5;
			Display[Update] = TRUE;
		} else if(event_press(XB1_UP)) {
			Settings[Menu[EditValue]] = ValidateRange(Settings[Menu[EditValue]], 0x0a, Menu[EditValueMinimum], Menu[EditValueMaximum], FALSE, TRUE);
			MenuShakeFrames = 5;
			Display[Update] = TRUE;
		} else if(event_press(XB1_LEFT)) {
			Settings[Menu[EditValue]] = ValidateRange(Settings[Menu[EditValue]], 0xffffffff, Menu[EditValueMinimum], Menu[EditValueMaximum], FALSE, TRUE);
			MenuShakeFrames = 5;
			Display[Update] = TRUE;
		} else if(event_press(XB1_DOWN)) {
			Settings[Menu[EditValue]] = ValidateRange(Settings[Menu[EditValue]], 0xfffffff6, Menu[EditValueMinimum], Menu[EditValueMaximum], FALSE, TRUE);
			MenuShakeFrames = 5;
			Display[Update] = TRUE;
		}
	} else {
		if(event_press(XB1_UP)) {
			Display[EditDepth] = ValidateRange(Display[EditDepth], 0xffffffff, 0, MenuItems[Menu[Index]][MenuItemDepth], FALSE, TRUE);
			MenuShakeFrames = 5;
			Display[Update] = TRUE;
		} else if(event_press(XB1_DOWN)) {
			Display[EditDepth] = ValidateRange(Display[EditDepth], 1, 0, MenuItems[Menu[Index]][MenuItemDepth], FALSE, TRUE);
			MenuShakeFrames = 5;
			Display[Update] = TRUE;
		} else if(event_release(XB1_B)) {
			combo_run(Combo_ChangeSuccess);
			Display[EditDepth] = 0;
			Display[Depth]--;
			Display[Update] = TRUE;
		}
	}
}



// Displays the edit menu
function DisplayEditMenu()
{
	// Quick small shake: 5 frames then back to (0,0)
	if(MenuShakeFrames == 5) { MenuGlitchX = 2; MenuGlitchY = 0; }
	else if(MenuShakeFrames == 4) { MenuGlitchX = -2; MenuGlitchY = 0; }
	else if(MenuShakeFrames == 3) { MenuGlitchX = 1; MenuGlitchY = 0; }
	else if(MenuShakeFrames == 2) { MenuGlitchX = -1; MenuGlitchY = 0; }
	else { MenuGlitchX = 0; MenuGlitchY = 0; }
	if(MenuShakeFrames > 0) MenuShakeFrames = MenuShakeFrames - 1;
	if(MenuShakeFrames > 0) Display[Update] = TRUE;
	else Display[Update] = FALSE;

	// Set current menu item variables
	Menu[EditValue] = SubMenuItems[MenuItems[Menu[Index]][MenuItemEditStart] + Display[EditDepth]][0];
	
	Menu[EditValueMinimum] = SubMenuItems[MenuItems[Menu[Index]][MenuItemEditStart] + Display[EditDepth]][1];
	Menu[EditValueMaximum] = SubMenuItems[MenuItems[Menu[Index]][MenuItemEditStart] + Display[EditDepth]][2];
	
	// Clear screen and draw the border
	DrawBorder();
	
	// Display menu item
	PrintText(AlignCenter, AlignTop, SubMenuNames[MenuItems[Menu[Index]][MenuItemEditStart] + Display[EditDepth]], OLED_FONT_SMALL, OLED_WHITE);
	line_oled(1, OLED_FONT_SMALL_HEIGHT + 7, 0x7f, OLED_FONT_SMALL_HEIGHT + 7, 1, OLED_WHITE);
	
	
	// Display minimum/maximum
	PrintNumber(AlignLeft, LineNumber[0], Menu[EditValueMinimum], OLED_FONT_SMALL, OLED_WHITE);
	PrintNumber(AlignRight, LineNumber[0], Menu[EditValueMaximum], OLED_FONT_SMALL, OLED_WHITE);
	
	// Display value
	PrintNumber(AlignCenter, LineNumber[1], Settings[SubMenuItems[MenuItems[Menu[Index]][MenuItemEditStart] + Display[EditDepth]][0]], OLED_FONT_LARGE, OLED_WHITE);
	
	// Disable display update (or keep TRUE to continue shake)
	// Display[Update] set above by shake logic
	
}

// Displays the menu
function DisplayMenu()
{
	// Quick small shake: 5 frames (+2,-2,+1,-1,0) then everything back at same spot
	if(MenuShakeFrames == 5) { MenuGlitchX = 2; MenuGlitchY = 0; }
	else if(MenuShakeFrames == 4) { MenuGlitchX = -2; MenuGlitchY = 0; }
	else if(MenuShakeFrames == 3) { MenuGlitchX = 1; MenuGlitchY = 0; }
	else if(MenuShakeFrames == 2) { MenuGlitchX = -1; MenuGlitchY = 0; }
	else { MenuGlitchX = 0; MenuGlitchY = 0; }
	if(MenuShakeFrames > 0) MenuShakeFrames = MenuShakeFrames - 1;
	if(MenuShakeFrames > 0) Display[Update] = TRUE;
	else Display[Update] = FALSE;

	// Set current menu item variables
	Menu[EditValue] = MenuItems[Menu[Index]][MenuItemRelation];
	Menu[EditValueMinimum] = MenuItems[Menu[Index]][MenuItemMinimum];
	Menu[EditValueMaximum] = MenuItems[Menu[Index]][MenuItemMaximum];
	
	// Clear screen and draw the border
	DrawBorder();
	
	// Display header
	PrintText(AlignCenter, AlignTop, MenuNames[Menu[Index]], OLED_FONT_SMALL, OLED_WHITE);
	line_oled(1, OLED_FONT_SMALL_HEIGHT + 7, 0x7f, OLED_FONT_SMALL_HEIGHT + 7, 1, OLED_WHITE);
	
	// Display footer
	PrintText(AlignCenter, AlignBottom, MenuAbility[MenuItems[Menu[Index]][MenuItemCanEdit]], OLED_FONT_SMALL, OLED_WHITE);
	line_oled(1, OLED_HEIGHT - OLED_FONT_SMALL_HEIGHT - 8, 0x7f, OLED_HEIGHT - OLED_FONT_SMALL_HEIGHT - 8, 1, OLED_WHITE); // Draw bottom line
	

	// Display mod number
	InsertCharacter(ASCII_UPPER_M);
	InsertCharacter(ASCII_UPPER_O);
	InsertCharacter(ASCII_UPPER_D);
	InsertCharacter(ASCII_COLON);
	InsertNumber(Menu[Index] + 1);
	FlushBuffer(AlignLeft, LineNumber[1], OLED_FONT_SMALL, OLED_WHITE);

	// Determine what to display (switch on relation; menu index no longer matches enum after removals)
	switch(MenuItems[Menu[Index]][MenuItemRelation]) {
		case ButtonLayout {
			PrintText(AlignCenter, LineNumber[0], ButtonLayoutName[Settings[ButtonLayout]], OLED_FONT_SMALL, OLED_WHITE);
			break;
		} case StickLayout {
			PrintText(AlignCenter, LineNumber[0], StickLayoutName[Settings[StickLayout]], OLED_FONT_SMALL, OLED_WHITE);
			break;
		} case DropShot {
			PrintText(AlignCenter, LineNumber[0], ActivationName[Settings[DropShot]], OLED_FONT_SMALL, OLED_WHITE);
			break;
		} case RotationAssist {
			PrintText(AlignCenter, LineNumber[0], ActivationName[Settings[RotationAssist]], OLED_FONT_SMALL, OLED_WHITE);
			break;
		} case RaidFire {
			PrintText(AlignCenter, LineNumber[0], RaidFireName[Settings[RaidFire]], OLED_FONT_SMALL, OLED_WHITE);
			break;
		} default {
			PrintText(AlignCenter, LineNumber[0], OffOn[Settings[MenuItems[Menu[Index]][MenuItemRelation]]], OLED_FONT_SMALL, OLED_WHITE);
		}
	}
	
	// Disable display update (or keep TRUE to continue shake) - set above by shake logic
}

// Clears the screen and draws a border around the OLED
function DrawBorder() {
	cls_oled(OLED_BLACK); // Clear screen
	rect_oled(0, 0, 0x80, 0x3f, 0, OLED_WHITE); // Draw border around OLED
}

// Draw shooting stars: random positions, bright head (thick) then fading trail (thin)
function DrawSplashStars() {
	for(i = 0; i < 6; i++) {
		SplashTmpX = SplashStarX[i] + 8;
		SplashTmpY = SplashStarY[i] - 8;
		if(SplashTmpX < 0) SplashTmpX = 0;
		if(SplashTmpY < 0) SplashTmpY = 0;
		line_oled(SplashTmpX, SplashTmpY, SplashStarX[i] + 3, SplashStarY[i] - 3, 1, OLED_WHITE);
		line_oled(SplashStarX[i] + 3, SplashStarY[i] - 3, SplashStarX[i], SplashStarY[i], 2, OLED_WHITE);
		SplashStarX[i] = SplashStarX[i] - 2;
		SplashStarY[i] = SplashStarY[i] + 1;
		if(SplashStarX[i] < -10 || SplashStarY[i] > 70) {
			SplashStarX[i] = 72 + ((i * 13 + SplashWavePhase) % 56);
			SplashStarY[i] = ((i * 11 + SplashWavePhase * 7) % 28);
		}
	}
}

function DrawSplash() {
	if(SplashPhase == 0 && SplashInit == 0) {
		SplashPhase = 2;
		SplashLix = 0;
		SplashLxp = 127;
		SplashInit = 1;
	}
	SplashWavePhase = SplashWavePhase + 1;
	if(SplashWavePhase > 32000) SplashWavePhase = 0;
	// Glitch only between screens (last 10 frames before phase transition)
	if(SplashHcd >= 1 && SplashHcd <= 10) {
		SplashGlitchX = ((SplashWavePhase * 13) % 11) - 5;
		SplashGlitchY = ((SplashWavePhase * 17) % 7) - 3;
	} else {
		SplashGlitchX = 0;
		SplashGlitchY = 0;
	}
	cls_oled(OLED_BLACK);
	if(SplashPhase == 0) {
		if(SplashLix > 0) PrintText(15 + SplashGlitchX, 25 + SplashGlitchY, SplashLtrA[0], OLED_FONT_MEDIUM, OLED_WHITE);
		if(SplashLix > 1) PrintText(25 + SplashGlitchX, 25 + SplashGlitchY, SplashLtrA[0], OLED_FONT_MEDIUM, OLED_WHITE);
		if(SplashLix > 2) PrintText(35 + SplashGlitchX, 25 + SplashGlitchY, SplashLtrG[0], OLED_FONT_MEDIUM, OLED_WHITE);
