	RaidFire_Off = 0, RaidFire_On, RaidFire_Smart,
	
	// Menu:
	HairTriggers = 0, ControllerRumbles, Deadzone, DropShot, HoldBreath, ButtonLayout, StickLayout,
	BattsStickyAim, ARGroundLoot, AutoPing, AutoSlide, HeadshotAssist, ShakeAssist, StickyAimAssist, RotationAssist, StrafeAssist, ReloadCancel, YYSpam, Inverted, RaidFire, RaidFireRate,
	
	// Submenu:
	DeadzoneLeft, DeadzoneRight, AimCurve, DropShotHold, DropShotReset, BattsStickyTime, BattsStickySize, ARGroundVertical, ARGroundHorizontal, HeadshotStrength, HeadshotTime,
	ShakeAssistRadius, ShakeAssistSteps, RotationAssistRadius, RotationAssistSpeed, StrafeAssistRadius, StrafeAssistTime,

	// Weapon Select variables:
	PrimaryWeapon, SecondaryWeapon = PrimaryWeapon + 0x0a,
	PrimaryWeaponVertical = SecondaryWeapon + 0x0a, PrimaryWeaponHorizontal = PrimaryWeaponVertical + 0x0a,
	SecondaryWeaponVertical = PrimaryWeaponHorizontal + 0x0a, SecondaryWeaponHorizontal = SecondaryWeaponVertical + 0x0a,
	
	// Menu position constants:
	DisplayHome = 0, DisplayMenu, DisplayEdit,
	
