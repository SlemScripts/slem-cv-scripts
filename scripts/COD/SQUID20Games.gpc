int AntiRecoilStrength;
int AntiRecoilMaxX, AntiRecoilMaxY;
int AntiRecoilCounterX, AntiRecoilCounterY;
int AntiRecoilStepX, AntiRecoilStepY;
int AntiRecoilX, AntiRecoilY;
function ExecuteAntiRecoil()
{
	
	if(Settings[ARGroundLoot]) {
        // Initialize Rumble Calculation
        AntiRecoilStrength = 0;
        
        // Check for rumble feedback from weapon firing
        if(get_rumble(RUMBLE_A) || get_rumble(RUMBLE_B)) {
        	AntiRecoilStrength = get_rumble(RumbleToUse());
        }
        
        // Calculate anti-recoil based on rumble detection
        if(AntiRecoilStrength > 0x0a) {  // If rumble is detected (above threshold)
            // Use rumble-based calculation for more accurate anti-recoil
            // Combine base vertical strength with rumble feedback (divide rumble by 4)
            AntiRecoilStrength = ((Settings[ARGroundVertical] * STICK_SCALE) * iif(Settings[Inverted], 0xffffffff, 1)) + (AntiRecoilStrength >> 2);
            // Cap the maximum strength to prevent excessive values
            if(AntiRecoilStrength > ((Settings[ARGroundVertical] * STICK_SCALE) * 2)) {
                AntiRecoilStrength = ((Settings[ARGroundVertical] * STICK_SCALE) * 2) * iif(Settings[Inverted], 0xffffffff, 1);
            }
            Output(Stick[AimX], (Settings[ARGroundHorizontal] * STICK_SCALE));
            Output(Stick[AimY], AntiRecoilStrength);
        } else {  // If NO Rumble Is Detected - Use Normal Anti-Recoil
            // Fallback to consistent base anti-recoil when rumble is not detected
            Output(Stick[AimX], (Settings[ARGroundHorizontal] * STICK_SCALE));
            Output(Stick[AimY], (Settings[ARGroundVertical] * STICK_SCALE) * iif(Settings[Inverted], 0xffffffff, 1));
        }
        
        // Reset Rumble Calculation for next frame
        AntiRecoilStrength = 0;
	}
	// Note: Loadout Profile Anti-Recoil is disabled
	// Only AR Ground Loot profile works for anti-recoil
}

int RotationAssistAngle;
function ExecuteRotationAssist()
{
	// Output coordinates
	Output(Stick[MoveX], cos[RotationAssistAngle] * Settings[RotationAssistRadius]);
	Output(Stick[MoveY], sin[RotationAssistAngle] * Settings[RotationAssistRadius]);
	
	// Advance angle
	RotationAssistAngle += Settings[RotationAssistSpeed];
	
	// Normalize angle to [0, 0x168) (360 degrees)
	if(RotationAssistAngle >= 0x168) RotationAssistAngle -= 0x168;
	if(RotationAssistAngle < 0) RotationAssistAngle += 0x168;
}

int ShakeAssistAngle;
function ExecuteShakeAssist()
{
	// Output coordinates
	Output(Stick[AimX], cos[ShakeAssistAngle] * Settings[ShakeAssistRadius]);
	Output(Stick[AimY], sin[ShakeAssistAngle] * Settings[ShakeAssistRadius]);
	
	// Advance angle
	ShakeAssistAngle += Settings[ShakeAssistSteps];
	
	// Normalize angle to [0, 0x168) (360 degrees)
	if(ShakeAssistAngle >= 0x168) ShakeAssistAngle -= 0x168;
	if(ShakeAssistAngle < 0) ShakeAssistAngle += 0x168;
}

// Sticky Aim (BIG MAMA aim assist): filtering, smoothing, slowdown, pull; adaptive flick vs small
function ExecuteStickyAimAssist()
{
//updated PA . 236773//
	Sticky_raw_mag = abs(RawAimX) + abs(RawAimY); // For adaptive: flick = fast, small = smooth
	Sticky_tmp1 = RawAimX;
	Sticky_tmp2 = RawAimY;
	if(Settings[Inverted]) Sticky_tmp2 = 0 - Sticky_tmp2;

	Sticky_filtered_x = (Sticky_tmp1 * 45 + Sticky_filtered_x * 55) / 100;
	Sticky_filtered_y = (Sticky_tmp2 * 45 + Sticky_filtered_y * 55) / 100;
	Sticky_tmp1 = Sticky_filtered_x;
	Sticky_tmp2 = Sticky_filtered_y;

	Sticky_history_x[Sticky_history_index] = Sticky_tmp1;
	Sticky_history_y[Sticky_history_index] = Sticky_tmp2;
	Sticky_history_index = Sticky_history_index + 1;
	if(Sticky_history_index >= 5) Sticky_history_index = 0;

	Sticky_variance_x = 0;
	Sticky_variance_y = 0;
	i = 0;
	while(i < 5) {
		Sticky_variance_x = Sticky_variance_x + abs(Sticky_history_x[i] - Sticky_tmp1);
		Sticky_variance_y = Sticky_variance_y + abs(Sticky_history_y[i] - Sticky_tmp2);
		i = i + 1;
	}
	Sticky_variance_x = Sticky_variance_x / 5;
	Sticky_variance_y = Sticky_variance_y / 5;

	if(Sticky_variance_x > 15 || Sticky_variance_y > 15) {
		Sticky_smooth_ratio = 98;
	} else if(Sticky_variance_x > 8 || Sticky_variance_y > 8) {
		Sticky_smooth_ratio = 93;
	} else {
		Sticky_smooth_ratio = 90;
	}

	Sticky_bmg = isqrt(Sticky_tmp1 * Sticky_tmp1 + Sticky_tmp2 * Sticky_tmp2);
	if(Sticky_bmg > 30) {
		Sticky_smooth_ratio = Sticky_smooth_ratio - 5;
		if(Sticky_smooth_ratio < 85) Sticky_smooth_ratio = 85;
	} else if(Sticky_bmg < 10) {
		Sticky_smooth_ratio = Sticky_smooth_ratio + 3;
		if(Sticky_smooth_ratio > 95) Sticky_smooth_ratio = 95;
	}
	// Adaptive: flick (high raw) = respond faster; small (low raw) = extra smooth
	if(Sticky_raw_mag > 50) Sticky_smooth_ratio = 82;
	else if(Sticky_raw_mag < 15) Sticky_smooth_ratio = 96;

	Sticky_srx = (Sticky_tmp1 * (100 - Sticky_smooth_ratio) + Sticky_psx * Sticky_smooth_ratio) / 100;
	Sticky_sry = (Sticky_tmp2 * (100 - Sticky_smooth_ratio) + Sticky_psy * Sticky_smooth_ratio) / 100;
	Sticky_psx = Sticky_srx;
	Sticky_psy = Sticky_sry;

	Sticky_vlx = Sticky_srx - Sticky_apx;
	Sticky_vly = Sticky_sry - Sticky_apy;

	Sticky_assist_mult = 100;
	if(Sticky_bmg < 20) {
		Sticky_assist_mult = 120;
	} else if(Sticky_bmg > 50) {
		Sticky_assist_mult = 80;
	}

	Sticky_direction_changed = 0;
	if(abs(Sticky_vlx) > 5) {
		if((Sticky_vlx > 0 && Sticky_lv1 < 0) || (Sticky_vlx < 0 && Sticky_lv1 > 0)) {
			Sticky_direction_changed = 1;
			Sticky_dch = 13;
		}
		Sticky_lv1 = Sticky_vlx;
	}
	if(abs(Sticky_vly) > 5) {
		if((Sticky_vly > 0 && Sticky_lv2 < 0) || (Sticky_vly < 0 && Sticky_lv2 > 0)) {
			Sticky_direction_changed = 1;
			Sticky_dch = 10;
		}
		Sticky_lv2 = Sticky_vly;
	}

	if(Sticky_direction_changed) {
		Sticky_old_str_x = Sticky_old_str_x * 90 / 100;
		Sticky_old_str_y = Sticky_old_str_y * 90 / 100;
		Sticky_new_str_x = 22;
		Sticky_new_str_y = 22;
	} else {
		Sticky_old_str_x = Sticky_old_str_x * 95 / 100;
		Sticky_old_str_y = Sticky_old_str_y * 95 / 100;
		Sticky_new_str_x = Sticky_new_str_x + 5;
		Sticky_new_str_y = Sticky_new_str_y + 5;
		if(Sticky_new_str_x > 100) Sticky_new_str_x = 100;
		if(Sticky_new_str_y > 100) Sticky_new_str_y = 100;
	}

	// Reset pull accumulation for this frame (before dch adds, then slowdown adds)
	Sticky_cox = 0;
	Sticky_coy = 0;
	if(Sticky_dch > 0) {
		Sticky_tmp2 = (Sticky_vlx * 52 * Sticky_new_str_x) / 10000;
		Sticky_cox = Sticky_cox + Sticky_tmp2;
		Sticky_tmp2 = (Sticky_vly * 40 * Sticky_new_str_y) / 10000;
		Sticky_coy = Sticky_coy + Sticky_tmp2;
		Sticky_dch = Sticky_dch - 1;
	}

	Sticky_apx = Sticky_srx;
	Sticky_apy = Sticky_sry;
	Sticky_bmg = isqrt(Sticky_srx * Sticky_srx + Sticky_sry * Sticky_sry);

	if(Sticky_bmg > 2) {
		Sticky_apt = Sticky_apt + get_rtime();
		if(Sticky_aph == 0 && Sticky_apt > 50) Sticky_aph = 1;
		else if(Sticky_aph == 1 && Sticky_apt > 150) Sticky_aph = 2;
		else if(Sticky_aph == 2 && Sticky_apt > 300) Sticky_aph = 3;
	} else {
		if(Sticky_apt > 200) Sticky_apt = Sticky_apt - get_rtime();
		if(Sticky_apt < 0) { Sticky_aph = 0; Sticky_apt = 0; }
	}

	Sticky_drx = Sticky_vlx - Sticky_lcx;
	Sticky_dry = Sticky_vly - Sticky_lcy;
	Sticky_tmp1 = isqrt(Sticky_drx * Sticky_drx + Sticky_dry * Sticky_dry);
	Sticky_lcx = Sticky_vlx;
	Sticky_lcy = Sticky_vly;

	if(Sticky_tmp1 < 11 && Sticky_bmg > 3) {
		Sticky_stk = Sticky_stk + 5;
		if(Sticky_stk > Sticky_bsk) Sticky_bsk = Sticky_stk;
		if(Sticky_asa < 25) Sticky_asa = Sticky_asa + 4;
	} else if(Sticky_tmp1 < 16) {
		Sticky_stk = Sticky_stk + 3;
		if(Sticky_asa < 25) Sticky_asa = Sticky_asa + 2;
	}
	if(Sticky_bmg > 10) {
		if(Sticky_ama < 15) Sticky_ama = Sticky_ama + 4;
	} else if(Sticky_bmg > 6) {
		if(Sticky_ama < 15) Sticky_ama = Sticky_ama + 2;
	}

	if(get_val(Button[Focus]) > 50 && get_val(Stick[MoveY]) > 70) {
		Sticky_assist_mult = Sticky_assist_mult * 70 / 100;
	}

	if(!State[HoldingFire]) {
		Sticky_tmp2 = 84; // Less slowdown when ADS only = faster feel (stronger stick)
	} else {
		if(Sticky_bmg < 10) Sticky_tmp2 = 62;
		else if(Sticky_bmg < 20) Sticky_tmp2 = 78;
		else if(Sticky_bmg < 35) Sticky_tmp2 = 90;
		else Sticky_tmp2 = 72;
	}
	if(Sticky_bmg < 35) {
		Sticky_tmp2 = Sticky_tmp2 - (Sticky_asa / 4);
		Sticky_tmp2 = Sticky_tmp2 - (Sticky_stk / 25);
	}
	Sticky_tmp2 = (Sticky_tmp2 * Sticky_assist_mult) / 100;
	if(State[HoldingFire]) {
		if(Sticky_tmp2 < 26) Sticky_tmp2 = 26;
	} else {
		if(Sticky_tmp2 < 78) Sticky_tmp2 = 78;
	}
	if(Sticky_tmp2 > 96) Sticky_tmp2 = 96;
	if(Sticky_raw_mag > 50) { Sticky_tmp2 = Sticky_tmp2 + 10; if(Sticky_tmp2 > 96) Sticky_tmp2 = 96; } // Flick = less slowdown
	Sticky_tmp1 = 100 - Sticky_tmp2;
	Sticky_cox = Sticky_cox + (Sticky_srx * Sticky_tmp1 * -1) / 100;
	Sticky_coy = Sticky_coy + (Sticky_sry * Sticky_tmp1 * -1) / 100;

	if(Sticky_bmg > 3) {
		Sticky_tmp1 = abs(Sticky_vlx);
		// Reduce pull when magnitude is low to avoid drift when releasing stick (higher = stronger tracking)
		if(Sticky_bmg < 6) Sticky_pls = 58;
		else if(Sticky_tmp1 > 12) Sticky_pls = 118;
		else if(Sticky_tmp1 > 8) Sticky_pls = 112;
		else if(Sticky_tmp1 > 5) Sticky_pls = 102;
		else if(Sticky_tmp1 > 2) Sticky_pls = 95;
		else Sticky_pls = 90;
		Sticky_pls = Sticky_pls + (Sticky_ama / 3);
		if(Sticky_aph == 3) Sticky_pls = Sticky_pls + 24;
		else if(Sticky_aph >= 2) Sticky_pls = Sticky_pls + 18;
		if(State[HoldingFire]) {
			Sticky_pls = Sticky_pls + 46;
			if(Sticky_bmg < 20) Sticky_pls = Sticky_pls + 22;
			else if(Sticky_bmg > 25 && Sticky_bmg < 50) Sticky_pls = Sticky_pls + 12;
			else if(Sticky_bmg >= 50) Sticky_pls = Sticky_pls + 18;
		}
		if(Sticky_pls > 185) Sticky_pls = 185;
		if(Sticky_pcf >= 6) { Sticky_pls = Sticky_pls * 110 / 100; if(Sticky_pls > 185) Sticky_pls = 185; }

		if(abs(Sticky_vlx) > 2) {
			if(abs(Sticky_vlx - Sticky_lvx) < 3) {
				Sticky_pcf = Sticky_pcf + 1;
				if(Sticky_pcf > 10) Sticky_pcf = 10;
			} else {
				Sticky_pcf = 0;
				if(Sticky_direction_changed) {
					Sticky_lv1 = 0;
					Sticky_lv2 = 0;
					Sticky_dch = 0;
				}
			}
			Sticky_lvx = (Sticky_lvx * 7 + Sticky_vlx * 3) / 10;
			Sticky_tmp1 = 25 + (Sticky_pcf * 7);
			Sticky_pdx = (Sticky_vlx * (100 + Sticky_tmp1)) / 100;
			Sticky_tmp2 = (Sticky_pdx * Sticky_pls) / 100;
			Sticky_cox = Sticky_cox + Sticky_tmp2;
		}
		if(abs(Sticky_vly) > 2) {
			if(abs(Sticky_vly - Sticky_lvy) < 3) Sticky_pcf = Sticky_pcf + 1;
			Sticky_lvy = (Sticky_lvy * 7 + Sticky_vly * 3) / 10;
			Sticky_tmp1 = 25 + (Sticky_pcf * 7);
			Sticky_pdy = (Sticky_vly * (100 + Sticky_tmp1)) / 100;
			Sticky_tmp2 = (Sticky_pdy * Sticky_pls) / 100;
			Sticky_coy = Sticky_coy + Sticky_tmp2;
		}
	}

	// Separate X/Y: vertical pull 93% when not firing (stronger tracking), 85% when firing (avoid fighting recoil)
	if(State[HoldingFire]) Sticky_coy = Sticky_coy * 85 / 100;
	else Sticky_coy = Sticky_coy * 93 / 100;
	Sticky_scx = (Sticky_cox * 72 + Sticky_pcx * 28) / 100;
	Sticky_scy = (Sticky_coy * 72 + Sticky_pcy * 28) / 100;
	Sticky_tmp1 = Sticky_srx + Sticky_scx;
	Sticky_tmp2 = Sticky_sry + Sticky_scy;
	Sticky_pcx = Sticky_cox;
	Sticky_pcy = Sticky_coy;
	if(Sticky_tmp1 < -100) Sticky_tmp1 = -100;
	if(Sticky_tmp1 > 100) Sticky_tmp1 = 100;
	if(Sticky_tmp2 < -100) Sticky_tmp2 = -100;
	if(Sticky_tmp2 > 100) Sticky_tmp2 = 100;
	Sticky_tmp1 = (Sticky_tmp1 * 93 + Sticky_lox * 7) / 100;
	Sticky_tmp2 = (Sticky_tmp2 * 93 + Sticky_loy * 7) / 100;
	Sticky_lox = Sticky_tmp1;
	Sticky_loy = Sticky_tmp2;

	// Adaptive blend: warm-up; flick = responsive; small/normal = more sticky for stronger tracking
	if(Sticky_ads_frames < 6) {
		Sticky_tmp1 = (Sticky_tmp1 * 20 + RawAimX * 80) / 100;
		Sticky_tmp2 = (Sticky_tmp2 * 20 + iif(Settings[Inverted], 0 - RawAimY, RawAimY) * 80) / 100;
	} else if(Sticky_raw_mag > 50) {
		Sticky_tmp1 = (Sticky_tmp1 * 18 + RawAimX * 82) / 100;
		Sticky_tmp2 = (Sticky_tmp2 * 18 + iif(Settings[Inverted], 0 - RawAimY, RawAimY) * 82) / 100;
	} else if(Sticky_raw_mag < 15) {
		Sticky_tmp1 = (Sticky_tmp1 * 82 + RawAimX * 18) / 100;
		Sticky_tmp2 = (Sticky_tmp2 * 82 + iif(Settings[Inverted], 0 - RawAimY, RawAimY) * 18) / 100;
	} else {
		Sticky_tmp1 = (Sticky_tmp1 * 55 + RawAimX * 45) / 100;
		Sticky_tmp2 = (Sticky_tmp2 * 55 + iif(Settings[Inverted], 0 - RawAimY, RawAimY) * 45) / 100;
	}
	if(Sticky_ads_frames < 10) Sticky_ads_frames = Sticky_ads_frames + 1; // Advance warm-up counter (cap at 10)
	if(Sticky_tmp1 < -100) Sticky_tmp1 = -100;
	if(Sticky_tmp1 > 100) Sticky_tmp1 = 100;
	if(Sticky_tmp2 < -100) Sticky_tmp2 = -100;
	if(Sticky_tmp2 > 100) Sticky_tmp2 = 100;

	// Aim curve: big movement = more responsive, small = current speed (when setting enabled)
	if(Settings[AimCurve] > 0) {
		AimCurveMag = isqrt(Sticky_tmp1 * Sticky_tmp1 + Sticky_tmp2 * Sticky_tmp2);
		if(AimCurveMag > 35) {
			AimCurveMult = 100 + (AimCurveMag - 35) * 35 * Settings[AimCurve] / 100 / 106;
			if(AimCurveMult > 135) AimCurveMult = 135;
		} else {
			AimCurveMult = 100;
		}
		if(AimCurveMag > 0) {
			AimCurveNewMag = AimCurveMag * AimCurveMult / 100;
			if(AimCurveNewMag > 100) AimCurveNewMag = 100;
			Sticky_tmp1 = Sticky_tmp1 * AimCurveNewMag / AimCurveMag;
			Sticky_tmp2 = Sticky_tmp2 * AimCurveNewMag / AimCurveMag;
		}
	}

	// Scale to GPC stick range (-32767 to 32767)
	set_val(Stick[AimX], Sticky_tmp1 * STICK_SCALE);
	if(Settings[Inverted])
		set_val(Stick[AimY], 0 - (Sticky_tmp2 * STICK_SCALE));
	else
		set_val(Stick[AimY], Sticky_tmp2 * STICK_SCALE);
}

// Flushes the display buffer
function FlushBuffer(x, y, Size, Color)
{

	// Decrement display buffer value for proper arithmetic
	Display[Buffer]--; 
	
	// Check horizontal alignment
	switch(x) { 
		case AlignRight {
			x = OLED_WIDTH - (Display[Buffer] * FontWidth[Size]) + 0xfffffffc; // Additional 4 for padding from border
			break;	
		} case AlignCenter {
			x = (OLED_WIDTH >> 1) - ((Display[Buffer] * FontWidth[Size]) >> 1);
			break;
		}
		// AlignLeft case is not needed because AlignLeft is set to the proper left alignment already
	}
	
	// Check vertical alignment
	switch(y) { 
		case AlignCenter {
			y = (OLED_HEIGHT >> 1) - (FontHeight[Size] >> 1);
			break;
		} case AlignBottom {
			y = OLED_HEIGHT - FontHeight[Size] + 0xfffffffc; // Additional 4 for padding from border
			break;	
		}
		// AlignTop case is not needed because AlignTop is set to the proper top alignment already
	}
	
	// Menu glitch: jitter text when navigating in menu
	if(Display[Depth] >= DisplayMenu) {
		x = x + MenuGlitchX;
		y = y + MenuGlitchY;
	}
	
	puts_oled(x, y, Size, Display[Buffer], Color); // Output display buffer
	Display[Buffer] = 1; // Reset display buffer
}

// Alternative for the ternary operator
function iif(expression, truepart, falsepart) {

	// evaluate if expression is true
	if(expression) {
		return truepart; // Return truepart
	}
	
	// Else, return falsepart
	return falsepart;
}

// Inserts a character into the display buffer
function InsertCharacter(int Value)
{
	// Puts a character in the display buffer
	putc_oled(Display[Buffer], Value);
	Display[Buffer]++;
	
}

// Inserts a number into the display buffer
function InsertNumber(int Value)
{

	// Check if value is negative
	if(Value < 0) {
		InsertCharacter(ASCII_MINUS); // Insert '-' into the display buffer
		Value = abs(Value); // Convert value to positive
	}
	
	Display[BufferInsertCopyValue] = Value; // Create a copy of value to perform work on
	Display[BufferInsertDigitCount] = 0; // Reset number of digits to 0
	
    // Determine the number of digits in the number by
    // dividing it by 10 repeatedly until it becomes 0
    // while not ignoring a value of 0
    do {
        Display[BufferInsertCopyValue] /= 0x0a;
        Display[BufferInsertDigitCount]++;
    } while(Display[BufferInsertCopyValue])
    
    // Extract each digit of the number and store it in an array
    // Check this loop for optimization: excessive iterations may cause lag
for(i = 0; i < Display[BufferInsertDigitCount]; i++) {
        Display[BufferInsertDigits + i] = (Value % 0x0a) + 48;
        Value /= 0x0a;
    }
    
    // Insert the digits in the order that they appear in the number
    // Check this loop for optimization: excessive iterations may cause lag
for(i = Display[BufferInsertDigitCount] - 1; i >= 0; i--) {
        InsertCharacter(Display[BufferInsertDigits + i]);
    }
    
}

// Inserts a string into the display buffer
function InsertString(s)
{

	// Loop through each character of the string
    do {
    	InsertCharacter(dint8(s)); // Insert character into display buffer
    	s++; // Move to next character of the string
    } while(dint8(s)) // Check if a next character exists
    
}

function LoadSettings()
{
	reset_rumble(); // Reset rumble state
	reset_spvar(); // Reset SPVAR state
	
	// Read and check the first bit, if it is set, we know something should have been saved, otherwise we fall back on our default setting
	if(read_spvar(0, 1)) {
	
		// Menu settings:
		Settings[HairTriggers] = read_spvar(FALSE, TRUE);
		Settings[ControllerRumbles] = read_spvar(FALSE, TRUE);
		Settings[Deadzone] = read_spvar(FALSE, TRUE);
		Settings[DropShot] = read_spvar(Activation_Off, Activation_ADSAndFire);
		Settings[HoldBreath] = read_spvar(FALSE, TRUE);
		Settings[ButtonLayout] = read_spvar(ButtonLayout_Default, ButtonLayout_BumperPingTacticalFlipped);
		Settings[StickLayout] = read_spvar(StickLayout_Default, StickLayout_SouthpawNoClickSwap);
		Settings[BattsStickyAim] = read_spvar(FALSE, TRUE);
		Settings[ARGroundLoot] = read_spvar(FALSE, TRUE);
		Settings[AutoPing] = read_spvar(FALSE, TRUE);
		Settings[AutoSlide] = read_spvar(FALSE, TRUE);
		Settings[HeadshotAssist] = read_spvar(FALSE, TRUE);
		Settings[ShakeAssist] = read_spvar(FALSE, TRUE);
		Settings[StickyAimAssist] = read_spvar(FALSE, TRUE);
		Settings[RotationAssist] = read_spvar(Activation_Off, Activation_ADSOrFire);
		Settings[StrafeAssist] = read_spvar(Activation_Off, Activation_ADSOrFire);
		Settings[ReloadCancel] = read_spvar(FALSE, TRUE);
		Settings[YYSpam] = read_spvar(FALSE, TRUE);
		Settings[Inverted] = read_spvar(FALSE, TRUE);
		Settings[RaidFire] = read_spvar(RaidFire_Off, RaidFire_Smart);
		Settings[RaidFireRate] = read_spvar(0, 10);
		
		// Sub menu settings:
		Settings[DeadzoneLeft] = read_spvar(1, 0x63);
		Settings[DeadzoneRight] = read_spvar(1, 0x63);
		Settings[DropShotHold] = read_spvar(0x64, 0x1770);
		Settings[DropShotReset] = read_spvar(0x64, 0x1770);
		Settings[BattsStickyTime] = read_spvar(1, 0x64);
		Settings[BattsStickySize] = read_spvar(1, 0x64);
		Settings[ARGroundVertical] = read_spvar(0, 0x64);
		Settings[ARGroundHorizontal] = read_spvar(0xffffff9c, 0x64);
		Settings[HeadshotStrength] = read_spvar(1, 0x64);
		Settings[HeadshotTime] = read_spvar(1, 0x7d0);
		Settings[ShakeAssistRadius] = read_spvar(1, 0x64);
		Settings[ShakeAssistSteps] = read_spvar(1, 0x64);
		Settings[RotationAssistRadius] = read_spvar(1, 0x64);
		Settings[RotationAssistSpeed] = read_spvar(1, 120);
		Settings[StrafeAssistRadius] = read_spvar(1, 0x64);
		Settings[StrafeAssistTime] = read_spvar(1, 0x3e8);
		
		// Loadout data:
		// Check this loop for optimization: excessive iterations may cause lag
for(i = 0; i < 10; i++) {
			Settings[PrimaryWeapon + i] = read_spvar(M4, SniperShotgun);
			Settings[SecondaryWeapon + i] = read_spvar(M4, SniperShotgun);
			Settings[PrimaryWeaponVertical + i] = read_spvar(0xffffff81, 0x7f);
			Settings[PrimaryWeaponHorizontal + i] = read_spvar(0xffffff81, 0x7f);
			Settings[SecondaryWeaponVertical + i] = read_spvar(0xffffff81, 0x7f);
			Settings[SecondaryWeaponHorizontal + i] = read_spvar(0xffffff81, 0x7f);
		}
		
	} else {
		
		// Set default values:
		//
		// Menu settings:
		Settings[HairTriggers] = TRUE;
		Settings[ControllerRumbles] = FALSE;
		Settings[Deadzone] = FALSE;
		Settings[DropShot] = FALSE;
		Settings[HoldBreath] = FALSE;
		Settings[ButtonLayout] = ButtonLayout_Default;
		Settings[StickLayout] = StickLayout_Default;
		Settings[BattsStickyAim] = FALSE;
		Settings[ARGroundLoot] = TRUE;
		Settings[AutoPing] = FALSE;
		Settings[AutoSlide] = FALSE;
		Settings[HeadshotAssist] = FALSE;
		Settings[ShakeAssist] = FALSE;
		Settings[StickyAimAssist] = TRUE;
		Settings[RotationAssist] = Activation_ADSAndFire;
		Settings[StrafeAssist] = Activation_Off;
		Settings[ReloadCancel] = FALSE;
		Settings[YYSpam] = FALSE;
		Settings[RaidFire] = RaidFire_Off;
		Settings[RaidFireRate] = 3;
		
		// Sub menu settings:
		Settings[DeadzoneLeft] = 10;
		Settings[DeadzoneRight] = 10;
		Settings[DropShotHold] = 600;
		Settings[DropShotReset] = 5000;
		Settings[BattsStickyTime] = 9;
		Settings[BattsStickySize] = 9;
		Settings[ARGroundVertical] = 12;
		Settings[ARGroundHorizontal] = 0;
		Settings[HeadshotStrength] = 13;
		Settings[HeadshotTime] = 700;
		Settings[ShakeAssistRadius] = 9;
		Settings[ShakeAssistSteps] = 9;
		Settings[RotationAssistRadius] = 3;
		Settings[RotationAssistSpeed] = 3;
		Settings[StrafeAssistRadius] = 40;
		Settings[StrafeAssistTime] = 40;
		
		// Loadout data:
		// Check this loop for optimization: excessive iterations may cause lag
for(i = 0; i < 10; i++) {
			Settings[PrimaryWeapon + i] = M4;
			Settings[SecondaryWeapon + i] = SniperShotgun;
			Settings[PrimaryWeaponVertical + i] = 0;
			Settings[PrimaryWeaponHorizontal + i] = 0;
			Settings[SecondaryWeaponVertical + i] = 0;
			Settings[SecondaryWeaponHorizontal + i] = 0;
		}
	}
}

function SaveSettings()
{
	reset_spvar();
	
	// Save a constant 1 to denote previously saved data, this range uses 1 bit
	save_spvar(1, 0, 1);
	
	// Menu settings:
	save_spvar(Settings[HairTriggers], FALSE, TRUE);
	save_spvar(Settings[ControllerRumbles], FALSE, TRUE);
	save_spvar(Settings[Deadzone], FALSE, TRUE);
	save_spvar(Settings[DropShot], Activation_Off, Activation_ADSAndFire);
	save_spvar(Settings[HoldBreath], FALSE, TRUE);
	save_spvar(Settings[ButtonLayout], ButtonLayout_Default, ButtonLayout_BumperPingTacticalFlipped);
	save_spvar(Settings[StickLayout], StickLayout_Default, StickLayout_SouthpawNoClickSwap);
	save_spvar(Settings[BattsStickyAim], FALSE, TRUE);
	save_spvar(Settings[ARGroundLoot], FALSE, TRUE);
	save_spvar(Settings[AutoPing], FALSE, TRUE);
	save_spvar(Settings[AutoSlide], FALSE, TRUE);
	save_spvar(Settings[HeadshotAssist], FALSE, TRUE);
	save_spvar(Settings[ShakeAssist], FALSE, TRUE);
	save_spvar(Settings[StickyAimAssist], FALSE, TRUE);
	save_spvar(Settings[RotationAssist], Activation_Off, Activation_ADSOrFire);
	save_spvar(Settings[StrafeAssist], Activation_Off, Activation_ADSOrFire);
	save_spvar(Settings[ReloadCancel], FALSE, TRUE);
	save_spvar(Settings[YYSpam], FALSE, TRUE);
	save_spvar(Settings[Inverted], FALSE, TRUE);
	save_spvar(Settings[RaidFire], RaidFire_Off, RaidFire_Smart);
	save_spvar(Settings[RaidFireRate], 0, 10);
	
	// Sub menu settings:
	save_spvar(Settings[DeadzoneLeft], 1, 0x63);
	save_spvar(Settings[DeadzoneRight], 1, 0x63);
	save_spvar(Settings[DropShotHold], 0x64, 0x1770);
	save_spvar(Settings[DropShotReset], 0x64, 0x1770);
	save_spvar(Settings[BattsStickyTime], 1, 0x64);
	save_spvar(Settings[BattsStickySize], 1, 0x64);
	save_spvar(Settings[ARGroundVertical], 0, 0x64);
	save_spvar(Settings[ARGroundHorizontal], 0xffffff9c, 0x64);
	save_spvar(Settings[HeadshotStrength], 1, 0x64);
	save_spvar(Settings[HeadshotTime], 1, 0x7d0);
	save_spvar(Settings[ShakeAssistRadius], 1, 0x64);
	save_spvar(Settings[ShakeAssistSteps], 1, 0x64);
	save_spvar(Settings[RotationAssistRadius], 1, 0x64);
	save_spvar(Settings[RotationAssistSpeed], 1, 120);
	save_spvar(Settings[StrafeAssistRadius], 1, 0x64);
	save_spvar(Settings[StrafeAssistTime], 1, 0x3e8);
	
	// Loadout data:
	// Check this loop for optimization: excessive iterations may cause lag
for(i = 0; i < 10; i++) {
		save_spvar(Settings[PrimaryWeapon + i], M4, SniperShotgun);
		save_spvar(Settings[SecondaryWeapon + i], M4, SniperShotgun);
		save_spvar(Settings[PrimaryWeaponVertical + i], 0xffffff81, 0x7f);
		save_spvar(Settings[PrimaryWeaponHorizontal + i], 0xffffff81, 0x7f);
		save_spvar(Settings[SecondaryWeaponVertical + i], 0xffffff81, 0x7f);
		save_spvar(Settings[SecondaryWeaponHorizontal + i], 0xffffff81, 0x7f);
	}
}

// Output value to stick and gradually reduce it as it approaches maximum movement
function Output(stick, value) {
	OutputTempValue = get_val(stick);
	OutputTempAbs = abs(OutputTempValue);
	set_val(stick, clamp(value * (0x7fff - OutputTempAbs) / 0x7fff + OutputTempValue, 0xffff8000, 0x7fff));
}

// Prints a number to the screen
function PrintNumber(x, y, number, size, color)
{

	// Insert number to the display buffer
	InsertNumber(number);
	FlushBuffer(x, y, size, color);
	
}

 // Prints text to the screen
 function PrintText(x, y, text, size, color)
 {
 
 	// Insert string to the display buffer
	InsertString(text);
	FlushBuffer(x, y, size, color);
}

function RumbleToUse()
{

    if(get_rumble(RUMBLE_A) == get_rumble(RUMBLE_B)) {
        return RUMBLE_A;
    }
    
    if(get_rumble(RUMBLE_A) == 100) {
        return RUMBLE_B;
    }
    
    if(get_rumble(RUMBLE_B) == 100) {
        return RUMBLE_A;
    }
    
    if(get_rumble(RUMBLE_A) > get_rumble(RUMBLE_B)) {
        return RUMBLE_A;
    }
    
    if(get_rumble(RUMBLE_A) < get_rumble(RUMBLE_B)) {
        return RUMBLE_B;
    }
    
    return 0;
}

function SetControllerConfig()
{

	// Set Button Layout
	Button[ADS] = ButtonLayoutMap[Settings[ButtonLayout]][ADS];
	Button[Tactical] = ButtonLayoutMap[Settings[ButtonLayout]][Tactical];
	Button[Ping] = ButtonLayoutMap[Settings[ButtonLayout]][Ping];
	Button[Focus] = ButtonLayoutMap[Settings[ButtonLayout]][Focus];
	Button[Fire] = ButtonLayoutMap[Settings[ButtonLayout]][Fire];
	Button[Lethal] = ButtonLayoutMap[Settings[ButtonLayout]][Lethal];
	Button[Weapon] = ButtonLayoutMap[Settings[ButtonLayout]][Weapon];
	Button[Action] = ButtonLayoutMap[Settings[ButtonLayout]][Action];
	Button[Jump] = ButtonLayoutMap[Settings[ButtonLayout]][Jump];
	Button[Melee] = ButtonLayoutMap[Settings[ButtonLayout]][Melee];
	
	// Set Stick Layout
	Stick[AimX] = StickLayoutMap[Settings[StickLayout]][AimX];
	Stick[AimY] = StickLayoutMap[Settings[StickLayout]][AimY];
	Stick[MoveX] = StickLayoutMap[Settings[StickLayout]][MoveX];
	Stick[MoveY] = StickLayoutMap[Settings[StickLayout]][MoveY];
	
	// For Southpaw, Left and Right joystick clicks must be swapped
	if((Settings[StickLayout] == StickLayout_Southpaw) || (Settings[StickLayout] == StickLayout_LegacySouthpaw)) {
		switch(Settings[ButtonLayout]) {
			case ButtonLayout_Default {
				Button[Melee] = XB1_RS;
				Button[Focus] = XB1_LS;
				break;
			} case ButtonLayout_Tactical {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_Lefty {
				Button[Focus] = XB1_LS;
				Button[Melee] = XB1_RS;
				break;
			} case ButtonLayout_NomadCharlie {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_NomadCharlieTactical {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_NomadCharlieLefty {
				Button[Focus] = XB1_LS;
				Button[Melee] = XB1_RS;
				break;
			} case ButtonLayout_BumperJumper {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BumperJumperTactical {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_OneHandGunslinger {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_StickAndMove {
				Button[Jump] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_Brawler {
				Button[Lethal] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_Beast {
				Button[Lethal] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BumperPing {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BumperPingTactical {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_DefaultFlipped {
				Button[Melee] = XB1_RS;
				Button[Focus] = XB1_LS;
				break;
			} case ButtonLayout_TacticalFlipped {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_LeftyFlipped {
				Button[Focus] = XB1_LS;
				Button[Melee] = XB1_RS;
				break;
			} case ButtonLayout_NomadCharlieFlipped {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_NomadCharlieTacticalFlipped {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_NomadCharlieLeftyFlipped {
				Button[Focus] = XB1_LS;
				Button[Melee] = XB1_RS;
				break;
			} case ButtonLayout_BumperJumperFlipped {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BumperJumperTacticalFlipped {
				Button[Action] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_OneHandGunslingerFlipped {
				Button[Melee] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_StickAndMoveFlipped {
				Button[Jump] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BrawlerFlipped {
				Button[Lethal] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BeastFlipped {
				Button[Lethal] = XB1_LS;
				Button[Focus] = XB1_RS;
				break;
			} case ButtonLayout_BumperPingFlipped {
				Button[Melee] = XB1_LS;
