function LedFlow() {

    Rgb += get_rtime();
        
    if (Rgb == 60) {
        set_rgb(Colour,Colour[1],Colour[2]);
        Colour[LedDec] -= 1; 
        Colour[LedInc] += 1;

        if (!Colour[LedDec]) { 
            LedInc = (LedInc + 1) % 3; 
            LedDec = (LedDec + 1) % 3; 
        }
            Rgb = 0;    
    }
}␀����������������