combo AntiBloom {
	set_val(LX,-40);
	wait(50);
	set_val(LX, 40);
	wait(50);
	} 
int Position;   
function GetShapes(f_var) {     
    if(!SpiralPosition1)                                
	{
		InnerSpiral -= 1;
		if(InnerSpiral < TaylorRadiusMin)
			SpiralPosition1 = True;
	}
	else
	{
	    InnerSpiral += 1;
		if(InnerSpiral > f_var)
			SpiralPosition1 = False;
	}
	if(!SpiralPosition2)
	{
		OuterSpiral -= 1;
		if(OuterSpiral < TaylorRadiusMin)
			SpiralPosition2 = True;
	}
	else
	{
		OuterSpiral += 1;
		if(OuterSpiral >  f_var)
			SpiralPosition2 = False;
	} 
	if(ToleTaylorAssist == TRUE)                    
	{ 
        RY1 = (get_val(PS4_RY))  + ( (SinAngle * f_var) )/100;
        RX1 = (get_val(PS4_RX))  + ( (CosAngle * f_var) )/100;  
	} 
    set_val(PS4_RX,RX1);
    set_val(PS4_RY,RY1);
}
function AXRL(AxisXY,AxisVal) 
{
    if (abs(get_ival(AxisXY)) <= ExpoStrength) 
        return AxisVal;
        return get_ival(AxisXY);
}
combo Aim_Expo 
{
    set_val(RY,AXRL(RY,ExpoStrength));
    wait(8);
    set_val(RX,AXRL(RX,ExpoStrength));
    wait(8);
    set_val(LX,AXRL(LX,ExpoStrength));
    wait(8);
    set_val(RY,AXRL(RY,-ExpoStrength));
    wait(8);
    set_val(RX,AXRL(RX,-ExpoStrength));
    wait(8);
    set_val(LX,AXRL(LX,-ExpoStrength));
    wait(8);
}
combo Aim_Expo_Accuracy 
{
    set_val(RY,AXRL(RY,27));
    wait(8);
    set_val(RX,AXRL(RX,ExpoStrength));
    wait(8);
    set_val(RY,AXRL(RY,-ExpoStrength));
    wait(8);
    set_val(RX,AXRL(RX,-ExpoStrength));
    wait(8);
}
