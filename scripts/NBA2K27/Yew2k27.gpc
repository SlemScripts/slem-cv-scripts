                    else { if (_nd) { combo_run(_ndc); } else { _id = _sm + random(_rn, _rx); combo_run(_iss); } }
                } else if (get_val(PS4_L2)) { if (_nd) { combo_run(_ndc); } else { _id = _sm + random(_rn, _rx); combo_run(_iss); } }
                else if (get_val(PS4_R2)) { _id = _tm + random(_rn, _rx); if (_rf == 1) { combo_run(_isr); } else { combo_run(_iss); } }
