function _uss() {
    _stt2++;
    if (_stt2 % 2 == 0) {
        for (_sti = 0; _sti < _stc + (_osd / _osd) - 1; _sti++) {
            if (_sta[_sti]) {
                _stx[_sti] += _stvx[_sti];
                _sty[_sti] += _stvy[_sti];
                if (_stt[_sti] > 8) {
                    _stvy[_sti] += 1;
                }
                _stt[_sti]++;
                if (_stx[_sti] > 135 || _sty[_sti] > 60 || _stt[_sti] > 50) {
                    _sta[_sti] = 0;
                }
            } else {
                if (random(0, 100) < 2) {
                    _sta[_sti] = 1;
                    _stx[_sti] = random(-5, 30);
                    _sty[_sti] = random(-8, 5);
                    _stvx[_sti] = random(2, 3);
                    _stvy[_sti] = 1;
                    _stt[_sti] = 0;
// discord.gg/orla
                }
            }
        }
    }
}

function _dss() {
    for (_sti = 0; _sti < _stc; _sti++) {
        if (_sta[_sti] && _sty[_sti] >= 0 && _sty[_sti] < 56) {
            pixel_oled(_stx[_sti], _sty[_sti], 1);
            pixel_oled(_stx[_sti] + 1, _sty[_sti], 1);
            pixel_oled(_stx[_sti] + 1, _sty[_sti] + 1, 1);
            if (_stt[_sti] > 3) {
                pixel_oled(_stx[_sti] - _stvx[_sti], _sty[_sti] - 1, 1);
                pixel_oled(_stx[_sti] - _stvx[_sti] + 1, _sty[_sti] - 1, 1);
            }
            if (_stt[_sti] > 8) {
                pixel_oled(_stx[_sti] - _stvx[_sti] * 2, _sty[_sti] - 2, 1);
            }
            if (_stt[_sti] > 15) {
// discord.gg/orla
                pixel_oled(_stx[_sti] - _stvx[_sti] * 3, _sty[_sti] - 3, 1);
            }
        }
    }
}

function _dis() {
    cls_oled(0);
    _uss();
    _dss();
    _flt = _flt + get_rtime() + (_osd / _osd) - 1;
    if (_flt >= _fli) {
        _flt = 0;
        _fls = _fls + 1;
        if (_fls > 2) {
            _fls = 0;
        }
    }
    if (_fls == 0) {
        _dht(17, 8);
    } else if (_fls == 1) {
        _dyt(21, 8);
    } else {
        _dnt(23, 8);
    }
    print(_cx(_gsl(_HL[0]), OLED_FONT_MEDIUM_WIDTH), 38, OLED_FONT_MEDIUM, OLED_WHITE, _HL[0]);
// discord.gg/orla
}

function _ait() {
    if (_it) {
        if (get_val(PS4_L2) > 0) {
            set_val(PS4_L2, 100);
        }
        if (get_val(PS4_R2) > 0) {
            set_val(PS4_R2, 100);
        }
    }
}

function _trv() {
    if (_rv && get_val(PS4_SQUARE)) {
        if (!_sqh) {
            _sqh = 1;
            _shs = _ct;
            _va = 0;
            _vt = 0;
        } else {
            _hd = _ct - _shs;
            if (_hd >= _rvm && !_vt) {
                set_rumble(RUMBLE_A, 100);
// discord.gg/orla
                _va = 1;
                _vt = 1;
            }
        }
    } else if (!get_val(PS4_SQUARE)) {
        if (_va) {
            set_rumble(RUMBLE_A, 0);
            _va = 0;
        }
        _sqh = 0;
        _vt = 0;
    }
}

function _hmd() {
    if (_md > 0) {
        if (_md == 1) {
            if (get_val(PS4_L1)) {
                set_val(PS4_RY, 100);
                set_val(PS4_R2, 100);
                _mdo = 1;
            } else if (event_release(PS4_L1)) {
                set_val(PS4_RY, 0);
                set_val(PS4_R2, 0);
                _mdo = 0;
            }
        } else if (_md == 2) {
            if (get_val(PS4_CIRCLE)) {
                set_val(PS4_RY, 100);
                set_val(PS4_R2, 100);
