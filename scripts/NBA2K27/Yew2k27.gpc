function _dpd(c, t) {
// discord.gg/orla
    _tdt = t;
    _cdt = c;
    _dtx = (128 - (_tdt * 7 - 3)) / 2;
    for (_dti = 0; _dti < _tdt; _dti++) {
        if (_dti == _cdt) {
            rect_oled(_dtx + (_dti * 7), 56, 4, 4, 1, OLED_WHITE);
        } else {
            rect_oled(_dtx + (_dti * 7), 56, 4, 4, 1, OLED_WHITE);
            rect_oled(_dtx + (_dti * 7) + 1, 57, 2, 2, 1, OLED_BLACK);
        }
    }
}

function _dtp(x, y, o) {
    rect_oled(x, y, 24, 12, 1, OLED_WHITE);
    rect_oled(x + 1, y + 1, 22, 10, 1, OLED_BLACK);
// discord.gg/orla
    if (o) {
        rect_oled(x + 13, y + 2, 8, 8, 1, OLED_WHITE);
    } else {
        rect_oled(x + 3, y + 2, 8, 8, 1, OLED_WHITE);
        rect_oled(x + 4, y + 3, 6, 6, 1, OLED_BLACK);
    }
}

function _dch(x, y) {
    line_oled(x, y, x + 4, y + 4, 1, OLED_WHITE);
    line_oled(x + 4, y + 4, x, y + 8, 1, OLED_WHITE);
}

function _gvpi(ap) {
    if (ap <= 1) return ap;
    if (ap >= 3 && ap <= 8) return ap - 1;
    if (ap >= 9 && ap <= 18) return ap - 1;
    if (ap == 20) return 18;
    if (ap == 21) return 19;
    return 0;
}

function _ntsa(fv, fd, px, py) {
    _nbi = 1;
    _ndi = 10000;
    if (fv < 0) {
        putc_oled(_nbi, 45);
        _nbi += 1;
        fv = abs(fv);
    }
// discord.gg/orla
    for (_nci = 5; _nci >= 1; _nci--) {
        if (fd >= _nci) {
            putc_oled(_nbi, (fv / _ndi) + 48);
            fv %= _ndi;
            _nbi++;
        }
        _ndi /= 10;
    }
    puts_oled(px, py, OLED_FONT_MEDIUM, _nbi - 1, OLED_WHITE);
}

combo _mc {
    if (_is && _gsa && !_mdo && !_ss && !_rss && !get_val(PS4_SQUARE) && !combo_running(_fus) && !combo_running(_fur) && !combo_running(_iss) && !combo_running(_isr)) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            _mt = _mt + get_rtime();
            if (_is == 1) {
                _gcc = _gcn;
            } else if (_is == 2) {
                if (_mt <= _rdl + (_gco / _gco) - 1) {
                    _gcc = _gcx;
                } else if (_mt <= _rdl + _rdr) {
                    _gcc = _gcx - ((_gcx - _gcn) * (_mt - _rdl) / _rdr);
                } else {
                    _gcc = _gcn;
                }
            }
            set_val(PS4_LX, (get_val(PS4_LX) * _gcc) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * _gcc) / 100);
        } else {
// discord.gg/orla
            _mt = 0;
            _gcc = _gcx;
        }
        if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

function _aoc() {
    _rbt += get_rtime();
    if (_rbt >= 25 + (_dtc / _dtc) - 1) {
        _rbt = 0;
        _rbh += 1;
        if (_rbh >= 300) _rbh = 0;
    }
// discord.gg/orla
    _rbrg = _rbh / 100;
    _rbre = _rbh % 100;
    if (_rbrg == 0) {
        _rbr = 255 - (117 * _rbre / 100);
        _rbg = 140 - (97 * _rbre / 100);
        _rbb = (226 * _rbre / 100);
    } else if (_rbrg == 1) {
        _rbr = 138 - (138 * _rbre / 100);
        _rbg = 43 + (85 * _rbre / 100);
        _rbb = 226 + (29 * _rbre / 100);
    } else {
        _rbr = (255 * _rbre / 100);
        _rbg = 128 + (12 * _rbre / 100);
        _rbb = 255 - (255 * _rbre / 100);
    }
// discord.gg/orla
    set_rgb(_rbr, _rbg, _rbb);
}

function _ude() {
    if (_du > 0 || _dd > 0 || _dl > 0 || _dr > 0) {
        _de = 1;
    } else {
        _de = 0;
    }
}

function _ulm(o) {
    if (o) {
        _aoc();
    } else {
        set_rgb(0, 0, 0);
    }
// discord.gg/orla
}

function _ctd() {
    _d1 = random(_bt - 1, _bt + 1) + (_dtc / _dtc) - 1;
}

function _gdi() {
    return _di + random(_hrn, _hrx);
}

combo _ruc {
    set_val(PS4_RY, 0 + random(_hrn, _hrx));
    set_val(PS4_RX, 20 + random(_hrn, _hrx));
    wait(_d1);
    set_val(PS4_RY, -100 + random(_rn, _rx));
    set_val(PS4_RX, 25 + random(_rn, _rx));
    wait(200);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo _rdc {
    set_val(PS4_RY, 0 + random(_hrn, _hrx));
    set_val(PS4_RX, -20 + random(_hrn, _hrx));
    wait(_d1);
    set_val(PS4_RY, 100 + random(_rn, _rx));
    set_val(PS4_RX, -25 + random(_rn, _rx));
// discord.gg/orla
    wait(200);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

