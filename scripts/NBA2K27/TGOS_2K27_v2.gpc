    Script : NBA2k27 TGOS AUTOGREEN SCRIPT
    Author : TheGodOfScripts
    Discord: https://discord.gg/orla
    Store  : https://payhip.com/thegodofscripts
    Contact: TheGodOfScripts@gmail.com
    Release: 2.0

    v2.0 - Shot pipeline rebuilt on discrete step timing.
           - Safe Mode and the whole interpolating motion engine are gone.
             Every shot is once again a discrete set_val step sequence.
           - Smart Shot Detection: Insta Shot now picks its own dip offset
             from what the sticks were doing (fade / off-dribble / standing).
           - Go-To Shot on D-pad Down, with its own speed page.
           - Infinite Stamina, now a menu toggle rather than always-on.
           - Factory reset: hold L1+R1 (LB+RB) through the boot animation
             for one second to wipe all five profiles back to defaults.
*/

// discord.gg/orla
// ===== Persistent storage map =====
// This is every slot the script writes. Nothing else on the device is touched.
//
//   SPVAR_11        last menu page
//   SPVAR_20        active profile slot (1-5)
//   SPVAR_23        layout signature - see INIT_SIGNATURE
//   pvar 30..49     the five profiles, 4 pvars each (PVAR_BASE / PVAR_OFFSET)
//
// v1 also declared PVAR_TEMPO_MS, PVAR_STABILITY, PVAR_REVERSE_MODE,
// PVAR_RS_SHOOT, PVAR_REMAP_SQ, PVAR_DUNK_METER, PVAR_AUTO_SHOT_ACTIVE,
// PVAR_AUTO_SHOT_DUR, PVAR_AUTO_TEMPO, PVAR_NODIP_ENABLED and
// PVAR_NODIP_VALUE. Those predate the bitfield profiles and were never read
// or written, so they are gone - they only implied slots this script owned.
define PVAR_LAST_PAGE       = SPVAR_11;
define PVAR_PROFILE_SLOT    = SPVAR_20;
define PVAR_INIT            = SPVAR_23;

define PROFILE_MIN = 1;
define PROFILE_MAX = 5;

// Written to PVAR_INIT once the profile block has been laid down. Any other
// value - including a fresh device, or leftovers from another script that
// happened to use this slot - forces every profile back to defaults.
// A small ordinal like 1/2/3 is a bad sentinel: those bytes turn up in stale
// EEPROM by chance, and a false match boots the customer into decoded garbage.
// BUMP THIS ON EVERY RELEASE THAT CHANGES THE PROFILE BITFIELD LAYOUT.
define INIT_SIGNATURE = 197;
// discord.gg/orla

// ===== Intro sequence =====
define INTRO_ON_MS   = 100;  // word lit during a blink
define INTRO_OFF_MS  = 70;   // word dark during a blink
define INTRO_BLINKS  = 2;    // blinks before the word settles
define INTRO_HOLD_MS = 300;  // solid hold once it settles
define INTRO_GAP_MS  = 80;   // blank between words
define INTRO_WORDS   = 4;

define GREEN_R = 0;
define GREEN_G = 200;
define GREEN_B = 0;
define STAR_COUNT = 42;

define REPEAT_INITIAL_MS = 250;
define REPEAT_RATE_SLOW  = 90;
define REPEAT_ACCEL_AT   = 500;
define REPEAT_RATE_FAST  = 40;

int flick_up_shooting_active = 0;
// discord.gg/orla
int delay_duration = 0;
int Delay_duration_Insta = 0;
int STICK_DOWN_VALUE = 100;
int STICK_UP_VALUE = -100;
int RX_UP_VALUE = 25;
int random_variation_min = -4;
int random_variation_max = 4;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;
int stabilization_variation = 0;

int reverse_flick_mode = 0;
int rs_shooting_active = 0;
int rs_hold_duration = 300;

int Insta_shot_active = 0;
int Insta_shot_duration = 100;
int goto_shot_duration = 2230;

int isHolding = 0;
int holdTimer = 0;
// discord.gg/orla
int rs_is_up = 0;
int remap_square_active = 0;
int meter_dunk_active = 0;
int r2_recent_ms = 0;

// ----- Infinite Stamina (ground control) -----
// While ON and not shooting, the left stick is scaled back so the player
// jogs instead of sprinting, and is hard-centred below the deadzone.
// ground_control is the percentage the stick is scaled to - drop it for a
// heavier nerf, raise it toward 100 for a lighter one.
int infinite_stamina = 0;
int ground_control = 70;

// ----- Dunk Meter -----
int dm_engaged = 0;

// AutoGreen dip target while Square is held
int ag_target = 0;

// ----- Smart Shot Detection -----
// Insta Shot picks its own dip offset from what the sticks were doing at the
// moment it fired. Tune these two to your jumper; the rest is engine state.
int off_dribble_offset = -20;  // subtracted for off-dribble shots
int fade_offset        = 30;   // added for fades / moving shots
int dynamic_offset     = 0;    // engine - do not change
int rs_recent_timer    = 0;    // engine - do not change
int is_off_dribble     = 0;    // engine - do not change

// discord.gg/orla
// No-Dip Shot variables
int NODIP_SHOT_ENABLED = 0;
int NODIP_SHOT_DISPLAY_VALUE = 15;
int NODIP_SHOT_TIMING_MS_ACTUAL = 300;
int NODIP_MIN_MS, NODIP_MAX_MS, NODIP_RANDOM_OFFSET;
int nodip_for_this_shot = 0;
int use_nodip;

// Turbo fade flag (set on R2 + Square when Turbo Fade mode is active)
int is_turbo_fade = 0;

// Shot-pipeline state, used to keep RS Shooting from reacting to the
// stick values this script injects itself.
int square_held = 0;
int shot_engine_busy = 0;

// discord.gg/orla
int last_menu_page = 1;
int rpt_up_held = 0, rpt_dn_held = 0;
int rpt_up_bucket = 0, rpt_dn_bucket = 0;
int rpt_up_total = 0, rpt_dn_total = 0;
int rpt_rate_up = 0, rpt_rate_dn = 0;
int dt_menu = 0;
int step = 1;
int current_profile = 1;

int star_x[STAR_COUNT];
int star_y[STAR_COUNT];
int star_vx[STAR_COUNT];
int star_brightness[STAR_COUNT];
int star_index;
int profile_idx, profile_width;

// ----- factory reset chord -----
// L1+R1 (LB+RB) held through the intro wipes all five profiles. This is the
// support answer for a customer whose settings have ended up scrambled -
// without it the only remedy is reflashing a build with a new signature.
define RESET_HOLD_MS = 1000;   // how long the chord must be held
define RESET_SHOW_MS = 1500;   // how long the confirmation stays up
int reset_hold_t = 0;
// discord.gg/orla
int reset_done = 0;
int reset_show_t = 0;
int reset_bar = 0;

// ----- intro sequence -----
int intro_word = 0;    // which word is on screen
int intro_step = 0;    // 0 blinking, 1 solid hold, 2 blank gap
int intro_blink = 0;
int intro_vis = 1;
int intro_t = 0;

int saver_on = 0;
int sx = 2, sy = 16;
int svx = 2, svy = 2;
int msg_w, line1_w, line2_w;
int saver_timer = 0;
int saver_line1_x, saver_line2_x;
int saver_line1_y, saver_line2_y;
int saver_brand_x, saver_brand_y;

int graph_width;
int x_start;
int mid_x;
int bar_pos;

// discord.gg/orla
// Menu system: 4 categories, 15 pages total
// AutoGreen(1-5) | Insta Shot(6-8) | Misc(9-14) | Profile(15)
int startup = 1, numpgs = 15, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;
int p_start, val0, val1, val2;
int isLoadingScreen = 1;

int menu_mode = 0;
int category_index = 0;
int i;
int c_y;
int p_len;
int p_x;
int str_len;
int x_pos;
int p_idx;
int dot_count;
int dot_start_x;
int menu_scroll_y = 0;
int menu_target_y = 0;
int menu_r1 = 0;

const string CATEGORIES[] = { "AutoGreen", "Insta Shot", "Misc", "Profile" };
const int16 CAT_START[]  = {  1,  6,  9, 15 };
const int16 CAT_COUNT[]  = {  5,  3,  6,  1 };

// discord.gg/orla
const string ARROW_L[] = { "< " };
const string ARROW_R[] = { " >" };

const string version_txt[] = { "v1.0" };
const string profile_labels[] = {
    "Profile: 1",
    "Profile: 2",
    "Profile: 3",
    "Profile: 4",
    "Profile: 5"
};

const string saver_line1_ps[] = { "L2 + Options" };
