}

function selected_shot_value() {
    if (shot_menu_type == SHOT_STAND) {
        if (shot_field == 0) return stand_hold;
        return stand_tempo;
    }
    if (shot_menu_type == SHOT_LIGHT) {
        if (shot_field == 0) return light_hold;
        return light_tempo;
    }
    if (shot_menu_type == SHOT_MOVE) {
        if (shot_field == 0) return move_hold;
        return move_tempo;
    }
    if (shot_menu_type == SHOT_NODIP) {
        if (shot_field == 0) return nodip_hold;
        return nodip_tempo;
    }
    if (shot_menu_type == SHOT_FADE) {
        if (shot_field == 0) return fade_hold;
        return fade_tempo;
    }
    if (shot_field == 0) return goto_hold;
    if (shot_field == 1) return goto_tempo;
    return goto_extra;
}

function adjust_shot(amount) {
    if (shot_menu_type == SHOT_STAND) {
        if (shot_field == 0) stand_hold += amount;
        if (shot_field == 1) stand_tempo += amount;
    }
    if (shot_menu_type == SHOT_LIGHT) {
        if (shot_field == 0) light_hold += amount;
        if (shot_field == 1) light_tempo += amount;
    }
    if (shot_menu_type == SHOT_MOVE) {
        if (shot_field == 0) move_hold += amount;
        if (shot_field == 1) move_tempo += amount;
    }
    if (shot_menu_type == SHOT_NODIP) {
        if (shot_field == 0) nodip_hold += amount;
        if (shot_field == 1) nodip_tempo += amount;
    }
    if (shot_menu_type == SHOT_FADE) {
        if (shot_field == 0) fade_hold += amount;
        if (shot_field == 1) fade_tempo += amount;
    }
    if (shot_menu_type == SHOT_GOTO) {
        if (shot_field == 0) goto_hold += amount;
        if (shot_field == 1) goto_tempo += amount;
        if (shot_field == 2) goto_extra += amount;
    }

    stand_hold = limit_val(stand_hold,100,1500);
    light_hold = limit_val(light_hold,100,1500);
    move_hold = limit_val(move_hold,100,1500);
    nodip_hold = limit_val(nodip_hold,100,1500);
    fade_hold = limit_val(fade_hold,100,1500);
    goto_hold = limit_val(goto_hold,100,2000);

    stand_tempo = limit_val(stand_tempo,10,120);
    light_tempo = limit_val(light_tempo,10,120);
    move_tempo = limit_val(move_tempo,10,120);
    nodip_tempo = limit_val(nodip_tempo,10,120);
    fade_tempo = limit_val(fade_tempo,10,120);
    goto_tempo = limit_val(goto_tempo,10,120);
    goto_extra = limit_val(goto_extra,0,1200);
}

function selected_dribble() {
    if (drib_menu_bank == BANK_NORT) {
        if (drib_menu_dir == 0) return nort_up;
        if (drib_menu_dir == 1) return nort_down;
        if (drib_menu_dir == 2) return nort_left;
        return nort_right;
    }

    if (drib_menu_dir == 0) return rt_up;
    if (drib_menu_dir == 1) return rt_down;
    if (drib_menu_dir == 2) return rt_left;
    return rt_right;
}

function adjust_dribble(amount) {
    if (drib_menu_bank == BANK_NORT) {
        if (drib_menu_dir == 0) nort_up += amount;
        if (drib_menu_dir == 1) nort_down += amount;
        if (drib_menu_dir == 2) nort_left += amount;
        if (drib_menu_dir == 3) nort_right += amount;

        if (nort_up > 7) nort_up = 0; if (nort_up < 0) nort_up = 7;
        if (nort_down > 7) nort_down = 0; if (nort_down < 0) nort_down = 7;
        if (nort_left > 7) nort_left = 0; if (nort_left < 0) nort_left = 7;
        if (nort_right > 7) nort_right = 0; if (nort_right < 0) nort_right = 7;
    } else {
        if (drib_menu_dir == 0) rt_up += amount;
        if (drib_menu_dir == 1) rt_down += amount;
        if (drib_menu_dir == 2) rt_left += amount;
        if (drib_menu_dir == 3) rt_right += amount;

        if (rt_up > 7) rt_up = 0; if (rt_up < 0) rt_up = 7;
        if (rt_down > 7) rt_down = 0; if (rt_down < 0) rt_down = 7;
        if (rt_left > 7) rt_left = 0; if (rt_left < 0) rt_left = 7;
        if (rt_right > 7) rt_right = 0; if (rt_right < 0) rt_right = 7;
    }
}

function draw_num(v,x,y) {
    if (v < 0) v = -v;
    if (v > 9999) v = 9999;

    if (v >= 1000) {
        putc_oled(1,(v/1000)+48);
        putc_oled(2,((v/100)%10)+48);
        putc_oled(3,((v/10)%10)+48);
        putc_oled(4,(v%10)+48);
        puts_oled(x,y,OLED_FONT_MEDIUM,4,OLED_WHITE);
    } else if (v >= 100) {
        putc_oled(1,(v/100)+48);
        putc_oled(2,((v/10)%10)+48);
        putc_oled(3,(v%10)+48);
        puts_oled(x+6,y,OLED_FONT_MEDIUM,3,OLED_WHITE);
    } else if (v >= 10) {
        putc_oled(1,(v/10)+48);
        putc_oled(2,(v%10)+48);
        puts_oled(x+12,y,OLED_FONT_MEDIUM,2,OLED_WHITE);
    } else {
        putc_oled(1,v+48);
        puts_oled(x+18,y,OLED_FONT_MEDIUM,1,OLED_WHITE);
    }
}

