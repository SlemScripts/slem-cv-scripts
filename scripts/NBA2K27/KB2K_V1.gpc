function abs_diff(a,b) {
    if (a > b) return a - b;
    return b - a;
}

function limit_val(v,lo,hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

function current_ball_hand() {
    if (ball_hand != 0) return ball_hand;
    if (get_val(PS4_LX) < -35) return -1;
    if (get_val(PS4_LX) > 35) return 1;
    return last_side;
}

function opposite_hand() {
    if (current_ball_hand() < 0) return 1;
    return -1;
}

function classify_history_shot() {
    if (get_val(PS4_R2) > 80 &&
        rt_hold_ms >= RT_FADE_HOLD_MS &&
        (ls_strong_recent_ms > 0 || rs_up_recent_ms > 0 || combo_recent_ms > 0)) {
        return SHOT_FADE;
    }

    if (combo_recent_ms > 0) return SHOT_MOVE;

    if (rt_hold_ms >= RT_MOVE_HOLD_MS &&
        (ls_recent_ms > 0 || rs_recent_ms > 0)) {
        return SHOT_MOVE;
    }

    if (rt_recent_ms > 0 &&
        (ls_strong_recent_ms > 0 || rs_strong_recent_ms > 0)) {
        return SHOT_MOVE;
    }

    if (ls_strong_recent_ms > 0 && rs_recent_ms > 0) return SHOT_MOVE;
    if (rs_strong_recent_ms > 0 && ls_recent_ms > 0) return SHOT_MOVE;

    if (ls_recent_ms > 0 || rs_recent_ms > 0 || rt_recent_ms > 0 || post_move_light_ms > 0) {
        return SHOT_LIGHT;
    }

    return SHOT_STAND;
}

function classify_x_shot() {
    if (get_val(PS4_L1) > 30) return SHOT_GOTO;
    if (get_val(PS4_L2) > 20) return SHOT_NODIP;
    if (get_val(PS4_R2) > 80) return SHOT_FADE;

    return classify_history_shot();
}

function classify_r3_auto_shot() {
    return classify_history_shot();
}

function fatigue_hold_offset() {
    if (fatigue_load >= 70) return 7;
    if (fatigue_load >= 35) return 3;
    return 0;
}

function fatigue_tempo_offset() {
    if (fatigue_load >= 70) return 2;
    if (fatigue_load >= 35) return 1;
    return 0;
}

function effective_profile_hold(st) {
    return limit_val(profile_hold(st) + fatigue_hold_offset(),100,1500);
}

function effective_profile_tempo(st) {
    return limit_val(profile_tempo(st) + fatigue_tempo_offset(),10,120);
}

function profile_hold(st) {
    if (st == SHOT_STAND) return stand_hold;
    if (st == SHOT_LIGHT) return light_hold;
    if (st == SHOT_MOVE) return move_hold;
    if (st == SHOT_NODIP) return nodip_hold;
    if (st == SHOT_FADE) return fade_hold;
    return goto_hold;
}

function profile_tempo(st) {
    if (st == SHOT_STAND) return stand_tempo;
    if (st == SHOT_LIGHT) return light_tempo;
    if (st == SHOT_MOVE) return move_tempo;
    if (st == SHOT_NODIP) return nodip_tempo;
    if (st == SHOT_FADE) return fade_tempo;
    return goto_tempo;
}

function release_combo_active() {
    return combo_running(REL_NORMAL) ||
           combo_running(REL_FADE) ||
           combo_running(REL_GOTO);
}

function run_release(st) {
    effective_tempo_ms = effective_profile_tempo(st);
    last_tempo_ms = effective_tempo_ms;

    if (st == SHOT_FADE) combo_run(REL_FADE);
    else if (st == SHOT_GOTO) combo_run(REL_GOTO);
    else combo_run(REL_NORMAL);
}

function stop_release() {
    combo_stop(REL_NORMAL);
    combo_stop(REL_FADE);
    combo_stop(REL_GOTO);
    manual_release_active = 0;
}

function rhythm_x_engine() {
    if (!rhythm_x_enabled) return;

    if (!manual_shot_active && !manual_release_active && !release_combo_active() && event_press(PS4_SQUARE)) {
        active_shot_type = classify_x_shot();
        manual_hold_ms = 0;
        manual_rumble_fired = 0;
        manual_cue_hold = profile_hold(active_shot_type) - manual_rumble_lead_ms;
        manual_cue_hold = limit_val(manual_cue_hold,100,1500);
        manual_shot_active = 1;
    }

    if (manual_shot_active) {
        manual_hold_ms += get_rtime();
        set_val(PS4_SQUARE,0);

        if (active_shot_type == SHOT_FADE) set_val(PS4_RY,-100);
        else set_val(PS4_RY,100);

        if (manual_rumble_enabled && !manual_rumble_fired && manual_hold_ms >= manual_cue_hold) {
            manual_rumble_fired = 1;
            combo_run(RELEASE_RUMBLE);
        }

        if (event_release(PS4_SQUARE)) {
            record_shot_hold(active_shot_type,manual_hold_ms);
            manual_shot_active = 0;
            manual_release_active = 1;
            run_release(active_shot_type);
            home_draw();
        }
    }

    if (manual_release_active || release_combo_active()) set_val(PS4_SQUARE,0);

    if (manual_release_active && !release_combo_active()) {
        manual_release_active = 0;
        active_shot_type = 0;
    }
}

function queue_r3_auto(st) {
    auto_shot_pending_type = st;
    auto_shot_delay_ms = 0;

    if (st == SHOT_MOVE) auto_shot_delay_target = MOVE_AUTO_DELAY_MS;
    else if (st == SHOT_LIGHT) auto_shot_delay_target = LIGHT_AUTO_DELAY_MS;
    else auto_shot_delay_target = 0;

    if (auto_shot_delay_target <= 0) {
        auto_shot_pending = 0;
        fire_r3_auto(st);
    } else {
        auto_shot_pending = 1;
    }
}

function auto_shot_delay_engine() {
    if (!auto_shot_pending) return;

    auto_shot_delay_ms += get_rtime();

    if (auto_shot_delay_ms >= auto_shot_delay_target) {
        auto_shot_pending = 0;
        fire_r3_auto(auto_shot_pending_type);
    }
}

function fire_r3_auto(st) {
    rs_target_hold = effective_profile_hold(st);
    rs_target_tempo = effective_profile_tempo(st);

    record_shot_hold(st,rs_target_hold);
    last_tempo_ms = rs_target_tempo;
    home_draw();

    if (st == SHOT_FADE) combo_run(AUTO_FADE);
    else combo_run(AUTO_NORMAL);
}

function rs_auto_engine() {
    if (!auto_green_r3_enabled) {
        auto_shot_pending = 0;
        return;
    }

    if (auto_shot_pending) return;

    if (manual_shot_active || manual_release_active || release_combo_active() || dribble_combo_active() || rs_auto_combo_active()) {
        return;
    }

    if (event_press(PS4_R3)) {
        set_val(PS4_R3,0);
        queue_r3_auto(classify_r3_auto_shot());
    }

    if (get_val(PS4_R3)) set_val(PS4_R3,0);
}

function rs_auto_combo_active() {
    return combo_running(AUTO_NORMAL) ||
           combo_running(AUTO_FADE);
}

function shot_state_update() {
    if (abs(get_val(PS4_LX)) > 45 || abs(get_val(PS4_LY)) > 45) {
        ls_recent_ms = LS_RECENT_MS;
        ls_strong_recent_ms = LS_STRONG_MS;
    } else if (abs(get_val(PS4_LX)) > SMALL_MOVE_THRESHOLD || abs(get_val(PS4_LY)) > SMALL_MOVE_THRESHOLD) {
        ls_recent_ms = LS_RECENT_MS;
    }

    if (!manual_shot_active && !manual_release_active && !release_combo_active() && !rs_auto_combo_active()) {
        if (abs(get_val(PS4_RX)) > 55 || abs(get_val(PS4_RY)) > 55) {
            rs_recent_ms = RS_RECENT_MS;
            rs_strong_recent_ms = RS_STRONG_MS;
        } else if (abs(get_val(PS4_RX)) > 22 || abs(get_val(PS4_RY)) > 22) {
            rs_recent_ms = RS_RECENT_MS;
        }

        if (get_val(PS4_RY) < -55) {
            rs_up_recent_ms = RS_UP_MS;
        }
    }

    if (get_val(PS4_R2) > 35) {
        rt_recent_ms = RT_RECENT_MS;
        rt_hold_ms += get_rtime();
        if (rt_hold_ms > 3000) rt_hold_ms = 3000;
    } else {
        rt_hold_ms = 0;
    }
}

function workload_update() {
    if (ls_recent_ms > 0) {
        ls_recent_ms -= get_rtime();
        if (ls_recent_ms < 0) ls_recent_ms = 0;
    }

    if (ls_strong_recent_ms > 0) {
        ls_strong_recent_ms -= get_rtime();
        if (ls_strong_recent_ms < 0) ls_strong_recent_ms = 0;
    }

    if (rs_recent_ms > 0) {
        rs_recent_ms -= get_rtime();
        if (rs_recent_ms < 0) rs_recent_ms = 0;
    }

    if (rs_strong_recent_ms > 0) {
        rs_strong_recent_ms -= get_rtime();
        if (rs_strong_recent_ms < 0) rs_strong_recent_ms = 0;
    }

    if (rs_up_recent_ms > 0) {
        rs_up_recent_ms -= get_rtime();
        if (rs_up_recent_ms < 0) rs_up_recent_ms = 0;
    }

    if (rt_recent_ms > 0) {
        rt_recent_ms -= get_rtime();
        if (rt_recent_ms < 0) rt_recent_ms = 0;
    }

    if (combo_recent_ms > 0) {
        combo_recent_ms -= get_rtime();
        if (combo_recent_ms <= 0) {
            combo_recent_ms = 0;
            post_move_light_ms = POST_MOVE_LIGHT_MS;
        }
    } else if (post_move_light_ms > 0) {
        post_move_light_ms -= get_rtime();
        if (post_move_light_ms < 0) post_move_light_ms = 0;
    }

    fatigue_tick_ms += get_rtime();

    if (fatigue_tick_ms >= 100) {
        fatigue_tick_ms = 0;

        if (get_val(PS4_R2) > 35 || dribble_combo_active()) {
            fatigue_load += 2;
        } else if (abs(get_val(PS4_LX)) < SMALL_MOVE_THRESHOLD && abs(get_val(PS4_LY)) < SMALL_MOVE_THRESHOLD) {
            fatigue_load -= 3;
        } else {
            fatigue_load -= 1;
        }

        fatigue_load = limit_val(fatigue_load,0,100);
    }
}

function dribble_combo_active() {
    return (
        combo_running(N_BREAK) ||
        combo_running(N_CROSS_L) || combo_running(N_CROSS_R) ||
        combo_running(N_BTL_L) || combo_running(N_BTL_R) ||
        combo_running(N_BTB_L) || combo_running(N_BTB_R) ||
        combo_running(N_HESI_L) || combo_running(N_HESI_R) ||
        combo_running(N_INOUT_L) || combo_running(N_INOUT_R) ||
        combo_running(N_STEP) ||
        combo_running(N_SPIN_L) || combo_running(N_SPIN_R) ||
        combo_running(R_BREAK) ||
        combo_running(R_ATK_L) || combo_running(R_ATK_R) ||
        combo_running(R_HESI_L) || combo_running(R_HESI_R) ||
        combo_running(R_CROSS_L) || combo_running(R_CROSS_R) ||
        combo_running(R_BTB_L) || combo_running(R_BTB_R) ||
        combo_running(R_STEP_L) || combo_running(R_STEP_R) ||
        combo_running(R_MOVEBREAK_L) || combo_running(R_MOVEBREAK_R) ||
        combo_running(R_BURST_L) || combo_running(R_BURST_R)
    );
}

function stop_dribble_combos() {
    combo_stop(N_BREAK);
    combo_stop(N_CROSS_L); combo_stop(N_CROSS_R);
    combo_stop(N_BTL_L); combo_stop(N_BTL_R);
    combo_stop(N_BTB_L); combo_stop(N_BTB_R);
    combo_stop(N_HESI_L); combo_stop(N_HESI_R);
    combo_stop(N_INOUT_L); combo_stop(N_INOUT_R);
    combo_stop(N_STEP);
    combo_stop(N_SPIN_L); combo_stop(N_SPIN_R);
    combo_stop(R_BREAK);
    combo_stop(R_ATK_L); combo_stop(R_ATK_R);
    combo_stop(R_HESI_L); combo_stop(R_HESI_R);
    combo_stop(R_CROSS_L); combo_stop(R_CROSS_R);
    combo_stop(R_BTB_L); combo_stop(R_BTB_R);
    combo_stop(R_STEP_L); combo_stop(R_STEP_R);
    combo_stop(R_MOVEBREAK_L); combo_stop(R_MOVEBREAK_R);
    combo_stop(R_BURST_L); combo_stop(R_BURST_R);
}

function dribble_cancel_check() {
    if (!dribble_combo_active()) return;

    if (abs_diff(get_val(PS4_LX),dribble_ref_lx) > DRIBBLE_CANCEL_THRESHOLD ||
        abs_diff(get_val(PS4_LY),dribble_ref_ly) > DRIBBLE_CANCEL_THRESHOLD) {
        rt_loop_armed = 0;
        rt_loop_wait = 0;
        stop_dribble_combos();
    }
}

function rt_loop_held() {
    if (rt_loop_dir == 0 && raw_up > 50) return 1;
    if (rt_loop_dir == 1 && raw_down > 50) return 1;
    if (rt_loop_dir == 2 && raw_left > 50) return 1;
    if (rt_loop_dir == 3 && raw_right > 50) return 1;
    return 0;
}

function arm_rt_loop(dir,sel) {
    rt_loop_dir = dir;
    rt_loop_sel = sel;
    rt_loop_wait = 0;
    rt_loop_armed = 1;
}

function dribble_start(bank,sel) {
    dribble_ref_lx = get_val(PS4_LX);
    dribble_ref_ly = get_val(PS4_LY);

    if (bank == BANK_RT) {
        combo_recent_ms = COMBO_RECENT_MS;
        post_move_light_ms = 0;
        rt_recent_ms = RT_RECENT_MS;
    } else {
        rs_recent_ms = RS_RECENT_MS;
    }

    if (get_val(PS4_LX) < -30) last_side = -1;
    if (get_val(PS4_LX) > 30) last_side = 1;

    move_side = opposite_hand();

    if (bank == BANK_NORT) {
        if (sel == 0) combo_run(N_BREAK);

        if (sel == 1) {
            if (move_side < 0) combo_run(N_CROSS_L);
            else combo_run(N_CROSS_R);
            ball_hand = move_side;
        }

        if (sel == 2) {
            if (move_side < 0) combo_run(N_BTL_L);
            else combo_run(N_BTL_R);
            ball_hand = move_side;
        }

        if (sel == 3) {
            if (move_side < 0) combo_run(N_BTB_L);
            else combo_run(N_BTB_R);
            ball_hand = move_side;
        }

        if (sel == 4) {
            if (current_ball_hand() < 0) combo_run(N_HESI_L);
            else combo_run(N_HESI_R);
        }

        if (sel == 5) {
            if (current_ball_hand() < 0) combo_run(N_INOUT_L);
            else combo_run(N_INOUT_R);
        }

        if (sel == 6) combo_run(N_STEP);

        if (sel == 7) {
            if (current_ball_hand() < 0) combo_run(N_SPIN_L);
            else combo_run(N_SPIN_R);
            ball_hand = opposite_hand();
        }
    } else {

        if (sel == 0) combo_run(R_BREAK);

        if (sel == 1) {
            if (move_side < 0) combo_run(R_ATK_L);
            else combo_run(R_ATK_R);
        }

        if (sel == 2) {
            if (current_ball_hand() < 0) combo_run(R_HESI_L);
            else combo_run(R_HESI_R);
        }

        if (sel == 3) {
            if (move_side < 0) combo_run(R_CROSS_L);
            else combo_run(R_CROSS_R);
        }

        if (sel == 4) {
            if (move_side < 0) combo_run(R_BTB_L);
            else combo_run(R_BTB_R);
        }

        if (sel == 5) {
            if (move_side < 0) combo_run(R_STEP_L);
            else combo_run(R_STEP_R);
        }

        if (sel == 6) {
            if (current_ball_hand() < 0) combo_run(R_MOVEBREAK_L);
            else combo_run(R_MOVEBREAK_R);
        }

        if (sel == 7) {
            if (move_side < 0) combo_run(R_BURST_L);
            else combo_run(R_BURST_R);
        }
    }
}

function dribble_engine() {

    raw_up = get_val(PS4_UP);
    raw_down = get_val(PS4_DOWN);
    raw_left = get_val(PS4_LEFT);
    raw_right = get_val(PS4_RIGHT);

    set_val(PS4_UP,0);
    set_val(PS4_DOWN,0);
    set_val(PS4_LEFT,0);
    set_val(PS4_RIGHT,0);

    if (dribble_combo_active()) {

        if (get_val(PS4_R2) < 80 || !rt_loop_held()) rt_loop_armed = 0;
        dribble_cancel_check();
        return;
    }

    if (abs(get_val(PS4_RX)) > 30 || abs(get_val(PS4_RY)) > 30) {
        rt_loop_armed = 0;
        return;
    }

    if (rt_loop_armed) {
        if (get_val(PS4_R2) >= 80 && rt_loop_held()) {
            rt_loop_wait += get_rtime();
            if (rt_loop_wait >= RT_LOOP_PAUSE_MS) {
                rt_loop_wait = 0;
                dribble_start(BANK_RT,rt_loop_sel);
            }
            return;
        }
        rt_loop_armed = 0;
        rt_loop_wait = 0;
    }

    if (get_val(PS4_R2) >= 80) {
        if (event_press(PS4_UP)) {
            arm_rt_loop(0,rt_up);
            dribble_start(BANK_RT,rt_up);
        } else if (event_press(PS4_DOWN)) {
            arm_rt_loop(1,rt_down);
            dribble_start(BANK_RT,rt_down);
        } else if (event_press(PS4_LEFT)) {
            arm_rt_loop(2,rt_left);
            dribble_start(BANK_RT,rt_left);
        } else if (event_press(PS4_RIGHT)) {
            arm_rt_loop(3,rt_right);
            dribble_start(BANK_RT,rt_right);
        }
    } else {
        if (event_press(PS4_UP)) dribble_start(BANK_NORT,nort_up);
        else if (event_press(PS4_DOWN)) dribble_start(BANK_NORT,nort_down);
        else if (event_press(PS4_LEFT)) dribble_start(BANK_NORT,nort_left);
        else if (event_press(PS4_RIGHT)) dribble_start(BANK_NORT,nort_right);
    }
}

function shot_menu_from_index(idx) {
    if (idx == 7) return SHOT_STAND;
    if (idx == 8) return SHOT_LIGHT;
    if (idx == 9) return SHOT_MOVE;
    if (idx == 10) return SHOT_NODIP;
    if (idx == 11) return SHOT_FADE;
    return SHOT_GOTO;
}

function shot_index_from_type(st) {
    if (st == SHOT_STAND) return 7;
    if (st == SHOT_LIGHT) return 8;
    if (st == SHOT_MOVE) return 9;
    if (st == SHOT_NODIP) return 10;
    if (st == SHOT_FADE) return 11;
    return 12;
}

function draw_profile_name(p,x,y) {
    if (p == 0) print(x,y,OLED_FONT_SMALL,OLED_WHITE,P_REC[0]);
    if (p == 1) print(x,y,OLED_FONT_SMALL,OLED_WHITE,P_THEATER[0]);
    if (p == 2) print(x,y,OLED_FONT_SMALL,OLED_WHITE,P_CUSTOM[0]);
}

function save_active_profile() {
    if (active_profile == 0) {
        set_pvar(SPVAR_43,stand_hold);
        set_pvar(SPVAR_44,stand_tempo);
        set_pvar(SPVAR_45,light_hold);
        set_pvar(SPVAR_46,light_tempo);
        set_pvar(SPVAR_47,move_hold);
        set_pvar(SPVAR_48,move_tempo);
        set_pvar(SPVAR_49,fade_hold);
        set_pvar(SPVAR_50,fade_tempo);
    }

    if (active_profile == 1) {
        set_pvar(SPVAR_51,stand_hold);
        set_pvar(SPVAR_52,stand_tempo);
        set_pvar(SPVAR_53,light_hold);
        set_pvar(SPVAR_54,light_tempo);
        set_pvar(SPVAR_55,move_hold);
        set_pvar(SPVAR_56,move_tempo);
        set_pvar(SPVAR_57,fade_hold);
        set_pvar(SPVAR_58,fade_tempo);
    }

    if (active_profile == 2) {
        set_pvar(SPVAR_59,stand_hold);
        set_pvar(SPVAR_60,stand_tempo);
        set_pvar(SPVAR_61,light_hold);
        set_pvar(SPVAR_62,light_tempo);
        set_pvar(SPVAR_63,move_hold);
        set_pvar(SPVAR_64,move_tempo);
        set_pvar(SPVAR_4,fade_hold);
        set_pvar(SPVAR_5,fade_tempo);
    }
}

function load_profile(p) {
    if (p == 0) {
        stand_hold = get_pvar(SPVAR_43,100,1500,530);
        stand_tempo = get_pvar(SPVAR_44,10,120,52);
        light_hold = get_pvar(SPVAR_45,100,1500,545);
        light_tempo = get_pvar(SPVAR_46,10,120,53);
        move_hold = get_pvar(SPVAR_47,100,1500,555);
        move_tempo = get_pvar(SPVAR_48,10,120,54);
        fade_hold = get_pvar(SPVAR_49,100,1500,585);
        fade_tempo = get_pvar(SPVAR_50,10,120,56);
    }

    if (p == 1) {
        stand_hold = get_pvar(SPVAR_51,100,1500,530);
        stand_tempo = get_pvar(SPVAR_52,10,120,52);
        light_hold = get_pvar(SPVAR_53,100,1500,545);
        light_tempo = get_pvar(SPVAR_54,10,120,53);
        move_hold = get_pvar(SPVAR_55,100,1500,555);
        move_tempo = get_pvar(SPVAR_56,10,120,54);
        fade_hold = get_pvar(SPVAR_57,100,1500,585);
        fade_tempo = get_pvar(SPVAR_58,10,120,56);
    }

    if (p == 2) {
        stand_hold = get_pvar(SPVAR_59,100,1500,530);
        stand_tempo = get_pvar(SPVAR_60,10,120,52);
        light_hold = get_pvar(SPVAR_61,100,1500,545);
        light_tempo = get_pvar(SPVAR_62,10,120,53);
        move_hold = get_pvar(SPVAR_63,100,1500,555);
        move_tempo = get_pvar(SPVAR_64,10,120,54);
        fade_hold = get_pvar(SPVAR_4,100,1500,585);
        fade_tempo = get_pvar(SPVAR_5,10,120,56);
    }

    recent_set_hold = stand_hold;
    recent_light_hold = light_hold;
    recent_move_hold = move_hold;
    recent_fade_hold = fade_hold;
}

function activate_profile(p) {
    if (p < 0) p = 2;
    if (p > 2) p = 0;

    save_active_profile();
    active_profile = p;
    profile_select = p;
    load_profile(active_profile);
    set_pvar(SPVAR_17,active_profile);
}

function initialize_profiles() {
    set_pvar(SPVAR_43,stand_hold);
    set_pvar(SPVAR_44,stand_tempo);
    set_pvar(SPVAR_45,light_hold);
    set_pvar(SPVAR_46,light_tempo);
