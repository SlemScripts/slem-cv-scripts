function record_shot_hold(st,h) {
    last_shot_type = st;
    last_hold_ms = h;

    if (st == SHOT_STAND) recent_set_hold = h;
    if (st == SHOT_LIGHT) recent_light_hold = h;
    if (st == SHOT_MOVE) recent_move_hold = h;
    if (st == SHOT_FADE) recent_fade_hold = h;
}

function draw_last_shot_type(x,y) {
    if (last_shot_type == SHOT_STAND) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_SETTXT[0]);
    else if (last_shot_type == SHOT_LIGHT) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_LIGHTTXT[0]);
    else if (last_shot_type == SHOT_MOVE) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_MOVETXT[0]);
    else if (last_shot_type == SHOT_NODIP) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_NODIPTXT[0]);
    else if (last_shot_type == SHOT_FADE) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_FADETXT[0]);
    else if (last_shot_type == SHOT_GOTO) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_GOTOTXT[0]);
    else print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_LAST[0]);
}

function draw_last_shot_short(x,y) {
    if (last_shot_type == SHOT_STAND) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_SSHORT[0]);
    else if (last_shot_type == SHOT_LIGHT) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_LSHORT[0]);
    else if (last_shot_type == SHOT_MOVE) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_MSHORT[0]);
    else if (last_shot_type == SHOT_FADE) print(x,y,OLED_FONT_SMALL,OLED_WHITE,T_FSHORT[0]);
    else draw_last_shot_type(x,y);
}

function intro_draw() {
    cls_oled(OLED_BLACK);

    if (intro_elapsed < 1350) {
        print(intro_x,intro_y,OLED_FONT_MEDIUM,OLED_WHITE,T_INTRO_KB2K[0]);
        print(intro_x+20,intro_y+18,OLED_FONT_SMALL,OLED_WHITE,T_VERSION[0]);
        return;
    }

    if (intro_elapsed < 1650) {
        print(40,18,OLED_FONT_MEDIUM,OLED_WHITE,T_INTRO_KB2K[0]);
        print(57,42,OLED_FONT_SMALL,OLED_WHITE,T_VERSION[0]);
        return;
    }

    print(40,18,OLED_FONT_MEDIUM,OLED_WHITE,T_INTRO_KB2K[0]);
    print(57,42,OLED_FONT_SMALL,OLED_WHITE,T_VERSION[0]);
}

function intro_engine() {
    intro_elapsed += get_rtime();
    intro_frame_ms += get_rtime();

    if (intro_elapsed < 1350 && intro_frame_ms >= 70) {
        intro_frame_ms = 0;

        intro_x += intro_dx;
        intro_y += intro_dy;

        if (intro_x >= 84) {
            intro_x = 84;
            intro_dx = -5;
        }
        if (intro_x <= 2) {
            intro_x = 2;
            intro_dx = 5;
        }

        if (intro_y >= 38) {
            intro_y = 38;
            intro_dy = -3;
        }
        if (intro_y <= 2) {
            intro_y = 2;
            intro_dy = 3;
        }

        intro_draw();
    }

    if (intro_elapsed >= 1900) {
        intro_active = 0;
        home_draw();
    }
}

function home_draw() {
    cls_oled(OLED_BLACK);

    if (shot_feedback_enabled) {

        print(29,1,OLED_FONT_SMALL,OLED_WHITE,T_FEEDBACK[0]);

        print(4,17,OLED_FONT_SMALL,OLED_WHITE,T_SSHORT[0]);
        draw_num(recent_set_hold,13,11);

        print(67,17,OLED_FONT_SMALL,OLED_WHITE,T_LSHORT[0]);
        draw_num(recent_light_hold,76,11);

        print(4,38,OLED_FONT_SMALL,OLED_WHITE,T_MSHORT[0]);
        draw_num(recent_move_hold,13,32);

        print(67,38,OLED_FONT_SMALL,OLED_WHITE,T_FSHORT[0]);
        draw_num(recent_fade_hold,76,32);

        print(28,56,OLED_FONT_SMALL,OLED_WHITE,T_LAST[0]);
        draw_last_shot_short(70,56);
        return;
    }

    print(22,1,OLED_FONT_SMALL,OLED_WHITE,T_TITLE[0]);
    draw_profile_name(active_profile,88,1);

    print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_XRHYTHM[0]);
    if (rhythm_x_enabled) print(82,15,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
    else print(82,15,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);

    print(5,27,OLED_FONT_SMALL,OLED_WHITE,T_RSAUTO[0]);
    if (auto_green_r3_enabled) print(82,27,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
    else print(82,27,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);

    print(5,39,OLED_FONT_SMALL,OLED_WHITE,T_LASTHOLD[0]);
    draw_last_shot_type(72,39);

    draw_num(last_hold_ms,6,47);
    print(51,52,OLED_FONT_SMALL,OLED_WHITE,T_MS[0]);

    print(76,52,OLED_FONT_SMALL,OLED_WHITE,T_TEMPO[0]);
    draw_num(last_tempo_ms,103,47);
}

function menu_draw() {
    cls_oled(OLED_BLACK);
    print(22,1,OLED_FONT_SMALL,OLED_WHITE,T_TITLE[0]);

    if (menu_state == MENU_MAIN) {
        if (menu_index == 0) print(4,12,OLED_FONT_SMALL,OLED_WHITE,T_SHOOT[0]);
        if (menu_index == 1) print(4,27,OLED_FONT_SMALL,OLED_WHITE,T_PROFILES[0]);
        if (menu_index == 2) print(4,42,OLED_FONT_SMALL,OLED_WHITE,T_DRIB[0]);
        if (menu_index == 3) print(4,57,OLED_FONT_SMALL,OLED_WHITE,T_REMAP[0]);
        return;
    }

    if (menu_state == MENU_SHOOT) {
        if (menu_index == 0) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_XRHYTHM[0]);
            if (rhythm_x_enabled) print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
            else print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);
        } else if (menu_index == 1) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_RSAUTO[0]);
            if (auto_green_r3_enabled) print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
            else print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);
        } else if (menu_index == 2) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_SHOTFEED[0]);
            if (shot_feedback_enabled) print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
            else print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);
        } else if (menu_index == 3) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_RELRUMBLE[0]);
            if (manual_rumble_enabled) print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
            else print(90,16,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);
        } else if (menu_index == 4) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_VIBELEAD[0]);
            draw_num(manual_rumble_lead_ms,70,12);
            print(102,18,OLED_FONT_SMALL,OLED_WHITE,T_MS[0]);
        } else if (menu_index == 5) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_VIBELEN[0]);
            draw_num(manual_rumble_length_ms,70,12);
            print(102,18,OLED_FONT_SMALL,OLED_WHITE,T_MS[0]);
        } else if (menu_index == 6) {
            print(5,16,OLED_FONT_SMALL,OLED_WHITE,T_VIBESTR[0]);
            draw_num(manual_rumble_strength,74,12);
        } else {
            draw_shot_name(shot_menu_from_index(menu_index),16);
            print(42,44,OLED_FONT_SMALL,OLED_WHITE,T_EDIT[0]);
        }
        print(42,56,OLED_FONT_SMALL,OLED_WHITE,T_BACK[0]);
        return;
    }

    if (menu_state == MENU_SHOT_EDIT) {
        draw_shot_name(shot_menu_type,8);
        if (shot_field == 0) print(42,24,OLED_FONT_SMALL,OLED_WHITE,T_HOLD[0]);
        if (shot_field == 1) print(44,24,OLED_FONT_SMALL,OLED_WHITE,T_TEMPO[0]);
        if (shot_menu_type == SHOT_GOTO && shot_field == 2) print(45,24,OLED_FONT_SMALL,OLED_WHITE,T_EXTRA[0]);
        draw_num(selected_shot_value(),44,34);
        print(88,39,OLED_FONT_SMALL,OLED_WHITE,T_MS[0]);
        print(42,56,OLED_FONT_SMALL,OLED_WHITE,T_BACK[0]);
        return;
    }

    if (menu_state == MENU_DRIB) {
        if (menu_index == 0) {
            print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_DRIB[0]);
            if (dribbles_enabled) print(90,15,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
            else print(90,15,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);
        } else if (menu_index == 1) {
            print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_BANK[0]);
            if (drib_menu_bank == BANK_NORT) print(65,15,OLED_FONT_SMALL,OLED_WHITE,T_NORT[0]);
            else print(65,15,OLED_FONT_SMALL,OLED_WHITE,T_RT[0]);
        } else {
            if (menu_index == 2) print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_UP[0]);
            if (menu_index == 3) print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_DOWN[0]);
            if (menu_index == 4) print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_LEFT[0]);
            if (menu_index == 5) print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_RIGHT[0]);

            drib_menu_dir = menu_index - 2;
            if (drib_menu_bank == BANK_NORT) draw_nort_name(selected_dribble(),33);
            else draw_rt_name(selected_dribble(),33);
            print(42,50,OLED_FONT_SMALL,OLED_WHITE,T_EDIT[0]);
        }
        print(42,58,OLED_FONT_SMALL,OLED_WHITE,T_BACK[0]);
        return;
    }

    if (menu_state == MENU_DRIB_EDIT) {
        if (drib_menu_bank == BANK_NORT) print(39,8,OLED_FONT_SMALL,OLED_WHITE,T_NORT[0]);
        else print(39,8,OLED_FONT_SMALL,OLED_WHITE,T_RT[0]);

        if (drib_menu_dir == 0) print(51,20,OLED_FONT_SMALL,OLED_WHITE,T_UP[0]);
        if (drib_menu_dir == 1) print(46,20,OLED_FONT_SMALL,OLED_WHITE,T_DOWN[0]);
        if (drib_menu_dir == 2) print(46,20,OLED_FONT_SMALL,OLED_WHITE,T_LEFT[0]);
        if (drib_menu_dir == 3) print(43,20,OLED_FONT_SMALL,OLED_WHITE,T_RIGHT[0]);

        if (drib_menu_bank == BANK_NORT) draw_nort_name(selected_dribble(),36);
        else draw_rt_name(selected_dribble(),36);
        print(42,56,OLED_FONT_SMALL,OLED_WHITE,T_BACK[0]);
        return;
    }

    if (menu_state == MENU_PROFILE) {
        print(5,15,OLED_FONT_SMALL,OLED_WHITE,T_ACTIVE[0]);
        draw_profile_name(active_profile,67,15);

        print(5,32,OLED_FONT_SMALL,OLED_WHITE,T_PROFILES[0]);
        draw_profile_name(profile_select,67,32);

        print(42,50,OLED_FONT_SMALL,OLED_WHITE,T_LOAD[0]);
        print(42,60,OLED_FONT_SMALL,OLED_WHITE,T_BACK[0]);
        return;
    }

    if (menu_state == MENU_REMAP) {
        print(8,22,OLED_FONT_SMALL,OLED_WHITE,T_REMAP[0]);
        if (x_remap_l3) print(87,22,OLED_FONT_SMALL,OLED_WHITE,T_ON[0]);
        else print(87,22,OLED_FONT_SMALL,OLED_WHITE,T_OFF[0]);
        print(42,56,OLED_FONT_SMALL,OLED_WHITE,T_BACK[0]);
    }
}

function menu_update() {
    if (get_val(PS4_R1) > 50) step = 10;
    else step = 1;

    if (event_press(PS4_CIRCLE)) {
        if (menu_state == MENU_MAIN) {
            save_settings();
            menu_state = MENU_CLOSED;
            home_draw();
        } else if (menu_state == MENU_SHOT_EDIT) {
            menu_state = MENU_SHOOT;
            menu_index = shot_index_from_type(shot_menu_type);
            shot_field = 0;
        } else if (menu_state == MENU_DRIB_EDIT) {
            menu_state = MENU_DRIB;
            menu_index = drib_menu_dir + 2;
        } else {
            menu_state = MENU_MAIN;
            menu_index = 0;
        }
        return;
    }

    if (menu_state == MENU_MAIN) {
        if (event_press(PS4_UP)) { menu_index--; if (menu_index < 0) menu_index = 3; }
        if (event_press(PS4_DOWN)) { menu_index++; if (menu_index > 3) menu_index = 0; }

        if (event_press(PS4_CROSS)) {
            if (menu_index == 0) { menu_state = MENU_SHOOT; menu_index = 0; }
            if (menu_index == 1) {
                menu_state = MENU_PROFILE;
                menu_index = 0;
                profile_select = active_profile;
            }
            if (menu_index == 2) { menu_state = MENU_DRIB; menu_index = 0; }
            if (menu_index == 3) { menu_state = MENU_REMAP; menu_index = 0; }
        }
        return;
    }

    if (menu_state == MENU_SHOOT) {
        if (event_press(PS4_UP)) { menu_index--; if (menu_index < 0) menu_index = 12; }
        if (event_press(PS4_DOWN)) { menu_index++; if (menu_index > 12) menu_index = 0; }

        if (event_press(PS4_CROSS)) {
            if (menu_index == 0) rhythm_x_enabled = !rhythm_x_enabled;
            if (menu_index == 1) auto_green_r3_enabled = !auto_green_r3_enabled;
            if (menu_index == 2) shot_feedback_enabled = !shot_feedback_enabled;
            if (menu_index == 3) manual_rumble_enabled = !manual_rumble_enabled;

            if (menu_index >= 7) {
                shot_menu_type = shot_menu_from_index(menu_index);
                shot_field = 0;
                menu_state = MENU_SHOT_EDIT;
            }
        }

        if (event_press(PS4_LEFT)) {
            if (menu_index == 4) manual_rumble_lead_ms = limit_val(manual_rumble_lead_ms - step, 0, 100);
            if (menu_index == 5) manual_rumble_length_ms = limit_val(manual_rumble_length_ms - step, 20, 200);
            if (menu_index == 6) manual_rumble_strength = limit_val(manual_rumble_strength - step, 10, 100);
        }
        if (event_press(PS4_RIGHT)) {
            if (menu_index == 4) manual_rumble_lead_ms = limit_val(manual_rumble_lead_ms + step, 0, 100);
            if (menu_index == 5) manual_rumble_length_ms = limit_val(manual_rumble_length_ms + step, 20, 200);
            if (menu_index == 6) manual_rumble_strength = limit_val(manual_rumble_strength + step, 10, 100);
        }

        return;
    }

    if (menu_state == MENU_SHOT_EDIT) {
        if (event_press(PS4_UP)) {
            shot_field--;
            if (shot_field < 0) {
                if (shot_menu_type == SHOT_GOTO) shot_field = 2;
                else shot_field = 1;
            }
        }
        if (event_press(PS4_DOWN)) {
            shot_field++;
            if (shot_menu_type == SHOT_GOTO) {
                if (shot_field > 2) shot_field = 0;
            } else {
                if (shot_field > 1) shot_field = 0;
            }
        }
        if (event_press(PS4_LEFT)) adjust_shot(-step);
        if (event_press(PS4_RIGHT)) adjust_shot(step);
        return;
    }

    if (menu_state == MENU_DRIB) {
        if (event_press(PS4_UP)) { menu_index--; if (menu_index < 0) menu_index = 5; }
        if (event_press(PS4_DOWN)) { menu_index++; if (menu_index > 5) menu_index = 0; }

        if (event_press(PS4_CROSS)) {
            if (menu_index == 0) dribbles_enabled = !dribbles_enabled;
            if (menu_index == 1) drib_menu_bank = !drib_menu_bank;
            if (menu_index >= 2) {
                drib_menu_dir = menu_index - 2;
                menu_state = MENU_DRIB_EDIT;
            }
        }
        return;
    }

    if (menu_state == MENU_DRIB_EDIT) {
        if (event_press(PS4_LEFT)) adjust_dribble(-1);
        if (event_press(PS4_RIGHT)) adjust_dribble(1);
        return;
    }

    if (menu_state == MENU_PROFILE) {
        if (event_press(PS4_LEFT)) {
            profile_select--;
            if (profile_select < 0) profile_select = 2;
        }
        if (event_press(PS4_RIGHT)) {
            profile_select++;
            if (profile_select > 2) profile_select = 0;
        }
        if (event_press(PS4_CROSS)) {
            activate_profile(profile_select);
            menu_draw();
        }
        return;
    }

    if (menu_state == MENU_REMAP) {
        if (event_press(PS4_CROSS)) x_remap_l3 = !x_remap_l3;
    }
}

function menu_block() {
    set_val(PS4_L2,0); set_val(PS4_R2,0);
    set_val(PS4_L1,0); set_val(PS4_R1,0);
    set_val(PS4_OPTIONS,0);
    set_val(PS4_UP,0); set_val(PS4_DOWN,0);
    set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0);
    set_val(PS4_CROSS,0); set_val(PS4_CIRCLE,0);
    set_val(PS4_SQUARE,0); set_val(PS4_TRIANGLE,0);
    set_val(PS4_LX,0); set_val(PS4_LY,0);
    set_val(PS4_RX,0); set_val(PS4_RY,0);
    set_val(PS4_L3,0); set_val(PS4_R3,0);
}

function reset_defaults() {
    rhythm_x_enabled = 1;
    auto_green_r3_enabled = 0;
    shot_feedback_enabled = 0;
    manual_rumble_enabled = 1;
    manual_rumble_lead_ms = 25;
    manual_rumble_length_ms = 90;
    manual_rumble_strength = 100;

    stand_hold = 530;
    stand_tempo = 52;
    light_hold = 545;
    light_tempo = 53;
    move_hold = 555;
    move_tempo = 54;
    nodip_hold = 570;
    nodip_tempo = 54;
    fade_hold = 585;
    fade_tempo = 56;
    goto_hold = 700;
    goto_tempo = 52;
    goto_extra = 0;

    dribbles_enabled = 1;
    nort_up = 0;
    nort_down = 6;
    nort_left = 1;
    nort_right = 3;

    rt_up = 0;
    rt_down = 5;
    rt_left = 3;
    rt_right = 4;

    x_remap_l3 = 1;
    recent_set_hold = stand_hold;
    recent_light_hold = light_hold;
    recent_move_hold = move_hold;
    recent_fade_hold = fade_hold;
}

function load_settings() {
    if (get_pvar(SPVAR_31,0,32767,0) != CONFIG_MAGIC) {
        reset_defaults();
        initialize_profiles();
        save_settings();
        return;
    }

    rhythm_x_enabled = get_pvar(SPVAR_2,0,1,1);
    auto_green_r3_enabled = get_pvar(SPVAR_3,0,1,0);
    nodip_hold = get_pvar(SPVAR_9,100,1500,570);
    nodip_tempo = get_pvar(SPVAR_10,10,120,54);
    goto_hold = get_pvar(SPVAR_13,100,2000,700);
    goto_tempo = get_pvar(SPVAR_14,10,120,52);
    goto_extra = get_pvar(SPVAR_15,0,1200,0);

    dribbles_enabled = get_pvar(SPVAR_21,0,1,1);
    nort_up = get_pvar(SPVAR_22,0,7,0);
    nort_down = get_pvar(SPVAR_23,0,7,6);
    nort_left = get_pvar(SPVAR_24,0,7,1);
    nort_right = get_pvar(SPVAR_25,0,7,3);

    rt_up = get_pvar(SPVAR_26,0,7,0);
    rt_down = get_pvar(SPVAR_27,0,7,5);
    rt_left = get_pvar(SPVAR_28,0,7,3);
    rt_right = get_pvar(SPVAR_29,0,7,4);

    x_remap_l3 = get_pvar(SPVAR_30,0,1,1);
    shot_feedback_enabled = get_pvar(SPVAR_34,0,1,0);
    manual_rumble_enabled = get_pvar(SPVAR_35,0,1,1);
    manual_rumble_lead_ms = get_pvar(SPVAR_40,0,100,25);
    manual_rumble_length_ms = get_pvar(SPVAR_41,20,200,90);
    manual_rumble_strength = get_pvar(SPVAR_42,10,100,100);

    active_profile = get_pvar(SPVAR_17,0,2,0);
    profile_select = active_profile;
    load_profile(active_profile);
}

function save_settings() {
    save_active_profile();
    set_pvar(SPVAR_17,active_profile);
    set_pvar(SPVAR_2,rhythm_x_enabled);
    set_pvar(SPVAR_3,auto_green_r3_enabled);
    set_pvar(SPVAR_9,nodip_hold);
    set_pvar(SPVAR_10,nodip_tempo);
    set_pvar(SPVAR_13,goto_hold);
    set_pvar(SPVAR_14,goto_tempo);
    set_pvar(SPVAR_15,goto_extra);

    set_pvar(SPVAR_21,dribbles_enabled);
    set_pvar(SPVAR_22,nort_up);
    set_pvar(SPVAR_23,nort_down);
    set_pvar(SPVAR_24,nort_left);
    set_pvar(SPVAR_25,nort_right);

    set_pvar(SPVAR_26,rt_up);
    set_pvar(SPVAR_27,rt_down);
    set_pvar(SPVAR_28,rt_left);
    set_pvar(SPVAR_29,rt_right);

    set_pvar(SPVAR_30,x_remap_l3);
    set_pvar(SPVAR_31,CONFIG_MAGIC);
    set_pvar(SPVAR_34,shot_feedback_enabled);
    set_pvar(SPVAR_35,manual_rumble_enabled);
    set_pvar(SPVAR_40,manual_rumble_lead_ms);
    set_pvar(SPVAR_41,manual_rumble_length_ms);
    set_pvar(SPVAR_42,manual_rumble_strength);
}

init {
    load_settings();
    intro_active = 1;
    intro_elapsed = 0;
    intro_frame_ms = 0;
    intro_x = 8;
    intro_y = 8;
    intro_dx = 5;
    intro_dy = 3;
    intro_draw();
}

main {
    if (intro_active) {
        if (get_val(PS4_L2) > 50 && event_press(PS4_OPTIONS)) {
            intro_active = 0;
            menu_state = MENU_MAIN;
            menu_index = 0;
            menu_draw();
        } else {
            intro_engine();
        }
    } else if (get_val(PS4_L2) > 50 && event_press(PS4_OPTIONS)) {
        if (menu_state == MENU_CLOSED) {
            stop_release();
            stop_dribble_combos();
            manual_shot_active = 0;
            menu_state = MENU_MAIN;
            menu_index = 0;
        } else {
            save_settings();
            menu_state = MENU_CLOSED;
            home_draw();
        }
    }

    if (!intro_active) {
        if (menu_state != MENU_CLOSED) {
            menu_update();
            menu_block();
            menu_draw();
        } else {
            shot_state_update();
        workload_update();

        if (x_remap_l3 && get_val(PS4_L3)) {
            set_val(PS4_L3,0);
            set_val(PS4_SQUARE,100);
        }
        rhythm_x_engine();
        auto_shot_delay_engine();
        rs_auto_engine();

        if (dribbles_enabled && !auto_shot_pending && !manual_shot_active && !manual_release_active && !release_combo_active() && !rs_auto_combo_active()) {
            dribble_engine();
        }
        }
    }
}

combo RELEASE_RUMBLE {
    set_rumble(RUMBLE_A,manual_rumble_strength);
    set_rumble(RUMBLE_B,manual_rumble_strength);
    wait(manual_rumble_length_ms);
    set_rumble(RUMBLE_A,0);
    set_rumble(RUMBLE_B,0);
}

combo REL_NORMAL {
    set_val(PS4_SQUARE,0);
    set_val(PS4_RY,-50);
    set_val(PS4_RX,20);
    wait(effective_tempo_ms);
    set_val(PS4_RY,-100);
    set_val(PS4_RX,25);
    wait(300);
    set_val(PS4_RY,0);
    set_val(PS4_RX,0);
}

combo REL_FADE {
    set_val(PS4_SQUARE,0);
    set_val(PS4_RY,50);
    set_val(PS4_RX,-20);
    wait(effective_tempo_ms);
    set_val(PS4_RY,100);
    set_val(PS4_RX,-25);
    wait(300);
    set_val(PS4_RY,0);
    set_val(PS4_RX,0);
}

combo REL_GOTO {
    set_val(PS4_SQUARE,0);
    set_val(PS4_RY,100);
    set_val(PS4_RX,0);
    wait(goto_extra);
    set_val(PS4_RY,-50);
    set_val(PS4_RX,20);
    wait(effective_tempo_ms);
    set_val(PS4_RY,-100);
    set_val(PS4_RX,25);
    wait(300);
    set_val(PS4_RY,0);
    set_val(PS4_RX,0);
}

combo AUTO_NORMAL {
    set_val(PS4_R3,0);
    set_val(PS4_RY,100);
    set_val(PS4_RX,0);
    wait(rs_target_hold);
    set_val(PS4_RY,-50);
    set_val(PS4_RX,20);
    wait(rs_target_tempo);
    set_val(PS4_RY,-100);
    set_val(PS4_RX,25);
    wait(300);
    set_val(PS4_RY,0);
    set_val(PS4_RX,0);
}

combo AUTO_FADE {
    set_val(PS4_R3,0);
    set_val(PS4_RY,-100);
    set_val(PS4_RX,0);
    wait(rs_target_hold);
    set_val(PS4_RY,50);
    set_val(PS4_RX,-20);
    wait(rs_target_tempo);
    set_val(PS4_RY,100);
    set_val(PS4_RX,-25);
    wait(300);
    set_val(PS4_RY,0);
    set_val(PS4_RX,0);
}

combo N_BREAK {
    set_val(PS4_R2,0);
    set_val(PS4_RX,0); set_val(PS4_RY,-100); wait(42);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(35);
}

combo N_CROSS_L {
    set_val(PS4_R2,0);
    set_val(PS4_RX,-72); set_val(PS4_RY,-72); wait(42);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(38);
}
combo N_CROSS_R {
    set_val(PS4_R2,0);
    set_val(PS4_RX,72); set_val(PS4_RY,-72); wait(42);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(38);
}

combo N_BTL_L {
    set_val(PS4_R2,0);
    set_val(PS4_RX,-100); set_val(PS4_RY,0); wait(38);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(36);
}
combo N_BTL_R {
    set_val(PS4_R2,0);
    set_val(PS4_RX,100); set_val(PS4_RY,0); wait(38);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(36);
}

combo N_BTB_L {
    set_val(PS4_R2,0);
    set_val(PS4_RX,-72); set_val(PS4_RY,72); wait(45);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(42);
}
combo N_BTB_R {
    set_val(PS4_R2,0);
    set_val(PS4_RX,72); set_val(PS4_RY,72); wait(45);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(42);
}

combo N_HESI_L {
    set_val(PS4_R2,0);
    set_val(PS4_RX,-100); set_val(PS4_RY,0); wait(40);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(38);
}
combo N_HESI_R {
    set_val(PS4_R2,0);
    set_val(PS4_RX,100); set_val(PS4_RY,0); wait(40);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(38);
}

combo N_INOUT_L {
    set_val(PS4_R2,0);
    set_val(PS4_RX,-72); set_val(PS4_RY,-72); wait(44);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(40);
}
combo N_INOUT_R {
    set_val(PS4_R2,0);
    set_val(PS4_RX,72); set_val(PS4_RY,-72); wait(44);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(40);
}

combo N_STEP {
    set_val(PS4_R2,0);
    set_val(PS4_RX,0); set_val(PS4_RY,100); wait(45);
    set_val(PS4_RX,0); set_val(PS4_RY,0); wait(42);
}

combo N_SPIN_L {
    set_val(PS4_R2,0);
    set_val(PS4_RX,-100); set_val(PS4_RY,0); wait(22);
