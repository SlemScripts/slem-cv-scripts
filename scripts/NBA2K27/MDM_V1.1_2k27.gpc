function draw_spinning_basketball(x, y) {
    // Filled circular silhouette with smoother pixel-rounded edges.
    rect_oled(x,      y - 15, 1,  1, 1, OLED_WHITE);
    rect_oled(x - 5,  y - 14, 11, 1, 1, OLED_WHITE);
    rect_oled(x - 7,  y - 13, 15, 1, 1, OLED_WHITE);
    rect_oled(x - 9,  y - 12, 19, 1, 1, OLED_WHITE);
    rect_oled(x - 10, y - 11, 21, 1, 1, OLED_WHITE);
    rect_oled(x - 11, y - 10, 23, 1, 1, OLED_WHITE);
    rect_oled(x - 12, y - 9,  25, 2, 1, OLED_WHITE);
    rect_oled(x - 13, y - 7,  27, 2, 1, OLED_WHITE);
    rect_oled(x - 14, y - 5,  29, 2, 1, OLED_WHITE);
    rect_oled(x - 15, y - 3,  31, 7, 1, OLED_WHITE);
    rect_oled(x - 14, y + 4,  29, 2, 1, OLED_WHITE);
    rect_oled(x - 13, y + 6,  27, 2, 1, OLED_WHITE);
    rect_oled(x - 12, y + 8,  25, 2, 1, OLED_WHITE);
    rect_oled(x - 11, y + 10, 23, 1, 1, OLED_WHITE);
    rect_oled(x - 10, y + 11, 21, 1, 1, OLED_WHITE);
    rect_oled(x - 9,  y + 12, 19, 1, 1, OLED_WHITE);
    rect_oled(x - 7,  y + 13, 15, 1, 1, OLED_WHITE);
    rect_oled(x - 5,  y + 14, 11, 1, 1, OLED_WHITE);
    rect_oled(x,      y + 15, 1,  1, 1, OLED_WHITE);

    // Classic basketball panel seams cut into the bright ball.
    line_oled(x - 15, y,     x - 8, y - 3, 1, OLED_BLACK);
    line_oled(x - 8,  y - 3, x,     y - 4, 1, OLED_BLACK);
    line_oled(x,      y - 4, x + 8, y - 3, 1, OLED_BLACK);
    line_oled(x + 8,  y - 3, x + 15,y,     1, OLED_BLACK);
    line_oled(x - 11, y - 11, x - 6, y - 6, 1, OLED_BLACK);
    line_oled(x - 6,  y - 6,  x,     y,     1, OLED_BLACK);
    line_oled(x,      y,      x + 6, y + 6, 1, OLED_BLACK);
    line_oled(x + 6,  y + 6,  x + 11,y + 11,1, OLED_BLACK);

    // Moving curved seam creates a smoother left-to-right spin.
    if (ball_spin_frame == 0) {
        line_oled(x, y - 15, x - 8,  y - 8, 1, OLED_BLACK);
        line_oled(x - 8, y - 8, x - 12, y, 1, OLED_BLACK);
        line_oled(x - 12, y, x - 8, y + 8, 1, OLED_BLACK);
        line_oled(x - 8, y + 8, x, y + 15, 1, OLED_BLACK);
    } else if (ball_spin_frame == 1) {
        line_oled(x, y - 15, x - 5, y - 8, 1, OLED_BLACK);
        line_oled(x - 5, y - 8, x - 7, y, 1, OLED_BLACK);
        line_oled(x - 7, y, x - 5, y + 8, 1, OLED_BLACK);
        line_oled(x - 5, y + 8, x, y + 15, 1, OLED_BLACK);
    } else if (ball_spin_frame == 2 || ball_spin_frame == 5) {
        line_oled(x, y - 15, x, y + 15, 1, OLED_BLACK);
    } else if (ball_spin_frame == 3) {
        line_oled(x, y - 15, x + 5, y - 8, 1, OLED_BLACK);
        line_oled(x + 5, y - 8, x + 7, y, 1, OLED_BLACK);
        line_oled(x + 7, y, x + 5, y + 8, 1, OLED_BLACK);
        line_oled(x + 5, y + 8, x, y + 15, 1, OLED_BLACK);
    } else {
        line_oled(x, y - 15, x + 8,  y - 8, 1, OLED_BLACK);
        line_oled(x + 8, y - 8, x + 12, y, 1, OLED_BLACK);
        line_oled(x + 12, y, x + 8, y + 8, 1, OLED_BLACK);
        line_oled(x + 8, y + 8, x, y + 15, 1, OLED_BLACK);
    }

    // Pebbled texture and a darker lower-right edge add depth.
    rect_oled(x - 8, y - 9, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 2, y - 10, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 8, y - 6, 1, 1, 1, OLED_BLACK);
    rect_oled(x - 10, y + 5, 1, 1, 1, OLED_BLACK);
    rect_oled(x - 3, y + 9, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 5, y + 8, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 11, y + 4, 2, 1, 1, OLED_BLACK);
    rect_oled(x + 10, y + 7, 2, 1, 1, OLED_BLACK);
    rect_oled(x + 8,  y + 10, 2, 1, 1, OLED_BLACK);
}

function draw_realistic_basketball(x, y) {
    // High-detail 41x41 basketball silhouette.
    rect_oled(x,      y - 20, 1,  1, 1, OLED_WHITE);
    rect_oled(x - 6,  y - 19, 13, 1, 1, OLED_WHITE);
    rect_oled(x - 8,  y - 18, 17, 1, 1, OLED_WHITE);
    rect_oled(x - 10, y - 17, 21, 1, 1, OLED_WHITE);
    rect_oled(x - 12, y - 16, 25, 1, 1, OLED_WHITE);
    rect_oled(x - 13, y - 15, 27, 1, 1, OLED_WHITE);
    rect_oled(x - 14, y - 14, 29, 1, 1, OLED_WHITE);
    rect_oled(x - 15, y - 13, 31, 1, 1, OLED_WHITE);
    rect_oled(x - 16, y - 12, 33, 2, 1, OLED_WHITE);
    rect_oled(x - 17, y - 10, 35, 2, 1, OLED_WHITE);
    rect_oled(x - 18, y - 8,  37, 2, 1, OLED_WHITE);
    rect_oled(x - 19, y - 6,  39, 5, 1, OLED_WHITE);
    rect_oled(x - 20, y - 1,  41, 3, 1, OLED_WHITE);
    rect_oled(x - 19, y + 2,  39, 5, 1, OLED_WHITE);
    rect_oled(x - 18, y + 7,  37, 2, 1, OLED_WHITE);
    rect_oled(x - 17, y + 9,  35, 2, 1, OLED_WHITE);
    rect_oled(x - 16, y + 11, 33, 2, 1, OLED_WHITE);
    rect_oled(x - 15, y + 13, 31, 1, 1, OLED_WHITE);
    rect_oled(x - 14, y + 14, 29, 1, 1, OLED_WHITE);
    rect_oled(x - 13, y + 15, 27, 1, 1, OLED_WHITE);
    rect_oled(x - 12, y + 16, 25, 1, 1, OLED_WHITE);
    rect_oled(x - 10, y + 17, 21, 1, 1, OLED_WHITE);
    rect_oled(x - 8,  y + 18, 17, 1, 1, OLED_WHITE);
    rect_oled(x - 6,  y + 19, 13, 1, 1, OLED_WHITE);
    rect_oled(x,      y + 20, 1,  1, 1, OLED_WHITE);

    // Double-width curved equator seam.
    line_oled(x - 20, y,     x - 12, y - 3, 1, OLED_BLACK);
    line_oled(x - 12, y - 3, x - 4,  y - 5, 1, OLED_BLACK);
    line_oled(x - 4,  y - 5, x + 4,  y - 5, 1, OLED_BLACK);
    line_oled(x + 4,  y - 5, x + 12, y - 3, 1, OLED_BLACK);
    line_oled(x + 12, y - 3, x + 20, y,     1, OLED_BLACK);
    line_oled(x - 19, y + 1, x - 12, y - 2, 1, OLED_BLACK);
    line_oled(x - 12, y - 2, x - 4,  y - 4, 1, OLED_BLACK);
    line_oled(x - 4,  y - 4, x + 4,  y - 4, 1, OLED_BLACK);
    line_oled(x + 4,  y - 4, x + 12, y - 2, 1, OLED_BLACK);
    line_oled(x + 12, y - 2, x + 19, y + 1, 1, OLED_BLACK);

    // Diagonal panel seam gives the ball its classic eight-panel construction.
    line_oled(x - 15, y - 13, x - 8, y - 7, 1, OLED_BLACK);
    line_oled(x - 8,  y - 7,  x,     y,     1, OLED_BLACK);
    line_oled(x,      y,      x + 8, y + 7, 1, OLED_BLACK);
    line_oled(x + 8,  y + 7,  x + 15,y + 13,1, OLED_BLACK);
    line_oled(x - 14, y - 13, x - 7, y - 7, 1, OLED_BLACK);
    line_oled(x - 7,  y - 7,  x + 1, y,     1, OLED_BLACK);
    line_oled(x + 1,  y,      x + 9, y + 7, 1, OLED_BLACK);
    line_oled(x + 9,  y + 7,  x + 16,y + 12,1, OLED_BLACK);

    // Eight seam positions make the rotation smoother.
    if (ball_spin_frame == 0) ball_seam_offset = -16;
    else if (ball_spin_frame == 1) ball_seam_offset = -12;
    else if (ball_spin_frame == 2) ball_seam_offset = -7;
    else if (ball_spin_frame == 3) ball_seam_offset = -3;
    else if (ball_spin_frame == 4) ball_seam_offset = 3;
    else if (ball_spin_frame == 5) ball_seam_offset = 7;
    else if (ball_spin_frame == 6) ball_seam_offset = 12;
    else ball_seam_offset = 16;

    line_oled(x, y - 20, x + (ball_seam_offset / 2), y - 11, 1, OLED_BLACK);
    line_oled(x + (ball_seam_offset / 2), y - 11, x + ball_seam_offset, y, 1, OLED_BLACK);
    line_oled(x + ball_seam_offset, y, x + (ball_seam_offset / 2), y + 11, 1, OLED_BLACK);
    line_oled(x + (ball_seam_offset / 2), y + 11, x, y + 20, 1, OLED_BLACK);
    line_oled(x + 1, y - 19, x + (ball_seam_offset / 2) + 1, y - 10, 1, OLED_BLACK);
    line_oled(x + (ball_seam_offset / 2) + 1, y - 10, x + ball_seam_offset + 1, y, 1, OLED_BLACK);
    line_oled(x + ball_seam_offset + 1, y, x + (ball_seam_offset / 2) + 1, y + 10, 1, OLED_BLACK);
    line_oled(x + (ball_seam_offset / 2) + 1, y + 10, x + 1, y + 19, 1, OLED_BLACK);

    // Pebbled leather texture, sparse in the highlight and dense in the shadow.
    rect_oled(x - 11, y - 12, 1, 1, 1, OLED_BLACK);
    rect_oled(x - 4,  y - 14, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 4,  y - 13, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 11, y - 10, 1, 1, 1, OLED_BLACK);
    rect_oled(x - 15, y - 5,  1, 1, 1, OLED_BLACK);
    rect_oled(x - 7,  y - 7,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 2,  y - 8,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 9,  y - 5,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 15, y - 3,  1, 1, 1, OLED_BLACK);
    rect_oled(x - 16, y + 3,  1, 1, 1, OLED_BLACK);
    rect_oled(x - 9,  y + 1,  1, 1, 1, OLED_BLACK);
    rect_oled(x - 3,  y + 5,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 5,  y + 2,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 11, y + 5,  1, 1, 1, OLED_BLACK);
    rect_oled(x - 12, y + 9,  1, 1, 1, OLED_BLACK);
    rect_oled(x - 5,  y + 12, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 2,  y + 11, 1, 1, 1, OLED_BLACK);
    rect_oled(x + 8,  y + 10, 1, 1, 1, OLED_BLACK);

    // Dithered lower-right shadow creates roundness and depth.
    rect_oled(x + 16, y - 7,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 17, y - 3,  2, 1, 1, OLED_BLACK);
    rect_oled(x + 16, y + 1,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 18, y + 3,  1, 1, 1, OLED_BLACK);
    rect_oled(x + 15, y + 6,  2, 1, 1, OLED_BLACK);
    rect_oled(x + 13, y + 9,  2, 1, 1, OLED_BLACK);
    rect_oled(x + 10, y + 12, 2, 1, 1, OLED_BLACK);
    rect_oled(x + 7,  y + 15, 2, 1, 1, OLED_BLACK);
}

function draw_clean_basketball(x, y) {
    // Perfect circular body; clean two-tone art reads clearly on the Zen OLED.
    circle_oled(x, y, 19, 1, OLED_WHITE);

    // Classic curved equator seam.
    line_oled(x - 19, y,     x - 10, y - 4, 1, OLED_BLACK);
    line_oled(x - 10, y - 4, x,      y - 6, 1, OLED_BLACK);
    line_oled(x,      y - 6, x + 10, y - 4, 1, OLED_BLACK);
    line_oled(x + 10, y - 4, x + 19, y,     1, OLED_BLACK);

    // Diagonal seam creates the recognizable eight-panel basketball pattern.
    line_oled(x - 14, y - 13, x - 7, y - 7, 1, OLED_BLACK);
    line_oled(x - 7,  y - 7,  x,     y,     1, OLED_BLACK);
    line_oled(x,      y,      x + 7, y + 7, 1, OLED_BLACK);
    line_oled(x + 7,  y + 7,  x + 14,y + 13,1, OLED_BLACK);

    // Smooth moving vertical seam supplies the spin without visual clutter.
    if (ball_spin_frame == 0) ball_seam_offset = -15;
    else if (ball_spin_frame == 1) ball_seam_offset = -11;
    else if (ball_spin_frame == 2) ball_seam_offset = -7;
    else if (ball_spin_frame == 3) ball_seam_offset = -3;
    else if (ball_spin_frame == 4) ball_seam_offset = 3;
    else if (ball_spin_frame == 5) ball_seam_offset = 7;
    else if (ball_spin_frame == 6) ball_seam_offset = 11;
    else ball_seam_offset = 15;

    line_oled(x, y - 19, x + (ball_seam_offset / 2), y - 10, 1, OLED_BLACK);
    line_oled(x + (ball_seam_offset / 2), y - 10, x + ball_seam_offset, y, 1, OLED_BLACK);
    line_oled(x + ball_seam_offset, y, x + (ball_seam_offset / 2), y + 10, 1, OLED_BLACK);
    line_oled(x + (ball_seam_offset / 2), y + 10, x, y + 19, 1, OLED_BLACK);

}

function draw_loading_screen() {
    if (!ball_intro_drawn) {
        cls_oled(OLED_BLACK);
        print(center_x(get_string_length(welcome_line1[0]), OLED_FONT_MEDIUM_WIDTH), 45, OLED_FONT_MEDIUM, OLED_WHITE, welcome_line1[0]);
        ball_intro_drawn = 1;
    }

    if (ball_redraw) {
        // The filled circle replaces the previous seam frame without clearing the screen.
        draw_spinning_basketball(64, 18);
        ball_redraw = 0;
    }
}

