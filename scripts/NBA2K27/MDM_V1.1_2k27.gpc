}

function draw_footer_hint() {
}

function draw_loading_meter(progress, limit) {
    meter_fill = map(progress, 0, limit, 0, 88);
    if (meter_fill < 0) meter_fill = 0;
    if (meter_fill > 88) meter_fill = 88;
    rect_oled(18, 52, 88, 5, OLED_BLACK, OLED_WHITE);
    rect_oled(18, 52, meter_fill, 5, 1, OLED_WHITE);
}

function saver_step() {
    cls_oled(OLED_BLACK);

    // Two-line moving prompt with no logo, border, or divider lines.
    line1_w = (get_string_length(idle_prompt[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    line2_w = (get_string_length(idle_action[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    if (line1_w > line2_w) msg_w = line1_w;
    else msg_w = line2_w;

    print(sx + ((msg_w - line1_w) / 2), sy, OLED_FONT_SMALL, OLED_WHITE, idle_prompt[0]);
    print(sx + ((msg_w - line2_w) / 2), sy + 12, OLED_FONT_SMALL, OLED_WHITE, idle_action[0]);

    sx += svx;
    sy += svy;

    if (sx <= 1 || sx >= (OLED_WIDTH - msg_w - 1)) svx = -svx;
    if (sy <= 1 || sy >= (OLED_HEIGHT - 23)) svy = -svy;
}

function draw_snow() {
    if (!snow_enabled) return;
    
    // Update and draw each snowflake
    for (snow_i = 0; snow_i < num_snowflakes; snow_i++) {
        // Move snowflake down
        snow_y[snow_i] += snow_speed[snow_i];
        
        // Reset snowflake to top if it goes off screen
        if (snow_y[snow_i] > 63) {
            snow_y[snow_i] = -5;
            snow_x[snow_i] = random(0, 127);
            snow_speed[snow_i] = random(1, 3);
        }
        
        // Draw snowflake as small square (1x1 or 2x2 pixels)
        if (snow_speed[snow_i] > 1) {
            // Larger snowflakes (2x2)
            rect_oled(snow_x[snow_i], snow_y[snow_i], 2, 2, 1, OLED_WHITE);
        } else {
            // Smaller snowflakes (1x1)
            rect_oled(snow_x[snow_i], snow_y[snow_i], 1, 1, 1, OLED_WHITE);
        }
    }
}

function map(val, in_min, in_max, out_min, out_max) {
    return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

function draw_x_graph(value, min_val, max_val, y_pos) {
}

function center_x(f_chars, f_font) {
    return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

int bufferIndex, digitIndex, charIndex;
function number_to_string(f_val, f_digits, f_y) {
    bufferIndex = 1;
    digitIndex = 10000;
    if (f_val < 0) {
        putc_oled(bufferIndex, 45);
        bufferIndex += 1;
        f_val = abs(f_val);
    }
    for (charIndex = 5; charIndex >= 1; charIndex--) {
        if (f_digits >= charIndex) {
            putc_oled(bufferIndex, (f_val / digitIndex) + 48);
            f_val %= digitIndex;
            bufferIndex++;
            if (charIndex == 4) {
                putc_oled(bufferIndex, 44);
                bufferIndex++;
            }
        }
        digitIndex /= 10;
    }
    puts_oled(center_x(bufferIndex - 1, OLED_FONT_MEDIUM_WIDTH), f_y, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_WHITE);
}

int logVal;
function find_digits(num) {
    logVal = 0;
    do {
        num /= 10;
        logVal++;
    } while (num);
    return logVal;
}

int stringLength;
function get_string_length(offset) {
    stringLength = 0;
    while (duint8(offset++)) {
        stringLength++;
    }
    return stringLength + 1;
}

function apply_zen_color() {
    // Apply RGB LED color based on zen_color selection
    // 0-7: Original colors, 8-19: New colors
    if (zen_color == 0) {
        set_rgb(255, 0, 0);  // Red
    } else if (zen_color == 1) {
        set_rgb(0, 255, 0);  // Green
    } else if (zen_color == 2) {
        set_rgb(0, 0, 255);  // Blue
    } else if (zen_color == 3) {
        set_rgb(0, 255, 255);  // Cyan
    } else if (zen_color == 4) {
        set_rgb(255, 0, 255);  // Magenta
    } else if (zen_color == 5) {
        set_rgb(255, 255, 0);  // Yellow
    } else if (zen_color == 6) {
        set_rgb(255, 255, 255);  // White
    } else if (zen_color == 7) {
        set_rgb(0, 0, 0);  // Black (off)
    } else if (zen_color == 8) {
        set_rgb(255, 165, 0);  // Orange
    } else if (zen_color == 9) {
        set_rgb(128, 0, 128);  // Purple
    } else if (zen_color == 10) {
        set_rgb(255, 105, 180);  // Pink
    } else if (zen_color == 11) {
        set_rgb(50, 205, 50);  // Lime
    } else if (zen_color == 12) {
        set_rgb(0, 128, 128);  // Teal
    } else if (zen_color == 13) {
        set_rgb(75, 0, 130);  // Indigo
    } else if (zen_color == 14) {
        set_rgb(135, 206, 235);  // Sky Blue
    } else if (zen_color == 15) {
        set_rgb(255, 20, 147);  // Hot Pink
    } else if (zen_color == 16) {
        set_rgb(255, 215, 0);  // Gold
    } else if (zen_color == 17) {
        set_rgb(238, 130, 238);  // Violet
    } else if (zen_color == 18) {
        set_rgb(64, 224, 208);  // Turquoise
    } else if (zen_color == 19) {
        set_rgb(255, 127, 80);  // Coral
    }
}
