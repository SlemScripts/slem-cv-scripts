}

function draw_face_animation(x, y) {
    face_blink_frame = loading_time_elapsed % 900;

    // Warped scratches and heavier ink so the face is not identical to the old one.
    line_oled(x + 21, y + 7, x + 8, y + 2, 1, OLED_WHITE);
    line_oled(x + 25, y + 11, x + 6, y + 15, 1, OLED_WHITE);
    line_oled(x + 102, y + 8, x + 119, y + 3, 1, OLED_WHITE);
    line_oled(x + 101, y + 50, x + 108, y + 63, 1, OLED_WHITE);
    line_oled(x + 59, y + 51, x + 58, y + 63, 1, OLED_WHITE);
    line_oled(x + 82, y + 50, x + 86, y + 63, 1, OLED_WHITE);

    // Darken/reshape the grin into a rougher slash.
    rect_oled(x + 33, y + 38, 64, 3, 1, OLED_BLACK);
    line_oled(x + 31, y + 38, x + 99, y + 41, 1, OLED_WHITE);
    line_oled(x + 34, y + 48, x + 94, y + 46, 1, OLED_WHITE);
    rect_oled(x + 42, y + 41, 2, 9, 1, OLED_WHITE);
    rect_oled(x + 52, y + 40, 2, 10, 1, OLED_WHITE);
    rect_oled(x + 63, y + 40, 2, 10, 1, OLED_WHITE);
    rect_oled(x + 74, y + 40, 2, 10, 1, OLED_WHITE);
    rect_oled(x + 85, y + 41, 2, 8, 1, OLED_WHITE);

    // Tiny blink/flicker overlay during the loading screen.
    if (face_blink_frame > 720 && face_blink_frame < 795) {
        rect_oled(x + 38, y + 17, 21, 8, 1, OLED_BLACK);
        rect_oled(x + 72, y + 16, 23, 9, 1, OLED_BLACK);
        line_oled(x + 37, y + 21, x + 59, y + 21, 1, OLED_WHITE);
        line_oled(x + 72, y + 21, x + 96, y + 21, 1, OLED_WHITE);
    } else if (face_blink_frame > 430 && face_blink_frame < 470) {
        rect_oled(x + 47, y + 20, 2, 2, 1, OLED_BLACK);
        rect_oled(x + 82, y + 20, 2, 2, 1, OLED_BLACK);
        rect_oled(x + 46, y + 19, 1, 1, 1, OLED_WHITE);
        rect_oled(x + 83, y + 19, 1, 1, 1, OLED_WHITE);
    } else if (face_blink_frame > 180 && face_blink_frame < 230) {
        // Horizontal glitch tear.
        rect_oled(x + 18, y + 18, 24, 3, 1, OLED_BLACK);
        rect_oled(x + 42, y + 18, 28, 3, 1, OLED_WHITE);
        rect_oled(x + 68, y + 27, 35, 3, 1, OLED_BLACK);
        rect_oled(x + 75, y + 27, 30, 3, 1, OLED_WHITE);
        line_oled(x + 12, y + 35, x + 118, y + 35, 1, OLED_WHITE);
    } else if (face_blink_frame > 610 && face_blink_frame < 660) {
        // Eye jitter frame.
        rect_oled(x + 35, y + 15, 12, 4, 1, OLED_BLACK);
        rect_oled(x + 48, y + 15, 10, 4, 1, OLED_WHITE);
        rect_oled(x + 72, y + 16, 14, 4, 1, OLED_BLACK);
        rect_oled(x + 85, y + 16, 10, 4, 1, OLED_WHITE);
        line_oled(x + 28, y + 29, x + 102, y + 31, 1, OLED_WHITE);
    } else if (face_blink_frame > 810 && face_blink_frame < 860) {
        // Heavy split-frame glitch.
        rect_oled(x + 9, y + 10, 35, 4, 1, OLED_WHITE);
        rect_oled(x + 46, y + 10, 25, 4, 1, OLED_BLACK);
        rect_oled(x + 75, y + 11, 39, 4, 1, OLED_WHITE);
        rect_oled(x + 23, y + 32, 28, 3, 1, OLED_BLACK);
        rect_oled(x + 53, y + 32, 43, 3, 1, OLED_WHITE);
        rect_oled(x + 17, y + 55, 78, 2, 1, OLED_WHITE);
        rect_oled(x + 41, y + 57, 61, 2, 1, OLED_BLACK);
    }
}

function draw_v4_logo() {
    print(4, 54, OLED_FONT_SMALL, OLED_WHITE, loading_version[0]);
}

