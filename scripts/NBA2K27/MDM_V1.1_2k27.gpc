/*
  Script: MDM_V1.1_2K27
  Author: MUD Scripts
  Release: V1.1
*/
/*
  Features:
  - Button Tempo
  - Button Logic
  - Auto Green
  - Stability Enhancer
  - Stand Logic
  - Fade Logic
  - No-Dip Logic
  - Remap Square
  - L2 Quick Stop
  - Spot Take Macro
  - Instant Triggers
  - Infinite Stamina
  - Meter Dunk
  - Normal Passing Fix
  - Save Inputs
  - Zen Color
*/
int l2_qs_active = 0;
int spotTakeMacro = 0;
int instantTriggers = 0;
int flick_delay = 150;
int delay_duration = 50;
int STICK_DOWN_VALUE = 100;
int random_variation_min = -4;
int random_variation_max = 4;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;
int stabilization_variation = 34;
int flick_up_shooting_active = 1;
int insta_shot_active = 1;
int stand_shot_duration = 700;
int fade_shot_duration = 700;
int no_dip_shot_duration = 500;
int remap_square_active = 0;
int flicked = 0;
int rs_down_active = 0;
int square_button = 0;
int shooting_button_pressed = 0;
int square_shooting_in_progress = 0;
int insta_shot_button_held = 0;  // Track if Insta button is held
int insta_button_pressed = 0;    // Track Insta button state
int auto_green_mode = 0;         // 0 = Stand, 1 = Fade, 2 = No-Dip

int meter_dunk_active = 0;
int meter_dunk_combo_running = 0;
int meter_dunk_override_active = 0;
int meter_dunk_start_time = 0;
int meter_dunk_duration = 1000;
int meter_dunk_button = 0;  
int current_time = 0;
int infinite_stamina = 0;
int ground_control = 70;
int ground_stick_active = 1;
int snow_enabled = 1;
int num_snowflakes = 30;
int snow_x[30];
int snow_y[30];
int snow_speed[30];
int snow_i;
int saver_on = 0;
int sx = 2, sy = 16;
int svx = 2, svy = 2;
int msg_w, line1_w, line2_w, line3_w;
int saver_timer = 0;
int zen_color = 0;  // New: Zen Color selection (0-19)
int active_profile = 0;
int profile_target = 0;
int face_blink_frame = 0;
int ball_spin_frame = 0;
int ball_spin_timer = 0;
int ball_seam_offset = 0;
int ball_redraw = 1;
int ball_intro_drawn = 0;
const string welcome_line1[] = { "MDM" };
const string welcome_line2[] = { "MDM" };
const string welcome_line3[] = { "MDM" };
const string saver_line1[] = { "MDM V4" };
const string saver_line2[] = { "HOLD L2+OPTIONS" };
const string saver_line3[] = { "MDM" };
const string idle_prompt[] = { "LT + OPTIONS" };
const string idle_action[] = { "OPEN MENU" };
const string directions_line1[] = { "HOLD LT + DPAD" };
const string directions_line2[] = { "LEFT/RIGHT NAV" };
const string directions_line3[] = { "UP/DOWN ADJUST" };
const string ui_brand[] = { "MDM V4" };
const string loading_version[] = { "V4" };
const string ui_tag[] = { "" };
const string ui_hint1[] = { "L2+UP/DOWN" };
const string ui_hint2[] = { "CHANGE" };
const string ui_nav[] = { "L2 < >" };
const string ui_edit[] = { "UP/DN" };

// Menu state
int startup = 1, num_pages = 16, menu_enabled = 0, page = 1, menu_selection, toggle_type, page_chg_state;
int flash_toggle, isXbox;

// Menu labels
const string menu_header[] = { 
    "Directions", "Button Tempo", "Button Logic", "Profile",
    "STABIL ENHANCER", "Auto Green", "Stand Logic", "Fade Logic",
    "NO-DIP LOGIC", "Remap Square", "Infinite Stamina", "Quick Stop",
    "Spot Take Macro", "Instant Triggers", "Meter Dunk", "Zen Color"
};
const string pageChg[] = {"---------L2+RIGHT->", "<-L2+LEFT--L2+RIGHT->", "<-L2+LEFT---------"};
const string item_toggle[] = {"L2 + UP/DOWN", "to change"};
const string onOff[] = {"OFF", "ON", "", "L3", "R3", "SQ"};
const string dunk_buttons[] = {"L1", "CIRCLE"};
const string quick_stop_modes[] = {"OFF", "L2 QS"};
const string spot_take_modes[] = {"OFF", "HOLD X"};
const string profile_names[] = {"BUILD 1", "BUILD 2", "BUILD 3"};
const string color_names[] = {"Red", "Green", "Blue", "Cyan", "Magenta", "Yellow", "White", "Black", 
                             "Orange", "Purple", "Pink", "Lime", "Teal", "Indigo", "Sky Blue", "Hot Pink",
                             "Gold", "Violet", "Turquoise", "Coral"};

int is_loading_screen = 1;
define loading_timer = 2000;
int loading_time_elapsed = 0;

int graph_width, x_start, mid_x, bar_pos, pip_x, i_local, meter_fill;
// Version check variables
int saved_version = 0;
int current_version = 8;
int first_time_flag = 0;

init {
    // Load selected build profile
    active_profile = get_pvar(SPVAR_58, 0, 2, 0);
    load_profile_settings();
    // Fixed values
    meter_dunk_active = 1;
    ground_control = 70;
    ground_stick_active = 1;
    saver_on = 0;
    saver_timer = 0;
    
    // Initialize snow positions
    for (snow_i = 0; snow_i < num_snowflakes; snow_i++) {
        snow_x[snow_i] = random(0, 127);
        snow_y[snow_i] = random(-20, 63);
        snow_speed[snow_i] = random(1, 3);
    }
}



main {
    ball_spin_timer += get_rtime();
    if (ball_spin_timer >= 100) {
        ball_spin_timer = 0;
        ball_spin_frame++;
        if (ball_spin_frame > 7) ball_spin_frame = 0;
        ball_redraw = 1;
    }

    if (get_console() == PIO_XB1) isXbox = 1;
    else isXbox = 0;

    if (startup && is_loading_screen) {
        draw_loading_screen();

        loading_time_elapsed += get_rtime();
        if (loading_time_elapsed >= loading_timer) {
            cls_oled(OLED_BLACK);
            is_loading_screen = 0;
            startup = 0;
            saver_on = 1;
            saver_timer = 80;
        }
    } else {
        combo_run(movement_control);

        if (event_press(PS4_CIRCLE) && menu_enabled) {
            menu_enabled = 0;
            combo_run(vibration_off);
            set_rgb(128,0,128);
            saver_on = 1;
        } else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = 1;
            combo_run(vibration_on);
            set_rgb(128,0,128);
            saver_on = 0;
        }

        if (menu_enabled) {
            cls_oled(OLED_BLACK);
            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

            if (page == 1) {
                print(center_x(get_string_length(directions_line1[0]), OLED_FONT_SMALL_WIDTH), 30, OLED_FONT_SMALL, OLED_WHITE, directions_line1[0]);
                print(center_x(get_string_length(directions_line2[0]), OLED_FONT_SMALL_WIDTH), 41, OLED_FONT_SMALL, OLED_WHITE, directions_line2[0]);
                print(center_x(get_string_length(directions_line3[0]), OLED_FONT_SMALL_WIDTH), 52, OLED_FONT_SMALL, OLED_WHITE, directions_line3[0]);
            } else if (page == 4) {
                print(center_x(get_string_length(profile_names[active_profile]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, profile_names[active_profile]);
            } else if (page == 10) {
                print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, onOff[remap_square_active + 3]);
            } else if (page == 12) {
                print(center_x(get_string_length(quick_stop_modes[l2_qs_active]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, quick_stop_modes[l2_qs_active]);
            } else if (page == 13) {
                print(center_x(get_string_length(spot_take_modes[spotTakeMacro]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, spot_take_modes[spotTakeMacro]);
            } else if (page == 15) {
                print(center_x(get_string_length(dunk_buttons[meter_dunk_button]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, dunk_buttons[meter_dunk_button]);
            } else if (page == 16) {
                print(center_x(get_string_length(color_names[zen_color]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, color_names[zen_color]);
            } else if (page != 3 && page != 5 && page != 7 && page != 8 && page != 9) {
                print(center_x(get_string_length(onOff[menu_selection]), OLED_FONT_MEDIUM_WIDTH), 34, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menu_selection]);
            }

            if (page == 1) {
                page_chg_state = 0;
            } else if (page == num_pages) {
                page_chg_state = 2;
            } else {
                page_chg_state = 1;
            }

            if (page > num_pages) page = num_pages;
            if (page < 1) page = 1;
            
            if (get_val(PS4_L2)) {
                set_val(PS4_UP,0); set_val(PS4_DOWN,0);
                set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0);
            }
            if (get_val(PS4_L2) && event_press(PS4_LEFT)) { page--; combo_run(vibration_valchg); }
            if (get_val(PS4_L2) && event_press(PS4_RIGHT)) { page++; combo_run(vibration_valchg); }

            // Page 2: Button Tempo
            if (page == 2) {
                menu_selection = flick_up_shooting_active;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    flick_up_shooting_active = 1;
                    save_current_profile();
                    flash_toggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    flick_up_shooting_active = 0;
                    save_current_profile();
                    flash_toggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 3: Button Logic (original Tempo Speed)
            if (page == 3) {
                menu_selection = 2;
                toggle_type = 0;
                number_to_string(delay_duration, find_digits(delay_duration), 34);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP)) delay_duration += 10;
                        if (event_press(PS4_DOWN)) delay_duration -= 10;
                    } else {
                        if (event_press(PS4_UP)) delay_duration++;
                        if (event_press(PS4_DOWN)) delay_duration--;
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        save_current_profile();
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (delay_duration > 300) delay_duration = 300;
                if (delay_duration < 0) delay_duration = 0;
            }

            // Page 5: Stability Enhancer
            if (page == 5) {
                menu_selection = 2;
                toggle_type = 0;
                number_to_string(stabilization_variation, find_digits(stabilization_variation), 34);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP)) stabilization_variation += 10;
                        if (event_press(PS4_DOWN)) stabilization_variation -= 10;
                    } else {
                        if (event_press(PS4_UP)) stabilization_variation++;
                        if (event_press(PS4_DOWN)) stabilization_variation--;
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        save_current_profile();
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (stabilization_variation > 100) stabilization_variation = 100;
                if (stabilization_variation < 10) stabilization_variation = 10;
            }

            // Page 6: Auto Green
            if (page == 6) {
                menu_selection = insta_shot_active;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    insta_shot_active = 1;
                    save_current_profile();
                    flash_toggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    insta_shot_active = 0;
                    save_current_profile();
                    flash_toggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 7: Stand Logic
            if (page == 7) {
                menu_selection = 2;
                toggle_type = 0;
                number_to_string(stand_shot_duration, find_digits(stand_shot_duration), 34);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP)) stand_shot_duration += 10;
                        if (event_press(PS4_DOWN)) stand_shot_duration -= 10;
                    } else {
                        if (event_press(PS4_UP)) stand_shot_duration += 1;
                        if (event_press(PS4_DOWN)) stand_shot_duration -= 1;
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        save_current_profile();
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (stand_shot_duration > 1000) stand_shot_duration = 1000;
                if (stand_shot_duration < 100) stand_shot_duration = 100;
            }

            // Page 8: Fade Logic
            if (page == 8) {
                menu_selection = 2;
                toggle_type = 0;
                number_to_string(fade_shot_duration, find_digits(fade_shot_duration), 34);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP)) fade_shot_duration += 10;
                        if (event_press(PS4_DOWN)) fade_shot_duration -= 10;
                    } else {
                        if (event_press(PS4_UP)) fade_shot_duration += 1;
                        if (event_press(PS4_DOWN)) fade_shot_duration -= 1;
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        save_current_profile();
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (fade_shot_duration > 1500) fade_shot_duration = 1500;
                if (fade_shot_duration < 100) fade_shot_duration = 100;
            }

            // Page 9: No-Dip Logic
            if (page == 9) {
                menu_selection = 2;
                toggle_type = 0;
                number_to_string(no_dip_shot_duration, find_digits(no_dip_shot_duration), 34);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP)) no_dip_shot_duration += 10;
                        if (event_press(PS4_DOWN)) no_dip_shot_duration -= 10;
                    } else {
                        if (event_press(PS4_UP)) no_dip_shot_duration += 1;
                        if (event_press(PS4_DOWN)) no_dip_shot_duration -= 1;
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        save_current_profile();
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (no_dip_shot_duration > 1000) no_dip_shot_duration = 1000;
                if (no_dip_shot_duration < 100) no_dip_shot_duration = 100;
            }

            // Page 10: Remap Square
            if (page == 10) {
                menu_selection = remap_square_active + 3;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    remap_square_active++;
                    if (remap_square_active > 2) remap_square_active = 0;
                    save_current_profile();
                    flash_toggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    remap_square_active--;
                    if (remap_square_active < 0) remap_square_active = 2;
                    save_current_profile();
                    flash_toggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 11: Infinite Stamina
            if (page == 11) {
                menu_selection = infinite_stamina;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    infinite_stamina = 1;
                    save_current_profile();
                    flash_toggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    infinite_stamina = 0;
                    save_current_profile();
                    flash_toggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }
            
            // Page 15: Meter Dunk Button (L1/Circle)
            if (page == 15) {
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    meter_dunk_button = 1;  // Circle
                    save_current_profile();
                    combo_run(vibration_valchg);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    meter_dunk_button = 0;  // L1
                    save_current_profile();
                    combo_run(vibration_valchg);
                }
            }

            // Page 16: Zen Color
            if (page == 16) {
                menu_selection = zen_color;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    zen_color++;
                    if (zen_color > 19) zen_color = 0;
                    save_current_profile();
                    apply_zen_color();
                    combo_run(vibration_valchg);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    zen_color--;
                    if (zen_color < 0) zen_color = 19;
                    save_current_profile();
                    apply_zen_color();
                    combo_run(vibration_valchg);
                }
            }

            // Page 12: L2 Quick Stop
            if (page == 12) {
                menu_selection = l2_qs_active;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) { l2_qs_active = 1; save_current_profile(); flash_toggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { l2_qs_active = 0; save_current_profile(); flash_toggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }

            // Page 13: Spot Take Macro
            if (page == 13) {
                menu_selection = spotTakeMacro;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) { spotTakeMacro = 1; save_current_profile(); flash_toggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { spotTakeMacro = 0; save_current_profile(); flash_toggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }

            // Page 14: Instant Triggers
            if (page == 14) {
                menu_selection = instantTriggers;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) { instantTriggers = 1; save_current_profile(); flash_toggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { instantTriggers = 0; save_current_profile(); flash_toggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }

            // Page 4: Profile
            if (page == 4) {
                menu_selection = active_profile;
                toggle_type = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    profile_target = active_profile + 1;
                    if (profile_target > 2) profile_target = 0;
                    switch_profile(profile_target);
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    profile_target = active_profile - 1;
                    if (profile_target < 0) profile_target = 2;
                    switch_profile(profile_target);
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

        } // END MENU

        // GAMEPLAY LOGIC (NO MENU)
        if (!menu_enabled) {
            // Handle color cycling or static color
            apply_zen_color();

            if (saver_on) {
                saver_timer += get_rtime();
                if (saver_timer >= 80) {
                    saver_step();
                    saver_timer = 0;
                }
            }

            // Update current time
            current_time += get_rtime();

            // Meter Dunk (Hold selected button + R2 only, not with L2)
            if (meter_dunk_active && get_val(PS4_R2) && !get_val(PS4_L2)) {
                // Check selected trigger button (0 = L1, 1 = Circle)
                if ((meter_dunk_button == 0 && get_val(PS4_L1)) || (meter_dunk_button == 1 && get_val(PS4_CIRCLE))) {
                    if (!meter_dunk_combo_running) {
                        combo_run(meter_dunk_combo);
                        meter_dunk_combo_running = 1;
                        meter_dunk_override_active = 1;
                        meter_dunk_start_time = current_time;
                    }
                } else {
                    if (meter_dunk_combo_running) {
                        if ((current_time - meter_dunk_start_time) >= meter_dunk_duration) {
                            combo_stop(meter_dunk_combo);
                            meter_dunk_combo_running = 0;
                            meter_dunk_override_active = 0;
                        }
                    }
                }
            } else {
                if (meter_dunk_combo_running) {
                    combo_stop(meter_dunk_combo);
                    meter_dunk_combo_running = 0;
                    meter_dunk_override_active = 0;
                }
            }

            // L3/R3/SQ Remap Logic
            if (remap_square_active == 0) {
                if (get_val(PS4_L3)) set_val(PS4_SQUARE, 100);
            } else if (remap_square_active == 1) {
                if (get_val(PS4_R3)) set_val(PS4_SQUARE, 100);
            }
            // If remap_square_active == 2 (SQ), Square stays as Square (no remap)

            // Button Tempo applies only to the physical X/Square button.
            shooting_button_pressed = 0;
            if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
                shooting_button_pressed = get_val(PS4_SQUARE);
            }

            apply_instant_triggers();
            handle_spot_take_macro();

            // L2 Quick Stop
            if (l2_qs_active && get_val(PS4_L2) > 0) {
                if (get_val(PS4_SQUARE)) {
                    set_val(PS4_SQUARE, 0);
                    if (!square_button) { square_button = 1; flicked = 0; rs_down_active = 0; }
                    if (!flicked) {
                        if (get_val(PS4_LX) < -50 || get_val(PS4_LY) < -50) combo_run(rs_right_flick);
                        else if (get_val(PS4_LX) > 50 || get_val(PS4_LY) > 50) combo_run(rs_left_flick);
                        flicked = 1;
                        combo_run(wait_flick);
                        set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0);
                    } else if (rs_down_active == 1 || (!flicked && rs_down_active == 0)) {
                        set_val(PS4_SQUARE, 100);
                    }
                    set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0);
                } else {
                    if (square_button) { square_button = 0; rs_down_active = 0; }
                    set_val(PS4_SQUARE, 0);
                }
            }

            // Original Button Tempo behavior: hold the right stick down while
            // X/Square is held, then apply the timed upward flick on release.
            if (flick_up_shooting_active) {
                if (shooting_button_pressed) {
                    // Preserve R1/RB + X/Square passing.
                    if (!get_val(PS4_R1)) {
                        set_val(PS4_SQUARE, 0);
                        square_shooting_in_progress = 1;
                        set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                        set_val(PS4_RX, random(random_variation_min, random_variation_max));
                    }
                }

                if (!shooting_button_pressed && square_shooting_in_progress) {
                    combo_run(button_tempo_release);
                    square_shooting_in_progress = 0;
                }
            }

            // Auto Green: Stand normally, Fade with RT/R2, or No-Dip with LT/L2.
            if (insta_shot_active) {
                // Check which button based on remap setting
                insta_button_pressed = 0;
                if (remap_square_active == 0 && get_val(PS4_R3)) {
                    insta_button_pressed = 1;
                } else if (remap_square_active == 1 && get_val(PS4_L3)) {
                    insta_button_pressed = 1;
                }
                
                if (insta_button_pressed) {
                    if (!insta_shot_button_held) {
                        insta_shot_button_held = 1;
                        auto_green_mode = 0;
                    }
                    // L2/LT has priority. Once a modifier is detected, keep it
                    // latched until the Auto Green stick button is released.
                    if (get_val(PS4_L2) > 20) {
                        auto_green_mode = 2;
                    } else if (get_val(PS4_R2) > 20 && auto_green_mode == 0) {
                        auto_green_mode = 1;
                    }
                } else {
                    if (insta_shot_button_held) {
                        if (auto_green_mode == 2) {
                            combo_run(no_dip_shot_square);
                        } else if (auto_green_mode == 1) {
                            combo_run(fade_shot_square);
                        } else {
                            combo_run(stand_shot_square);
                        }
                        insta_shot_button_held = 0;
                        auto_green_mode = 0;
                    }
                }
            }
            
        }
    }
}

// INFINITE STAMINA COMBO - FIXED TO ALLOW FADE AND PASSING




combo movement_control {
    // Only apply movement control if:
    // 1. Infinite stamina is enabled
    // 2. Ground stick is active
    // 3. NOT doing meter dunk
    // 4. NOT actively shooting with Square
    // 5. NOT holding Square (for passing)
    if (infinite_stamina && ground_stick_active && !meter_dunk_override_active && 
        !square_shooting_in_progress && !get_val(PS4_SQUARE) &&
        !combo_running(button_tempo_release) &&
        !combo_running(stand_shot_square) && !combo_running(fade_shot_square) &&
        !combo_running(no_dip_shot_square)) {
        if(abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        }
        
        if(abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

combo meter_dunk_combo {
    set_val(PS4_RY, 100);
    set_val(PS4_R2, 100);
    wait(1000);
    set_val(PS4_RY, 0);
    set_val(PS4_R2, 0);
}

// SHOOTING COMBOS
combo button_tempo_release {
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo stand_shot_square {
    set_val(PS4_SQUARE, 100);
    wait(stand_shot_duration);
    set_val(PS4_SQUARE, 0);
}

combo fade_shot_square {
    set_val(PS4_SQUARE, 100);
    set_val(PS4_R2, 100);
    wait(fade_shot_duration);
    set_val(PS4_SQUARE, 0);
    set_val(PS4_R2, 0);
}

combo no_dip_shot_square {
    set_val(PS4_SQUARE, 100);
    wait(no_dip_shot_duration);
    set_val(PS4_SQUARE, 0);
}

combo spot_take_combo {
    set_val(PS4_CROSS, 100);
    wait(10);
    set_val(PS4_CROSS, 0);
    wait(10);
    set_val(PS4_CROSS, 100);
    wait(10);
    set_val(PS4_CROSS, 0);
    wait(10);
    set_val(PS4_CROSS, 100);
    wait(10);
    set_val(PS4_CROSS, 0);
}

combo rs_left_flick {
    set_val(PS4_SQUARE, 0);
    set_val(PS4_R2, 0);
    set_val(PS4_RX, 100);
    wait(100);
    set_val(PS4_RX, 0);
    set_val(PS4_LX, 0);
    set_val(PS4_LY, 0);
}

combo rs_right_flick {
    set_val(PS4_SQUARE, 0);
    set_val(PS4_R2, 0);
    set_val(PS4_RX, -100);
    wait(100);
    set_val(PS4_RX, 0);
    set_val(PS4_LX, 0);
    set_val(PS4_LY, 0);
}

combo wait_flick {
    wait(flick_delay);
    set_val(PS4_SQUARE, 100);
    rs_down_active = 1;
}

function apply_instant_triggers() {
    if (instantTriggers) {
        if (get_val(PS4_L2) > 0) set_val(PS4_L2, 100);
        if (get_val(PS4_R2) > 0) set_val(PS4_R2, 100);
    }
}

function handle_spot_take_macro() {
    if (spotTakeMacro && get_val(PS4_CROSS)) combo_run(spot_take_combo);
}

function load_profile_settings() {
    if (active_profile == 0) {
        flick_up_shooting_active = get_pvar(SPVAR_1, 0, 1, 1);
        delay_duration = get_pvar(SPVAR_2, 0, 300, 50);
        stabilization_variation = get_pvar(SPVAR_3, 10, 100, 50);
        insta_shot_active = get_pvar(SPVAR_6, 0, 1, 1);
        stand_shot_duration = get_pvar(SPVAR_7, 100, 1000, 700);
        fade_shot_duration = get_pvar(SPVAR_8, 100, 1500, 700);
        no_dip_shot_duration = get_pvar(SPVAR_4, 100, 1000, 500);
        remap_square_active = get_pvar(SPVAR_9, 0, 2, 2);
        infinite_stamina = get_pvar(SPVAR_10, 0, 1, 0);
        meter_dunk_button = get_pvar(SPVAR_11, 0, 1, 0);
        zen_color = get_pvar(SPVAR_13, 0, 19, 9);
        l2_qs_active = get_pvar(SPVAR_60, 0, 1, 0);
        spotTakeMacro = get_pvar(SPVAR_62, 0, 1, 0);
        instantTriggers = get_pvar(SPVAR_63, 0, 1, 0);
    } else if (active_profile == 1) {
        flick_up_shooting_active = get_pvar(SPVAR_20, 0, 1, 1);
        delay_duration = get_pvar(SPVAR_21, 0, 300, 50);
        stabilization_variation = get_pvar(SPVAR_22, 10, 100, 50);
        insta_shot_active = get_pvar(SPVAR_25, 0, 1, 1);
        stand_shot_duration = get_pvar(SPVAR_26, 100, 1000, 700);
        fade_shot_duration = get_pvar(SPVAR_27, 100, 1500, 700);
        no_dip_shot_duration = get_pvar(SPVAR_23, 100, 1000, 500);
        remap_square_active = get_pvar(SPVAR_28, 0, 2, 2);
        infinite_stamina = get_pvar(SPVAR_29, 0, 1, 0);
        meter_dunk_button = get_pvar(SPVAR_30, 0, 1, 0);
        zen_color = get_pvar(SPVAR_32, 0, 19, 9);
        l2_qs_active = get_pvar(SPVAR_60, 0, 1, 0);
        spotTakeMacro = get_pvar(SPVAR_62, 0, 1, 0);
        instantTriggers = get_pvar(SPVAR_63, 0, 1, 0);
    } else {
        flick_up_shooting_active = get_pvar(SPVAR_39, 0, 1, 1);
        delay_duration = get_pvar(SPVAR_40, 0, 300, 50);
        stabilization_variation = get_pvar(SPVAR_41, 10, 100, 50);
        insta_shot_active = get_pvar(SPVAR_44, 0, 1, 1);
        stand_shot_duration = get_pvar(SPVAR_45, 100, 1000, 700);
        fade_shot_duration = get_pvar(SPVAR_46, 100, 1500, 700);
        no_dip_shot_duration = get_pvar(SPVAR_42, 100, 1000, 500);
        remap_square_active = get_pvar(SPVAR_47, 0, 2, 2);
        infinite_stamina = get_pvar(SPVAR_48, 0, 1, 0);
        meter_dunk_button = get_pvar(SPVAR_49, 0, 1, 0);
        zen_color = get_pvar(SPVAR_51, 0, 19, 9);
        l2_qs_active = get_pvar(SPVAR_60, 0, 1, 0);
        spotTakeMacro = get_pvar(SPVAR_62, 0, 1, 0);
        instantTriggers = get_pvar(SPVAR_63, 0, 1, 0);
    }
}

function save_current_profile() {
    if (active_profile == 0) {
        set_pvar(SPVAR_1, flick_up_shooting_active);
        set_pvar(SPVAR_2, delay_duration);
        set_pvar(SPVAR_3, stabilization_variation);
        set_pvar(SPVAR_6, insta_shot_active);
        set_pvar(SPVAR_7, stand_shot_duration);
        set_pvar(SPVAR_8, fade_shot_duration);
        set_pvar(SPVAR_4, no_dip_shot_duration);
        set_pvar(SPVAR_9, remap_square_active);
        set_pvar(SPVAR_10, infinite_stamina);
        set_pvar(SPVAR_11, meter_dunk_button);
        set_pvar(SPVAR_13, zen_color);
        set_pvar(SPVAR_60, l2_qs_active);
        set_pvar(SPVAR_62, spotTakeMacro);
        set_pvar(SPVAR_63, instantTriggers);
    } else if (active_profile == 1) {
        set_pvar(SPVAR_20, flick_up_shooting_active);
        set_pvar(SPVAR_21, delay_duration);
        set_pvar(SPVAR_22, stabilization_variation);
        set_pvar(SPVAR_25, insta_shot_active);
        set_pvar(SPVAR_26, stand_shot_duration);
        set_pvar(SPVAR_27, fade_shot_duration);
        set_pvar(SPVAR_23, no_dip_shot_duration);
        set_pvar(SPVAR_28, remap_square_active);
        set_pvar(SPVAR_29, infinite_stamina);
        set_pvar(SPVAR_30, meter_dunk_button);
        set_pvar(SPVAR_32, zen_color);
        set_pvar(SPVAR_60, l2_qs_active);
        set_pvar(SPVAR_62, spotTakeMacro);
        set_pvar(SPVAR_63, instantTriggers);
    } else {
        set_pvar(SPVAR_39, flick_up_shooting_active);
        set_pvar(SPVAR_40, delay_duration);
        set_pvar(SPVAR_41, stabilization_variation);
        set_pvar(SPVAR_44, insta_shot_active);
        set_pvar(SPVAR_45, stand_shot_duration);
        set_pvar(SPVAR_46, fade_shot_duration);
        set_pvar(SPVAR_42, no_dip_shot_duration);
        set_pvar(SPVAR_47, remap_square_active);
        set_pvar(SPVAR_48, infinite_stamina);
        set_pvar(SPVAR_49, meter_dunk_button);
        set_pvar(SPVAR_51, zen_color);
        set_pvar(SPVAR_60, l2_qs_active);
        set_pvar(SPVAR_62, spotTakeMacro);
        set_pvar(SPVAR_63, instantTriggers);
    }
}

function switch_profile(new_profile) {
    save_current_profile();
    active_profile = new_profile;
    set_pvar(SPVAR_58, active_profile);
    load_profile_settings();
    apply_zen_color();
}

// UI EFFECTS
combo flashtog {
    if (!flash_toggle) {
        set_rgb(128, 0, 128);
    } else {
        set_rgb(180, 60, 255);
    }
    wait(1000);
    set_rgb(128, 0, 128);
}

combo flashedit {
    set_rgb(64, 0, 64);
    wait(150);
    set_rgb(128, 0, 128);
}

combo vibration_on {
    set_rumble(RUMBLE_A, 100);
    set_rumble(RUMBLE_B, 100);
    wait(200);
    set_rumble(RUMBLE_A, 0);
    set_rumble(RUMBLE_B, 0);
}

combo vibration_off {
    set_rumble(RUMBLE_A, 50);
    set_rumble(RUMBLE_B, 50);
    wait(200);
    set_rumble(RUMBLE_A, 0);
    set_rumble(RUMBLE_B, 0);
}

combo vibration_valchg {
    set_rumble(RUMBLE_A, 50);
    set_rumble(RUMBLE_B, 50);
    wait(50);
    set_rumble(RUMBLE_A, 0);
    set_rumble(RUMBLE_B, 0);
}

