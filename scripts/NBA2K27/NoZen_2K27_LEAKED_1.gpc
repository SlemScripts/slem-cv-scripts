function pmem_read(pmem_slot) {
    if (pmem_slot == NOZEN_038) {
        return get_pvar(NOZEN_PMEM0, 0, 1, 0);
    }
    return get_pvar(NOZEN_PMEM1, 0, 0x7530, 0);
}

function pmem_write(pmem_slot, pmem_val) {
    if (pmem_slot == NOZEN_038) {
        set_pvar(NOZEN_PMEM0, pmem_val);
    } else {
        set_pvar(NOZEN_PMEM1, pmem_val);
    }
}

