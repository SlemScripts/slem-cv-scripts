set_val(PS4_LX, (get_val(PS4_LX) * NOZEN_0207) / 0x64);
set_val(PS4_LY, (get_val(PS4_LY) * NOZEN_0207) / 0x64);
}

if (abs(get_val(PS4_LX)) < 0x14 && abs(get_val(PS4_LY)) < 0x14) {
set_val(PS4_LX, 0);
set_val(PS4_LY, 0);
}
}
}

function NOZEN_F001(f_chars, f_font) {
return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

int NOZEN_0260, NOZEN_0261, NOZEN_0262;
function NOZEN_F002(f_val, f_digits) {
NOZEN_0260 = 1;
NOZEN_0261 = 0x2710;
if (f_val < 0) { putc_oled(NOZEN_0260, 0x2d); NOZEN_0260 += 1; f_val = abs(f_val); }
for (NOZEN_0262 = 5; NOZEN_0262 >= 1; NOZEN_0262--) {
if (f_digits >= NOZEN_0262) {
putc_oled(NOZEN_0260, (f_val / NOZEN_0261) + 0x30);
f_val %= NOZEN_0261;
NOZEN_0260++;
if (NOZEN_0262 == 4) { putc_oled(NOZEN_0260, 0x2c); NOZEN_0260++; }
}
NOZEN_0261 /= 0xa;
}
puts_oled(NOZEN_F001(NOZEN_0260 + 1, OLED_FONT_MEDIUM_WIDTH), 0x1e, OLED_FONT_MEDIUM, NOZEN_0260 - 1, OLED_WHITE);
}

int NOZEN_0263;
function NOZEN_F003(num) { NOZEN_0263 = 0; do { num /= 0xa; NOZEN_0263++; } while (num); return NOZEN_0263; }

int NOZEN_0264;
function NOZEN_F004(offset) { NOZEN_0264 = 0; while (duint8(offset++)) { NOZEN_0264++; } return NOZEN_0264 + 1; }

function NOZEN_F005(btn) {
if      (NOZEN_0214 == 0) NOZEN_0219 = NOZEN_041;
else if (NOZEN_0214 == 1) NOZEN_0219 = NOZEN_042;
else if (NOZEN_0214 == 2) NOZEN_0219 = NOZEN_043;
else if (NOZEN_0214 == 3) NOZEN_0219 = NOZEN_044;
else                    NOZEN_0219 = NOZEN_045;

if (btn == NOZEN_0219) {
NOZEN_0214++;
if (NOZEN_0214 >= 5) {
NOZEN_0214 = 0;
NOZEN_0217 = 1;
NOZEN_0218 = 0;
}
} else {
NOZEN_0214 = 0;
NOZEN_0215 = 1;
NOZEN_0216 = 0;
}
}

function NOZEN_F006() {
cls_oled(OLED_BLACK);
if (NOZEN_0217) {
print(NOZEN_F001(NOZEN_F004(NOZEN_S012[0]),      OLED_FONT_SMALL_WIDTH), 0xe, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S012[0]);
print(NOZEN_F001(NOZEN_F004(NOZEN_S013[0]), OLED_FONT_SMALL_WIDTH), 0x1c, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S013[0]);
} else if (NOZEN_0215) {
print(NOZEN_F001(NOZEN_F004(NOZEN_S010[0]), OLED_FONT_SMALL_WIDTH), 0xe, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S010[0]);
print(NOZEN_F001(NOZEN_F004(NOZEN_S011[0]), OLED_FONT_SMALL_WIDTH), 0x1c, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S011[0]);
} else {
print(NOZEN_F001(NOZEN_F004(NOZEN_S008[0]), OLED_FONT_SMALL_WIDTH),  2, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S008[0]);
if      (NOZEN_0214 == 0) { print(NOZEN_F001(NOZEN_F004(NOZEN_S014[0]), OLED_FONT_SMALL_WIDTH), 0x12, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S014[0]); }
else if (NOZEN_0214 == 1) { print(NOZEN_F001(NOZEN_F004(NOZEN_S015[0]), OLED_FONT_SMALL_WIDTH), 0x12, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S015[0]); }
else if (NOZEN_0214 == 2) { print(NOZEN_F001(NOZEN_F004(NOZEN_S016[0]), OLED_FONT_SMALL_WIDTH), 0x12, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S016[0]); }
else if (NOZEN_0214 == 3) { print(NOZEN_F001(NOZEN_F004(NOZEN_S017[0]), OLED_FONT_SMALL_WIDTH), 0x12, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S017[0]); }
else if (NOZEN_0214 == 4) { print(NOZEN_F001(NOZEN_F004(NOZEN_S018[0]), OLED_FONT_SMALL_WIDTH), 0x12, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S018[0]); }
print(NOZEN_F001(NOZEN_F004(NOZEN_S009[0]), OLED_FONT_SMALL_WIDTH), 0x26, OLED_FONT_SMALL, OLED_WHITE, NOZEN_S009[0]);
}
}
