define DRIB_MOVE_MAX = 46;




// ---- Dunk trigger / style names ----

define PVAR_BASE = 30;
define PVAR_OFFSET = 6;  // 6 slots per profile so each profile owns full settings

function SaveProfile(idx) {
    p_start = PVAR_BASE + (idx - 1) * PVAR_OFFSET;
    val0 = 0;
    val1 = 0;

    // ---- val0: toggles ----
    if (flick_up_shooting_active) val0 = val0 | 1;
    if (reverse_flick_mode)       val0 = val0 | 2;
    if (br_auto_mode)             val0 = val0 | 4;
    if (btn_shot_on)              val0 = val0 | 8;
    if (smart_timing_enabled)     val0 = val0 | 16;
    if (nodip_enabled)            val0 = val0 | 32;
    if (fade_toggle)              val0 = val0 | 64;
    if (auto_stand_on)            val0 = val0 | 128;
    if (auto_fade_on)             val0 = val0 | 256;
    if (auto_nodip_on)            val0 = val0 | 512;
    if (rs_shoot_on)              val0 = val0 | 1024;
    if (unlimited_stamina)        val0 = val0 | 2048;
    if (dunk_meter_on)            val0 = val0 | 4096;
    if (dribble_on)               val0 = val0 | 8192;
    if (vib_block_on)             val0 = val0 | 16384;
    if (qs_on)                    val0 = val0 | 32768;
    if (shot_vibe_enabled)        val0 = val0 | 65536;
    if (fade_vibe_enabled)        val0 = val0 | 131072;
    if (shotlog_enabled)          val0 = val0 | 262144;
    if (tk_at_on)                 val0 = val0 | 524288;
    if (meter_dunk_active)        val0 = val0 | 1048576;
    if (fade_l1r2_on)             val0 = val0 | 2097152;
    val0 = val0 | ((remap_square_active & 3) << 22);
    val0 = val0 | ((bind_name_idx & 15) << 24);
    set_pvar(p_start, val0);

    // ---- val1: Button Rhythm timings ----
    val1 = (delay_duration & 16383) | ((br_auto_ms & 16383) << 14);
    set_pvar(p_start + 1, val1);

    // ---- val2: fade / nodip / button shot ms ----
    val0 = (fade_delay_ms & 511)
         | ((nodip_tempo_ms & 511) << 9)
         | ((btn_shot_hold_ms & 2047) << 18);
    set_pvar(p_start + 2, val0);

    // ---- val3: auto speeds ----
    val0 = (auto_speed_ms & 1023)
         | ((auto_tempo_ms & 511) << 10)
         | ((auto_fade_speed_ms & 1023) << 19);
    set_pvar(p_start + 3, val0);

    // ---- val4: auto nodip / rs hold / qs btn1 / qs btn2 ----
    // auto_nodip 10 bits, rs_hold 10 bits, qs_btn1 6 bits, qs_btn2 6 bits (button ids fit in 6)
    val0 = (auto_nodip_ms & 1023)
         | ((rs_hold_time & 1023) << 10)
         | ((qs_btn1 & 63) << 20)
         | ((qs_btn2 & 63) << 26);
    set_pvar(p_start + 4, val0);

    // ---- val5: dribble slots (8 bits each, 0-126 fits) ----
    // qs_btn2 stored in high bits of val4 already? extend val4 write above
    val0 = (drib_up & 255)
         | ((drib_dn & 255) << 8)
         | ((drib_lf & 255) << 16)
         | ((drib_rt & 255) << 24);
    set_pvar(p_start + 5, val0);
}

function LoadProfile(idx) {
    p_start = PVAR_BASE + (idx - 1) * PVAR_OFFSET;
    val0 = get_pvar(p_start, -2147483648, 2147483647, 0);
    val1 = get_pvar(p_start + 1, -2147483648, 2147483647, 0);

    flick_up_shooting_active = val0 & 1;
    reverse_flick_mode       = (val0 >> 1) & 1;
    br_auto_mode             = (val0 >> 2) & 1;
    btn_shot_on              = (val0 >> 3) & 1;
    smart_timing_enabled     = (val0 >> 4) & 1;
    nodip_enabled            = (val0 >> 5) & 1;
    fade_toggle              = (val0 >> 6) & 1;
    auto_stand_on            = (val0 >> 7) & 1;
    auto_fade_on             = (val0 >> 8) & 1;
    auto_nodip_on            = (val0 >> 9) & 1;
    rs_shoot_on              = (val0 >> 10) & 1;
    unlimited_stamina        = (val0 >> 11) & 1;
    dunk_meter_on            = (val0 >> 12) & 1;
    dribble_on               = (val0 >> 13) & 1;
    vib_block_on             = (val0 >> 14) & 1;
    qs_on                    = (val0 >> 15) & 1;
    shot_vibe_enabled        = (val0 >> 16) & 1;
    fade_vibe_enabled        = (val0 >> 17) & 1;
    shotlog_enabled          = (val0 >> 18) & 1;
    tk_at_on                 = (val0 >> 19) & 1;
    meter_dunk_active        = (val0 >> 20) & 1;
    fade_l1r2_on             = (val0 >> 21) & 1;
    remap_square_active      = (val0 >> 22) & 3;
    bind_name_idx            = (val0 >> 24) & 15;

    delay_duration = val1 & 16383;
    br_auto_ms     = (val1 >> 14) & 16383;
    if (delay_duration > 9000) delay_duration = 9000;
    if (br_auto_ms > 9000) br_auto_ms = 9000;

    val0 = get_pvar(p_start + 2, -2147483648, 2147483647, 0);
    fade_delay_ms    = val0 & 511;
    nodip_tempo_ms   = (val0 >> 9) & 511;
    btn_shot_hold_ms = (val0 >> 18) & 2047;
    if (btn_shot_hold_ms < 100) btn_shot_hold_ms = 664;
    ShotH = btn_shot_hold_ms;

    val0 = get_pvar(p_start + 3, -2147483648, 2147483647, 0);
    auto_speed_ms      = val0 & 1023;
    auto_tempo_ms      = (val0 >> 10) & 511;
    auto_fade_speed_ms = (val0 >> 19) & 1023;
    if (auto_speed_ms < 100) auto_speed_ms = 500;
    if (auto_fade_speed_ms < 100) auto_fade_speed_ms = 500;

    val0 = get_pvar(p_start + 4, -2147483648, 2147483647, 0);
    auto_nodip_ms = val0 & 1023;
    rs_hold_time  = (val0 >> 10) & 1023;
    qs_btn1       = (val0 >> 20) & 63;
    qs_btn2       = (val0 >> 26) & 63;
    if (auto_nodip_ms < 100) auto_nodip_ms = 440;
    if (rs_hold_time < 50) rs_hold_time = 300;
    if (qs_btn1 == 0) qs_btn1 = PS4_L2;

    val0 = get_pvar(p_start + 5, -2147483648, 2147483647, 0);
    drib_up = val0 & 255;
    drib_dn = (val0 >> 8) & 255;
    drib_lf = (val0 >> 16) & 255;
    drib_rt = (val0 >> 24) & 255;
    if (drib_up > DRIB_MOVE_MAX) drib_up = 0;
    if (drib_dn > DRIB_MOVE_MAX) drib_dn = 0;
    if (drib_lf > DRIB_MOVE_MAX) drib_lf = 0;
    if (drib_rt > DRIB_MOVE_MAX) drib_rt = 0;

    // dunk bind button from name idx
    if (bind_name_idx == 0)      { dunk_bind_btn = PS4_L1; }
    else if (bind_name_idx == 1) { dunk_bind_btn = PS4_CIRCLE; }
    else if (bind_name_idx == 2) { dunk_bind_btn = PS4_L2; }
    else if (bind_name_idx == 3) { dunk_bind_btn = PS4_TRIANGLE; }
    else if (bind_name_idx == 4) { dunk_bind_btn = PS4_SQUARE; }
    else if (bind_name_idx == 5) { dunk_bind_btn = PS4_R1; }
    else if (bind_name_idx == 6) { dunk_bind_btn = PS4_CROSS; }
    else if (bind_name_idx == 7) { dunk_bind_btn = PS4_UP; }
    else if (bind_name_idx == 8) { dunk_bind_btn = PS4_DOWN; }
    else if (bind_name_idx == 9) { dunk_bind_btn = PS4_LEFT; }
    else                         { dunk_bind_btn = PS4_RIGHT; }
}


init {
    current_profile = get_pvar(PVAR_PROFILE_SLOT, PROFILE_MIN, PROFILE_MAX, 1);
    if (current_profile < PROFILE_MIN || current_profile > PROFILE_MAX) current_profile = 1;
    profile_sel = current_profile;
    last_menu_page = get_pvar(PVAR_LAST_PAGE, 1, numpgs, 1);

    // Safe factory-ish defaults before profile load
    FadeLH = 925; FadeRH = 922; CatchH = 664;
    ShotH = 664; ShotV = 659; FadeLV = 920; FadeRV = 917; CatchV = 659;
    smart_fade_offset = 30;
    smart_quick_offset = 20;
    shot_vibe_ms = 500;
    fade_vibe_ms = 500;
    dunk_hold_dur = 700;
    tk_at_on = 1;
    remap_square_active = 1;
    qs_btn1 = PS4_L2;
    qs_btn2 = 0;
    delay_duration = 50;
    br_auto_ms = 500;
    br_auto_mode = 0;
    fade_delay_ms = 42;
    nodip_tempo_ms = 270;
    btn_shot_hold_ms = 664;
    auto_speed_ms = 500;
    auto_tempo_ms = 50;
    auto_fade_speed_ms = 500;
    auto_nodip_ms = 440;
    rs_hold_time = 300;

    // One-time stamp for first boot defaults
    if (get_pvar(PVAR_DEFAULTS_STAMP, 0, 1, 0) == 0) {
        set_pvar(PVAR_DEFAULTS_STAMP, 1);
    }

    // Load THIS profile's full custom settings last (wins over defaults)
    LoadProfile(current_profile);

    set_rgb(TEAL_R, TEAL_G, TEAL_B);
    saver_on = 0;
    saver_timer = 0;
    cls_oled(OLED_BLACK);
    starfield_init();
    saver_on = 1;
    saver_timer = 0;
    ssp = 1;
}

main {
    // ---- Vibe Blocker ----
    // block_rumble() stops rumble commands coming FROM the console, so the
    // script's own set_rumble feedback (menu ticks, toggle flashes) keeps
    // working. reset_rumble() is only called once on the off-transition so
    // it never stomps a feedback vibe mid-buzz.
    if (vib_block_on != vib_block_prev) {
        if (!vib_block_on) { reset_rumble(); }
        vib_block_prev = vib_block_on;
    }
    if (vib_block_on) { block_rumble(); }

    set_rgb(TEAL_R, TEAL_G, TEAL_B);

    if (get_console() == PIO_XB1) { isXbox = 1; } else { isXbox = 0; }

    {
        if (event_press(PS4_CIRCLE) && menu_enabled && !np_active && !info_active && bind_cap_mode == 0 && qs_cap_mode == 0) {
            // Nested editor: Circle goes back to the feature page first.
            if (menu_mode == 1 && (sub_edit_open || btn_edit_open)) {
                if (sub_edit_open) {
                    page = sub_parent_page;
                    sub_edit_open = 0;
                    sub_first_page = 0;
                    sub_last_page = 0;
                }
                if (btn_edit_open) {
                    btn_edit_open = 0;
                }
                combo_run(vibration_valchg);
                set_val(PS4_CIRCLE, 0);
            } else if (menu_mode == 1) {
                menu_mode = 0;
                combo_run(vibration_valchg);
                set_val(PS4_CIRCLE, 0);
            } else {
                menu_enabled = 0;
                combo_run(vibration_off);
                set_rgb(0, 255, 0);
                saver_on = 1;
                saver_init_static();
                last_menu_page = page;
                
                btn_shot_hold_ms = ShotH;
                SaveProfile(current_profile);
                set_pvar(PVAR_LAST_PAGE, last_menu_page);
                set_pvar(PVAR_PROFILE_SLOT, current_profile);

            }
        }
        else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = last_menu_page;
            
            category_index = 0;
            for (i = 0; i < NUM_CATEGORIES; i++) {
                if (page >= CAT_START[i] && page < (CAT_START[i] + CAT_COUNT[i])) {
                    category_index = i;
                }
            }

            // Migrate old/hidden child-page saves to their parent.
            if (page == 2) page = 1;
            else if (page == 5 || page == 6) page = 4;
            else if (page == 8) page = 7;
            else if (page == 10 || page == 11) page = 9;
            else if (page == 13) page = 12;
            else if (page == 15) page = 14;
            else if (page == 18) page = 17;
            else if (page == 20) page = 19;
            else if (page == 22) page = 21;
            else if (page == 24) page = 23;
            else if (page >= 28 && page <= 31) page = 27;
            else if (page == 38) page = 37;

            // Recalculate category after migration.
            category_index = 0;
            if (page >= 1 && page <= 12) category_index = 0;
            else if (page >= 14 && page <= 20) category_index = 1;
            else if (page >= 21 && page <= 24) category_index = 2;
            else if (page >= 25 && page <= 26) category_index = 3;
            else if (page >= 27 && page <= 31) category_index = 4;
            else if (page == 32) category_index = 5;
            else if (page >= 37 && page <= 38) category_index = 6;
            else if ((page >= 33 && page <= 35) || page == 39) category_index = 7;
            else if (page == 36) category_index = 8;

            menu_mode = 0; 
            menu_scroll_y = category_index * 10;

            combo_run(vibration_on);
            set_rgb(0, 0, 255);
            saver_on = 0;
        }

        if (menu_enabled) {
            dt_menu = get_rtime();
            repeat_update(dt_menu);
            starfield_step();
            cls_oled(OLED_BLACK);
            starfield_draw();

            set_val(PS4_UP, 0); set_val(PS4_DOWN, 0); 
            set_val(PS4_LEFT, 0); set_val(PS4_RIGHT, 0); 
            if (bind_cap_mode == 0) {
                set_val(PS4_CROSS, 0); set_val(PS4_CIRCLE, 0);
            }

            if (menu_mode == 0) {
                menu_target_y = category_index * 25;
                if (menu_scroll_y < menu_target_y) menu_scroll_y = menu_scroll_y + 2;
                if (menu_scroll_y > menu_target_y) menu_scroll_y = menu_scroll_y - 2;

                for(i = 0; i < NUM_CATEGORIES; i++) {
                    c_y = 25 + (i * 25) - menu_scroll_y;
                    
                    if (c_y >= -15 && c_y <= 70) {
                        str_len = get_string_length(CATEGORIES[i]);
                        
                        if (i == category_index) {
                             x_pos = center_x(str_len, OLED_FONT_MEDIUM_WIDTH);
                             print(x_pos, c_y, OLED_FONT_MEDIUM, OLED_WHITE, CATEGORIES[i]);
                             line_oled(39, c_y + 19, 89, c_y + 19, 3, OLED_WHITE);
                        } else {
                             x_pos = center_x(str_len, OLED_FONT_SMALL_WIDTH);
                             print(x_pos, c_y + 3, OLED_FONT_SMALL, OLED_WHITE, CATEGORIES[i]);
                        }
                    }
                }
                
                if (event_press(PS4_UP)) { 
                    category_index--; 
                    if(category_index < 0) category_index = NUM_CATEGORIES - 1; 
                    combo_run(vibration_valchg); 
                }
                if (event_press(PS4_DOWN)) { 
                    category_index++; 
                    if(category_index > (NUM_CATEGORIES - 1)) category_index = 0; 
                    combo_run(vibration_valchg); 
                }
                if (event_press(PS4_CROSS)) {
                    menu_mode = 1; 
                    if (last_menu_page >= CAT_START[category_index] && last_menu_page < (CAT_START[category_index] + CAT_COUNT[category_index])) {
                        page = last_menu_page;
                    } else {
                        page = CAT_START[category_index];
                    }
                    combo_run(vibration_valchg);
                }
            } else {
                if (sub_edit_open) {
                    p_len = get_string_length(menu_header[sub_parent_page - 1]);
                    p_x = center_x(p_len, OLED_FONT_SMALL_WIDTH);
                    print(p_x, 10, OLED_FONT_SMALL, OLED_WHITE, menu_header[sub_parent_page - 1]);
                } else if (page == 39) {
                    p_len = get_string_length(QS_CAP_TITLE[0]);
                    p_x = center_x(p_len, OLED_FONT_SMALL_WIDTH);
                    print(p_x, 10, OLED_FONT_SMALL, OLED_WHITE, QS_CAP_TITLE[0]);
                } else {
                    p_len = get_string_length(menu_header[page - 1]);
                    p_x = center_x(p_len, OLED_FONT_SMALL_WIDTH);
                    print(p_x, 10, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);
                }
                
                print(2, 25, OLED_FONT_SMALL, OLED_WHITE, ARROW_L[0]);
                print(115, 25, OLED_FONT_SMALL, OLED_WHITE, ARROW_R[0]);

                dot_count = CAT_COUNT[category_index];
                if (sub_edit_open) {
                    dot_count = (sub_last_page - sub_first_page) + 1;
                    dot_start_x = 64 - ((dot_count * 10) / 2);
                    p_idx = page - sub_first_page;
                } else {
                    dot_start_x = 64 - ((dot_count * 10) / 2);
                    if (category_index == 0) {
                        if (page == 1) p_idx = 0; else if (page == 3) p_idx = 1; else if (page == 4) p_idx = 2;
                        else if (page == 7) p_idx = 3; else if (page == 9) p_idx = 4; else p_idx = 5;
                    } else if (category_index == 1) {
                        if (page == 14) p_idx = 0; else if (page == 16) p_idx = 1; else if (page == 17) p_idx = 2; else p_idx = 3;
                    } else if (category_index == 2) {
                        if (page == 21) p_idx = 0; else p_idx = 1;
                    } else if (category_index == 3) {
                        if (page == 25) p_idx = 0; else p_idx = 1;
                    } else if (category_index == 6) {
                        p_idx = 0;
                    } else if (category_index == 7) {
                        if (page == 33) p_idx = 0; else if (page == 34) p_idx = 1; else if (page == 35) p_idx = 2; else p_idx = 3;
                    } else {
                        p_idx = 0;
                    }
                }

                for(i = 0; i < dot_count; i++) {
                    if (i == p_idx) {
                        rect_oled(dot_start_x + (i * 10), 58, 5, 5, 1, 1);
                    } else {
                        rect_oled(dot_start_x + (i * 10) + 1, 59, 3, 3, 1, 1);
                    }
                }

                if (event_press(PS4_LEFT) && !np_active && !info_active && bind_cap_mode == 0 && qs_cap_mode == 0 && !btn_edit_open && !sub_edit_open) {
                    // Parent-only navigation. Child timing/option pages are nested.
                    if (category_index == 0) {
                        if (page == 1) page = 12; else if (page == 12) page = 9; else if (page == 9) page = 7;
                        else if (page == 7) page = 4; else if (page == 4) page = 3; else page = 1;
                    } else if (category_index == 1) {
                        if (page == 14) page = 19; else if (page == 19) page = 17; else if (page == 17) page = 16; else page = 14;
                    } else if (category_index == 2) {
                        if (page == 21) page = 23; else page = 21;
                    } else if (category_index == 3) {
                        if (page == 25) page = 26; else page = 25;
                    } else if (category_index == 4) {
                        page = 27;
                    } else if (category_index == 5) {
                        page = 32;
                    } else if (category_index == 6) {
                        page = 37;
                    } else if (category_index == 7) {
                        if (page == 33) page = 39; else if (page == 39) page = 35; else if (page == 35) page = 34; else page = 33;
                    } else {
                        page = 36;
                    }
                    combo_run(vibration_valchg);
                }
                if (event_press(PS4_RIGHT) && !np_active && !info_active && bind_cap_mode == 0 && qs_cap_mode == 0 && !btn_edit_open && !sub_edit_open) {
                    // Parent-only navigation. Child timing/option pages are nested.
                    if (category_index == 0) {
                        if (page == 1) page = 3; else if (page == 3) page = 4; else if (page == 4) page = 7;
                        else if (page == 7) page = 9; else if (page == 9) page = 12; else page = 1;
                    } else if (category_index == 1) {
                        if (page == 14) page = 16; else if (page == 16) page = 17; else if (page == 17) page = 19; else page = 14;
                    } else if (category_index == 2) {
                        if (page == 21) page = 23; else page = 21;
                    } else if (category_index == 3) {
                        if (page == 25) page = 26; else page = 25;
                    } else if (category_index == 4) {
                        page = 27;
                    } else if (category_index == 5) {
                        page = 32;
                    } else if (category_index == 6) {
                        page = 37;
                    } else if (category_index == 7) {
                        if (page == 33) page = 34; else if (page == 34) page = 35; else if (page == 35) page = 39; else page = 33;
                    } else {
                        page = 36;
                    }
                    combo_run(vibration_valchg);
                }
                
                if ((event_press(PS4_LEFT) || event_press(PS4_RIGHT)) && !np_active && !info_active && bind_cap_mode == 0 && qs_cap_mode == 0 && !btn_edit_open && !sub_edit_open) {
                        last_menu_page = page;
                        set_pvar(PVAR_LAST_PAGE, last_menu_page);
                }

                if (event_press(PS4_TRIANGLE) && !np_active && !info_active) {
                    info_active = 1;
                    info_page = 0;
                    combo_run(vibration_valchg);
                }

                // ---- Nested feature navigation ----
                // Parent stays active while its child setting page is shown.
                // Left/right changes only the child setting; it never escapes to
                // the next top-level feature. Circle is handled globally above.
                if (sub_edit_open && !np_active && !info_active && bind_cap_mode == 0) {
                    if (event_press(PS4_LEFT)) {
                        if (page > sub_first_page) page--; else page = sub_last_page;
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_RIGHT)) {
                        if (page < sub_last_page) page++; else page = sub_first_page;
                        combo_run(vibration_valchg);
                    }
                }

                if (!info_active) {
                // ---- Button Rhythm (Shooting) ----
                if (page == 1) {
                    menuSelection = flick_up_shooting_active;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { flick_up_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { flick_up_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                    // X opens sub-pages: Mode -> Rhythm Tempo -> Auto Hold MS
                    if (event_press(PS4_CROSS) && !np_x_last) {
                        br_sub_tab = 0;
                        sub_edit_open = 1; sub_parent_page = 1; sub_first_page = 2; sub_last_page = 2; page = 2;
                        np_x_last = 1; combo_run(vibration_valchg);
                    }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                }

                // ---- Button Rhythm sub-pages (X from Button Rhythm) ----
                // Tab 0 = Mode | Tab 1 = Rhythm Tempo | Tab 2 = Auto Hold MS
                // Left/Right switches tabs. Up/Down changes value.
                if (page == 2) {
                    // L/R switch sub-tab
                    if (event_press(PS4_LEFT)) {
                        if (br_sub_tab > 0) br_sub_tab = br_sub_tab - 1;
                        else br_sub_tab = 2;
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_RIGHT)) {
                        if (br_sub_tab < 2) br_sub_tab = br_sub_tab + 1;
                        else br_sub_tab = 0;
                        combo_run(vibration_valchg);
                    }

                    if (br_sub_tab == 0) {
                        // MODE select
                        menuSelection = br_auto_mode;
                        print(center_x(get_string_length(BR_SUB_MODE[0]), OLED_FONT_SMALL_WIDTH), 16, OLED_FONT_SMALL, OLED_WHITE, BR_SUB_MODE[0]);
                        print(center_x(get_string_length(br_mode_names[br_auto_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, br_mode_names[br_auto_mode]);
                        print(center_x(get_string_length(BR_SUB_HINT[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, BR_SUB_HINT[0]);
                        if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                            if (br_auto_mode) br_auto_mode = 0; else br_auto_mode = 1;
                            flashtoggle = br_auto_mode;
                            combo_run(vibration_valchg); combo_run(flashtog);
                        }
                    }
                    else if (br_sub_tab == 1) {
                        // RHYTHM TEMPO 0-9000
                        if (np_confirmed && np_tid == 1) { delay_duration = clamp(np_result, 0, 9000); np_confirmed = 0; }
                        if (!np_active) {
                        menuSelection = 2;
                        NumberToString(delay_duration, FindDigits(delay_duration));
                        print(center_x(get_string_length(SL_RHYTHM_TEMPO[0]), OLED_FONT_SMALL_WIDTH), 16, OLED_FONT_SMALL, OLED_WHITE, SL_RHYTHM_TEMPO[0]);
                        print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                        draw_x_graph(delay_duration, 0, 9000, 45);
                        if (event_press(PS4_UP) || repeat_up_due()) { delay_duration++; }
                        if (event_press(PS4_DOWN) || repeat_down_due()) { delay_duration--; }
                        if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                            combo_run(vibration_valchg); combo_run(flashedit);
                        }
                        if (delay_duration > 9000) { delay_duration = 9000; }
                        if (delay_duration < 0) { delay_duration = 0; }
                        if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 1; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                        if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                        }
                    }
                    else {
                        // AUTO HOLD MS 0-9000
                        if (np_confirmed && np_tid == 40) { br_auto_ms = clamp(np_result, 0, 9000); np_confirmed = 0; }
                        if (!np_active) {
                        menuSelection = 2;
                        NumberToString(br_auto_ms, FindDigits(br_auto_ms));
                        print(center_x(get_string_length(SL_AUTO_HOLD[0]), OLED_FONT_SMALL_WIDTH), 16, OLED_FONT_SMALL, OLED_WHITE, SL_AUTO_HOLD[0]);
                        print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                        draw_x_graph(br_auto_ms, 0, 9000, 45);
                        if (event_press(PS4_UP) || repeat_up_due()) { br_auto_ms++; }
                        if (event_press(PS4_DOWN) || repeat_down_due()) { br_auto_ms--; }
                        if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                            combo_run(vibration_valchg); combo_run(flashedit);
                        }
                        if (br_auto_ms > 9000) { br_auto_ms = 9000; }
                        if (br_auto_ms < 0) { br_auto_ms = 0; }
                        if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 40; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                        if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                        }
                    }
                }

                // ---- Remap Button (Shooting) ----
                if (page == 3) {
                    menuSelection = remap_square_active;
                    if (isXbox) {
                        print(
                            center_x(get_string_length(remap_modes_xb[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                            30, OLED_FONT_MEDIUM, OLED_WHITE,
                            remap_modes_xb[menuSelection]
                        );
                    } else {
                        print(
                            center_x(get_string_length(remap_modes_ps[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                            30, OLED_FONT_MEDIUM, OLED_WHITE,
                            remap_modes_ps[menuSelection]
                        );
                    }
                    if (event_press(PS4_UP)) { remap_square_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { remap_square_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                // ---- Smart Timing (Shooting) ----
                if (page == 4) {
                    menuSelection = smart_timing_enabled;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { smart_timing_enabled = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { smart_timing_enabled = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_CROSS) && !np_x_last) {
                        sub_edit_open = 1; sub_parent_page = 4; sub_first_page = 5; sub_last_page = 6; page = 5;
                        np_x_last = 1; combo_run(vibration_valchg);
                    }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                }

                // ---- Smart Timing: Fade Assist (ms) (Shooting) ----
                if (page == 5) {
                    if (np_confirmed && np_tid == 2) { smart_fade_offset = clamp(np_result, 0, 100); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(smart_fade_offset, FindDigits(smart_fade_offset));
                    print(center_x(get_string_length(SL_FADE_ASSIST[0]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, SL_FADE_ASSIST[0]);
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(smart_fade_offset, 0, 100, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { smart_fade_offset++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { smart_fade_offset--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (smart_fade_offset > 100) { smart_fade_offset = 100; }
                    if (smart_fade_offset < 0) { smart_fade_offset = 0; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 2; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                // ---- Smart Timing: Pull-Up Assist (ms) (Shooting) ----
                if (page == 6) {
                    if (np_confirmed && np_tid == 3) { smart_quick_offset = clamp(np_result, 0, 100); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(smart_quick_offset, FindDigits(smart_quick_offset));
                    print(center_x(get_string_length(SL_PULLUP_ASSIST[0]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, SL_PULLUP_ASSIST[0]);
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(smart_quick_offset, 0, 100, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { smart_quick_offset++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { smart_quick_offset--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (smart_quick_offset > 100) { smart_quick_offset = 100; }
                    if (smart_quick_offset < 0) { smart_quick_offset = 0; }
