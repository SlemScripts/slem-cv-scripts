                                    print(64, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_xb[bind_cap_name_idx]);
                                } else {
                                    print(24, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_ps[0]);
                                    print(64, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_ps[bind_cap_name_idx]);
                                }
                            }
                            print(center_x(get_string_length(bind_cap_apply[0]), OLED_FONT_SMALL_WIDTH), 46, OLED_FONT_SMALL, OLED_WHITE, bind_cap_apply[0]);
                        } else {
                            // R2 released — save if a button was captured, else just exit
                            if (bind_cap_name_idx != 11) {
                                dunk_bind_btn = bind_cap_btn;
                                bind_name_idx = bind_cap_name_idx;
                                set_pvar(PVAR_DUNK_BIND, bind_name_idx);
                            }
                            bind_cap_mode = 0;
                            combo_run(vibration_valchg);
                        }
                    }
                }




                // ---- Auto Stand Still (Shooting) ----
                if (page == 9) {
