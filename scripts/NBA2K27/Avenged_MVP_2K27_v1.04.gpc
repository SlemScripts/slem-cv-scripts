    set_val(PS4_R2, 0); wait(130);
    drib_busy = 0;
}
combo mv_sizeup_esc {
    set_val(PS4_R2, 100); set_val(PS4_RX, -80); wait(35);
    set_val(PS4_R2, 100); set_val(PS4_RX, 80); wait(35);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0); set_val(PS4_RY, 100); wait(45);
    set_val(PS4_R2, 0); set_val(PS4_RY, 0); wait(130);
