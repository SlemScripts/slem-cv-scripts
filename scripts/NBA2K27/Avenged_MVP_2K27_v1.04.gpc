                if (page == 28) {
                    print(center_x(get_string_length(drib_move_names[drib_up]), OLED_FONT_SMALL_WIDTH), 28, OLED_FONT_SMALL, OLED_WHITE, drib_move_names[drib_up]);
                    if (event_press(PS4_UP)) {
