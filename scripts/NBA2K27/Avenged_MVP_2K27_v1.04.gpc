                            else if (qs_cap_step == 1 && qs_btn1 != PS4_LEFT) { qs_btn2 = PS4_LEFT; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_RIGHT)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_RIGHT; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_RIGHT) { qs_btn2 = PS4_RIGHT; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_L3)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_L3; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_L3) { qs_btn2 = PS4_L3; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_R3)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_R3; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_R3) { qs_btn2 = PS4_R3; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }

                        // Auto-finish after 2 buttons
                        if (qs_cap_step >= 2) {
                            qs_cap_mode = 0;
                            qs_circle_held = 0;
                            combo_run(vibration_on);
                        }

                        // Block normal menu nav buttons while capturing
                        set_val(PS4_CROSS, 0);
                        set_val(PS4_CIRCLE, 0);
                    }
                }

                if (page == 36) {
                    menuSelection = profile_sel;
                   
                    profile_idx = profile_sel - 1;
                    if (profile_idx < 0) profile_idx = 0;
                    if (profile_idx > (PROFILE_MAX - 1)) profile_idx = PROFILE_MAX - 1;

                    print(
                        center_x(get_string_length(profile_labels[profile_idx]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        profile_labels[profile_idx]
                    );

                    if (profile_sel == current_profile) {
                        print(center_x(get_string_length(profile_active_txt[0]), OLED_FONT_SMALL_WIDTH), 42, OLED_FONT_SMALL, OLED_WHITE, profile_active_txt[0]);
                    } else {
                        print(center_x(get_string_length(profile_load_txt[0]), OLED_FONT_SMALL_WIDTH), 42, OLED_FONT_SMALL, OLED_WHITE, profile_load_txt[0]);
                    }

                    loaded_idx = current_profile - 1;
                    if (loaded_idx < 0) loaded_idx = 0;
                    if (loaded_idx > (PROFILE_MAX - 1)) loaded_idx = PROFILE_MAX - 1;
                    print(center_x(get_string_length(profile_loaded_labels[loaded_idx]), OLED_FONT_SMALL_WIDTH), 54, OLED_FONT_SMALL, OLED_WHITE, profile_loaded_labels[loaded_idx]);

                    if (event_press(PS4_UP)) {
                        profile_sel++;
                        if (profile_sel > PROFILE_MAX) profile_sel = PROFILE_MIN;
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_DOWN)) {
                        profile_sel--;
                        if (profile_sel < PROFILE_MIN) profile_sel = PROFILE_MAX;
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_CROSS)) {
                        SaveProfile(current_profile);
                        current_profile = profile_sel;
                        LoadProfile(current_profile);
                        set_pvar(PVAR_PROFILE_SLOT, current_profile);
                        combo_run(vibration_valchg);
                        combo_run(profileFlash);
                    }
                }

                // ---- RS Shooting category (pages 37-38) ----
                if (page == 37) {
                    menuSelection = rs_shoot_on;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { rs_shoot_on = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { rs_shoot_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_CROSS) && !np_x_last) {
                        sub_edit_open = 1; sub_parent_page = 37; sub_first_page = 38; sub_last_page = 38; page = 38;
                        np_x_last = 1; combo_run(vibration_valchg);
                    }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                }

                if (page == 38) {
                    if (np_confirmed && np_tid == 37) { rs_hold_time = clamp(np_result, 50, 2000); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(rs_hold_time, FindDigits(rs_hold_time));
                    print(center_x(get_string_length(SL_RS_HOLD_TIME[0]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, SL_RS_HOLD_TIME[0]);
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(rs_hold_time, 50, 2000, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { rs_hold_time++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { rs_hold_time--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (rs_hold_time > 2000) rs_hold_time = 2000;
                    if (rs_hold_time < 50) rs_hold_time = 50;
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 37; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }
                }

                // ═══════════════ INFO PANEL (Triangle) ═══════════════
                if (info_active) {
                    info_idx = page - 1;
                    if (info_idx < 0) info_idx = 0;
                    if (info_idx > (numpgs - 1)) info_idx = numpgs - 1;
                    cls_oled(OLED_BLACK);
                    if (isXbox) {
                        print(center_x(get_string_length(INFO_L0_XB[info_idx]), OLED_FONT_SMALL_WIDTH), 6, OLED_FONT_SMALL, OLED_WHITE, INFO_L0_XB[info_idx]);
                        if (info_page == 0) {
                            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, INFO_L1_XB[info_idx]);
                            print(0, 36, OLED_FONT_SMALL, OLED_WHITE, INFO_L2_XB[info_idx]);
                            print(0, 55, OLED_FONT_SMALL, OLED_WHITE, INFO_HINT[0]);
                        } else if (info_page == 1) {
                            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, INFO_C1_XB[info_idx]);
                            print(0, 36, OLED_FONT_SMALL, OLED_WHITE, INFO_C2_XB[info_idx]);
                            print(0, 55, OLED_FONT_SMALL, OLED_WHITE, INFO_HINT[1]);
                        } else {
                            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, INFO_U1_XB[info_idx]);
                            print(0, 36, OLED_FONT_SMALL, OLED_WHITE, INFO_U2_XB[info_idx]);
                            print(0, 55, OLED_FONT_SMALL, OLED_WHITE, INFO_HINT[2]);
                        }
                    } else {
                        print(center_x(get_string_length(INFO_L0[info_idx]), OLED_FONT_SMALL_WIDTH), 6, OLED_FONT_SMALL, OLED_WHITE, INFO_L0[info_idx]);
                        if (info_page == 0) {
                            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, INFO_L1[info_idx]);
                            print(0, 36, OLED_FONT_SMALL, OLED_WHITE, INFO_L2[info_idx]);
                            print(0, 55, OLED_FONT_SMALL, OLED_WHITE, INFO_HINT[0]);
                        } else if (info_page == 1) {
                            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, INFO_C1[info_idx]);
                            print(0, 36, OLED_FONT_SMALL, OLED_WHITE, INFO_C2[info_idx]);
                            print(0, 55, OLED_FONT_SMALL, OLED_WHITE, INFO_HINT[1]);
                        } else {
                            print(0, 24, OLED_FONT_SMALL, OLED_WHITE, INFO_U1[info_idx]);
                            print(0, 36, OLED_FONT_SMALL, OLED_WHITE, INFO_U2[info_idx]);
                            print(0, 55, OLED_FONT_SMALL, OLED_WHITE, INFO_HINT[2]);
                        }
                    }
                    if (event_press(PS4_CROSS)) {
                        info_page = (info_page + 1) % 3;
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_CIRCLE)) {
                        info_active = 0;
                        info_page = 0;
                        combo_run(vibration_valchg);
                    }
                }
                // ════════════════════════════════════════════════════

                // ═══════════════ CUSTOM NUMPAD INPUT ═══════════════
                if (np_active) {
                    cls_oled(OLED_BLACK);
                    if (np_tid == 40) print(0, 2, OLED_FONT_SMALL, OLED_WHITE, SL_AUTO_HOLD[0]);
                    else if (np_tid >= 1 && np_tid <= 18) print(0, 2, OLED_FONT_SMALL, OLED_WHITE, np_labels[np_tid - 1]);
                    else print(0, 2, OLED_FONT_SMALL, OLED_WHITE, SL_TEMPO[0]);
                    print( 4, 13, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[0]);
                    print(18, 13, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[1]);
                    print(32, 13, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[2]);
                    print(46, 13, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[3]);
                    print(60, 13, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[4]);
                    print( 4, 25, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[5]);
                    print(18, 25, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[6]);
                    print(32, 25, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[7]);
                    print(46, 25, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[8]);
                    print(60, 25, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[9]);
                    print(80, 25, OLED_FONT_SMALL, OLED_WHITE, NP_OK[0]);
                    if (np_cur < 5)       { np_cx = 3 + np_cur * 14;       np_cy = 12; }
                    else if (np_cur < 10) { np_cx = 3 + (np_cur - 5) * 14; np_cy = 24; }
                    if (np_cur < 10) { rect_oled(np_cx, np_cy, 9, 9, 0, OLED_WHITE); }
                    if (np_cur == 10) { rect_oled(78, 23, 16, 10, 0, OLED_WHITE); }
                    print( 4, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DASH[0]);
                    print(24, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DASH[0]);
                    print(44, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DASH[0]);
                    print(64, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DASH[0]);
                    print(84, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DASH[0]);
                    print(104, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DASH[0]);
                    if (np_len >= 1) { print( 4, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[np_d0]); }
                    if (np_len >= 2) { print(24, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[np_d1]); }
                    if (np_len >= 3) { print(44, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[np_d2]); }
                    if (np_len >= 4) { print(64, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[np_d3]); }
                    if (np_len >= 5) { print(84, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[np_d4]); }
                    if (np_len >= 6) { print(104, 36, OLED_FONT_SMALL, OLED_WHITE, NP_DIG[np_d5]); }
                    print(0, 52, OLED_FONT_SMALL, OLED_WHITE, NP_HINT[0]);
                    if (event_press(PS4_LEFT)) {
                        if (np_cur == 10) { np_cur = 9; }
                        else if (np_cur == 5) { np_cur = 10; }
                        else if ((np_cur % 5) > 0) { np_cur = np_cur - 1; }
                        else { np_cur = np_cur + 4; }
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_RIGHT)) {
                        if (np_cur == 9) { np_cur = 10; }
                        else if (np_cur == 10) { np_cur = 5; }
                        else if ((np_cur % 5) < 4) { np_cur = np_cur + 1; }
                        else { np_cur = np_cur - 4; }
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_UP)) {
                        if (np_cur == 10) { np_cur = 4; }
                        else if (np_cur >= 5) { np_cur = np_cur - 5; }
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_DOWN)) {
                        if (np_cur < 5) { np_cur = np_cur + 5; }
                        else if (np_cur == 4) { np_cur = 10; }
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_CROSS)) {
                        if (np_len == 1) { np_disp = np_d0; }
                        else if (np_len == 2) { np_disp = np_d0 * 10 + np_d1; }
                        else if (np_len == 3) { np_disp = np_d0 * 100 + np_d1 * 10 + np_d2; }
                        else if (np_len == 4) { np_disp = np_d0 * 1000 + np_d1 * 100 + np_d2 * 10 + np_d3; }
                        else if (np_len == 5) { np_disp = np_d0 * 10000 + np_d1 * 1000 + np_d2 * 100 + np_d3 * 10 + np_d4; }
                        else if (np_len == 6) { np_disp = np_d0 * 100000 + np_d1 * 10000 + np_d2 * 1000 + np_d3 * 100 + np_d4 * 10 + np_d5; }
                        else { np_disp = 0; }
                        if (np_cur == 10 && np_len > 0) {
                            np_result = np_disp; np_confirmed = 1; np_active = 0; np_len = 0;
                            np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1;
                            if (np_tid == 1) {
                                delay_duration = np_result;
                                if (delay_duration < 0) delay_duration = 0;
                                if (delay_duration > 9000) delay_duration = 9000;
                                np_confirmed = 0;
                            }
                            if (np_tid == 40) {
                                br_auto_ms = np_result;
                                if (br_auto_ms < 0) br_auto_ms = 0;
                                if (br_auto_ms > 9000) br_auto_ms = 9000;
                                np_confirmed = 0;
                            }
                            combo_run(vibration_valchg);
                        }
                        else if (np_cur < 10 && np_len < 6) {
                            if (np_len == 0) { np_d0 = np_cur; }
                            else if (np_len == 1) { np_d1 = np_cur; }
                            else if (np_len == 2) { np_d2 = np_cur; }
                            else if (np_len == 3) { np_d3 = np_cur; }
                            else if (np_len == 4) { np_d4 = np_cur; }
                            else { np_d5 = np_cur; }
                            np_len++;
                            combo_run(vibration_valchg);
                        }
                    }
                    if (event_press(PS4_SQUARE) && np_len > 0) {
                        np_len--;
                        if (np_len == 0) { np_d0 = -1; }
                        else if (np_len == 1) { np_d1 = -1; }
                        else if (np_len == 2) { np_d2 = -1; }
                        else if (np_len == 3) { np_d3 = -1; }
                        else if (np_len == 4) { np_d4 = -1; }
                        else { np_d5 = -1; }
                        combo_run(vibration_valchg);
                    }
                    if (event_press(PS4_CIRCLE)) {
                        np_active = 0; np_len = 0;
                        np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1;
                       
                        combo_run(vibration_valchg);
                    }
                }
                // ════════════════════════════════════════════════════
            }
        }

        if (!menu_enabled) {
            set_rgb(0, 255, 0);

            // ==================== Soft Triggers (fully digital R2/L2) ====================
            // Removes analog creep: any press at all reads as a full 100, and
            // anything below the deadzone reads as a clean 0. Runs first so
            // every other check in this frame (sprint, dunk, shot triggers,
            // etc.) sees the same clean digital value.
            if (tk_at_on) {
                if (get_val(PS4_R2) > 10) { set_val(PS4_R2, 100); } else { set_val(PS4_R2, 0); }
                if (get_val(PS4_L2) > 10) { set_val(PS4_L2, 100); } else { set_val(PS4_L2, 0); }
            }

            if (saver_on) {
                saver_timer += get_rtime();
                if (saver_timer >= 35) {
                    if (shotlog_enabled) { draw_shotlog(); } else { saver_step(); }
                    saver_timer = 0;
                }
            }

            r2_recent_ms -= get_rtime();
            if (r2_recent_ms < 0) r2_recent_ms = 0;
            if (get_val(PS4_R2) > 30) r2_recent_ms = 200;

            // dunk_guard: true while a dunk-meter charge is plausibly in
            // progress, so Unlimited Sprint leaves the left stick alone.
            dunk_guard = (dunk_meter_on && get_val(dunk_bind_btn) && (get_val(PS4_R2) > 30 || r2_recent_ms > 0));
            combo_run(Unlimited_Stamina_Control);

            // ==================== Smart Timing (release-offset classifier) ====================
            // Watches the sticks every frame and buckets the current shot attempt
            // into one of three release characters, then nudges the flick-release
            // wait to match. Runs even when the toggle is off (cheap), but only
            // feeds into shot_offset when smart_timing_enabled is set, so it never
            // changes anything unless the player turns it on.
            rs_recent_timer -= get_rtime();
            if (rs_recent_timer < 0) { rs_recent_timer = 0; }
            if (abs(get_val(PS4_RX)) > 25 || abs(get_val(PS4_RY)) > 25) { rs_recent_timer = 550; }

            if (smart_timing_enabled) {
                if (abs(get_val(PS4_LX)) > 25 || abs(get_val(PS4_LY)) > 25) {
                    shot_offset = smart_fade_offset;       // drifting/moving reads as a fade attempt
                } else if (rs_recent_timer > 0) {
                    shot_offset = 0 - smart_quick_offset; // stick was just active -- treat as a quick pull-up
                } else {
                    shot_offset = 0;                     // stationary catch-and-shoot, no nudge
                }
            } else {
                shot_offset = 0;
            }
            // If this press already latched as a fade, the Fade combos add
            // fade_delay_ms themselves -- don't ALSO stack the smart fade
            // nudge on top (with defaults that double-counted ~30ms and made
            // Smart Timing fades release noticeably late).
            if (fade_intent) { shot_offset = 0; }
            effective_wait = delay_duration + shot_offset;
            if (effective_wait < 0) { effective_wait = 0; }

            // Fixed, sane release randomization (was previously overridden every
            // frame by an unreachable "stability" formula defaulting to a very
            // wide jitter range -- that continuous large stick wobble during
            // the hold was being read by the game as repeated release/recharge
            // cycles, causing the multi-pump-fake-before-real-shot bug).
            random_variation_min = -7;
            random_variation_max = 7;
            random_hold_variation_min = -2;
            random_hold_variation_max = 2;

            if (remap_square_active == 0) {
                if (get_val(PS4_L3)) { set_val(PS4_SQUARE, 100); }
            } else {
                if (get_val(PS4_R3)) { set_val(PS4_SQUARE, 100); }
            }

            // ==================== Release Timing Feedback ====================
            // Independent of flick_up_shooting_active -- tracks a hold on
            // Square (or L3/R3, since remap already fed into Square above)
            // whether or not Button Rhythm assistance is switched on.
            if (event_press(PS4_SQUARE)) {
                shot_press_ms = 0;
                shot_charging = 1;
                shot_log_nodip = 0;
                shot_vibe_fired = 0;
                fade_vibe_fired = 0;
            }
            if (shot_charging) {
                shot_press_ms += get_rtime();
                // Latch ND any time during the hold (do NOT clear until release)
                // so the Shot Log still records ND even if L2 is let go first.
                if (nodip_enabled && get_val(PS4_L2) > 20 && !fade_intent) {
                    shot_log_nodip = 1;
                }
                if (flick_up_shooting_active && fade_intent) {
                    if (fade_vibe_enabled && !fade_vibe_fired && shot_press_ms >= fade_vibe_ms) {
                        combo_run(fade_vibe_pulse);
                        fade_vibe_fired = 1;
                    }
                } else {
                    if (shot_vibe_enabled && !shot_vibe_fired && shot_press_ms >= shot_vibe_ms) {
                        combo_run(shot_vibe_pulse);
                        shot_vibe_fired = 1;
                    }
                }
            }
            if (event_release(PS4_SQUARE)) {
                if (shot_charging) {
                    shotlog_last_ms = shot_press_ms;
                    if (fade_intent) {
                        shotlog_last_type = 1;
                        shotlog_fade_ms = shot_press_ms;
                    } else if (shot_log_nodip) {
                        shotlog_last_type = 2;
                        shotlog_nodip_ms = shot_press_ms;
                    } else {
                        shotlog_last_type = 0;
                        shotlog_normal_ms = shot_press_ms;
                    }
                }
                shot_charging = 0;
                // keep shot_log_nodip until after rhythm release uses it; clear next press
            }

            // SQ Go To Shot rem
            // ---- Automation: stick click + context hold ----
            // Stick = free stick (opposite of Remap): Remap R3 -> use L3, Remap L3 -> use R3
            // Stand Still: stick only (no L2, no R2)
            // Fade:       R2 + stick
            // No-Dip:     L2 + stick
            if (!combo_running(Auto_Stand_Smooth) && !combo_running(Auto_Stand_Reversed)
             && !combo_running(Auto_Fade_Smooth) && !combo_running(Auto_Fade_Reversed)
             && !combo_running(Auto_NoDip_Smooth) && !combo_running(Auto_NoDip_Reversed)) {
                auto_stick = 0;
                if (remap_square_active == 0 && event_press(PS4_R3)) auto_stick = 1;
                if (remap_square_active == 1 && event_press(PS4_L3)) auto_stick = 1;
                if (auto_stick) {
                    if (auto_fade_on && get_val(PS4_R2) > 20 && get_val(PS4_L2) <= 20) {
                        if (reverse_flick_mode) combo_run(Auto_Fade_Reversed);
                        else combo_run(Auto_Fade_Smooth);
                    } else if (auto_nodip_on && get_val(PS4_L2) > 20) {
                        if (reverse_flick_mode) combo_run(Auto_NoDip_Reversed);
                        else combo_run(Auto_NoDip_Smooth);
                    } else if (auto_stand_on && get_val(PS4_L2) <= 20 && get_val(PS4_R2) <= 20) {
                        if (reverse_flick_mode) combo_run(Auto_Stand_Reversed);
                        else combo_run(Auto_Stand_Smooth);
                    }
                }
            }

            // ---- Dribble moves on D-pad (when enabled) ----
            // ---- Quick Stop ----
            if (qs_on && !menu_enabled && qs_btn1 != 0) {
                if (qs_btn2 == 0) {
                    if (event_press(qs_btn1)) combo_run(Quick_Stop_Move);
                } else {
                    if (get_val(qs_btn1) && event_press(qs_btn2)) combo_run(Quick_Stop_Move);
                    if (get_val(qs_btn2) && event_press(qs_btn1)) combo_run(Quick_Stop_Move);
                }
            }

            if (dribble_on && !drib_busy && !get_val(PS4_L2)) {
                if (event_press(PS4_UP) && drib_up > 0) { drib_busy = 1; drib_busy_ms = 0; fire_dribble(drib_up); }
                else if (event_press(PS4_DOWN) && drib_dn > 0) { drib_busy = 1; drib_busy_ms = 0; fire_dribble(drib_dn); }
                else if (event_press(PS4_LEFT) && drib_lf > 0) { drib_busy = 1; drib_busy_ms = 0; fire_dribble(drib_lf); }
                else if (event_press(PS4_RIGHT) && drib_rt > 0) { drib_busy = 1; drib_busy_ms = 0; fire_dribble(drib_rt); }
            }
            // Swallow bound d-pad directions so the game never sees them.
            // Without this, every dribble tap ALSO reached NBA 2K's own d-pad
            // handling (playcalling / on-the-fly coaching), which popped its
            // overlay mid-move -- that was the in-game "glitch". Directions
            // left on Off still pass through, and holding L2 bypasses the
            // whole system so d-pad playcalling stays reachable on demand.
            if (dribble_on && !get_val(PS4_L2)) {
                if (drib_up > 0) { set_val(PS4_UP, 0); }
                if (drib_dn > 0) { set_val(PS4_DOWN, 0); }
                if (drib_lf > 0) { set_val(PS4_LEFT, 0); }
                if (drib_rt > 0) { set_val(PS4_RIGHT, 0); }
            }
            // drib_busy is now a latch: set here on fire, cleared by the move
            // combo itself on its final step. (The old version counted 40 main
            // iterations -- roughly 400ms -- so any move longer than that could
            // be double-fired mid-combo; two combos fighting over the sticks
            // produced broken half-moves.) The ms counter below is only a
            // safety net in case a combo ever gets interrupted.
            if (drib_busy) {
                drib_busy_ms = drib_busy_ms + get_rtime();
                if (drib_busy_ms > 2200) { drib_busy = 0; drib_busy_ms = 0; }
            }



            // ==================== Button Rhythm ====================
            // 0 = Rhythm (you release) | 1 = Auto Hold (script releases)
            // L/R on Button Rhythm page switches mode. Button Shot untouched.
            if (flick_up_shooting_active && !btn_shot_on) {
                if (br_auto_mode) {
                    if (br_hold_active) {
                        set_val(PS4_SQUARE, 0);
                    }
                    else if (!get_val(PS4_R1) && !get_val(PS4_LEFT)
                        && !(remap_square_active == 0 && get_val(PS4_L3))
                        && !(remap_square_active == 1 && get_val(PS4_R3))
                        && event_press(PS4_SQUARE)) {
                        sq_shot_active = 1;
                        br_hold_active = 1;
                        if (fade_toggle && (abs(get_val(PS4_LX)) > 25 || abs(get_val(PS4_LY)) > 25))
                            fade_intent = 1;
                        else
                            fade_intent = 0;
                        if (!fade_intent && nodip_enabled && get_val(PS4_L2) > 20)
                            shot_log_nodip = 1;
                        else
                            shot_log_nodip = 0;
                        if (fade_intent) {
                            if (reverse_flick_mode && get_val(PS4_R2)) combo_run(BR_Auto_Fade_Rev);
                            else combo_run(BR_Auto_Fade);
                        } else if (shot_log_nodip) {
                            if (reverse_flick_mode && get_val(PS4_R2)) combo_run(BR_Auto_NoDip_Rev);
                            else combo_run(BR_Auto_NoDip);
                        } else {
                            if (reverse_flick_mode && get_val(PS4_R2)) combo_run(BR_Auto_Hold_Rev);
                            else combo_run(BR_Auto_Hold);
                        }
                    }
                    if (event_release(PS4_SQUARE) && !br_hold_active) {
                        fade_intent = 0; shot_log_nodip = 0; sq_shot_active = 0;
                    }
                } else {
                    if (!get_val(PS4_R1) && !get_val(PS4_LEFT)
                        && !(remap_square_active == 0 && get_val(PS4_L3))
                        && !(remap_square_active == 1 && get_val(PS4_R3))
                        && get_val(PS4_SQUARE)) {
                        if (event_press(PS4_SQUARE)) {
                            sq_shot_active = 1;
                            if (fade_toggle && (abs(get_val(PS4_LX)) > 25 || abs(get_val(PS4_LY)) > 25))
                                fade_intent = 1;
                            else
                                fade_intent = 0;
                            if (!fade_intent && nodip_enabled && get_val(PS4_L2) > 20)
                                shot_log_nodip = 1;
                        }
                        set_val(PS4_SQUARE, 0);
                        if (reverse_flick_mode && get_val(PS4_R2))
                            set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                        else
                            set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                        set_val(PS4_RX, random(random_variation_min, random_variation_max));
                    }
                    if (!(remap_square_active == 0 && get_val(PS4_L3))
                        && !(remap_square_active == 1 && get_val(PS4_R3))
                        && event_release(PS4_SQUARE)) {
                        if (sq_shot_active) {
                            if (fade_intent) {
                                if (reverse_flick_mode && get_val(PS4_R2)) combo_run(Fade_flick_up_rs_reversed);
                                else combo_run(Fade_flick_up_rs_smooth);
                            } else if (nodip_enabled && shot_log_nodip) {
                                if (reverse_flick_mode && get_val(PS4_R2)) combo_run(Release_NoDip_Reversed);
                                else combo_run(Release_NoDip_Smooth);
                            } else {
                                if (reverse_flick_mode && get_val(PS4_R2)) combo_run(flick_up_rs_reversed);
                                else combo_run(flick_up_rs_smooth);
                            }
                        }
                        fade_intent = 0; shot_log_nodip = 0; sq_shot_active = 0;
                    }
                }
            }

            // ==================== RS Shooting (V8) ====================
            // Hold RS past threshold, release after rs_hold_time → auto flick
            if (rs_shoot_on && !dunk_guard && !get_val(PS4_L2)) {
                if (abs(get_val(PS4_RY)) > 40 || abs(get_val(PS4_RX)) > 40) {
                    if (!rs_shot_active) {
                        rs_shot_active = 1;
                        rs_hold_elapsed = 0;
                        if (get_val(PS4_RY) < -30) rs_shot_dir = 1;
                        else rs_shot_dir = 0;
                    }
                    rs_hold_elapsed += get_rtime();
                } else if (rs_shot_active) {
                    if (rs_hold_elapsed >= rs_hold_time) {
                        if (rs_shot_dir || (reverse_flick_mode && get_val(PS4_R2))) {
                            combo_run(flick_up_rs_reversed);
                        } else {
                            combo_run(flick_up_rs_smooth);
                        }
                    }
                    rs_shot_active = 0;
                    rs_hold_elapsed = 0;
                }
            } else {
                rs_shot_active = 0;
                rs_hold_elapsed = 0;
            }

            // ==================== Button Shot ====================
            // Directional hold-release. On Square press read LX once, then
            // fire the matching hold combo. While a combo is active we keep
            // Square forced off so a long physical press cannot overshoot.
            if (btn_shot_on && !get_val(PS4_R1) && !get_val(PS4_LEFT)) {
                if (btn_hold_active) {
                    set_val(PS4_SQUARE, 0);
                } else if (event_press(PS4_SQUARE)) {
                    if (get_val(PS4_LX) <= -25) {
                        combo_run(BtnHold_FadeL);
                    } else if (get_val(PS4_LX) >= 25) {
                        combo_run(BtnHold_FadeR);
                    } else {
                        combo_run(BtnHold_Shot);
                    }
                    btn_hold_active = 1;
                    set_val(PS4_SQUARE, 0);
                }
                // Optional catch sequence on LB
                if (event_press(PS4_L1) && !btn_hold_active) {
                    combo_run(BtnHold_Catch);
                    btn_hold_active = 1;
                }
            } else {
                btn_hold_active = 0;
            }

            if (dunk_meter_on) {
                if (get_val(PS4_R2) > 50 && get_val(dunk_bind_btn)) {
                    if (dunk_release_l1) {
                        // Meter already maxed out during THIS hold -- snap the
                        // stick back to center right away and keep it there.
                        // Fire the release flick the instant the meter fills
                        // instead of waiting for a physical button release.
                        set_val(PS4_RY, 0);
                        set_val(PS4_RX, 0);
                    } else if (!dunk_fired_l1) {
                        dunk_hold_ms_l1 += get_rtime();
                        set_val(PS4_RY, -100);
                        if (dunk_hold_ms_l1 >= dunk_hold_dur) {
                            dunk_hold_ms_l1 = 0;
                            dunk_fired_l1 = 1;
                            dunk_release_l1 = 1; // fire the release this same frame
                        }
                    }
                } else {
                    dunk_hold_ms_l1 = 0;
                    dunk_fired_l1 = 0;
                    dunk_release_l1 = 0;
                }
            } else {
                dunk_hold_ms_l1 = 0;
                dunk_fired_l1 = 0;
                dunk_release_l1 = 0;
            }
        }
    }
}

// No-Dip flick timing
// ---- Button Shot hold-release combos ----
combo BtnHold_Shot {
    set_val(PS4_SQUARE, 100);
    wait(abs(ShotH));
    set_val(PS4_SQUARE, 0);
    wait(abs(ShotV));
    btn_hold_active = 0;
}

combo BtnHold_FadeL {
    set_val(PS4_SQUARE, 100);
    wait(abs(FadeLH));
    set_val(PS4_SQUARE, 0);
    wait(abs(FadeLV));
    btn_hold_active = 0;
}

combo BtnHold_FadeR {
    set_val(PS4_SQUARE, 100);
    wait(abs(FadeRH));
    set_val(PS4_SQUARE, 0);
    wait(abs(FadeRV));
    btn_hold_active = 0;
}

combo BtnHold_Catch {
    set_val(PS4_CIRCLE, 100);
    set_val(PS4_TRIANGLE, 100);
    wait(225);
    set_val(PS4_CIRCLE, 0);
    set_val(PS4_TRIANGLE, 0);
    wait(25);
    set_val(PS4_SQUARE, 100);
    wait(abs(CatchH));
    set_val(PS4_SQUARE, 0);
    wait(abs(CatchV));
    btn_hold_active = 0;
}

// ---- Auto Hold combos ----
combo BR_Auto_Hold {
    set_val(PS4_SQUARE, 100);
    wait(max(1, br_auto_ms + shot_offset));
    set_val(PS4_SQUARE, 0);
    br_hold_active = 0; sq_shot_active = 0; fade_intent = 0; shot_log_nodip = 0;
}
combo BR_Auto_Hold_Rev {
    set_val(PS4_SQUARE, 100);
    wait(max(1, br_auto_ms + shot_offset));
    set_val(PS4_SQUARE, 0);
    br_hold_active = 0; sq_shot_active = 0; fade_intent = 0; shot_log_nodip = 0;
}
combo BR_Auto_NoDip {
    set_val(PS4_SQUARE, 100);
    wait(max(1, nodip_tempo_ms + (br_auto_ms / 10)));
    set_val(PS4_SQUARE, 0);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(80);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
    br_hold_active = 0; sq_shot_active = 0; fade_intent = 0; shot_log_nodip = 0;
}
combo BR_Auto_NoDip_Rev {
    set_val(PS4_SQUARE, 100);
    wait(max(1, nodip_tempo_ms + (br_auto_ms / 10)));
    set_val(PS4_SQUARE, 0);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(80);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
    br_hold_active = 0; sq_shot_active = 0; fade_intent = 0; shot_log_nodip = 0;
}
combo BR_Auto_Fade {
    set_val(PS4_SQUARE, 100);
    wait(max(1, br_auto_ms + fade_delay_ms + shot_offset));
    set_val(PS4_SQUARE, 0);
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(max(1, effective_wait));
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(200);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
    br_hold_active = 0; sq_shot_active = 0; fade_intent = 0; shot_log_nodip = 0;
}
combo BR_Auto_Fade_Rev {
    set_val(PS4_SQUARE, 100);
    wait(max(1, br_auto_ms + fade_delay_ms + shot_offset));
    set_val(PS4_SQUARE, 0);
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(max(1, effective_wait));
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(200);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
    br_hold_active = 0; sq_shot_active = 0; fade_intent = 0; shot_log_nodip = 0;
}

combo flick_up_rs_smooth {
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(effective_wait);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo flick_up_rs_reversed {
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(effective_wait);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Fade_flick_up_rs_smooth {
    wait(fade_delay_ms);
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(effective_wait);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Fade_flick_up_rs_reversed {
    wait(fade_delay_ms);
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(effective_wait);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

// No-Dip: skips the two-stage hold-then-flick motion the other release
// combos use -- jumps straight to full stick deflection after a single
// wait, so there's no intermediate dip/pump pose in the release.
combo Release_NoDip_Smooth {
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(nodip_tempo_ms);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Release_NoDip_Reversed {
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(nodip_tempo_ms);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

// Fires the moment the player lets go of R2/the dunk-bind button after
// fully charging the Dunk Meter -- that release IS the "throw it down"
// action, so it needs its own committed flick instead of just zeroing
// the stick while the buttons are still (no longer) held.

// ---- Automation combos (L3/R3 one-tap shots) ----
combo Auto_Stand_Smooth {
    set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(auto_speed_ms);
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(auto_tempo_ms);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}
combo Auto_Stand_Reversed {
    set_val(PS4_RY, STICK_UP_VALUE + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(auto_speed_ms);
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(auto_tempo_ms);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}
combo Auto_Fade_Smooth {
    set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(auto_fade_speed_ms + fade_delay_ms);
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(auto_tempo_ms);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}
combo Auto_Fade_Reversed {
    set_val(PS4_RY, STICK_UP_VALUE + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(auto_fade_speed_ms + fade_delay_ms);
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(auto_tempo_ms);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}
combo Auto_NoDip_Smooth {
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(auto_nodip_ms);
    wait(auto_tempo_ms);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}
combo Auto_NoDip_Reversed {
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(auto_nodip_ms);
    wait(auto_tempo_ms);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

// -- Unlimited Sprint --
// Softens left stick while moving so stamina drains slower.
// Skips while dunking or while any shot is active so it never
// fights the shot stick or button.
combo Quick_Stop_Move {
    set_val(PS4_RY, 100);
    wait(28);
    set_val(PS4_RY, 0);
    wait(18);
    set_val(PS4_RX, 0);
    set_val(PS4_RY, 0);
    wait(40);
}

combo Unlimited_Stamina_Control {
    if (unlimited_stamina && stamina_stick_active && !dunk_guard
        && !btn_hold_active && !sq_shot_active && !br_hold_active
        && !get_val(PS4_SQUARE) && !get_val(PS4_R3)
        && !combo_running(flick_up_rs_smooth) && !combo_running(flick_up_rs_reversed)
        && !combo_running(Fade_flick_up_rs_smooth) && !combo_running(Fade_flick_up_rs_reversed)
        && !combo_running(Release_NoDip_Smooth) && !combo_running(Release_NoDip_Reversed)
        && !combo_running(BR_Auto_Hold) && !combo_running(BR_Auto_Hold_Rev)
        && !combo_running(BR_Auto_NoDip) && !combo_running(BR_Auto_NoDip_Rev)
        && !combo_running(BR_Auto_Fade) && !combo_running(BR_Auto_Fade_Rev)
        && !combo_running(BtnHold_Shot) && !combo_running(BtnHold_FadeL)
        && !combo_running(BtnHold_FadeR) && !combo_running(BtnHold_Catch)
        && !combo_running(Auto_Stand_Smooth) && !combo_running(Auto_Stand_Reversed)
        && !combo_running(Auto_Fade_Smooth) && !combo_running(Auto_Fade_Reversed)
        && !combo_running(Auto_NoDip_Smooth) && !combo_running(Auto_NoDip_Reversed)) {

        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * stamina_ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * stamina_ground_control) / 100);
        } else {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}


// ---- Dribble move combos (RS patterns for 2K) ----

// ---- Signature dribble packs (unique timings, not V8 duplicates) ----
combo mv_btb_spam {
    set_val(PS4_RX, -75); set_val(PS4_RY, 100); wait(95);
    set_val(PS4_RX, 0); set_val(PS4_RY, 0); wait(80);
    set_val(PS4_RX, 75); set_val(PS4_RY, 100); wait(100);
    set_val(PS4_RX, 0); set_val(PS4_RY, 0); wait(85);
    wait(120);
    drib_busy = 0;
}
combo mv_curry {
    set_val(PS4_R2, 100); set_val(PS4_RX, -75); set_val(PS4_RY, 100); wait(100);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0); set_val(PS4_RY, 0); wait(100);
    set_val(PS4_R2, 100); wait(18);
    set_val(PS4_R2, 100); set_val(PS4_RX, 75); set_val(PS4_RY, 100); wait(105);
    set_val(PS4_R2, 100); set_val(PS4_RX, 0); set_val(PS4_RY, 0); wait(110);
    set_val(PS4_R2, 0); wait(150);
    drib_busy = 0;
}
