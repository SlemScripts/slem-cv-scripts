combo mv_momentum {
    set_val(PS4_R2, 100); set_val(PS4_RY, -100); wait(30);
    set_val(PS4_R2, 100); set_val(PS4_RY, 0); set_val(PS4_RX, 100); wait(30);
    set_val(PS4_R2, 100); set_val(PS4_RX, -100); wait(30);
    set_val(PS4_R2, 0); set_val(PS4_RX, 0); wait(130);
