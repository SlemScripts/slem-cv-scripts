                    );
                    if (event_press(PS4_UP)) { unlimited_stamina = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { unlimited_stamina = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                // ---- Quick Stop (Misc) ----
                if (page == 39) {
                    if (qs_cap_mode == 0) {
                        menuSelection = qs_on;
                        print(
                            center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                            26, OLED_FONT_MEDIUM, OLED_WHITE,
                            onOff[menuSelection]
                        );
                        print(center_x(get_string_length(QS_OPEN_HINT[0]), OLED_FONT_SMALL_WIDTH), 44, OLED_FONT_SMALL, OLED_WHITE, QS_OPEN_HINT[0]);
                        if (event_press(PS4_UP)) { qs_on = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                        if (event_press(PS4_DOWN)) { qs_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                        if (event_press(PS4_CROSS) && !np_x_last) {
                            qs_cap_mode = 1;
                            qs_cap_step = 0;
                            qs_circle_held = 0;
                            qs_btn1 = 0;
                            qs_btn2 = 0;
                            np_x_last = 1;
                            combo_run(vibration_valchg);
                        }
                        if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    } else {
                        // CAPTURE SCREEN — hold Circle to exit so X/O can be bound
                        print(center_x(get_string_length(QS_CAP_TITLE[0]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, QS_CAP_TITLE[0]);
                        print(center_x(get_string_length(QS_CAP_TAP[0]), OLED_FONT_SMALL_WIDTH), 16, OLED_FONT_SMALL, OLED_WHITE, QS_CAP_TAP[0]);
                        print(center_x(get_string_length(QS_CAP_HINT[0]), OLED_FONT_SMALL_WIDTH), 52, OLED_FONT_SMALL, OLED_WHITE, QS_CAP_HINT[0]);

                        // Show captured so far
                        if (qs_btn1 != 0) {
                            // simple marker text via NumberToString of button id is ugly; show step status
                            print(10, 30, OLED_FONT_SMALL, OLED_WHITE, onOff[1]);
                        }
                        if (qs_btn2 != 0) {
                            print(50, 30, OLED_FONT_SMALL, OLED_WHITE, onOff[1]);
                        }

                        // Hold Circle 450ms+ to exit capture
                        if (get_val(PS4_CIRCLE)) {
                            qs_circle_held = qs_circle_held + get_rtime();
                            if (qs_circle_held >= 450) {
                                qs_cap_mode = 0;
                                qs_circle_held = 0;
                                // if nothing captured, keep previous via not zeroing if both 0 - already set
                                if (qs_btn1 == 0) { qs_btn1 = PS4_L2; }
                                combo_run(vibration_valchg);
                            }
                        } else {
                            // quick tap Circle = bind Circle as a button
                            if (qs_circle_held > 0 && qs_circle_held < 450) {
                                if (qs_cap_step == 0) { qs_btn1 = PS4_CIRCLE; qs_cap_step = 1; }
                                else if (qs_cap_step == 1 && qs_btn2 == 0 && qs_btn1 != PS4_CIRCLE) { qs_btn2 = PS4_CIRCLE; qs_cap_step = 2; }
                                combo_run(vibration_valchg);
                            }
                            qs_circle_held = 0;
                        }

                        // Capture other buttons (X/Square/etc are free here)
                        if (event_press(PS4_CROSS)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_CROSS; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_CROSS) { qs_btn2 = PS4_CROSS; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_SQUARE)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_SQUARE; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_SQUARE) { qs_btn2 = PS4_SQUARE; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_TRIANGLE)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_TRIANGLE; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_TRIANGLE) { qs_btn2 = PS4_TRIANGLE; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_L1)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_L1; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_L1) { qs_btn2 = PS4_L1; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_L2)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_L2; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_L2) { qs_btn2 = PS4_L2; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_R1)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_R1; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_R1) { qs_btn2 = PS4_R1; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_R2)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_R2; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_R2) { qs_btn2 = PS4_R2; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_UP)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_UP; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_UP) { qs_btn2 = PS4_UP; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_DOWN)) {
                            if (qs_cap_step == 0) { qs_btn1 = PS4_DOWN; qs_cap_step = 1; }
                            else if (qs_cap_step == 1 && qs_btn1 != PS4_DOWN) { qs_btn2 = PS4_DOWN; qs_cap_step = 2; }
                            combo_run(vibration_valchg);
                        }
                        if (event_press(PS4_LEFT)) {
