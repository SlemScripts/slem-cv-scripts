                        sub_edit_open = 1; sub_parent_page = 23; sub_first_page = 24; sub_last_page = 24; page = 24;
                        np_x_last = 1; combo_run(vibration_valchg);
                    }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                }

                // ---- Auto No-Dip Speed (No Dip category) ----
                if (page == 24) {
                    if (np_confirmed && np_tid == 21) { auto_nodip_ms = clamp(np_result, 100, 1000); np_confirmed = 0; }
                    if (!np_active) {
                    NumberToString(auto_nodip_ms, FindDigits(auto_nodip_ms));
                    print(center_x(get_string_length(SL_AUTO_NODIP_SPEED[0]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, SL_AUTO_NODIP_SPEED[0]);
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
