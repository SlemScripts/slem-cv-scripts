                    if (event_press(PS4_DOWN)) { vib_block_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 35) {
                    menuSelection = unlimited_stamina;
                    print(
