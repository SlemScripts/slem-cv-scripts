                if (page == 26) {
                    // Custom Dunk Bind — hold R2 + press any button, release R2 to save
                    if (bind_cap_mode == 0) {
                        // Show the current bind
                        if (isXbox) {
                            print(24, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_xb[0]);
                            print(64, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_xb[bind_name_idx]);
                        } else {
                            print(24, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_ps[0]);
                            print(64, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_ps[bind_name_idx]);
                        }
                        print(center_x(get_string_length(bind_hint1[0]), OLED_FONT_SMALL_WIDTH), 44, OLED_FONT_SMALL, OLED_WHITE, bind_hint1[0]);

                        // Holding R2 arms capture (also locks menu nav so captured
                        // presses don't flip pages / exit the menu)
                        if (get_ival(PS4_R2) > 20) {
                            bind_cap_mode = 2;
                            bind_cap_btn = dunk_bind_btn;
                            bind_cap_name_idx = 11;   // "?" until a button is pressed
                            combo_run(vibration_valchg);
                        }
                    } else {
                        print(center_x(get_string_length(bind_locked[0]), OLED_FONT_SMALL_WIDTH), 6, OLED_FONT_SMALL, OLED_WHITE, bind_locked[0]);

                        if (get_ival(PS4_R2) > 20) {
                            // Physical input via get_ival (menu zeroes get_val).
                            // Keep scanning while R2 is held — pressing a different
                            // button before release just overwrites the pending bind.
                            if (get_ival(PS4_L1) > 20)            { bind_cap_btn = PS4_L1;       bind_cap_name_idx = 0; }
                            else if (get_ival(PS4_CIRCLE) > 20)   { bind_cap_btn = PS4_CIRCLE;   bind_cap_name_idx = 1; }
                            else if (get_ival(PS4_L2) > 20)       { bind_cap_btn = PS4_L2;       bind_cap_name_idx = 2; }
                            else if (get_ival(PS4_TRIANGLE) > 20) { bind_cap_btn = PS4_TRIANGLE; bind_cap_name_idx = 3; }
                            else if (get_ival(PS4_SQUARE) > 20)   { bind_cap_btn = PS4_SQUARE;   bind_cap_name_idx = 4; }
                            else if (get_ival(PS4_R1) > 20)       { bind_cap_btn = PS4_R1;       bind_cap_name_idx = 5; }
                            else if (get_ival(PS4_CROSS) > 20)    { bind_cap_btn = PS4_CROSS;    bind_cap_name_idx = 6; }
                            else if (get_ival(PS4_UP) > 20)       { bind_cap_btn = PS4_UP;       bind_cap_name_idx = 7; }
                            else if (get_ival(PS4_DOWN) > 20)     { bind_cap_btn = PS4_DOWN;     bind_cap_name_idx = 8; }
                            else if (get_ival(PS4_LEFT) > 20)     { bind_cap_btn = PS4_LEFT;     bind_cap_name_idx = 9; }
                            else if (get_ival(PS4_RIGHT) > 20)    { bind_cap_btn = PS4_RIGHT;    bind_cap_name_idx = 10; }

                            if (bind_cap_name_idx == 11) {
                                print(center_x(get_string_length(bind_cap_listen[0]), OLED_FONT_SMALL_WIDTH), 26, OLED_FONT_SMALL, OLED_WHITE, bind_cap_listen[0]);
                            } else {
