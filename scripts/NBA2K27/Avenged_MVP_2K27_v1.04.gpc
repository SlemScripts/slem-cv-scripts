int STICK_UP_VALUE = -100;
int random_variation_min = -4;
int random_variation_max = 4;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;

int reverse_flick_mode = 0;

int remap_square_active = 1;  

// ==== Smart Timing (shot-context release offset) ====
// Reads the same way as a manual "off-dribble" or "fade" read: nudges the
// release earlier for a quick off-dribble pull-up, later for a fade, and
// leaves a stand-still shot untouched. Applies to Turbo Shot, Fade Shot,
// and Go-To Shot alike since they all release through the same combos.
int smart_timing_enabled = 0;
int rs_recent_timer = 0;
int shot_offset = 0;
int effective_wait = 0;
int smart_fade_offset = 30;
int smart_quick_offset = 20;

// -- Soft Trigger (Misc) --
int tk_at_on = 1;
// -- Vibe Blocker (Misc) --
int vib_block_on = 0;   // 1 = block all game rumble (script menu vibes unaffected)
int vib_block_prev = 0;

// ---- Dribble moves (D-pad slots) ----
int dribble_on = 0;

// ==== Button Shot ====
// Directional button-hold release. On Square press the script reads left
// stick once, then holds Square for a calibrated window and releases:
//   standstill  -> ShotH
//   fade left   -> FadeLH
//   fade right  -> FadeRH
// Optional Catch sequence (LB) runs Circle+Triangle then the CatchH hold.
// Pure button timing -- never touches the right stick.
int btn_shot_on = 0;          // master toggle (menu still labeled via strings)
int ShotH   = 664;            // standstill / normal shot hold
int FadeLH  = 925;            // fade left hold
int FadeRH  = 922;            // fade right hold
int CatchH  = 664;            // catch-and-shoot hold
int ShotV, FadeLV, FadeRV, CatchV;  // release residual (set in init)
int btn_hold_active = 0;        // 1 while a hold-release combo owns Square
int btn_shot_hold_ms = 664;   // kept in sync with ShotH for menu/profile
int btn_val_idx = 0;          // 0=Shot 1=Catch 2=FadeL 3=FadeR
int btn_edit_open = 0;        // 1 = value editor screen is open
const string BTN_VAL_NAMES[] = { "Shoot", "Catch", "Fade Left", "Fade Right", "" };
const string BTN_EDIT_HINT[] = { "L/R switch  U/D +/-" };
const string BTN_EDIT_HINT2[] = { "X type  O back" };
const string BTN_OPEN_HINT[] = { "X: edit values" };
int drib_up = 0;
int drib_dn = 0;
int drib_lf = 0;
int drib_rt = 0;
int drib_busy = 0;
int drib_busy_ms = 0;
int sq_shot_active = 0;
int br_hold_active = 0;
int br_auto_mode = 0;
int br_auto_ms = 500;
int br_sub_tab = 0;  // 0=Mode 1=Rhythm Tempo 2=Auto Hold MS


// -- Dunk (Contact / Normal slam system) --
int dunk_meter_on = 0;
int dunk_bind_btn = PS4_L1;
int bind_cap_mode = 0;
int bind_cap_btn = PS4_L1;
int bind_name_idx = 0;
int bind_cap_name_idx = 0;
int dunk_hold_dur = 700; int dunk_hold_ms_l1 = 0; int dunk_fired_l1 = 0;
int dunk_release_l1 = 0;  // V8-style: set the instant the meter maxes, fires the flick immediately
int dunk_guard = 0;       // keeps Unlimited Sprint from fighting the dunk stick input

// -- Quick Stop (Misc) --
int qs_on = 0;
int qs_btn1 = PS4_L2;     // primary bind button
int qs_btn2 = 0;          // secondary (0 = single-button bind)
int qs_cap_mode = 0;      // 1 = capture screen active
int qs_cap_step = 0;      // 0 = waiting btn1, 1 = waiting btn2 optional
int qs_circle_held = 0;   // track hold-to-exit on capture screen

// -- Unlimited Sprint (Misc) --
int unlimited_stamina = 0;
int stamina_ground_control = 70;  // % of full stick kept while sprinting
int stamina_stick_active = 1;     // reserved enable flag (always on, matches V8)

int fade_toggle = 1;
int fade_delay_ms = 42;
int fade_intent = 0;

// ==== RS Shooting ====
int rs_shoot_on = 0;
int rs_hold_time = 300;
int rs_hold_elapsed = 0;
int rs_shot_active = 0;
int rs_shot_dir = 0;
int fade_l1r2_on = 0;

// ==== Release Timing Feedback ====
// A standalone hold-timer that watches Square (post-remap) regardless of
// whether Turbo/Button Rhythm shooting itself is on. Two things read off
// this same timer: a small on-screen log of your last few release times,
// and an optional one-shot rumble that fires once you've held past a
// tunable point, as a "let go now" cue while you're learning your timing.
int shot_press_ms = 0;
int shot_charging = 0;
int shotlog_enabled = 0;
int shotlog_normal_ms = 0;
int shotlog_fade_ms = 0;
int shotlog_nodip_ms = 0;
int shotlog_last_ms = 0;
int shotlog_last_type = 0;
int shot_log_nodip = 0;
int nodip_enabled = 0;
int nodip_tempo_ms = 270;

