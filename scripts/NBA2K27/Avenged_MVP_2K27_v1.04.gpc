    set_val(PS4_R2, 100); set_val(PS4_RY, 100); wait(45);
    set_val(PS4_R2, 100); set_val(PS4_RY, 0); wait(5);
    set_val(PS4_R2, 0); wait(130);
    drib_busy = 0;
}
combo mv_ankle {
    set_val(PS4_R2, 100); set_val(PS4_RX, 0); set_val(PS4_RY, -100); wait(40);
    set_val(PS4_R2, 100); set_val(PS4_RX, -100); set_val(PS4_RY, 0); wait(40);
    set_val(PS4_R2, 0); set_val(PS4_RX, 0); wait(130);
    drib_busy = 0;
}
combo mv_escape {
    set_val(PS4_R2, 100); set_val(PS4_L2, 100); set_val(PS4_RX, -100); wait(40);
    set_val(PS4_R2, 100); set_val(PS4_L2, 100); set_val(PS4_RX, 100); wait(40);
    set_val(PS4_R2, 0); set_val(PS4_L2, 0); set_val(PS4_RX, 0); wait(130);
    drib_busy = 0;
