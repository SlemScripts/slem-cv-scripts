define PVAR_SMART_QUICK     = SPVAR_24;
define PVAR_SHOTLOG         = SPVAR_25;
define PVAR_SHOT_VIBE       = SPVAR_32;  // unused padding slot (profile 1's p_start+2)
define PVAR_SHOT_VIBE_MS    = SPVAR_35;  // unused padding slot (profile 2's p_start+2)
define PVAR_FADE_VIBE       = SPVAR_38;  // unused padding slot (profile 3's p_start+2)
define PVAR_FADE_VIBE_MS    = SPVAR_41;  // unused padding slot (profile 4's p_start+2)
