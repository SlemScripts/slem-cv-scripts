define PVAR_DRIB_UP         = SPVAR_27;
define PVAR_DRIB_DN         = SPVAR_28;
define PVAR_DRIB_LF         = SPVAR_29;
// SPVAR_30..SPVAR_44 are RESERVED by the profile system (SaveProfile/LoadProfile
// use PVAR_BASE=30 + slot*3), except the p_start+2 padding slots (32/35/38/41/44)
// already claimed above. The six settings that previously sat on 33/34/36/37/39/40
// were being overwritten every time profile 2/3/4 was saved -- drib_rt landing on
// profile 2's slot is why the D-Pad Right bind kept resetting to Off (and the
// unbound press then fell through to the game's own d-pad camera toggle).
// All six now live bit-packed in the one verified-free slot below:
// bits 0-8 drib_rt | 9 auto_stand | 10 auto_fade | 11 auto_nodip |
// bits 12-21 auto_speed_ms | bits 22-30 auto_tempo_ms
define PVAR_MISC_PACK       = SPVAR_49;
define PVAR_BTN_SHOT_ON     = SPVAR_45;
define PVAR_BTN_SHOT_MS     = SPVAR_46;
define PVAR_AUTO_FADE_SPD   = SPVAR_47;
define PVAR_AUTO_NODIP_MS   = SPVAR_48;




