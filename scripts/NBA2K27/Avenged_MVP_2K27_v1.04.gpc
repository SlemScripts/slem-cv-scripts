    set_val(PS4_R2, 100); set_val(PS4_LY, -100); wait(70);
    set_val(PS4_R2, 100); set_val(PS4_LY, 0); wait(55);
    set_val(PS4_R2, 100); set_val(PS4_LX, -100); wait(110);
    set_val(PS4_R2, 0); set_val(PS4_LX, 0); wait(120);
    drib_busy = 0;
