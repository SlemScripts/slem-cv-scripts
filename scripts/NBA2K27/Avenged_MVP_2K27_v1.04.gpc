                        print(center_x(get_string_length(BTN_OPEN_HINT[0]), OLED_FONT_SMALL_WIDTH), 46, OLED_FONT_SMALL, OLED_WHITE, BTN_OPEN_HINT[0]);
                        if (event_press(PS4_UP)) { btn_shot_on = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                        if (event_press(PS4_DOWN)) { btn_shot_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                        // X opens the value editor
                        if (event_press(PS4_CROSS) && !np_x_last) {
                            btn_edit_open = 1;
                            btn_val_idx = 0;
                            np_x_last = 1;
                            combo_run(vibration_valchg);
                        }
                        if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    } else {
                        // ===== Value editor (opened from Button Shot) =====
                        if (event_press(PS4_LEFT))  { btn_val_idx = btn_val_idx - 1; if (btn_val_idx < 0) btn_val_idx = 3; combo_run(vibration_valchg); }
                        if (event_press(PS4_RIGHT)) { btn_val_idx = btn_val_idx + 1; if (btn_val_idx > 3) btn_val_idx = 0; combo_run(vibration_valchg); }
                        set_val(PS4_LEFT, 0); set_val(PS4_RIGHT, 0);

                        // Active value label
                        
                        // Sync display value
                        if (btn_val_idx == 0) btn_shot_hold_ms = ShotH;
                        else if (btn_val_idx == 1) btn_shot_hold_ms = CatchH;
                        else if (btn_val_idx == 2) btn_shot_hold_ms = FadeLH;
                        else btn_shot_hold_ms = FadeRH;

                        if (np_confirmed && np_tid == 19) {
                            btn_shot_hold_ms = clamp(np_result, 100, 1500);
                            if (btn_val_idx == 0) { ShotH = btn_shot_hold_ms; ShotV = ShotH - 5; }
                            else if (btn_val_idx == 1) { CatchH = btn_shot_hold_ms; CatchV = CatchH - 5; }
                            else if (btn_val_idx == 2) { FadeLH = btn_shot_hold_ms; FadeLV = FadeLH - 5; }
                            else { FadeRH = btn_shot_hold_ms; FadeRV = FadeRH - 5; }
                            np_confirmed = 0;
                        }
                        if (!np_active) {
                            NumberToString(btn_shot_hold_ms, FindDigits(btn_shot_hold_ms));
                            print(center_x(get_string_length(BTN_VAL_NAMES[btn_val_idx]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, BTN_VAL_NAMES[btn_val_idx]);
                            print(70, 24, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                            draw_x_graph(btn_shot_hold_ms, 100, 1500, 40);
                            print(center_x(get_string_length(BTN_EDIT_HINT[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, BTN_EDIT_HINT[0]);
                            print(center_x(get_string_length(BTN_EDIT_HINT2[0]), OLED_FONT_SMALL_WIDTH), 58, OLED_FONT_SMALL, OLED_WHITE, BTN_EDIT_HINT2[0]);

                            if (event_press(PS4_UP) || repeat_up_due()) {
                                btn_shot_hold_ms++;
                                if (btn_shot_hold_ms > 1500) btn_shot_hold_ms = 1500;
                                if (btn_val_idx == 0) { ShotH = btn_shot_hold_ms; ShotV = ShotH - 5; }
                                else if (btn_val_idx == 1) { CatchH = btn_shot_hold_ms; CatchV = CatchH - 5; }
                                else if (btn_val_idx == 2) { FadeLH = btn_shot_hold_ms; FadeLV = FadeLH - 5; }
                                else { FadeRH = btn_shot_hold_ms; FadeRV = FadeRH - 5; }
                                combo_run(vibration_valchg); combo_run(flashedit);
                            }
                            if (event_press(PS4_DOWN) || repeat_down_due()) {
                                btn_shot_hold_ms--;
                                if (btn_shot_hold_ms < 100) btn_shot_hold_ms = 100;
                                if (btn_val_idx == 0) { ShotH = btn_shot_hold_ms; ShotV = ShotH - 5; }
                                else if (btn_val_idx == 1) { CatchH = btn_shot_hold_ms; CatchV = CatchH - 5; }
                                else if (btn_val_idx == 2) { FadeLH = btn_shot_hold_ms; FadeLV = FadeLH - 5; }
                                else { FadeRH = btn_shot_hold_ms; FadeRV = FadeRH - 5; }
                                combo_run(vibration_valchg); combo_run(flashedit);
                            }
                            // X = type exact number
                            if (event_press(PS4_CROSS) && !np_x_last) {
                                np_active = 1; np_tid = 19; np_x_last = 1;
                                np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1;
                            }
                            if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                            // O = back to ON/OFF screen
                            if (event_press(PS4_CIRCLE)) {
                                btn_edit_open = 0;
                                combo_run(vibration_valchg);
                            }
                            set_val(PS4_CIRCLE, 0);
                        }
                    }
                }

                // (page 13 removed — Button Shot's editor now only opens when
                // X is pressed on the Button Shot toggle, per Shooting CAT_COUNT above)

                // ---- Auto Fade (Fade category) ----
                if (page == 19) {
                    menuSelection = auto_fade_on;
                    print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
                    if (event_press(PS4_UP)) { auto_fade_on = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { auto_fade_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_CROSS) && !np_x_last) {
                        sub_edit_open = 1; sub_parent_page = 19; sub_first_page = 20; sub_last_page = 20; page = 20;
                        np_x_last = 1; combo_run(vibration_valchg);
                    }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                }

                // ---- Auto Fade Speed (Fade category) ----
                if (page == 20) {
                    if (np_confirmed && np_tid == 20) { auto_fade_speed_ms = clamp(np_result, 100, 1000); np_confirmed = 0; }
                    if (!np_active) {
                    NumberToString(auto_fade_speed_ms, FindDigits(auto_fade_speed_ms));
                    print(center_x(get_string_length(SL_AUTO_FADE_SPEED[0]), OLED_FONT_SMALL_WIDTH), 18, OLED_FONT_SMALL, OLED_WHITE, SL_AUTO_FADE_SPEED[0]);
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(auto_fade_speed_ms, 100, 1000, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { auto_fade_speed_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { auto_fade_speed_ms--; }
                    if (auto_fade_speed_ms > 1000) auto_fade_speed_ms = 1000;
                    if (auto_fade_speed_ms < 100) auto_fade_speed_ms = 100;
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 20; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }
                // ---- Auto No-Dip (No Dip category) ----
                if (page == 23) {
                    menuSelection = auto_nodip_on;
                    print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
