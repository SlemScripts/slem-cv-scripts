int  FadeRH =922;    int  ShotH =664;   int  FadeLH =925;    int  CatchH =664;   // CHANGE TO SET INITIAL VALUES
int shotButton = XB1_X;  int catchButton = XB1_LB; // CHANGE VALUES THROUGH ZEN

                                                                                                                             
// build 6s83hngpau65.cc572acc24
                                                                                                                             
  
/*                                       */
const string Misc[] = { "On" , "Off" , "2k27" , "Button Script" , "By" , "yFqnta" , "KillSwitch" , "Enabled" , "Disabled" , "" };  
const string ModNames[] = { "MyTypaShot","DefenceTendos", "Dribbling","" }; 
const string ValNames[] = { "Shoot","Catch","FadeLeft","FadeRight","" }; 
define AmountOfMods = 2
define AmountOfValues = 3;  
int DisplayTitle = TRUE;
int ScreenSaver, BlankScreen, ModMenu, DisplayMenu, EditMenu, Toggle, ValNameIdx, ModNameIdx, KillSwitch, GreenBean, Dribbling, DefenseBoost;
init {vm_tctrl(-6); 
    	   CatchV = get_pvar(SPVAR_1,  100, 1500, CatchV); 
   		   CatchH = get_pvar(SPVAR_1,  100, 1500, CatchH);  
   		   FadeRV = get_pvar(SPVAR_2,  100, 1500, FadeRV); 
   		   FadeRH = get_pvar(SPVAR_2,  100, 1500, FadeRH); 
   		   FadeLV = get_pvar(SPVAR_3,  100, 1500, FadeLV); 
   		   FadeLH = get_pvar(SPVAR_3,  100, 1500, FadeLH); 
   		   ShotV = get_pvar(SPVAR_4,  100, 1500, ShotV); 
   		   ShotH = get_pvar(SPVAR_4,  100, 1500, ShotH);  
}
init {
    CatchV = CatchH - 5;
    FadeLV = FadeLH - 5;
// discord.gg/orla
    FadeRV = FadeRH - 5;
    ShotV = ShotH - 5;
}
    int combo_step_time_leftS;
       int combo_step_time_leftFL;
         int combo_step_time_leftFR;
          int combo_step_time_left;
          int CatchV, FadeLV, FadeRV, ShotV ;
int  percentageBoost = 11;
main{
set_val(TRACE_1,ShotH);
set_val(TRACE_2,CatchH);
set_val(TRACE_3,FadeLH);
set_val(TRACE_4,FadeRH);
set_val(TRACE_1, combo_step_time_leftS);
set_val(TRACE_2, combo_step_time_left);
set_val(TRACE_1, combo_step_time_leftFL);
set_val(TRACE_4, combo_step_time_leftFR);
if(get_ival(PS4_L2)) {
if(event_press(PS4_OPTIONS)) {
	ModMenu = TRUE;      
	DisplayMenu = TRUE;       
	EditMenu = FALSE;     
if(!ModMenu) DisplayTitle = TRUE;} 
if(event_press(PS4_PS)){ 
	KillSwitch =! KillSwitch; 
	combo_run(KillSwitch)} 	
	set_val(PS4_OPTIONS,0);
	set_val(PS4_PS,0);}

// discord.gg/orla
if(!DisplayTitle) {
if(ModMenu) {
	ModNameIdx = MenuNavigation(ModNameIdx,0,3);   
	GreenBean = ToggleSwitch(ModNameIdx == 0,GreenBean);
	DefenseBoost = ToggleSwitch(ModNameIdx == 1,DefenseBoost);
	Dribbling = ToggleSwitch(ModNameIdx == 2,Dribbling);}
if(EditMenu) {
	ValNameIdx = MenuNavigation(ValNameIdx,0,4); 
	ShotH  = EditValues(ValNameIdx , 0, ShotH , 100, 1000);
	CatchH  = EditValues(ValNameIdx , 1,CatchH , 100, 1000);
	FadeLH  = EditValues(ValNameIdx , 2,FadeLH , 100, 1000);
	FadeRH  = EditValues(ValNameIdx , 3,FadeRH , 100, 1000);
	if(ModNameIdx == 0) ValNameIdx = cycle(ValNameIdx,0,3); } } 
if(DisplayMenu){ 
	cls_oled(OLED_BLACK);  
	rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE); 
	line_oled(0, 27, OLED_WIDTH - 1, 27, 1, OLED_WHITE); 
if(EditMenu) {
	print(center_x(get_valName_chars(ValNameIdx), OLED_FONT_MEDIUM_WIDTH),7,OLED_FONT_MEDIUM,OLED_WHITE,ValNames[ValNameIdx]); } 
else if(ModMenu) { 
	print(center_x(get_modName_chars(ModNameIdx), OLED_FONT_MEDIUM_WIDTH),7,OLED_FONT_MEDIUM,OLED_WHITE,ModNames[ModNameIdx]);  
if(Toggle == 1)
	print(center_x(get_misc_chars(0), OLED_FONT_MEDIUM_WIDTH),37,OLED_FONT_MEDIUM,OLED_WHITE,Misc[0]);	
else if(Toggle == 0)
	print(center_x(get_misc_chars(1), OLED_FONT_MEDIUM_WIDTH),37,OLED_FONT_MEDIUM,OLED_WHITE,Misc[1]); }
	DisplayMenu = FALSE; } 
if(!ModMenu && !EditMenu) {
// discord.gg/orla
	if(DisplayTitle) { 
		cls_oled(OLED_BLACK); 
		rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE); 
		print(center_x(get_misc_chars(2), OLED_FONT_SMALL_WIDTH),7,OLED_FONT_SMALL,OLED_WHITE,Misc[2]); 
		print(center_x(get_misc_chars(3), OLED_FONT_SMALL_WIDTH),22,OLED_FONT_SMALL,OLED_WHITE,Misc[3]); 
		print(center_x(get_misc_chars(4), OLED_FONT_SMALL_WIDTH),37,OLED_FONT_SMALL,OLED_WHITE,Misc[4]); 
		print(center_x(get_misc_chars(5), OLED_FONT_SMALL_WIDTH),50,OLED_FONT_SMALL,OLED_WHITE,Misc[5]); 
		DisplayTitle = FALSE;
		ScreenSaver  = TRUE; }
if(ScreenSaver) {
	BlankScreen += get_rtime();
if(BlankScreen >= 5000) {
	cls_oled(OLED_BLACK);
	BlankScreen = 0;
	ScreenSaver = TRUE; } } } 
if(!KillSwitch){
if(!GreenBean){colourled(21);}
if(GreenBean){
// discord.gg/orla
 if(event_press(shotButton) && !combo_running(ShotS)){ // check if the combo is active 
    if(combo_current_step(ShotS)) { // counts the running time of button  
    	combo_run(ShotS);
    	}
    	 
    if(combo_step_time_leftS == ShotH){ // counts HoldTime left to run combo
    	combo_restart(ShotS);} //resets combo runtime to 0 
    	}
        combo_step_time_leftS = ShotH; // Update combo_step_time_left
    
     if(get_val(PS4_LX) <=-25 && event_press(shotButton) && !combo_running(FadeL)){{ // check if the combo is active 
    if(combo_current_step(FadeL)) { // counts the running time of button  
    	combo_run(FadeL);
    	}
    }	 
    if(combo_step_time_leftFL == FadeLH){ // counts HoldTime left to run combo
    	combo_restart(FadeL);} //resets combo runtime to 0 
    	}
        combo_step_time_leftFL = FadeLH; // Update combo_step_time_left
        if(get_val(PS4_LX) >=25 && event_press(shotButton) && !combo_running(FadeR)){{ // check if the combo is active 
    if(combo_current_step(FadeR)) { // counts the running time of button  
    	combo_run(FadeR);
// discord.gg/orla
    	}
