    if(combo_step_time_leftFR == FadeRH){ // counts HoldTime left to run combo
    	combo_restart(FadeR);} //resets combo runtime to 0 
    	}
        combo_step_time_leftFR = FadeRH; // Update combo_step_time_left
         if(event_press(catchButton) && !combo_running(CatchS)){ // check if the combo is active 
    if(combo_current_step(CatchS)) { // counts the running time of button  
    	combo_run(CatchS);
    	}
    	 
    if(combo_step_time_left == CatchH){ // counts HoldTime left to run combo
    	combo_restart(CatchS);} //resets combo runtime to 0 
    	}
        combo_step_time_left = CatchH; // Update combo_step_time_left
        }
if(!DefenseBoost){colourled(18);}
if(DefenseBoost){
// discord.gg/orla
     if(get_val(PS4_L2) >=15 && event_press(shotButton)){
                combo_run(STEAL);
            }
		if(get_val(PS4_L2)){
			combo_run(ALTERNATE_STEP);
			}
		}

if(!Dribbling){colourled(19);}
if(Dribbling){
if (event_press(PS4_L3)) 
        {
            set_val(PS4_R2,0);
            combo_run(BoostLH);
        }
        
        if (event_press(PS4_R3)) 
        {
            set_val(PS4_R2,0);
            combo_run(BoostRH);
        }
    }
}
		   }
	 combo STEAL {
// discord.gg/orla
    set_val(shotButton,100);
    set_val(PS4_LX,0);
    set_val(PS4_LY,0);
    wait(50);
    set_val(PS4_LX,0);
    set_val(PS4_LY,0);
    wait(300);
    set_val (shotButton, 0)
}
	  combo ShotS {
    	set_val(shotButton, 100);// remove this to Automate Shot Block by using "//"
    	wait(abs(ShotH));
    	set_val(shotButton, 0); 
    	wait(abs(ShotV - get_rtime() + isqrt(percentageBoost)));
    	//Holdtime = random(Holdtime,Holdtime + 5);// remove this to Automate Shot by using "//"
    	}
// discord.gg/orla
    	  combo FadeL {
    	set_val(shotButton, 100);// remove this to Automate Shot Block by using "//"
    	wait(abs(FadeLH));
    	set_val(shotButton, 0); 
    	wait(abs(FadeLV - get_rtime() + isqrt(percentageBoost)));
    	//Holdtime = random(Holdtime,Holdtime + 5);// remove this to Automate Shot by using "//"
    	}
    	 combo FadeR {
    	set_val(shotButton, 100);// remove this to Automate Shot Block by using "//"
