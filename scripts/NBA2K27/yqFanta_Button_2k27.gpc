    	set_val(shotButton, 0); 
    	wait(abs(FadeRV - get_rtime() + isqrt(percentageBoost)));
    	//Holdtime = random(Holdtime,Holdtime + 5);// remove this to Automate Shot by using "//"
    	}
    	combo  CatchS {
// discord.gg/orla
	set_val(PS4_CIRCLE, 100);
	set_val(PS4_TRIANGLE, 100);
	wait(225);
	set_val(PS4_CIRCLE, 0);
	set_val(PS4_TRIANGLE, 0);
	wait(25);
	set_val(shotButton, 100);
	wait(abs(CatchH));
	set_val(shotButton, 0);
	wait(abs(CatchV - get_rtime() + isqrt(percentageBoost)));
	}
combo ALTERNATE_STEP{
	set_val(PS4_R2,0);
    set_val(PS4_L2,100);
    wait(100);
    set_val(PS4_R2,100);
    set_val(PS4_L2,0);
}
