// Script by BoostSquad

/*
 


*/



// int flick_up_shooting_active = 1;
int full_court_green_tap_ms = 100; // configurable Full Court Green Tap hold in ms
int full_court_green_active = 0;
int full_court_green_timer = 0;
int flick_sequences_enabled = 0;
int delay_duration = 50;
int Delay_duration_Insta = 50;
int STICK_DOWN_VALUE = 100000;
int STICK_UP_VALUE = -100000;
int RX_UP_VALUE = 25;
int random_variation_min = -4;
int random_variation_max = 4;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;
int stabilization_variation = 150000;
int reverse_flick_mode = 1;
int rs_shooting_active = 0;
int rs_hold_duration = 300;
int Insta_shot_active = 1;
int Insta_shot_duration = 585;
int isHolding = 0;
int holdTimer = 0;
int rs_is_up = 0;
int remap_square_active = 0; // Toggle for L3/R3 remap (0 = L3, 1 = R3)
int stamina_blocked = 0;
// --- Idle screensaver state ---
int saver_on = 0;
int sx = 2, sy = 16;
int svx = 2, svy = 2;
int msg_w, line1_w, line2_w;
int saver_timer = 0;
const string saver_line1[] = { "BoostSquad" };
const string saver_line2[] = { "" };
const string tt_title[] = { "BoostSquad" };

// ===== Menu state =====
int startup = 1, numpgs = 11, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;

// ===== Menu labels =====
const string menu_header[] = { "Auto Green", "Tempo Speed (ms)", "Stability Enhancer", "Turbo Shots", "RS Shooting", "Insta Shot", "Insta Speed (ms)", "Insta Tempo (ms)", "Remap Square", "Full Court Green L1/LB", "Infinite Stamina" };
const string pageChg[] = {"---------L2+RIGHT->", "<-L2+LEFT--L2+RIGHT->", "<-L2+LEFT---------"};
const string item_toggle[] = {"L2 + UP/DOWN", "to change"};
const string onOff[] = {"OFF", "ON", "", "L3", "R3"};
const string ms[] = {"ms"};
const string reverse_modes[] = {"Hop Jumper", "Turbo Fade"};

// display for Turbo Shots page
int isLoadingScreen = 1;
define LoadingTimer = 2000;
int LoadingTimeToRun = 0;

// Additional variables for graph
int graph_width;
int x_start;
int mid_x;
int bar_pos;
int infinite_stamina = 1;      // ON/OFF toggle
int ground_control = 70;       // % of stick strength (lower = less stamina drain)
int ground_stick_active = 1;   // must be ON
int shooting_active = 0;       // disables stamina while shooting
// New flag for turbo fade
int is_turbo_fade = 0;
int flick_up_shooting_active = 1;

// ===== Init =====
init {
flick_up_shooting_active = 1;
delay_duration = 50;
Delay_duration_Insta = 50;
reverse_flick_mode = 1;
rs_shooting_active = 0;
rs_hold_duration = 300;
Insta_shot_active = 1;
Insta_shot_duration = 585;
remap_square_active = 0;
stabilization_variation = 150000;
full_court_green_tap_ms = 100;
full_court_green_active = 0;
full_court_green_timer = 0;
saver_on = 0;
saver_timer = 0;
cls_oled(OLED_BLACK);
}

// ===== Main =====
main {
// Console detect
if (get_console() == PIO_XB1) {
isXbox = 1;
} else {
isXbox = 0;
}

// ===== STARTUP / LOADING =====

LoadingTimeToRun += get_rtime();
if (LoadingTimeToRun >= LoadingTimer) {
cls_oled(OLED_BLACK);
isLoadingScreen = 0;
startup = 0;
saver_on = 1;
saver_timer = 80; // draw a saver frame soon
}
combo_run(Infinite_Stamina_Control);

if (get_val(PS4_SQUARE)
    || combo_running(Insta_shot_reversed)) {   // ✅ ADD THIS
    shooting_active = 1;
} else if (!combo_running(flick_up_rs_smooth)
        && !combo_running(flick_up_rs_reversed)
        && !combo_running(Insta_shot_smooth)
        && !combo_running(Insta_shot_reversed)) { // ✅ ADD THIS
    shooting_active = 0;
}
// ===== Menu open/close =====
if (event_press(PS4_CIRCLE) && menu_enabled) { // CLOSE MENU
menu_enabled = 0;
combo_run(vibration_off);
set_rgb(0,255,0);
saver_on = 1; // enable saver when leaving menu
} else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) { // OPEN MENU
menu_enabled = 1;
page = 1;
combo_run(vibration_on);
set_rgb(0,0,255);
saver_on = 0; // pause saver while menu is up
}

// ===== MENU RENDER & INPUT =====
if (menu_enabled) {
cls_oled(OLED_BLACK);
rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE);
line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);
print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageChg[pageChg_s]);
print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

// pages with numeric edit: 2 (tempo), 3 (stability enhancer), 7 (Insta speed), 8 (Insta tempo), 10 (Square hold)
if (page == 4) { // Turbo Shots page shows reverse_modes
print(center_x(get_string_length(reverse_modes[reverse_flick_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, reverse_modes[reverse_flick_mode]);
} else if (page == 9) { // Remap page shows L3/R3
print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[remap_square_active + 3]);
} else if (page != 2 && page != 3 && page != 7 && page != 8 && page != 10) { // other non-numeric pages show ON/OFF
print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
}
print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_toggle[toggleType]);

if (page == 1) {
pageChg_s = 0;
} else if (page == numpgs) {
pageChg_s = 2;
} else {
pageChg_s = 1;
}
if (page > numpgs) {
page = numpgs;
}
if (page < 1) {
page = 1;
}
if (get_val(PS4_L2)) {
set_val(PS4_UP,0);
set_val(PS4_DOWN,0);
set_val(PS4_LEFT,0);
set_val(PS4_RIGHT,0);
}
if (get_val(PS4_L2) && event_press(PS4_LEFT)) {
page--;
combo_run(vibration_valchg);
}
if (get_val(PS4_L2) && event_press(PS4_RIGHT)) {
page++;
combo_run(vibration_valchg);
}

// Page 1: Auto Green
if (page == 1) {
menuSelection = flick_up_shooting_active;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
flick_up_shooting_active = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
flick_up_shooting_active = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

// Page 2: Tempo Speed (ms) -> delay_duration
if (page == 2) {
menuSelection = 2;
toggleType = 0;
NumberToString(delay_duration, FindDigits(delay_duration));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
draw_x_graph(delay_duration, 0, 300, 45);
if (get_val(PS4_L2)) {
if (event_press(PS4_UP)) {
delay_duration++;
}
if (event_press(PS4_DOWN)) {
delay_duration--;
}
if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
combo_run(vibration_valchg);
combo_run(flashedit);
}
}
if (delay_duration > 300) {
delay_duration = 300;
}
if (delay_duration < 0) {
delay_duration = 0;
}
}

// Page 3: Stability Enhancer -> stabilization_variation
if (page == 3) {
menuSelection = 2;
toggleType = 0;
NumberToString(stabilization_variation, FindDigits(stabilization_variation));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
draw_x_graph(stabilization_variation, 10, 150000, 45);
if (get_val(PS4_L2)) {
if (event_press(PS4_UP)) {
stabilization_variation++;
}
if (event_press(PS4_DOWN)) {
stabilization_variation--;
}
if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
combo_run(vibration_valchg);
combo_run(flashedit);
}
}
if (stabilization_variation > 150000) {
stabilization_variation = 150000;
}
if (stabilization_variation < 10) {
stabilization_variation = 10;
}
}

// Page 4: Turbo Shots (reverse_flick_mode ON/OFF)
if (page == 4) {
menuSelection = reverse_flick_mode;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
reverse_flick_mode = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
reverse_flick_mode = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

// Page 5: RS Shooting
if (page == 5) {
menuSelection = rs_shooting_active;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
rs_shooting_active = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
rs_shooting_active = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

// Page 6: Insta Shot
if (page == 6) {
menuSelection = Insta_shot_active;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
Insta_shot_active = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
Insta_shot_active = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

// Page 7: Insta Speed (ms) -> Insta_shot_duration
if (page == 7) {
menuSelection = 2;
toggleType = 0;
NumberToString(Insta_shot_duration, FindDigits(Insta_shot_duration));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
draw_x_graph(Insta_shot_duration, 100, 1000, 45);
if (get_val(PS4_L2)) {
if (get_val(PS4_R1)) {
if (event_press(PS4_UP)) {
Insta_shot_duration += 10;
}
if (event_press(PS4_DOWN)) {
Insta_shot_duration -= 10;
}
} else {
if (event_press(PS4_UP)) {
Insta_shot_duration += 1;
}
if (event_press(PS4_DOWN)) {
Insta_shot_duration -= 1;
}
}
if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
combo_run(vibration_valchg);
combo_run(flashedit);
}
}
if (Insta_shot_duration > 1000) {
Insta_shot_duration = 1000;
}
if (Insta_shot_duration < 100) {
Insta_shot_duration = 100;
}
}

// Page 8: Insta Tempo (ms) -> Delay_duration_Insta
if (page == 8) {
menuSelection = 2;
toggleType = 0;
NumberToString(Delay_duration_Insta, FindDigits(Delay_duration_Insta));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
draw_x_graph(Delay_duration_Insta, 0, 300, 45);
if (get_val(PS4_L2)) {
if (event_press(PS4_UP)) {
Delay_duration_Insta++;
}
if (event_press(PS4_DOWN)) {
Delay_duration_Insta--;
}
if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
combo_run(vibration_valchg);
combo_run(flashedit);
}
}
if (Delay_duration_Insta > 300) {
Delay_duration_Insta = 300;
}
if (Delay_duration_Insta < 0) {
Delay_duration_Insta = 0;
}
}

// Page 9: Remap Square (L3/R3)
if (page == 9) {
menuSelection = remap_square_active;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
remap_square_active = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
remap_square_active = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}
// Page 10: Full Court Green L1/LB (ms)
if (page == 10) {
menuSelection = 2;
NumberToString(full_court_green_tap_ms, FindDigits(full_court_green_tap_ms));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
draw_x_graph(full_court_green_tap_ms, 1, 1000, 45);
if (event_press(PS4_UP)) full_court_green_tap_ms += 10;
if (event_press(PS4_DOWN)) full_court_green_tap_ms -= 10;
if (full_court_green_tap_ms > 1000) full_court_green_tap_ms = 1000;
if (full_court_green_tap_ms < 1) full_court_green_tap_ms = 1;
}
// Page 11: Infinite Stamina ON/OFF
if (page == 11) {
menuSelection = infinite_stamina;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
    infinite_stamina = 1;
    flashtoggle = 1;
    combo_run(vibration_valchg);
    combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
    infinite_stamina = 0;
    flashtoggle = 0;
    combo_run(vibration_valchg);
    combo_run(flashtog);
}
}

} // end menu_enabled

// ===== Gameplay logic (no menu) =====
if (!menu_enabled) {
// idle visuals
set_rgb(0,255,0);

// run saver every ~80ms only when outside the menu
if (saver_on) {
saver_timer += get_rtime();
if (saver_timer >= 80) {
saver_step();
saver_timer = 0;
}
}

// L3/R3 Remap Logic for Square
if (remap_square_active == 0) {
if (get_val(PS4_L3)) {
set_val(PS4_SQUARE, 100);
}
} else {
if (get_val(PS4_R3)) {
set_val(PS4_SQUARE, 100);
}
}

// Full Court Green L1/LB: L1 holds Square for the configured time.
// It is intentionally separated from Auto Green, so L1 does NOT move the RS.
if (event_press(PS4_L1)) {
    full_court_green_active = 1;
    combo_run(full_court_green_tap);
}

// Auto Green: original Square behavior is kept unchanged.
if (flick_up_shooting_active && !full_court_green_active) {
    if (event_press(PS4_SQUARE) && !(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
        if (reverse_flick_mode && get_val(PS4_R2)) {
            is_turbo_fade = 1;
        } else {
            is_turbo_fade = 0;
        }
    }

    if (get_val(PS4_SQUARE) && !(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
        set_val(PS4_SQUARE, 0);
        if (is_turbo_fade) {
            set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
        } else {
            set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
        }
        set_val(PS4_RX, random(random_variation_min, random_variation_max));
    }

    if (event_release(PS4_SQUARE) && !(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
        if (is_turbo_fade) {
            combo_run(flick_up_rs_reversed);
        } else {
            combo_run(flick_up_rs_smooth);
        }
        is_turbo_fade = 0;
    }
}
// D-PAD DOWN → Go To Shot Insta (priority)
if (event_press(PS4_DOWN)) {
    combo_run(go_to_shot_insta);
    
}



// 2. Normal Insta Shot logic
if (Insta_shot_active) {
    if ((remap_square_active == 0 && event_press(PS4_R3)) ||
        (remap_square_active == 1 && event_press(PS4_L3))) {

        if (reverse_flick_mode && get_val(PS4_R2)) {
            combo_run(Insta_shot_reversed);
        } else {
            combo_run(Insta_shot_smooth);
        }
    }
}

// Insta Shot Logic (R3/L3 depending on remap)
if (Insta_shot_active) {
if ((remap_square_active == 0 && event_press(PS4_R3)) || (remap_square_active == 1 && event_press(PS4_L3))) {
if (reverse_flick_mode && get_val(PS4_R2)) {
combo_run(Insta_shot_reversed);
} else {
combo_run(Insta_shot_smooth);
}
}
}

// RS Shooting (detect manual stick hold)
if (rs_shooting_active) {
if (!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
if (!isHolding) {
isHolding = 1;
holdTimer = 0;
if (get_val(PS4_RY) < 0) {
rs_is_up = 1;
} else {
rs_is_up = 0;
}
}
holdTimer += get_rtime();
} else {
if (isHolding) {
if (holdTimer > rs_hold_duration) {
if (!rs_is_up) {
combo_run(flick_up_rs_smooth);
} else {
combo_run(flick_up_rs_reversed);
}
}
isHolding = 0;
holdTimer = 0;
}
}
}
}
} // end !menu_enabled
} // end big else (post-startup)


// ===== OLED helpers =====


function saver_step() {
sx += 3;
if (sx >= OLED_HEIGHT) sx = 0;
draw_custom_oled();
}

