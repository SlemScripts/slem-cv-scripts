function draw_tt_scripture_screen() {
cls_oled(OLED_BLACK);

// Falling line splash screen behind the centered name.
rect_oled(8, (sx + 0) % OLED_HEIGHT, 1, 7, OLED_WHITE, OLED_WHITE);
rect_oled(18, (sx + 21) % OLED_HEIGHT, 1, 5, OLED_WHITE, OLED_WHITE);
rect_oled(30, (sx + 43) % OLED_HEIGHT, 1, 8, OLED_WHITE, OLED_WHITE);
rect_oled(45, (sx + 12) % OLED_HEIGHT, 1, 6, OLED_WHITE, OLED_WHITE);
rect_oled(59, (sx + 35) % OLED_HEIGHT, 1, 9, OLED_WHITE, OLED_WHITE);
rect_oled(73, (sx + 5) % OLED_HEIGHT, 1, 5, OLED_WHITE, OLED_WHITE);
rect_oled(88, (sx + 49) % OLED_HEIGHT, 1, 8, OLED_WHITE, OLED_WHITE);
rect_oled(102, (sx + 27) % OLED_HEIGHT, 1, 6, OLED_WHITE, OLED_WHITE);
rect_oled(118, (sx + 14) % OLED_HEIGHT, 1, 9, OLED_WHITE, OLED_WHITE);

rect_oled(14, (sx + 33) % OLED_HEIGHT, 2, 3, OLED_WHITE, OLED_WHITE);
rect_oled(37, (sx + 7) % OLED_HEIGHT, 2, 2, OLED_WHITE, OLED_WHITE);
rect_oled(69, (sx + 58) % OLED_HEIGHT, 2, 3, OLED_WHITE, OLED_WHITE);
rect_oled(111, (sx + 41) % OLED_HEIGHT, 2, 2, OLED_WHITE, OLED_WHITE);

rect_oled(14, 20, 100, 24, OLED_BLACK, OLED_BLACK);
print(center_x(get_string_length(saver_line1[0]), OLED_FONT_SMALL_WIDTH), 24, OLED_FONT_SMALL, OLED_WHITE, saver_line1[0]);
line_oled(22, 37, 106, 37, 2, OLED_WHITE);
line_oled(30, 40, 98, 40, 1, OLED_WHITE);
}
// New function for mapping values
function map(val, in_min, in_max, out_min, out_max) {
return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

// New function to draw X-axis graph
function draw_x_graph(value, min_val, max_val, y_pos) {
graph_width = 100;
x_start = (OLED_WIDTH - graph_width) / 2;
mid_x = x_start + graph_width / 2;
bar_pos = map(value, min_val, max_val, 0, graph_width);

// Draw axis line
line_oled(x_start, y_pos, x_start + graph_width, y_pos, 1, OLED_WHITE);

// Draw center tick
line_oled(mid_x, y_pos - 3, mid_x, y_pos + 3, 1, OLED_WHITE);

// Draw left tick
line_oled(x_start, y_pos - 2, x_start, y_pos + 2, 1, OLED_WHITE);

// Draw right tick
line_oled(x_start + graph_width, y_pos - 2, x_start + graph_width, y_pos + 2, 1, OLED_WHITE);

// Draw bar from start to position
rect_oled(x_start, y_pos - 2, bar_pos, 4, 1, OLED_WHITE);
}

// ===== Combos =====
// Full Court Green L1/LB: L1 -> Square hold only. No RS movement/flick.
combo full_court_green_tap {
    set_val(PS4_L1, 0);
    set_val(PS4_SQUARE, 100);
    wait(full_court_green_tap_ms);
    set_val(PS4_SQUARE, 0);
    full_court_green_active = 0;
}

combo flick_up_rs_smooth {
set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
wait(delay_duration);
set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
wait(300);
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}

combo flick_up_rs_reversed {
set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
wait(delay_duration);
set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
wait(300);
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}
combo Infinite_Stamina_Control {
    if (infinite_stamina
        && ground_stick_active
        && !shooting_active
        && !get_val(PS4_SQUARE)
        && !get_val(PS4_R3)
        && !combo_running(Insta_shot_smooth)
        && !combo_running(flick_up_rs_smooth)
        && !combo_running(flick_up_rs_reversed)
    ) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        } else {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}
combo Insta_shot_smooth {

// Initial pull (small humanization OK)
set_val(PS4_RY, STICK_DOWN_VALUE);
set_val(PS4_RX, 0);
wait(Insta_shot_duration);

// Gather / settle (VERY small variance)
set_val(PS4_RY, -55 + random(-1, 1));
set_val(PS4_RX, 18);
wait(Delay_duration_Insta);

// FINAL SNAP – NO RANDOMNESS
set_val(PS4_RY, -100);
set_val(PS4_RX, 25);
wait(260);

// Release
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}
combo go_to_shot_insta {

    set_val(PS4_RY, STICK_UP_VALUE);
    set_val(PS4_RX, 0);
    wait(1985);

    set_val(PS4_RY, 55 + random(-1, 1));
    set_val(PS4_RX, -18);
    wait(Delay_duration_Insta);

    set_val(PS4_RY, 100);
    set_val(PS4_RX, -25);
    wait(250);

    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}


combo Insta_shot_reversed {

    stamina_blocked = 1; // 🔴 STOP stamina logic

    // Initial pull
    set_val(PS4_RY, STICK_UP_VALUE);
    set_val(PS4_RX, 0);
    wait(871);

    // Gather
    set_val(PS4_RY, 55);
    set_val(PS4_RX, -18);
    wait(Delay_duration_Insta);

    // FINAL SNAP
    set_val(PS4_RY, 100);
    set_val(PS4_RX, -25);
    wait(500);

    // Release
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);

    stamina_blocked = 0; // 🟢 TURN stamina back on
}

// ===== UI effects =====
combo flashtog {
if (!flashtoggle) {
set_rgb(255, 0, 0);
} else {
set_rgb(0, 255, 0);
}
wait(1000);
set_rgb(0, 0, 255);
}

combo flashedit {
set_rgb(0, 0, 0);
wait(150);
set_rgb(0, 0, 255);
}

combo vibration_on {
set_rumble(RUMBLE_A, 100);
wait(200);
set_rumble(RUMBLE_A, 0);
}

combo vibration_off {
set_rumble(RUMBLE_A, 50);
wait(200);
set_rumble(RUMBLE_A, 0);
}

combo vibration_valchg {
set_rumble(RUMBLE_A, 50);
wait(50);
set_rumble(RUMBLE_A, 0);
}

// ===== Small helpers =====
function center_x(f_chars, f_font) {
return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

int bufferIndex, digitIndex, charIndex;
function NumberToString(f_val, f_digits) {
bufferIndex = 1;
digitIndex = 10000;
if (f_val < 0) {
putc_oled(bufferIndex, 45);
bufferIndex += 1;
f_val = abs(f_val);
}
for (charIndex = 5; charIndex >= 1; charIndex--) {
if (f_digits >= charIndex) {
putc_oled(bufferIndex, (f_val / digitIndex) + 48);
f_val %= digitIndex;
bufferIndex++;
if (charIndex == 4) {
putc_oled(bufferIndex, 44);
bufferIndex++;
}
}
digitIndex /= 10;
}
puts_oled(center_x(bufferIndex + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_WHITE);
}

int logVal;
function FindDigits(num) {
logVal = 0;
do {
num /= 10;
logVal++;
} while (num);
return logVal;
}

int stringLength;
function get_string_length(offset) {
stringLength = 0;
while (duint8(offset++)) {
stringLength++;
}
return stringLength + 1;
}                