// Script by Sopelele
/*
 SSSS   OOOOO  PPPPPP  EEEEEE  L       EEEEEE  L       EEEEEE
S      O     O P     P E       L       E       L       E
 SSSS  O     O PPPPPP  EEEEE   L       EEEEE   L       EEEEE
     S O     O P       E       L       E       L       E
 SSSS   OOOOO  P       EEEEEE  LLLLLL  EEEEEE  LLLLLL  EEEEEE
*/

int delay_duration = 50;
int STICK_DOWN_VALUE = 100;
int STICK_UP_VALUE = -100;
int random_variation_min = -4;
int random_variation_max = 4;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;

// Zmienne przypisane pod menu
int flick_up_shooting_active = 1; // Osobny toggle flicka dla Kwadratu
int tempo_mode_active = 1;        // Globalny toggle flicka dla R3, L1 i Go To Shot
int go_to_shot_duration = 1869;
int go_to_shot_tempo = 47;
int stabilization_variation = 34; 
int reverse_flick_mode = 1;

// Auto Shot R3
int Insta_shot_active = 1;
int Insta_shot_duration = 647;
int Delay_duration_Insta = 47;

// Auto Shot L1
int Auto_L1_active = 1;
int Auto_L1_duration = 647;
int Delay_duration_Auto_L1 = 47;

int remap_square_active = 0; 
int infinite_stamina = 1;      

// Reszta zmiennych
int ground_control = 70;       
int shooting_active = 0;       
int is_turbo_fade = 0;

// --- Wygaszacz i Śnieg ---
int saver_on = 0;
int sx = 2, sy = 16;
int svx = 1, svy = 1; 
int msg_w, line1_w, line2_w;
int saver_timer = 0;

// NAPISY DLA WYGASZACZA
const string saver_line1[] = { "Snazy x Tag" };
const string saver_line2[] = { "   2k27   " };

// Tło wygaszacza i menu (śnieg)
int dot_x[12];
int dot_y[12];
int dot_s[12];
int i_dot;

// ===== Menu state =====
int startup = 1, numpgs = 15, menu_enabled = 0, page = 1, menuSelection, toggleType;
int flashtoggle;

// ===== Menu labels =====
const string menu_header[] = { 
    "Auto Green", 
    "Tempo Mode", 
    "Tempo Speed(ms)", 
    "Go to Speed(ms)", 
    "Go to Tempo(ms)", 
    "Stability Config", 
    "Turbo Shots", 
    "Auto Shot (R3)", 
    "Auto R3 Spd(ms)", 
    "Auto R3 Tmp(ms)", 
    "Auto Shot (L1)", 
    "Auto L1 Spd(ms)", 
    "Auto L1 Tmp(ms)", 
    "Remap Square", 
    "Infinite Stamina" 
};
const string item_toggle[] = {"L2 + UP/DOWN", "to change"};
const string onOff[] = {"OFF", "ON", "", "L3", "R3"};
const string reverse_modes[] = {"Hop Jumper", "Turbo Fade"};

define LoadingTimer = 2000;
int LoadingTimeToRun = 0;

int graph_width;
int x_start;
int mid_x;
int bar_pos;

// ===== Init =====
init {
    // WCZYTYWANIE USTAWIEŃ Z PAMIĘCI
    flick_up_shooting_active = get_pvar(SPVAR_1, 0, 1, 1);
    tempo_mode_active = get_pvar(SPVAR_2, 0, 1, 1);
    delay_duration = get_pvar(SPVAR_3, 0, 300, 50);
    go_to_shot_duration = get_pvar(SPVAR_4, 100, 3000, 1869);
    go_to_shot_tempo = get_pvar(SPVAR_5, 0, 300, 47);
    stabilization_variation = get_pvar(SPVAR_6, 10, 32000, 34); 
    reverse_flick_mode = get_pvar(SPVAR_7, 0, 1, 1);
    Insta_shot_active = get_pvar(SPVAR_8, 0, 1, 1);
    Insta_shot_duration = get_pvar(SPVAR_9, 100, 1000, 647);
    Delay_duration_Insta = get_pvar(SPVAR_10, 0, 300, 47);
    Auto_L1_active = get_pvar(SPVAR_11, 0, 1, 1);
    Auto_L1_duration = get_pvar(SPVAR_12, 100, 1000, 647);
    Delay_duration_Auto_L1 = get_pvar(SPVAR_13, 0, 300, 47);
    remap_square_active = get_pvar(SPVAR_14, 0, 1, 0);
    infinite_stamina = get_pvar(SPVAR_15, 0, 1, 1);

    saver_on = 0;
    saver_timer = 0;
    
    // Inicjalizacja śniegu
    for (i_dot = 0; i_dot < 12; i_dot++) {
        dot_x[i_dot] = random(0, 127);
        dot_y[i_dot] = random(0, 63);
        dot_s[i_dot] = random(1, 3);
    }
    
    cls_oled(OLED_BLACK);
}

// ===== Main =====
main {
    // ===== STARTUP / LOADING =====
    if (LoadingTimeToRun < LoadingTimer) {
        LoadingTimeToRun += get_rtime();
        if (LoadingTimeToRun >= LoadingTimer) {
            cls_oled(OLED_BLACK);
            startup = 0;
            saver_on = 1;
            saver_timer = 80; 
        }
    }

    combo_run(Infinite_Stamina_Control);

    if (get_val(PS4_SQUARE) || combo_running(Insta_shot_reversed) || combo_running(Simple_R3_Shot) || combo_running(Simple_Go_To_Shot) || combo_running(Auto_L1_reversed) || combo_running(Simple_L1_Shot)) {   
        shooting_active = 1;
    } else if (!combo_running(flick_up_rs_smooth)
            && !combo_running(flick_up_rs_reversed)
            && !combo_running(Insta_shot_smooth)
            && !combo_running(Insta_shot_reversed)
            && !combo_running(Simple_R3_Shot)
            && !combo_running(go_to_shot_insta)
            && !combo_running(Simple_Go_To_Shot)
            && !combo_running(Auto_L1_smooth)
            && !combo_running(Auto_L1_reversed)
            && !combo_running(Simple_L1_Shot)) { 
        shooting_active = 0;
    }

    // ===== Menu open/close =====
    if (event_press(PS4_CIRCLE) && menu_enabled) { 
        menu_enabled = 0;
        combo_run(vibration_off);
        set_rgb(0,255,0);
        saver_on = 1; 
        
        // ZAPISYWANIE USTAWIEŃ PO ZAMKNIĘCIU MENU
        set_pvar(SPVAR_1, flick_up_shooting_active);
        set_pvar(SPVAR_2, tempo_mode_active);
        set_pvar(SPVAR_3, delay_duration);
        set_pvar(SPVAR_4, go_to_shot_duration);
        set_pvar(SPVAR_5, go_to_shot_tempo);
        set_pvar(SPVAR_6, stabilization_variation);
        set_pvar(SPVAR_7, reverse_flick_mode);
        set_pvar(SPVAR_8, Insta_shot_active);
        set_pvar(SPVAR_9, Insta_shot_duration);
        set_pvar(SPVAR_10, Delay_duration_Insta);
        set_pvar(SPVAR_11, Auto_L1_active);
        set_pvar(SPVAR_12, Auto_L1_duration);
        set_pvar(SPVAR_13, Delay_duration_Auto_L1);
        set_pvar(SPVAR_14, remap_square_active);
        set_pvar(SPVAR_15, infinite_stamina);

    } else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) { 
        menu_enabled = 1;
        page = 1;
        combo_run(vibration_on);
        set_rgb(0,0,255);
        saver_on = 0; 
    }

    // ===== MENU RENDER & INPUT =====
    if (menu_enabled) {
        cls_oled(OLED_BLACK);
        
        // PADĄJĄCY ŚNIEG W TLE MENU
        for (i_dot = 0; i_dot < 12; i_dot++) {
            rect_oled(dot_x[i_dot], dot_y[i_dot], 1, 1, 1, OLED_WHITE);
            dot_y[i_dot] += dot_s[i_dot]; 
            if (dot_y[i_dot] > 63) {
                dot_y[i_dot] = 0;
                dot_x[i_dot] = random(0, 127);
                dot_s[i_dot] = random(1, 3);
            }
        }

        // Rysowanie UI menu 
        rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE); 
        line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);
        
        // TYTUŁ ZAKŁADKI WYŚRODKOWANY
        print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

        if (page == 7) { 
            print(center_x(get_string_length(reverse_modes[reverse_flick_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, reverse_modes[reverse_flick_mode]);
        } else if (page == 14) { 
            print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[remap_square_active + 3]);
        } else if (page != 3 && page != 4 && page != 5 && page != 6 && page != 9 && page != 10 && page != 12 && page != 13) { 
            print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
        }
        print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_toggle[toggleType]);

        // Bezpieczniki przewijania stron
        if (page > numpgs) page = numpgs;
        if (page < 1) page = 1;
        
        if (get_val(PS4_L2)) {
            set_val(PS4_UP,0); set_val(PS4_DOWN,0); set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0);
        }
        if (get_val(PS4_L2) && event_press(PS4_LEFT)) {
            page--; combo_run(vibration_valchg);
        }
        if (get_val(PS4_L2) && event_press(PS4_RIGHT)) {
            page++; combo_run(vibration_valchg);
        }

        // --- Logika edycji na Stronach ---

        // Page 1: Auto Green
        if (page == 1) {
            menuSelection = flick_up_shooting_active; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { flick_up_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { flick_up_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }

        // Page 2: Tempo Mode
        if (page == 2) {
            menuSelection = tempo_mode_active; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { tempo_mode_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { tempo_mode_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }

        // Page 3: Tempo Speed (ms)
        if (page == 3) {
            menuSelection = 2; toggleType = 0;
            NumberToString(delay_duration, FindDigits(delay_duration)); draw_x_graph(delay_duration, 0, 300, 45);
            if (get_val(PS4_L2)) {
                if (event_press(PS4_UP)) delay_duration++;
                if (event_press(PS4_DOWN)) delay_duration--;
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (delay_duration > 300) delay_duration = 300; if (delay_duration < 0) delay_duration = 0;
        }

        // Page 4: Go to Speed (ms)
        if (page == 4) {
            menuSelection = 2; toggleType = 0;
            NumberToString(go_to_shot_duration, FindDigits(go_to_shot_duration)); draw_x_graph(go_to_shot_duration, 100, 3000, 45);
            if (get_val(PS4_L2)) {
                if (get_val(PS4_R1)) {
                    if (event_press(PS4_UP)) go_to_shot_duration += 10;
                    if (event_press(PS4_DOWN)) go_to_shot_duration -= 10;
                } else {
                    if (event_press(PS4_UP)) go_to_shot_duration += 1;
                    if (event_press(PS4_DOWN)) go_to_shot_duration -= 1;
                }
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (go_to_shot_duration > 3000) go_to_shot_duration = 3000; if (go_to_shot_duration < 100) go_to_shot_duration = 100;
        }

        // Page 5: Go to Tempo (ms) 
        if (page == 5) {
            menuSelection = 2; toggleType = 0;
            NumberToString(go_to_shot_tempo, FindDigits(go_to_shot_tempo)); draw_x_graph(go_to_shot_tempo, 0, 300, 45);
            if (get_val(PS4_L2)) {
                if (event_press(PS4_UP)) go_to_shot_tempo++;
                if (event_press(PS4_DOWN)) go_to_shot_tempo--;
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (go_to_shot_tempo > 300) go_to_shot_tempo = 300; if (go_to_shot_tempo < 0) go_to_shot_tempo = 0;
        }

        // Page 6: Stability Config
        if (page == 6) {
            menuSelection = 2; toggleType = 0;
            NumberToString(stabilization_variation, FindDigits(stabilization_variation)); draw_x_graph(stabilization_variation, 10, 32000, 45);
            if (get_val(PS4_L2)) {
                if (event_press(PS4_UP)) stabilization_variation++;
                if (event_press(PS4_DOWN)) stabilization_variation--;
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (stabilization_variation > 32000) stabilization_variation = 32000; if (stabilization_variation < 10) stabilization_variation = 10;
        }

        // Page 7: Turbo Shots
        if (page == 7) {
            menuSelection = reverse_flick_mode; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { reverse_flick_mode = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { reverse_flick_mode = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }

        // Page 8: Auto Shot (R3)
        if (page == 8) {
            menuSelection = Insta_shot_active; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { Insta_shot_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { Insta_shot_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }

        // Page 9: Auto R3 Spd (ms)
        if (page == 9) {
            menuSelection = 2; toggleType = 0;
            NumberToString(Insta_shot_duration, FindDigits(Insta_shot_duration)); draw_x_graph(Insta_shot_duration, 100, 1000, 45);
            if (get_val(PS4_L2)) {
                if (get_val(PS4_R1)) {
                    if (event_press(PS4_UP)) Insta_shot_duration += 10;
                    if (event_press(PS4_DOWN)) Insta_shot_duration -= 10;
                } else {
                    if (event_press(PS4_UP)) Insta_shot_duration += 1;
                    if (event_press(PS4_DOWN)) Insta_shot_duration -= 1;
                }
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (Insta_shot_duration > 1000) Insta_shot_duration = 1000; if (Insta_shot_duration < 100) Insta_shot_duration = 100;
        }

        // Page 10: Auto R3 Tmp (ms)
        if (page == 10) {
            menuSelection = 2; toggleType = 0;
            NumberToString(Delay_duration_Insta, FindDigits(Delay_duration_Insta)); draw_x_graph(Delay_duration_Insta, 0, 300, 45);
            if (get_val(PS4_L2)) {
                if (event_press(PS4_UP)) Delay_duration_Insta++;
                if (event_press(PS4_DOWN)) Delay_duration_Insta--;
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (Delay_duration_Insta > 300) Delay_duration_Insta = 300; if (Delay_duration_Insta < 0) Delay_duration_Insta = 0;
        }

        // Page 11: Auto Shot (L1)
        if (page == 11) {
            menuSelection = Auto_L1_active; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { Auto_L1_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { Auto_L1_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }

        // Page 12: Auto L1 Spd (ms)
        if (page == 12) {
            menuSelection = 2; toggleType = 0;
            NumberToString(Auto_L1_duration, FindDigits(Auto_L1_duration)); draw_x_graph(Auto_L1_duration, 100, 1000, 45);
            if (get_val(PS4_L2)) {
                if (get_val(PS4_R1)) {
                    if (event_press(PS4_UP)) Auto_L1_duration += 10;
                    if (event_press(PS4_DOWN)) Auto_L1_duration -= 10;
                } else {
                    if (event_press(PS4_UP)) Auto_L1_duration += 1;
                    if (event_press(PS4_DOWN)) Auto_L1_duration -= 1;
                }
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (Auto_L1_duration > 1000) Auto_L1_duration = 1000; if (Auto_L1_duration < 100) Auto_L1_duration = 100;
        }

        // Page 13: Auto L1 Tmp (ms)
        if (page == 13) {
            menuSelection = 2; toggleType = 0;
            NumberToString(Delay_duration_Auto_L1, FindDigits(Delay_duration_Auto_L1)); draw_x_graph(Delay_duration_Auto_L1, 0, 300, 45);
            if (get_val(PS4_L2)) {
                if (event_press(PS4_UP)) Delay_duration_Auto_L1++;
                if (event_press(PS4_DOWN)) Delay_duration_Auto_L1--;
                if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
            }
            if (Delay_duration_Auto_L1 > 300) Delay_duration_Auto_L1 = 300; if (Delay_duration_Auto_L1 < 0) Delay_duration_Auto_L1 = 0;
        }

        // Page 14: Remap Square
        if (page == 14) {
            menuSelection = remap_square_active; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { remap_square_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { remap_square_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }

        // Page 15: Infinite Stamina
        if (page == 15) {
            menuSelection = infinite_stamina; toggleType = 0;
            if (get_val(PS4_L2) && event_press(PS4_UP)) { infinite_stamina = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
            if (get_val(PS4_L2) && event_press(PS4_DOWN)) { infinite_stamina = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
        }
    } // end menu_enabled

    // ===== Gameplay logic (no menu) =====
    if (!menu_enabled) {
        set_rgb(0,255,0);

        if (saver_on) {
            saver_timer += get_rtime();
            if (saver_timer >= 80) {
                saver_step();
                saver_timer = 0;
            }
        }

        // L3/R3 Remap Logic for Square
        if (remap_square_active == 0) {
            if (get_val(PS4_L3)) set_val(PS4_SQUARE, 100);
        } else {
            if (get_val(PS4_R3)) set_val(PS4_SQUARE, 100);
        }

        if (event_press(PS4_SQUARE) && !(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
            if (reverse_flick_mode && get_val(PS4_R2)) is_turbo_fade = 1;
            else is_turbo_fade = 0;
        }

        // Auto Green logic
        if (flick_up_shooting_active) {
            if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE)) {
                set_val(PS4_SQUARE, 0);
                if (is_turbo_fade) {
                    set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                } else {
                    set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                }
                set_val(PS4_RX, random(random_variation_min, random_variation_max));
            }
            if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE)) {
                if (is_turbo_fade) combo_run(flick_up_rs_reversed);
                else combo_run(flick_up_rs_smooth);
                is_turbo_fade = 0;
            }
        }

        // D-PAD DOWN → Go To Shot (Zależne od Tempo Mode)
        if (event_press(PS4_DOWN)) {
            if (tempo_mode_active) {
                combo_run(go_to_shot_insta);
            } else {
                combo_run(Simple_Go_To_Shot);
            }
        }

        // Auto Shot R3 logic (Zależne od Tempo Mode)
        if (Insta_shot_active) {
            if ((remap_square_active == 0 && event_press(PS4_R3)) ||
                (remap_square_active == 1 && event_press(PS4_L3))) {

                if (tempo_mode_active) {
                    if (reverse_flick_mode && get_val(PS4_R2)) {
                        combo_run(Insta_shot_reversed);
                    } else {
                        combo_run(Insta_shot_smooth);
                    }
                } else {
                    combo_run(Simple_R3_Shot);
                }
            }
        }

        // Auto Shot L1 logic (Zależne od Tempo Mode + Firewall)
        if (Auto_L1_active) {
            if (event_press(PS4_L1)) {
                if (tempo_mode_active) {
                    if (reverse_flick_mode && get_val(PS4_R2)) {
                        combo_run(Auto_L1_reversed);
                    } else {
                        combo_run(Auto_L1_smooth);
                    }
                } else {
                    combo_run(Simple_L1_Shot);
                }
            }
        }

        // FIREWALL DLA L1 (Odcina ikony w parku, D-Pad Left robi za L1)
        if (Auto_L1_active) {
            set_val(PS4_L1, 0); 
            if (get_val(PS4_LEFT)) {
                set_val(PS4_L1, 100);
                set_val(PS4_LEFT, 0); 
            }
        }
    } 
} 

// ===== OLED helpers =====

function saver_step() {
    cls_oled(OLED_BLACK);
    
    // TŁO: Płatki śniegu
    for (i_dot = 0; i_dot < 12; i_dot++) {
        rect_oled(dot_x[i_dot], dot_y[i_dot], 1, 1, 1, OLED_WHITE);
        dot_y[i_dot] += dot_s[i_dot]; 
        
        if (dot_y[i_dot] > 63) {
            dot_y[i_dot] = 0;
            dot_x[i_dot] = random(0, 127);
            dot_s[i_dot] = random(1, 3);
        }
    }

    // PIERWSZY PLAN: Duży napis (OLED_FONT_MEDIUM)
    print(sx, sy, OLED_FONT_MEDIUM, OLED_WHITE, saver_line1[0]);
    print(sx, sy + 16, OLED_FONT_MEDIUM, OLED_WHITE, saver_line2[0]);

    // Odbijanie tekstu 
    line1_w = (get_string_length(saver_line1[0]) - 1) * OLED_FONT_MEDIUM_WIDTH;
    line2_w = (get_string_length(saver_line2[0]) - 1) * OLED_FONT_MEDIUM_WIDTH;
    if (line1_w > line2_w) msg_w = line1_w;
    else msg_w = line2_w;

    sx += svx;
    sy += svy;

    if (sx <= 1 || sx >= (OLED_WIDTH - msg_w - 1)) svx = -svx;
    if (sy <= 1 || sy >= 28) svy = -svy; 
}

function map(val, in_min, in_max, out_min, out_max) {
    return ((val - in_min) / ((in_max - in_min) / (out_max - out_min))) + out_min;
}

function draw_x_graph(value, min_val, max_val, y_pos) {
    graph_width = 100;
    x_start = (OLED_WIDTH - graph_width) / 2;
    mid_x = x_start + graph_width / 2;
    bar_pos = map(value, min_val, max_val, 0, graph_width);

    line_oled(x_start, y_pos, x_start + graph_width, y_pos, 1, OLED_WHITE);
    line_oled(mid_x, y_pos - 3, mid_x, y_pos + 3, 1, OLED_WHITE);
    line_oled(x_start, y_pos - 2, x_start, y_pos + 2, 1, OLED_WHITE);
    line_oled(x_start + graph_width, y_pos - 2, x_start + graph_width, y_pos + 2, 1, OLED_WHITE);
    rect_oled(x_start, y_pos - 2, bar_pos, 4, 1, OLED_WHITE);
}

// ===== Combos =====
combo flick_up_rs_smooth {
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo flick_up_rs_reversed {
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Infinite_Stamina_Control {
    if (infinite_stamina
        && !shooting_active
        && !get_val(PS4_SQUARE)
        && !get_val(PS4_R3)
        && !combo_running(Insta_shot_smooth)
        && !combo_running(flick_up_rs_smooth)
        && !combo_running(flick_up_rs_reversed)
        && !combo_running(Auto_L1_smooth)
        && !combo_running(Auto_L1_reversed)
    ) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        } else {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

