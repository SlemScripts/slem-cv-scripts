function run_sequence() {
    sequence_timer = sequence_timer + get_rtime();

    switch(sequence_state) {
        case STATE_ACTIVATION_WAIT {
            if(sequence_timer >= ACTIVATION_WAIT_MS) next_state(STATE_WAIT_1610);
            break;
        }
        case STATE_WAIT_1610 {
            if(sequence_timer >= 1610) next_state(STATE_CROSS_140);
            break;
        }
        case STATE_CROSS_140 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 140) next_state(STATE_WAIT_580);
            break;
        }
        case STATE_WAIT_580 {
            if(sequence_timer >= 580) next_state(STATE_CROSS_120);
            break;
        }
        case STATE_CROSS_120 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 120) next_state(STATE_WAIT_20);
            break;
        }
        case STATE_WAIT_20 {
            if(sequence_timer >= 20) next_state(STATE_CROSS_110);
            break;
        }
        case STATE_CROSS_110 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 110) next_state(STATE_WAIT_80_A);
            break;
        }
        case STATE_WAIT_80_A {
            if(sequence_timer >= 80) next_state(STATE_CROSS_130);
            break;
        }
        case STATE_CROSS_130 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 130) next_state(STATE_WAIT_60);
            break;
        }
        case STATE_WAIT_60 {
            if(sequence_timer >= 60) next_state(STATE_CROSS_100);
            break;
        }
        case STATE_CROSS_100 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 100) next_state(STATE_WAIT_70);
            break;
        }
        case STATE_WAIT_70 {
            if(sequence_timer >= 70) next_state(STATE_CROSS_80);
            break;
        }
        case STATE_CROSS_80 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 80) next_state(STATE_WAIT_1100);
            break;
        }
        case STATE_WAIT_1100 {
            if(sequence_timer >= 1100) next_state(STATE_R2_120);
            break;
        }
        case STATE_R2_120 {
            set_val(PS5_R2, 100);
            if(sequence_timer >= 120) next_state(STATE_WAIT_8700);
            break;
        }
        case STATE_WAIT_8700 {
            if(sequence_timer >= 8700) next_state(STATE_R2_140);
            break;
        }
        case STATE_R2_140 {
            set_val(PS5_R2, 100);
            if(sequence_timer >= 140) next_state(STATE_WAIT_3370);
            break;
        }
        case STATE_WAIT_3370 {
            if(sequence_timer >= 3370) next_state(STATE_CROSS_80_B);
            break;
        }
        case STATE_CROSS_80_B {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 80) next_state(STATE_WAIT_80_B);
            break;
        }
        case STATE_WAIT_80_B {
            if(sequence_timer >= 80) next_state(STATE_CROSS_90);
            break;
        }
        case STATE_CROSS_90 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 90) next_state(STATE_WAIT_50);
            break;
        }
        case STATE_WAIT_50 {
            if(sequence_timer >= 50) next_state(STATE_CROSS_70);
            break;
        }
        case STATE_CROSS_70 {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 70) next_state(STATE_WAIT_120);
            break;
        }
        case STATE_WAIT_120 {
            if(sequence_timer >= 120) next_state(STATE_CROSS_90_B);
            break;
        }
        case STATE_CROSS_90_B {
            set_val(PS5_CROSS, 100);
            if(sequence_timer >= 90) next_state(STATE_WAIT_80_END);
            break;
        }
        case STATE_WAIT_80_END {
            if(sequence_timer >= 80) next_state(STATE_WAIT_1610);
            break;
        }
    }
}

function next_state(new_state) {
    sequence_state = new_state;
    sequence_timer = 0;
}

function draw_screen() {
    cls_oled(OLED_BLACK);

    // Smaller bold title lines fit comfortably within the OLED width.
    draw_centered(0, 4, OLED_FONT_SMALL, OLED_WHITE, TRUE);
    draw_centered(13, 16, OLED_FONT_SMALL, OLED_WHITE, TRUE);

    // Two short instruction lines remain fully visible.
    draw_centered(26, 33, OLED_FONT_SMALL, OLED_WHITE, FALSE);
    draw_centered(40, 43, OLED_FONT_SMALL, OLED_WHITE, FALSE);

    draw_clock();
}

function draw_centered(data_offset, y, font, color, bold_text) {
    text_length = 0;

    while(dint8(data_offset + text_length)) {
        putc_oled(text_length + 1, dint8(data_offset + text_length));
        text_length++;
    }

    if(font == OLED_FONT_MEDIUM) {
        glyph_width = OLED_FONT_MEDIUM_WIDTH;
    } else {
        glyph_width = OLED_FONT_SMALL_WIDTH;
    }

    text_x = (OLED_WIDTH - (text_length * glyph_width)) / 2;
    text_x = clamp(text_x, 0, OLED_WIDTH - (text_length * glyph_width));
    puts_oled(text_x, y, font, text_length, color);

    // A one-pixel duplicate creates bold text without clipping its right edge.
    if(bold_text && text_x + (text_length * glyph_width) < OLED_WIDTH) {
        puts_oled(text_x + 1, y, font, text_length, color);
    }
}

function draw_clock() {
    // Small animated clock remains isolated in the lower-right corner.
    rect_oled(108, 46, 19, 18, FALSE, OLED_WHITE);
    line_oled(117, 49, 117, 49, 1, OLED_WHITE);
    line_oled(117, 60, 117, 60, 1, OLED_WHITE);
    line_oled(111, 54, 111, 54, 1, OLED_WHITE);
    line_oled(124, 54, 124, 54, 1, OLED_WHITE);

    switch(oled_frame) {
        case 0 { line_oled(117, 54, 117, 49, 1, OLED_WHITE); break; }
        case 1 { line_oled(117, 54, 121, 50, 1, OLED_WHITE); break; }
        case 2 { line_oled(117, 54, 124, 54, 1, OLED_WHITE); break; }
        case 3 { line_oled(117, 54, 121, 58, 1, OLED_WHITE); break; }
        case 4 { line_oled(117, 54, 117, 60, 1, OLED_WHITE); break; }
        case 5 { line_oled(117, 54, 113, 58, 1, OLED_WHITE); break; }
        case 6 { line_oled(117, 54, 111, 54, 1, OLED_WHITE); break; }
        case 7 { line_oled(117, 54, 113, 50, 1, OLED_WHITE); break; }
    }
}
