/*
    Sewer's 2KTV Clicker - PS5 / Cronus Zen

    Toggle: Options / Start

    After activation and release, wait 1.5 seconds. Then replay
    retained recording steps 1-25 and loop them indefinitely.
*/

define STATE_ACTIVATION_WAIT = 0;
define STATE_WAIT_1610       = 1;
define STATE_CROSS_140       = 2;
define STATE_WAIT_580        = 3;
define STATE_CROSS_120       = 4;
define STATE_WAIT_20         = 5;
define STATE_CROSS_110       = 6;
define STATE_WAIT_80_A       = 7;
define STATE_CROSS_130       = 8;
define STATE_WAIT_60         = 9;
define STATE_CROSS_100       = 10;
define STATE_WAIT_70         = 11;
define STATE_CROSS_80        = 12;
define STATE_WAIT_1100       = 13;
define STATE_R2_120          = 14;
define STATE_WAIT_8700       = 15;
define STATE_R2_140          = 16;
define STATE_WAIT_3370       = 17;
define STATE_CROSS_80_B      = 18;
define STATE_WAIT_80_B       = 19;
define STATE_CROSS_90        = 20;
define STATE_WAIT_50         = 21;
define STATE_CROSS_70        = 22;
define STATE_WAIT_120        = 23;
define STATE_CROSS_90_B      = 24;
define STATE_WAIT_80_END     = 25;

define ACTIVATION_WAIT_MS = 1500;
define OLED_FRAME_MS      = 500;

// OLED strings:
// 0  = "Sewer's 2KTV"
// 13 = "Auto Clicker"
// 26 = "Press Options"
// 40 = "Start / Stop"
data(
    0x53,0x65,0x77,0x65,0x72,0x27,0x73,0x20,0x32,0x4B,0x54,0x56,0x00,
    0x41,0x75,0x74,0x6F,0x20,0x43,0x6C,0x69,0x63,0x6B,0x65,0x72,0x00,
    0x50,0x72,0x65,0x73,0x73,0x20,0x4F,0x70,0x74,0x69,0x6F,0x6E,0x73,0x00,
    0x53,0x74,0x61,0x72,0x74,0x20,0x2F,0x20,0x53,0x74,0x6F,0x70,0x00
);

int script_enabled = FALSE;
int toggle_lock = FALSE;
int sequence_state = STATE_ACTIVATION_WAIT;
int sequence_timer = 0;
int oled_timer = 0;
int oled_frame = 0;
int text_length = 0;
int text_x = 0;
int glyph_width = 0;

init {
    draw_screen();
}

main {
    if(event_press(PS5_OPTIONS)) {
        script_enabled = !script_enabled;
        toggle_lock = TRUE;
        sequence_state = STATE_ACTIVATION_WAIT;
        sequence_timer = 0;
    }

    // Wait for Options / Start to be released before starting.
    // The button is intentionally allowed to pass through to the game.
    if(toggle_lock) {
        if(!get_ival(PS5_OPTIONS)) {
            toggle_lock = FALSE;
            sequence_timer = 0;
        }
    }

    // Start only after both activation buttons have been fully released.
    if(script_enabled && !toggle_lock) {
        run_sequence();
    }

    // OLED animation uses an independent timer and cannot advance the sequence.
    oled_timer = oled_timer + get_rtime();
    if(oled_timer >= OLED_FRAME_MS) {
        oled_timer = 0;
        oled_frame = (oled_frame + 1) % 8;
        draw_screen();
    }
}

