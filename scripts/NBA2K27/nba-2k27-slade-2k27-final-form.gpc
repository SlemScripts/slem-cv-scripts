
// ============================================================
//  FINAL FORM SLADE
//  CODED BY SLADE
//
//  😈 Are you prepared to reach your final form? 😈
// ============================================================

int flick_up_shooting_active = 1;
int flick_sequences_enabled = 0;
int delay_duration = 50;
int Delay_duration_Insta = 50;
int STICK_DOWN_VALUE = 100;
int STICK_UP_VALUE   = -100;
int RX_UP_VALUE = 25;
int random_variation_min = -7;
int random_variation_max = 7;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;
int stabilization_variation = 34;

int reverse_flick_mode = 1;
int rs_shooting_active = 0;
int rs_hold_duration   = 300;

int Insta_shot_active   = 1;
int Insta_shot_duration = 650;

int isHolding = 0;
int holdTimer = 0;
int rs_is_up  = 0;
int remap_square_active = 0;

int zen_light_color = 0;
int rainbow_timer   = 0;
int rainbow_phase   = 0;

int dunk_mode   = 0;
int dunk_active = 0;
int spot_take_active = 0;

int infinite_stamina     = 0;
int ground_control       = 70;
int ground_stick_active  = 1;
int square_shooting_in_progress = 0;
int rs_shooting_in_progress     = 0;

int frame_time;

int saver_on = 0;
int sx = 2, sy = 16;
int svx = 2, svy = 2;
int msg_w, line1_w, line2_w;
int saver_timer = 0;
const string saver_line1[] = { "L2 + OPTIONS" };
const string saver_line2[] = { "CHANGE SETTINGS" };

const string load_l1[] = { "FINAL FORM" };
const string load_l2[] = { "SLADE" };
const string load_l3[] = { "CODED BY SLADE" };
const string load_l4[] = { "Are you prepared?" };

int startup = 1, numpgs = 9, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;

const string menu_header[] = {
    "Tempo AI",
    "Tempo Speed (ms)",
    "Stability Enhancer",
    "RS Shooting",
    "Remap Square",
    "Zen Light",
    "Dunk Mode",
    "Spot Take",
    "Infinite Stamina"
};

const string pageChg[]     = { "---------L2+RIGHT->", "<-L2+LEFT--L2+RIGHT->", "<-L2+LEFT---------" };
const string item_toggle[] = { "L2 + UP/DOWN", "to change" };
const string onOff[]       = { "OFF", "ON", "", "L3", "R3" };
const string ms[]          = { "ms" };

const string zen_light_colors[] = { "Blue", "Purple", "White", "Red", "Green", "Yellow", "Rainbow" };
const string dunk_modes[]       = { "Circle Hold", "L1 Hold", "RS Down" };

int isLoadingScreen = 1;
define LoadingTimer = 2000;
int LoadingTimeToRun = 0;

int graph_width;
int x_start;
int mid_x;
int bar_pos;

// ===== Init =====
init {
    if (get_pvar(SPVAR_10, 0, 32767, 0) != 8472) {
        set_pvar(SPVAR_1,  1);
        set_pvar(SPVAR_2,  40);
        set_pvar(SPVAR_3,  34);
        set_pvar(SPVAR_4,  0);
        set_pvar(SPVAR_5,  0);
        set_pvar(SPVAR_6,  0);
        set_pvar(SPVAR_7,  0);
        set_pvar(SPVAR_8,  2);
        set_pvar(SPVAR_9,  0);
        set_pvar(SPVAR_10, 8472);
    }
    flick_up_shooting_active = get_pvar(SPVAR_1, 0, 1,   1);
    delay_duration           = get_pvar(SPVAR_2, 0, 300, 40);
    stabilization_variation  = get_pvar(SPVAR_3, 10, 100, 34);
    rs_shooting_active       = get_pvar(SPVAR_4, 0, 1,   0);
    remap_square_active      = get_pvar(SPVAR_5, 0, 1,   0);
    infinite_stamina         = get_pvar(SPVAR_6, 0, 1,   0);
    zen_light_color          = get_pvar(SPVAR_7, 0, 6,   0);
    dunk_mode                = get_pvar(SPVAR_8, 0, 2,   2);
    spot_take_active         = get_pvar(SPVAR_9, 0, 1,   0);
    Insta_shot_active        = 1;
    Insta_shot_duration      = 650;
    dunk_active              = 0;
    ground_control           = 70;
    ground_stick_active      = 1;
    square_shooting_in_progress = 0;
    rs_shooting_in_progress     = 0;
    rainbow_timer            = 0;
    rainbow_phase            = 0;
    saver_on                 = 0;
    saver_timer              = 0;
    draw_picture(0, 0);
}

// ===== Main =====
main {
    if (get_console() == PIO_XB1) { isXbox = 1; } else { isXbox = 0; }

    if (startup && isLoadingScreen) {
        LoadingTimeToRun += get_rtime();
        if (LoadingTimeToRun >= LoadingTimer) {
            cls_oled(OLED_WHITE);
            isLoadingScreen = 0;
            startup  = 0;
            saver_on = 1;
            saver_timer = 80;
        }
    } else {
        combo_run(Movement_Control);

        if (event_press(PS4_CIRCLE) && menu_enabled) {
            set_pvar(SPVAR_1, flick_up_shooting_active);
            set_pvar(SPVAR_2, delay_duration);
            set_pvar(SPVAR_3, stabilization_variation);
            set_pvar(SPVAR_4, rs_shooting_active);
            set_pvar(SPVAR_5, remap_square_active);
            set_pvar(SPVAR_6, infinite_stamina);
            set_pvar(SPVAR_7, zen_light_color);
            set_pvar(SPVAR_8, dunk_mode);
            set_pvar(SPVAR_9, spot_take_active);
            menu_enabled = 0;
            combo_run(vibration_off);
            saver_on = 1;
        }
        else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = 1;
            combo_run(vibration_on);
            set_rgb(0, 0, 255);
            saver_on = 0;
        }

        // ===== MENU =====
        if (menu_enabled) {
            cls_oled(OLED_WHITE);
            rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_WHITE, OLED_BLACK);
            line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_BLACK);

            if (page == 1)           { pageChg_s = 0; }
            else if (page == numpgs) { pageChg_s = 2; }
            else                     { pageChg_s = 1; }
            if (page > numpgs) { page = numpgs; }
            if (page < 1)      { page = 1; }

            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 4,  OLED_FONT_SMALL, OLED_BLACK, pageChg[pageChg_s]);
            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_BLACK, menu_header[page - 1]);

            if (page == 5) {
                print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_BLACK, onOff[remap_square_active + 3]);
            } else if (page == 6) {
                print(center_x(get_string_length(zen_light_colors[zen_light_color]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_BLACK, zen_light_colors[zen_light_color]);
            } else if (page == 7) {
                print(center_x(get_string_length(dunk_modes[dunk_mode]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_BLACK, dunk_modes[dunk_mode]);
            } else if (page != 2 && page != 3) {
                print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_BLACK, onOff[menuSelection]);
            }
            print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_BLACK, item_toggle[toggleType]);

            if (get_val(PS4_L2)) { set_val(PS4_UP,0); set_val(PS4_DOWN,0); set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0); }
            if (get_val(PS4_L2) && event_press(PS4_LEFT)  && page > 1)      { page--; combo_run(vibration_valchg); }
            if (get_val(PS4_L2) && event_press(PS4_RIGHT) && page < numpgs) { page++; combo_run(vibration_valchg); }

            if (page == 1) {
                menuSelection = flick_up_shooting_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { flick_up_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { flick_up_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 2) {
                menuSelection = 2; toggleType = 0;
                NumberToString(delay_duration, FindDigits(delay_duration));
                print(70, 30, OLED_FONT_MEDIUM, OLED_BLACK, ms[0]);
                draw_x_graph(delay_duration, 0, 300, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { delay_duration++; }
                    if (event_press(PS4_DOWN)) { delay_duration--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (delay_duration > 300) { delay_duration = 300; }
                if (delay_duration < 0)   { delay_duration = 0;   }
            }
            if (page == 3) {
                menuSelection = 2; toggleType = 0;
                NumberToString(stabilization_variation, FindDigits(stabilization_variation));
                print(70, 30, OLED_FONT_MEDIUM, OLED_BLACK, ms[0]);
                draw_x_graph(stabilization_variation, 10, 100, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { stabilization_variation++; }
                    if (event_press(PS4_DOWN)) { stabilization_variation--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (stabilization_variation > 100) { stabilization_variation = 100; }
                if (stabilization_variation < 10)  { stabilization_variation = 10;  }
            }
            if (page == 4) {
                menuSelection = rs_shooting_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { rs_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { rs_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 5) {
                menuSelection = remap_square_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { remap_square_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { remap_square_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 6) {
                menuSelection = zen_light_color; toggleType = 1;
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { zen_light_color++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { zen_light_color--; combo_run(vibration_valchg); }
                }
                if (zen_light_color > 6) { zen_light_color = 0; }
                if (zen_light_color < 0) { zen_light_color = 6; }
            }
            if (page == 7) {
                menuSelection = dunk_mode; toggleType = 1;
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { dunk_mode++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { dunk_mode--; combo_run(vibration_valchg); }
                }
                if (dunk_mode > 2) { dunk_mode = 0; }
                if (dunk_mode < 0) { dunk_mode = 2; }
            }
            if (page == 8) {
                menuSelection = spot_take_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { spot_take_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { spot_take_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 9) {
                menuSelection = infinite_stamina; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { infinite_stamina = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { infinite_stamina = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
        }

        // ===== GAMEPLAY =====
        if (!menu_enabled) {
            frame_time  = get_rtime();
            dunk_active = 0;

            // Dunk mode (meter dunk)
            if (dunk_mode == 0) {
                if (get_val(PS4_CIRCLE)) {
                    set_val(PS4_RY, 100);
                    set_val(PS4_R2, 100);
                    dunk_active = 1;
                } else if (event_release(PS4_CIRCLE)) {
                    set_val(PS4_RY, 0);
                    set_val(PS4_R2, 0);
                }
            } else if (dunk_mode == 1) {
                if (get_val(PS4_L1)) {
                    set_val(PS4_RY, 100);
                    set_val(PS4_R2, 100);
                    dunk_active = 1;
                } else if (event_release(PS4_L1)) {
                    set_val(PS4_RY, 0);
                    set_val(PS4_R2, 0);
                }
            } else if (dunk_mode == 2 && get_val(PS4_RY) > 50) {
                dunk_active = 1;
            }

            // Zen light
            apply_zen_light();
            if (zen_light_color == 6) {
                rainbow_timer += frame_time;
                if (rainbow_timer >= 100) {
                    rainbow_timer = 0;
                    rainbow_phase++;
                    if (rainbow_phase > 11) { rainbow_phase = 0; }
                }
            }

            // Screensaver
            if (saver_on) {
                saver_timer += frame_time;
                if (saver_timer >= 80) {
                    saver_step();
                    saver_timer = 0;
                }
            }

            // L3/R3 square remap
            if (remap_square_active == 0) {
                if (get_val(PS4_L3)) { set_val(PS4_SQUARE, 100); }
            } else {
                if (get_val(PS4_R3)) { set_val(PS4_SQUARE, 100); }
            }

            // Tempo AI (flick-up) — skipped when dunking
            if (flick_up_shooting_active && !dunk_active) {
                if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE)) {
                    set_val(PS4_SQUARE, 0);
                    square_shooting_in_progress = 1;
                    if (reverse_flick_mode && get_val(PS4_R2)) {
                        set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                    } else {
                        set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                    }
                    set_val(PS4_RX, random(random_variation_min, random_variation_max));
                }
                if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE)) {
                    if (reverse_flick_mode && get_val(PS4_R2)) { combo_run(flick_up_rs_reversed); }
                    else                                        { combo_run(flick_up_rs_smooth);   }
                    square_shooting_in_progress = 0;
                }
            }

            // Insta shot
            if (Insta_shot_active) {
                if ((remap_square_active == 0 && event_press(PS4_R3)) || (remap_square_active == 1 && event_press(PS4_L3))) {
                    if (reverse_flick_mode && get_val(PS4_R2)) { combo_run(Insta_shot_reversed); }
                    else                                        { combo_run(Insta_shot_smooth);   }
                }
            }

            // RS Shooting
            if (rs_shooting_active) {
                if (!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
                    if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
                        if (!isHolding) {
                            isHolding = 1;
                            rs_shooting_in_progress = 1;
                            holdTimer = 0;
                            if (get_val(PS4_RY) < 0) { rs_is_up = 1; } else { rs_is_up = 0; }
                        }
                        holdTimer += frame_time;
                    } else {
                        if (isHolding) {
                            if (holdTimer > rs_hold_duration) {
                                if (!rs_is_up) { combo_run(flick_up_rs_smooth);   }
                                else           { combo_run(flick_up_rs_reversed); }
                            }
                            isHolding = 0;
                            rs_shooting_in_progress = 0;
                            holdTimer = 0;
                        }
                    }
                }
            }

            // Spot Take — hold X to rapid-fire X
            if (spot_take_active) {
                if (get_val(PS4_CROSS)) {
                    combo_run(spot_take_combo);
                } else {
                    combo_stop(spot_take_combo);
                }
            }

        }
    }
}

// ===== Infinite Stamina =====
combo Movement_Control {
    if (infinite_stamina && ground_stick_active && !dunk_active &&
        !square_shooting_in_progress && !rs_shooting_in_progress && !get_val(PS4_SQUARE) &&
        !combo_running(flick_up_rs_smooth) && !combo_running(flick_up_rs_reversed) &&
        !combo_running(Insta_shot_smooth)  && !combo_running(Insta_shot_reversed)) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        }
        if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

// ===== Zen Light =====
function apply_zen_light() {
    if      (zen_light_color == 0) { set_rgb(0,   0,   255); }
    else if (zen_light_color == 1) { set_rgb(128, 0,   128); }
    else if (zen_light_color == 2) { set_rgb(255, 255, 255); }
    else if (zen_light_color == 3) { set_rgb(255, 0,   0);   }
    else if (zen_light_color == 4) { set_rgb(0,   255, 0);   }
    else if (zen_light_color == 5) { set_rgb(255, 255, 0);   }
    else if (zen_light_color == 6) {
        if      (rainbow_phase == 0)  { set_rgb(255, 0,   0);   }
        else if (rainbow_phase == 1)  { set_rgb(255, 64,  0);   }
        else if (rainbow_phase == 2)  { set_rgb(255, 128, 0);   }
        else if (rainbow_phase == 3)  { set_rgb(255, 192, 0);   }
        else if (rainbow_phase == 4)  { set_rgb(255, 255, 0);   }
        else if (rainbow_phase == 5)  { set_rgb(128, 255, 0);   }
        else if (rainbow_phase == 6)  { set_rgb(0,   255, 0);   }
        else if (rainbow_phase == 7)  { set_rgb(0,   255, 128); }
        else if (rainbow_phase == 8)  { set_rgb(0,   255, 255); }
        else if (rainbow_phase == 9)  { set_rgb(0,   128, 255); }
        else if (rainbow_phase == 10) { set_rgb(0,   0,   255); }
        else if (rainbow_phase == 11) { set_rgb(128, 0,   255); }
    }
}

// ===== Loading Screen =====
function draw_picture(x, y) {
    cls_oled(OLED_WHITE);
    rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_WHITE, OLED_BLACK);
    rect_oled(3, 3, 122, 58, OLED_WHITE, OLED_BLACK);

    // Corner stars (5-point cross)
    draw_star(7,   7);
    draw_star(120, 7);
    draw_star(7,   57);
    draw_star(120, 57);

    // Scattered small stars along borders
    pixel_oled(30,  5,  OLED_BLACK);
    pixel_oled(50,  4,  OLED_BLACK);
    pixel_oled(78,  4,  OLED_BLACK);
    pixel_oled(98,  5,  OLED_BLACK);
    pixel_oled(30,  59, OLED_BLACK);
    pixel_oled(50,  60, OLED_BLACK);
    pixel_oled(78,  60, OLED_BLACK);
    pixel_oled(98,  59, OLED_BLACK);
    pixel_oled(5,   20, OLED_BLACK);
    pixel_oled(4,   32, OLED_BLACK);
    pixel_oled(5,   44, OLED_BLACK);
    pixel_oled(123, 20, OLED_BLACK);
    pixel_oled(124, 32, OLED_BLACK);
    pixel_oled(123, 44, OLED_BLACK);

    // Basketball — center right (cx=110, cy=32, r=9)
    pixel_oled(119, 32, OLED_BLACK);
    pixel_oled(101, 32, OLED_BLACK);
    pixel_oled(110, 23, OLED_BLACK);
    pixel_oled(110, 41, OLED_BLACK);
    pixel_oled(118, 36, OLED_BLACK);
    pixel_oled(118, 28, OLED_BLACK);
    pixel_oled(102, 36, OLED_BLACK);
    pixel_oled(102, 28, OLED_BLACK);
    pixel_oled(116, 39, OLED_BLACK);
    pixel_oled(116, 25, OLED_BLACK);
    pixel_oled(104, 39, OLED_BLACK);
    pixel_oled(104, 25, OLED_BLACK);
    pixel_oled(113, 41, OLED_BLACK);
    pixel_oled(107, 41, OLED_BLACK);
    pixel_oled(113, 23, OLED_BLACK);
    pixel_oled(107, 23, OLED_BLACK);
    // Basketball seam lines
    line_oled(101, 32, 119, 32, 1, OLED_BLACK);
    line_oled(110, 23, 110, 41, 1, OLED_BLACK);
    line_oled(110, 23, 106, 32, 1, OLED_BLACK);
    line_oled(106, 32, 110, 41, 1, OLED_BLACK);
    line_oled(110, 23, 114, 32, 1, OLED_BLACK);
    line_oled(114, 32, 110, 41, 1, OLED_BLACK);

    // Small devil face left of center (x=18, y=14)
    // Horns
    pixel_oled(16, 14, OLED_BLACK);
    pixel_oled(16, 13, OLED_BLACK);
    pixel_oled(20, 14, OLED_BLACK);
    pixel_oled(20, 13, OLED_BLACK);
    pixel_oled(17, 15, OLED_BLACK);
    pixel_oled(19, 15, OLED_BLACK);
    // Head outline
    pixel_oled(15, 16, OLED_BLACK);
    pixel_oled(21, 16, OLED_BLACK);
    pixel_oled(14, 17, OLED_BLACK);
    pixel_oled(22, 17, OLED_BLACK);
    pixel_oled(14, 18, OLED_BLACK);
    pixel_oled(22, 18, OLED_BLACK);
    pixel_oled(14, 19, OLED_BLACK);
    pixel_oled(22, 19, OLED_BLACK);
    pixel_oled(15, 20, OLED_BLACK);
    pixel_oled(21, 20, OLED_BLACK);
    pixel_oled(16, 21, OLED_BLACK);
    pixel_oled(20, 21, OLED_BLACK);
    pixel_oled(17, 22, OLED_BLACK);
    pixel_oled(18, 22, OLED_BLACK);
    pixel_oled(19, 22, OLED_BLACK);
    // Eyes (angry)
    pixel_oled(16, 17, OLED_BLACK);
    pixel_oled(17, 18, OLED_BLACK);
    pixel_oled(20, 17, OLED_BLACK);
    pixel_oled(19, 18, OLED_BLACK);
    // Evil grin
    pixel_oled(16, 20, OLED_BLACK);
    pixel_oled(17, 21, OLED_BLACK);
    pixel_oled(18, 20, OLED_BLACK);
    pixel_oled(19, 21, OLED_BLACK);
    pixel_oled(20, 20, OLED_BLACK);

    // Horizontal divider line
    line_oled(10, 50, 118, 50, 1, OLED_BLACK);

    // Text
    print(center_x(get_string_length(load_l1[0]), OLED_FONT_MEDIUM_WIDTH), 16, OLED_FONT_MEDIUM, OLED_BLACK, load_l1[0]);
    print(center_x(get_string_length(load_l2[0]), OLED_FONT_MEDIUM_WIDTH), 33, OLED_FONT_MEDIUM, OLED_BLACK, load_l2[0]);

    // Credit
    print(center_x(get_string_length(load_l3[0]), OLED_FONT_SMALL_WIDTH), 54, OLED_FONT_SMALL, OLED_BLACK, load_l3[0]);
}

// 9-pixel cross star
function draw_star(ds_x, ds_y) {
    pixel_oled(ds_x,     ds_y,     OLED_BLACK);
    pixel_oled(ds_x - 2, ds_y,     OLED_BLACK);
    pixel_oled(ds_x + 2, ds_y,     OLED_BLACK);
    pixel_oled(ds_x,     ds_y - 2, OLED_BLACK);
    pixel_oled(ds_x,     ds_y + 2, OLED_BLACK);
    pixel_oled(ds_x - 1, ds_y - 1, OLED_BLACK);
    pixel_oled(ds_x + 1, ds_y - 1, OLED_BLACK);
    pixel_oled(ds_x - 1, ds_y + 1, OLED_BLACK);
    pixel_oled(ds_x + 1, ds_y + 1, OLED_BLACK);
}

// ===== Screensaver =====
function saver_step() {
    cls_oled(OLED_WHITE);

    line1_w = (get_string_length(saver_line1[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    line2_w = (get_string_length(saver_line2[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    if (line1_w > line2_w) { msg_w = line1_w; } else { msg_w = line2_w; }

    rect_oled(sx - 4, sy - 4, msg_w + 8, 26, OLED_WHITE, OLED_BLACK);
    pixel_oled(sx - 4,         sy - 4,  OLED_WHITE);
    pixel_oled(sx + msg_w + 3, sy - 4,  OLED_WHITE);
    pixel_oled(sx - 4,         sy + 21, OLED_WHITE);
    pixel_oled(sx + msg_w + 3, sy + 21, OLED_WHITE);

    print(sx, sy,      OLED_FONT_SMALL, OLED_BLACK, saver_line1[0]);
    print(sx, sy + 11, OLED_FONT_SMALL, OLED_BLACK, saver_line2[0]);

    sx += svx;
    sy += svy;

    if (sx <= 5 || sx >= (OLED_WIDTH - msg_w - 5))  { svx = -svx; }
    if (sy <= 5 || sy >= (OLED_HEIGHT - 32 - 5))     { svy = -svy; }
}

function map(val, in_min, in_max, out_min, out_max) {
    return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

function draw_x_graph(value, min_val, max_val, y_pos) {
    graph_width = 100;
    x_start     = (OLED_WIDTH - graph_width) / 2;
    mid_x       = x_start + graph_width / 2;
    bar_pos     = map(value, min_val, max_val, 0, graph_width);
    line_oled(x_start, y_pos, x_start + graph_width, y_pos, 1, OLED_BLACK);
    line_oled(mid_x, y_pos - 3, mid_x, y_pos + 3, 1, OLED_BLACK);
    line_oled(x_start, y_pos - 2, x_start, y_pos + 2, 1, OLED_BLACK);
    line_oled(x_start + graph_width, y_pos - 2, x_start + graph_width, y_pos + 2, 1, OLED_BLACK);
    rect_oled(x_start, y_pos - 2, bar_pos, 4, 1, OLED_BLACK);
}

// ===== Combos =====
combo flick_up_rs_smooth {
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20  + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX,  25  + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo flick_up_rs_reversed {
    set_val(PS4_RY, 50  + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Insta_shot_smooth {
    set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(Insta_shot_duration);
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX,  20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(Delay_duration_Insta);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX,   25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Insta_shot_reversed {
    set_val(PS4_RY, STICK_UP_VALUE + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(Insta_shot_duration);
    set_val(PS4_RY,  50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(Delay_duration_Insta);
    set_val(PS4_RY,  100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX,  -25 + random(random_variation_min, random_variation_max));
    wait(30);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo spot_take_combo {
    set_val(PS4_CROSS, 100);
    wait(20);
    set_val(PS4_CROSS, 0);
    wait(20);
}

combo flashtog         { if (!flashtoggle) { set_rgb(255, 0, 0); } else { set_rgb(0, 255, 0); } wait(1000); set_rgb(0, 0, 255); }
combo flashedit        { set_rgb(0, 0, 0); wait(150); set_rgb(0, 0, 255); }
combo vibration_on     { set_rumble(RUMBLE_A, 100); wait(200); set_rumble(RUMBLE_A, 0); }
combo vibration_off    { set_rumble(RUMBLE_A, 50);  wait(200); set_rumble(RUMBLE_A, 0); }
combo vibration_valchg { set_rumble(RUMBLE_A, 50);  wait(50);  set_rumble(RUMBLE_A, 0); }

function center_x(f_chars, f_font) { return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2); }

int bufferIndex, digitIndex, charIndex;
function NumberToString(f_val, f_digits) {
    bufferIndex = 1;
    digitIndex  = 10000;
    if (f_val < 0) { putc_oled(bufferIndex, 45); bufferIndex += 1; f_val = abs(f_val); }
    for (charIndex = 5; charIndex >= 1; charIndex--) {
        if (f_digits >= charIndex) {
            putc_oled(bufferIndex, (f_val / digitIndex) + 48);
            f_val %= digitIndex;
            bufferIndex++;
            if (charIndex == 4) { putc_oled(bufferIndex, 44); bufferIndex++; }
        }
        digitIndex /= 10;
    }
    puts_oled(center_x(bufferIndex + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_BLACK);
}

int logVal;
function FindDigits(num) { logVal = 0; do { num /= 10; logVal++; } while (num); return logVal; }

int stringLength;
function get_string_length(offset) { stringLength = 0; while (duint8(offset++)) { stringLength++; } return stringLength + 1; }
