                if (get_val(PS4_L2) && event_press(MOD_DECREASE)) { turboTimingMs -= 10; } else if (event_press(MOD_DECREASE)) { turboTimingMs--; }
                if (event_press(MOD_INCREASE) || event_press(MOD_DECREASE)) { combo_run(vibration_valchg); combo_run(flashedit); SAVE_SETTINGS(); UPDATE_LED_FOR_MOD_STATE(TRUE); }
