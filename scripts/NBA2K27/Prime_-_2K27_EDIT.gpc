const string MENU_TITLES[] = {"", "", "", "", "", "", "", "", "", "", "", "", ""};
const string MOD_HEADERS[] = {"Select Build", "AI Tempo", "Tempo MS", "AI Auto Green", "Auto Green MS", "Turbo Shots", "RS Auto Tempo", "SQ/X Remap", "AI Defense", "Auto Quick-Stop", "Auto Dribbles", "Meter Dunk", "LED Color"};
const string METER_DUNK_OPTIONS[] = {"OFF", "L1 / LB", "Circle / B"};
const string LED_COLOR_OPTIONS[] = {"Prime", "Blue", "Orange", "Rainbow"};
const string TOGGLE_TEXT[] = {"UP/DOWN", "to change"};
const string ON_OFF_TEXT[] = {"OFF", "ON", "", "Left Stick", "Right Stick"};
const string MS_TEXT[] = {"MS"};
const string TURBO_MODES[] = {"Hop Jumper", "Turbo Fade", "OFF"};
const string NOTIFICATION_TEXT[] = {"", ""};

int GRAPH_WIDTH, X_START, MID_X, BAR_POS;

init {
    CURRENT_BUILD = get_pvar(SPVAR_1, 1, 3, 1);
    LOAD_BUILD_SETTINGS();
    CONVERT_TEMPO_DISPLAY_TO_MS(); // Initialize actual MS value
    CONVERT_AUTO_GREEN_DISPLAY_TO_MS(); // Initialize actual MS value
    RS_HOLD_TIME = 300;
    cls_oled(OLED_BLACK); DRAW_LOGO();
    SET_LED_COLOR();
}

main {
    if(get_console() == PIO_XB1) { IS_XBOX = 1; } else { IS_XBOX = 0; }
    
    // LED Color (when not in menu)
    if(!MENU_OPEN) {
        SET_LED_COLOR();
    }
    
    if(event_release(PS4_SQUARE)) {
        if(AUTO_QUICKSTOP_TRIGGERED) {
            combo_stop(initial_rx_flick); combo_run(complete_flick_up_rs_smooth); AUTO_QUICKSTOP_TRIGGERED = 0;
        }
    }
    
    if(event_press(PS4_CIRCLE) && MENU_OPEN) {
        SAVE_BUILD_SETTINGS();
        set_pvar(SPVAR_1, CURRENT_BUILD); // Save current build when closing menu
        MENU_OPEN = 0; 
        combo_run(VIBRATION_OFF); 
        SET_LED_COLOR(); 
        cls_oled(OLED_BLACK); 
        DRAW_LOGO();
    } else if(!MENU_OPEN && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
        MENU_OPEN = 1; CURRENT_PAGE = 1; combo_run(VIBRATION_ON);
    }
    
    if(MENU_OPEN) {
        cls_oled(OLED_BLACK);
        line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);
        print(CENTER_X(GET_STRING_LENGTH(MOD_HEADERS[CURRENT_PAGE - 1]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, MOD_HEADERS[CURRENT_PAGE - 1]);
        print(CENTER_X(GET_STRING_LENGTH(MENU_TITLES[CURRENT_PAGE - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, MENU_TITLES[CURRENT_PAGE - 1]);
        
        set_val(PS4_SQUARE, 0);
        set_val(PS4_CROSS, 0);
        set_val(PS4_CIRCLE, 0);
        set_val(PS4_TRIANGLE, 0);
        set_val(PS4_L1, 0);
        set_val(PS4_R1, 0);
        set_val(PS4_L3, 0);
        set_val(PS4_R3, 0);
        set_val(PS4_SHARE, 0);
        set_val(PS4_PS, 0);
        set_val(PS4_TOUCH, 0);
        set_val(PS4_LX, 0);
        set_val(PS4_LY, 0);
        set_val(PS4_RX, 0);
        set_val(PS4_RY, 0);
        
        if(event_press(PS4_LEFT)) {
            if(CURRENT_PAGE > 1) {
                CURRENT_PAGE--;
                combo_run(VIBRATION_CHANGE);
            } else {
                combo_run(VIBRATION_EDGE);
                print(CENTER_X(GET_STRING_LENGTH(NOTIFICATION_TEXT[0]), OLED_FONT_SMALL_WIDTH), 40, OLED_FONT_SMALL, OLED_WHITE, NOTIFICATION_TEXT[0]);
            }
        }
        if(event_press(PS4_RIGHT)) {
            if(CURRENT_PAGE < TOTAL_PAGES) {
                CURRENT_PAGE++;
                combo_run(VIBRATION_CHANGE);
            } else {
                combo_run(VIBRATION_EDGE);
                print(CENTER_X(GET_STRING_LENGTH(NOTIFICATION_TEXT[1]), OLED_FONT_SMALL_WIDTH), 40, OLED_FONT_SMALL, OLED_WHITE, NOTIFICATION_TEXT[1]);
            }
        }
        
        if(CURRENT_PAGE == 1) {
            SELECTION = 1; TOGGLE_TYPE = 0; SET_LED_COLOR();
            NUMBER_TO_STRING(CURRENT_BUILD, FIND_DIGITS(CURRENT_BUILD));
            if(event_press(PS4_UP)) {
                SAVE_BUILD_SETTINGS();
                CURRENT_BUILD++; 
                if(CURRENT_BUILD > 3) CURRENT_BUILD = 1;
                set_pvar(SPVAR_1, CURRENT_BUILD);
                LOAD_BUILD_SETTINGS();
                combo_run(VIBRATION_CHANGE);
            }
            if(event_press(PS4_DOWN)) {
                SAVE_BUILD_SETTINGS();
                CURRENT_BUILD--; 
                if(CURRENT_BUILD < 1) CURRENT_BUILD = 3;
                set_pvar(SPVAR_1, CURRENT_BUILD);
                LOAD_BUILD_SETTINGS();
                combo_run(VIBRATION_CHANGE);
            }
        }
        
        if(CURRENT_PAGE == 2) {
            SELECTION = FLICK_UP_SHOOTING_ACTIVE; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(FLICK_UP_SHOOTING_ACTIVE);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS4_UP)) { FLICK_UP_SHOOTING_ACTIVE = 1; FLASH_TOGGLE = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
            if(event_press(PS4_DOWN)) { FLICK_UP_SHOOTING_ACTIVE = 0; FLASH_TOGGLE = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
        }
        
        if(CURRENT_PAGE == 3) {
            SELECTION = 2; TOGGLE_TYPE = 0; SET_LED_COLOR();
            // Display value 1-25 (maps to 25-49ms)
            NUMBER_TO_STRING(TEMPO_DISPLAY_VALUE, FIND_DIGITS(TEMPO_DISPLAY_VALUE));
            CONVERT_TEMPO_DISPLAY_TO_MS();
            DRAW_X_GRAPH(TEMPO_MS_ACTUAL, 25, 75, 52);
            if(get_val(PS4_UP)) {
                VALUE_HOLD_TIMER += get_rtime();
                if(event_press(PS4_UP) || (VALUE_HOLD_TIMER > 300 && RAPID_CHANGE_TIMER > 25)) { 
                    TEMPO_DISPLAY_VALUE++;
                    if(TEMPO_DISPLAY_VALUE > 25) TEMPO_DISPLAY_VALUE = 25;
                    CONVERT_TEMPO_DISPLAY_TO_MS();
                    SAVE_SETTINGS(); 
                    RAPID_CHANGE_TIMER = 0; 
                }
                RAPID_CHANGE_TIMER += get_rtime();
            } else if(get_val(PS4_DOWN)) {
                VALUE_HOLD_TIMER += get_rtime();
                if(event_press(PS4_DOWN) || (VALUE_HOLD_TIMER > 300 && RAPID_CHANGE_TIMER > 25)) { 
                    TEMPO_DISPLAY_VALUE--;
                    if(TEMPO_DISPLAY_VALUE < 1) TEMPO_DISPLAY_VALUE = 1;
                    CONVERT_TEMPO_DISPLAY_TO_MS();
                    SAVE_SETTINGS(); 
                    RAPID_CHANGE_TIMER = 0; 
                }
                RAPID_CHANGE_TIMER += get_rtime();
            } else { VALUE_HOLD_TIMER = 0; RAPID_CHANGE_TIMER = 0; }
        }
        
        if(CURRENT_PAGE == 4) {
            SELECTION = TAP_SHOT_ACTIVE; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(TAP_SHOT_ACTIVE);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS4_UP)) { TAP_SHOT_ACTIVE = 1; FLASH_TOGGLE = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
            if(event_press(PS4_DOWN)) { TAP_SHOT_ACTIVE = 0; FLASH_TOGGLE = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
        }
        
        if(CURRENT_PAGE == 5) {
            SELECTION = 2; TOGGLE_TYPE = 0; SET_LED_COLOR();
            CONVERT_AUTO_GREEN_DISPLAY_TO_MS();
            NUMBER_TO_STRING(AUTO_GREEN_DISPLAY_VALUE, FIND_DIGITS(AUTO_GREEN_DISPLAY_VALUE));
            DRAW_X_GRAPH(AUTO_GREEN_MS_ACTUAL, 550, 750, 52);
            if(get_val(PS4_UP)) {
                VALUE_HOLD_TIMER += get_rtime();
                if(event_press(PS4_UP) || (VALUE_HOLD_TIMER > 300 && RAPID_CHANGE_TIMER > 25)) { 
                    AUTO_GREEN_DISPLAY_VALUE++;
                    if(AUTO_GREEN_DISPLAY_VALUE > 50) AUTO_GREEN_DISPLAY_VALUE = 50;
                    CONVERT_AUTO_GREEN_DISPLAY_TO_MS();
                    SAVE_SETTINGS(); 
                    RAPID_CHANGE_TIMER = 0; 
                }
                RAPID_CHANGE_TIMER += get_rtime();
            } else if(get_val(PS4_DOWN)) {
                VALUE_HOLD_TIMER += get_rtime();
                if(event_press(PS4_DOWN) || (VALUE_HOLD_TIMER > 300 && RAPID_CHANGE_TIMER > 25)) { 
                    AUTO_GREEN_DISPLAY_VALUE--;
                    if(AUTO_GREEN_DISPLAY_VALUE < 1) AUTO_GREEN_DISPLAY_VALUE = 1;
                    CONVERT_AUTO_GREEN_DISPLAY_TO_MS();
                    SAVE_SETTINGS(); 
                    RAPID_CHANGE_TIMER = 0; 
                }
                RAPID_CHANGE_TIMER += get_rtime();
            } else { VALUE_HOLD_TIMER = 0; RAPID_CHANGE_TIMER = 0; }
        }
        
        if(CURRENT_PAGE == 6) {
            SELECTION = TURBO_MODE; TOGGLE_TYPE = 0;
            if(TURBO_MODE == 2) {
                set_rgb(0, 0, 0); // LED off when Turbo is OFF
            } else {
                SET_LED_COLOR(); // LED on for Hop Jumper or Turbo Fade
            }
            print(CENTER_X(GET_STRING_LENGTH(TURBO_MODES[TURBO_MODE]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, TURBO_MODES[TURBO_MODE]);
            if(event_press(PS4_UP)) {
                TURBO_MODE++;
                if(TURBO_MODE > 2) TURBO_MODE = 0;
                combo_run(VIBRATION_CHANGE); SAVE_SETTINGS();
            }
            if(event_press(PS4_DOWN)) {
                TURBO_MODE--;
                if(TURBO_MODE < 0) TURBO_MODE = 2;
                combo_run(VIBRATION_CHANGE); SAVE_SETTINGS();
            }
        }
        
        if(CURRENT_PAGE == 7) {
            SELECTION = RS_SHOOT_ENABLED; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(RS_SHOOT_ENABLED);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS4_UP)) { RS_SHOOT_ENABLED = 1; FLASH_TOGGLE = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
            if(event_press(PS4_DOWN)) { RS_SHOOT_ENABLED = 0; FLASH_TOGGLE = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
        }
        
        if(CURRENT_PAGE == 8) {
            SELECTION = SQUARE_REMAP; TOGGLE_TYPE = 0; SET_LED_COLOR();
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SQUARE_REMAP + 3]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SQUARE_REMAP + 3]);
            if(event_press(PS4_UP)) { SQUARE_REMAP = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); }
            if(event_press(PS4_DOWN)) { SQUARE_REMAP = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); }
        }
        
        if(CURRENT_PAGE == 9) {
            SELECTION = DEFENSE_ASSIST; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(DEFENSE_ASSIST);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS4_UP)) { DEFENSE_ASSIST = 1; FLASH_TOGGLE = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
            if(event_press(PS4_DOWN)) { DEFENSE_ASSIST = 0; FLASH_TOGGLE = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
        }
        
        if(CURRENT_PAGE == 10) {
            SELECTION = AUTO_QUICKSTOP_ACTIVE; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(AUTO_QUICKSTOP_ACTIVE);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS4_UP)) { AUTO_QUICKSTOP_ACTIVE = 1; FLASH_TOGGLE = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
            if(event_press(PS4_DOWN)) { AUTO_QUICKSTOP_ACTIVE = 0; FLASH_TOGGLE = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
        }
        
        if(CURRENT_PAGE == 11) {
            SELECTION = DRIBBLE_ENABLED; TOGGLE_TYPE = 0;
            UPDATE_LED_FOR_MOD_STATE(DRIBBLE_ENABLED);
            print(CENTER_X(GET_STRING_LENGTH(ON_OFF_TEXT[SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ON_OFF_TEXT[SELECTION]);
            if(event_press(PS4_UP)) { DRIBBLE_ENABLED = 1; FLASH_TOGGLE = 1; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
            if(event_press(PS4_DOWN)) { DRIBBLE_ENABLED = 0; FLASH_TOGGLE = 0; combo_run(VIBRATION_CHANGE); SAVE_SETTINGS(); combo_run(FLASH_TOGGLE_ONOFF); }
        }
        
        if(CURRENT_PAGE == 12) {
            // Meter Dunk trigger selection (0-2: OFF, L1, Circle/B)
            SELECTION = METER_DUNK_TRIGGER; TOGGLE_TYPE = 1; SET_LED_COLOR();
            if(METER_DUNK_TRIGGER >= 0 && METER_DUNK_TRIGGER < 3) {
                print(CENTER_X(GET_STRING_LENGTH(METER_DUNK_OPTIONS[METER_DUNK_TRIGGER]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, METER_DUNK_OPTIONS[METER_DUNK_TRIGGER]);
            }
            if(event_press(PS4_UP)) { 
                METER_DUNK_TRIGGER = (METER_DUNK_TRIGGER + 2) % 3; 
                combo_run(VIBRATION_CHANGE); 
                SAVE_SETTINGS(); 
            }
            if(event_press(PS4_DOWN)) { 
                METER_DUNK_TRIGGER = (METER_DUNK_TRIGGER + 1) % 3; 
                combo_run(VIBRATION_CHANGE); 
                SAVE_SETTINGS(); 
            }
        }
        
        if(CURRENT_PAGE == 13) {
            // LED Color selection (0-3: Yellow/Green, Blue, Orange, Rainbow)
            SELECTION = LED_COLOR_SELECTION; TOGGLE_TYPE = 1; SET_LED_COLOR();
            if(LED_COLOR_SELECTION >= 0 && LED_COLOR_SELECTION < 4) {
                print(CENTER_X(GET_STRING_LENGTH(LED_COLOR_OPTIONS[LED_COLOR_SELECTION]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, LED_COLOR_OPTIONS[LED_COLOR_SELECTION]);
            }
            if(event_press(PS4_UP)) { 
                LED_COLOR_SELECTION = (LED_COLOR_SELECTION + 3) % 4; 
                SET_LED_COLOR(); // Update LED immediately
                combo_run(VIBRATION_CHANGE); 
                SAVE_SETTINGS(); 
            }
            if(event_press(PS4_DOWN)) { 
                LED_COLOR_SELECTION = (LED_COLOR_SELECTION + 1) % 4; 
                SET_LED_COLOR(); // Update LED immediately
                combo_run(VIBRATION_CHANGE); 
                SAVE_SETTINGS(); 
            }
        }
        
        set_val(PS4_RIGHT, 0);
        set_val(PS4_UP, 0);
        set_val(PS4_DOWN, 0);
        set_val(PS4_L2, 0);
        set_val(PS4_R2, 0);
    } else {
        if(get_val(PS4_R2) > 80) { IS_CONTESTED = 1; } else { IS_CONTESTED = 0; }
        
        if(DRIBBLE_ENABLED) {
            if(get_val(PS4_UP)) {
                set_val(PS4_UP, 0);
                if(DRIBBLE_UP_FIRST_RUN) {
                    combo_run(DRIBBLE_UP_INITIAL);
                    DRIBBLE_UP_FIRST_RUN = 0;
                } else {
                    combo_run(DRIBBLE_UP_LOOP);
                }
            } else {
                combo_stop(DRIBBLE_UP_INITIAL);
                combo_stop(DRIBBLE_UP_LOOP);
                DRIBBLE_UP_FIRST_RUN = 1;
            }
            if(get_val(PS4_RIGHT)) { set_val(PS4_RIGHT, 0); combo_run(DRIBBLE_RIGHT); } else combo_stop(DRIBBLE_RIGHT);
            if(get_val(PS4_DOWN)) { set_val(PS4_DOWN, 0); combo_run(DRIBBLE_DOWN); } else combo_stop(DRIBBLE_DOWN);
            if(get_val(PS4_LEFT)) { set_val(PS4_LEFT, 0); combo_run(DRIBBLE_LEFT); } else combo_stop(DRIBBLE_LEFT);
        }
        
        if(SQUARE_REMAP == 0) { if(get_val(PS4_L3)) set_val(PS4_SQUARE, 100); }
        else { if(get_val(PS4_R3)) set_val(PS4_SQUARE, 100); }
        
        if(AUTO_QUICKSTOP_ACTIVE && !AUTO_QUICKSTOP_TRIGGERED && get_val(PS4_R2) > 30 && (get_val(PS4_LX) < -20 || get_val(PS4_LY) < -20 || abs(get_val(PS4_LX)) >= 20 || abs(get_val(PS4_LY)) >= 20)) {
            if(event_press(PS4_SQUARE)) { AUTO_QUICKSTOP_TRIGGERED = 1; combo_run(initial_rx_flick); }
        }

        if(AUTO_QUICKSTOP_TRIGGERED && get_val(PS4_SQUARE)) {
            set_val(PS4_SQUARE, 0); set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0);
            if(!combo_running(initial_rx_flick)) {
                set_val(PS4_RY, STICK_DOWN_VALUE + random(RANDOM_MIN, RANDOM_MAX));
                set_val(PS4_RX, random(RANDOM_MIN, RANDOM_MAX));
            }
        }
        
        if(FLICK_UP_SHOOTING_ACTIVE && !AUTO_QUICKSTOP_TRIGGERED) {
            if(!(SQUARE_REMAP == 0 && get_val(PS4_L3)) && !(SQUARE_REMAP == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE)) {
                set_val(PS4_SQUARE, 0);
                if(TURBO_MODE != 2 && get_val(PS4_R2)) {
                    if(TURBO_MODE == 0) {
                        set_val(PS4_RY, STICK_DOWN_VALUE + random(RANDOM_MIN, RANDOM_MAX));  // Fixed: Hop Jumper holds DOWN (matches SMOOTH combo)
                    } else {
                        set_val(PS4_RY, STICK_UP_VALUE + random(RANDOM_MIN, RANDOM_MAX));  // Fixed: Turbo Fade holds UP (matches REVERSED combo)
                    }
                } else {
                    set_val(PS4_RY, STICK_DOWN_VALUE + random(RANDOM_MIN, RANDOM_MAX));
                }
                set_val(PS4_RX, random(RANDOM_MIN, RANDOM_MAX));
            }
            if(!(SQUARE_REMAP == 0 && get_val(PS4_L3)) && !(SQUARE_REMAP == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE)) {
                if(TURBO_MODE != 2 && get_val(PS4_R2)) {
                    if(TURBO_MODE == 0) {
                        combo_run(FLICK_UP_RS_SMOOTH);  // Fixed: Hop Jumper uses SMOOTH
                    } else {
                        combo_run(FLICK_UP_RS_REVERSED);  // Fixed: Turbo Fade uses REVERSED
                    }
                } else {
                    combo_run(FLICK_UP_RS_SMOOTH);
                }
            }
        }
        
        if(TURBO_MODE != 2 && !AUTO_QUICKSTOP_TRIGGERED) {
            if(!(SQUARE_REMAP == 0 && get_val(PS4_L3)) && !(SQUARE_REMAP == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE) && get_val(PS4_R2)) {
                set_val(PS4_SQUARE, 0);
                if(TURBO_MODE == 0) {
                    set_val(PS4_RY, STICK_DOWN_VALUE + random(RANDOM_MIN, RANDOM_MAX));  // Fixed: Hop Jumper holds DOWN (matches SMOOTH combo)
                } else {
                    set_val(PS4_RY, STICK_UP_VALUE + random(RANDOM_MIN, RANDOM_MAX));  // Fixed: Turbo Fade holds UP (matches REVERSED combo)
                }
                set_val(PS4_RX, random(RANDOM_MIN, RANDOM_MAX));
            }
            if(!(SQUARE_REMAP == 0 && get_val(PS4_L3)) && !(SQUARE_REMAP == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE) && get_val(PS4_R2)) {
                if(TURBO_MODE == 0) {
                    combo_run(FLICK_UP_RS_SMOOTH);  // Fixed: Hop Jumper uses SMOOTH
                } else {
                    combo_run(FLICK_UP_RS_REVERSED);  // Fixed: Turbo Fade uses REVERSED
                }
            }
        }
        
        if(TAP_SHOT_ACTIVE) {
            if((SQUARE_REMAP == 0 && event_press(PS4_R3)) || (SQUARE_REMAP == 1 && event_press(PS4_L3))) {
                if(TURBO_MODE != 2 && get_val(PS4_R2)) {
                    if(TURBO_MODE == 0) {
                        combo_run(TAP_SHOT_SMOOTH);  // Fixed: Hop Jumper uses SMOOTH
                    } else {
                        combo_run(TAP_SHOT_REVERSED);  // Fixed: Turbo Fade uses REVERSED
                    }
                } else {
                    combo_run(TAP_SHOT_SMOOTH);
                }
            }
        }
        
        if(RS_SHOOT_ENABLED) {
            if(!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
                if(abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
                    if(!IS_HOLDING) {
                        IS_HOLDING = 1; HOLD_TIMER = 0;
                        if(get_val(PS4_RY) < 0) RS_IS_UP = 1; else RS_IS_UP = 0;
                    }
                    HOLD_TIMER += get_rtime();
                } else {
                    if(IS_HOLDING) {
                        if(HOLD_TIMER > RS_HOLD_TIME) {
                            if(!RS_IS_UP) { combo_run(FLICK_UP_RS_SMOOTH); }
                            else { combo_run(FLICK_UP_RS_REVERSED); }
                        }
                        IS_HOLDING = 0; HOLD_TIMER = 0;
                    }
                }
            }
        }
        
        if(METER_DUNK_TRIGGER > 0) {
            // Meter dunk with L1 (option 1)
            if(METER_DUNK_TRIGGER == 1) {
                if(get_val(PS4_L1)) {
                    set_val(PS4_RY, 100);
                    set_val(PS4_R2, 100);
                } else if(event_release(PS4_L1)) {
                    set_val(PS4_RY, 0);
                    set_val(PS4_R2, 0);
                }
            }
            // Meter dunk with Circle/B (option 2)
            else if(METER_DUNK_TRIGGER == 2) {
                if(get_val(PS4_CIRCLE)) {
                    set_val(PS4_RY, 100);
                    set_val(PS4_R2, 100);
                } else if(event_release(PS4_CIRCLE)) {
                    set_val(PS4_RY, 0);
                    set_val(PS4_R2, 0);
                }
            }
        }
        
        
        if(DEFENSE_ASSIST) {
            if(get_val(PS4_L2) > 50) { set_val(PS4_RY, (get_val(PS4_RY) * 13) / 10); }
        }
    }
}

function SAVE_SETTINGS() {
    SAVE_BUILD_SETTINGS();
}

int BUILD_BASE_SPVAR;
function GET_BUILD_SPVAR_BASE() {
    BUILD_BASE_SPVAR = ((CURRENT_BUILD - 1) * 12) + 2;  // 12 variables per build (0-11), includes LED_COLOR_SELECTION
    return BUILD_BASE_SPVAR;
}

function SAVE_BUILD_SETTINGS() {
    GET_BUILD_SPVAR_BASE();
    set_pvar(BUILD_BASE_SPVAR + 0, FLICK_UP_SHOOTING_ACTIVE);
    set_pvar(BUILD_BASE_SPVAR + 1, TEMPO_DISPLAY_VALUE); // Save display value (1-25)
    set_pvar(BUILD_BASE_SPVAR + 2, TAP_SHOT_ACTIVE);
    set_pvar(BUILD_BASE_SPVAR + 3, AUTO_GREEN_DISPLAY_VALUE); // Save display value (1-50)
    set_pvar(BUILD_BASE_SPVAR + 4, TURBO_MODE);
    set_pvar(BUILD_BASE_SPVAR + 5, RS_SHOOT_ENABLED);
    set_pvar(BUILD_BASE_SPVAR + 6, SQUARE_REMAP);
    set_pvar(BUILD_BASE_SPVAR + 7, DEFENSE_ASSIST);
    set_pvar(BUILD_BASE_SPVAR + 8, AUTO_QUICKSTOP_ACTIVE);
    set_pvar(BUILD_BASE_SPVAR + 9, DRIBBLE_ENABLED);
    set_pvar(BUILD_BASE_SPVAR + 10, METER_DUNK_TRIGGER);
    set_pvar(BUILD_BASE_SPVAR + 11, LED_COLOR_SELECTION);
    // Note: Total of 12 variables per build (0-11)
}

function LOAD_BUILD_SETTINGS() {
    GET_BUILD_SPVAR_BASE();
    FLICK_UP_SHOOTING_ACTIVE = get_pvar(BUILD_BASE_SPVAR + 0, 0, 1, 1);
    TEMPO_DISPLAY_VALUE = get_pvar(BUILD_BASE_SPVAR + 1, 1, 25, 15); // Load display value (1-25, default 15)
    CONVERT_TEMPO_DISPLAY_TO_MS(); // Convert display value to actual MS value
    TAP_SHOT_ACTIVE = get_pvar(BUILD_BASE_SPVAR + 2, 0, 1, 1);
    AUTO_GREEN_DISPLAY_VALUE = get_pvar(BUILD_BASE_SPVAR + 3, 1, 50, 34); // Load display value (1-50, default 34 = ~650ms)
    CONVERT_AUTO_GREEN_DISPLAY_TO_MS(); // Convert display value to actual MS value
    TURBO_MODE = get_pvar(BUILD_BASE_SPVAR + 4, 0, 2, 2);
    RS_SHOOT_ENABLED = get_pvar(BUILD_BASE_SPVAR + 5, 0, 1, 0);
    SQUARE_REMAP = get_pvar(BUILD_BASE_SPVAR + 6, 0, 1, 0);
    DEFENSE_ASSIST = get_pvar(BUILD_BASE_SPVAR + 7, 0, 1, 1);
    AUTO_QUICKSTOP_ACTIVE = get_pvar(BUILD_BASE_SPVAR + 8, 0, 1, 0);
    DRIBBLE_ENABLED = get_pvar(BUILD_BASE_SPVAR + 9, 0, 1, 0);
    METER_DUNK_TRIGGER = get_pvar(BUILD_BASE_SPVAR + 10, 0, 2, 0);
    LED_COLOR_SELECTION = get_pvar(BUILD_BASE_SPVAR + 11, 0, 3, 2); // Default to Orange (2)
    SET_LED_COLOR(); // Apply LED color after loading
    // Note: Total of 12 variables per build (0-11)
}

function SWITCH_BUILD() {
    SAVE_BUILD_SETTINGS();
    set_pvar(SPVAR_1, CURRENT_BUILD);
    LOAD_BUILD_SETTINGS();
}

function DRAW_LOGO() { image_oled(0, 0, TRUE, TRUE, LOGO[0]); }
function CENTER_X(f_chars, f_font) { return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2); }
function MAP(val, in_min, in_max, out_min, out_max) { return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min; }

function SET_LED_COLOR() {
    // Set LED based on color selection
    if(LED_COLOR_SELECTION == 0) {
        // Yellow/Green (Prime)
        LED_R = 200; LED_G = 255; LED_B = 0;
    } else if(LED_COLOR_SELECTION == 1) {
        // Blue
        LED_R = 23; LED_G = 84; LED_B = 216;
    } else if(LED_COLOR_SELECTION == 2) {
        // Orange (default)
        LED_R = 255; LED_G = 30; LED_B = 0;
    } else if(LED_COLOR_SELECTION == 3) {
        // Rainbow - cycle through colors
        RAINBOW_TIMER += get_rtime();
        if(RAINBOW_TIMER >= 100) {
            RAINBOW_TIMER = 0;
            RAINBOW_STEP = (RAINBOW_STEP + 1) % 6;
        }
        if(RAINBOW_STEP == 0) { LED_R = 255; LED_G = 0; LED_B = 0; } // Red
        else if(RAINBOW_STEP == 1) { LED_R = 255; LED_G = 165; LED_B = 0; } // Orange
        else if(RAINBOW_STEP == 2) { LED_R = 255; LED_G = 255; LED_B = 0; } // Yellow
        else if(RAINBOW_STEP == 3) { LED_R = 0; LED_G = 255; LED_B = 0; } // Green
        else if(RAINBOW_STEP == 4) { LED_R = 0; LED_G = 0; LED_B = 255; } // Blue
        else if(RAINBOW_STEP == 5) { LED_R = 128; LED_G = 0; LED_B = 128; } // Purple
    }
    set_rgb(LED_R, LED_G, LED_B);
}

function UPDATE_LED_FOR_MOD_STATE(is_mod_on) {
    if(is_mod_on) {
        SET_LED_COLOR(); // Use selected color when mod is ON
    } else {
        set_rgb(0, 0, 0); // LED off when mod is OFF
    }
}

function DRAW_X_GRAPH(value, min_val, max_val, y_pos) {
    GRAPH_WIDTH = 100; X_START = (OLED_WIDTH - GRAPH_WIDTH) / 2; MID_X = X_START + GRAPH_WIDTH / 2; BAR_POS = MAP(value, min_val, max_val, 0, GRAPH_WIDTH);
    line_oled(X_START, y_pos, X_START + GRAPH_WIDTH, y_pos, 1, OLED_WHITE);
    line_oled(MID_X, y_pos - 3, MID_X, y_pos + 3, 1, OLED_WHITE);
    line_oled(X_START, y_pos - 2, X_START, y_pos + 2, 1, OLED_WHITE);
    line_oled(X_START + GRAPH_WIDTH, y_pos - 2, X_START + GRAPH_WIDTH, y_pos + 2, 1, OLED_WHITE);
    rect_oled(X_START, y_pos - 2, BAR_POS, 4, 1, OLED_WHITE);
}

int BUFFER_INDEX, DIGIT_INDEX, CHAR_INDEX;
function NUMBER_TO_STRING(f_val, f_digits) {
    BUFFER_INDEX = 1; DIGIT_INDEX = 10000;
    if(f_val < 0) { putc_oled(BUFFER_INDEX, 45); BUFFER_INDEX += 1; f_val = abs(f_val); }
    for(CHAR_INDEX = 5; CHAR_INDEX >= 1; CHAR_INDEX--) {
        if(f_digits >= CHAR_INDEX) {
            putc_oled(BUFFER_INDEX, (f_val / DIGIT_INDEX) + 48); f_val %= DIGIT_INDEX; BUFFER_INDEX++;
            if(CHAR_INDEX == 4) { putc_oled(BUFFER_INDEX, 44); BUFFER_INDEX++; }
        }
        DIGIT_INDEX /= 10;
    }
    puts_oled(CENTER_X(BUFFER_INDEX - 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, BUFFER_INDEX - 1, OLED_WHITE);
}

int LOG_VAL;
function FIND_DIGITS(num) {
    LOG_VAL = 0;
    do { num /= 10; LOG_VAL++; } while(num);
    return LOG_VAL;
}

int STRING_LENGTH;
function GET_STRING_LENGTH(offset) {
    STRING_LENGTH = 0;
    while(duint8(offset++)) { STRING_LENGTH++; }
    return STRING_LENGTH + 1;
}

int SHOT_DELAY_RESULT;
function GET_SHOT_DELAY() {
    if(IS_CONTESTED) { SHOT_DELAY_RESULT = CONTESTED_DELAY_DURATION; }
    else { 
        SHOT_DELAY_RESULT = GET_TEMPO_MS_WITH_RNG(); // Get RNG-biased value for gameplay
    }
    return SHOT_DELAY_RESULT;
}

int TEMPO_MIN_MS, TEMPO_MAX_MS, TEMPO_RANDOM_OFFSET;
int AUTO_GREEN_MIN_MS, AUTO_GREEN_MAX_MS, AUTO_GREEN_RANDOM_OFFSET;
function CONVERT_TEMPO_DISPLAY_TO_MS() {
    // Convert display value (1-25) to actual MS range
    // Display 1 = 25-26ms, Display 2 = 27-28ms, ..., Display 25 = 74-75ms
    // For display purposes, show the min value
    if(TEMPO_DISPLAY_VALUE < 25) {
        TEMPO_MIN_MS = 24 + (TEMPO_DISPLAY_VALUE * 2) - 1; // Display 1 = 25ms
        TEMPO_MAX_MS = TEMPO_MIN_MS + 1; // Display 1 = 26ms
    } else {
        // Display 25: 74-75ms to reach 75ms
        TEMPO_MIN_MS = 74;
        TEMPO_MAX_MS = 75;
    }
    TEMPO_MS_ACTUAL = TEMPO_MIN_MS; // Show min for display
}

function GET_TEMPO_MS_WITH_RNG() {
    // Get actual MS value with 50/50 RNG between the two values
    // Display 1: 25-26ms (50/50), Display 2: 27-28ms (50/50), Display 25: 74-75ms (50/50)
    if(TEMPO_DISPLAY_VALUE < 25) {
        TEMPO_MIN_MS = 24 + (TEMPO_DISPLAY_VALUE * 2) - 1; // Display 1 = 25ms
        TEMPO_MAX_MS = TEMPO_MIN_MS + 1; // Display 1 = 26ms
    } else {
        // Display 25: 74-75ms
        TEMPO_MIN_MS = 74;
        TEMPO_MAX_MS = 75;
    }
    
    // Generate 50/50 RNG
    TEMPO_RANDOM_OFFSET = random(0, 99);
    if(TEMPO_RANDOM_OFFSET < 50) {
        return TEMPO_MIN_MS;
    }
    return TEMPO_MAX_MS;
}

function CONVERT_AUTO_GREEN_DISPLAY_TO_MS() {
    // Convert display value (1-50) to actual MS range
    // Display 1 = 550-554ms, Display 2 = 554-558ms, ..., Display 50 = 746-750ms
    // Each value covers 4ms: base = 550 + (value - 1) * 4
    AUTO_GREEN_MIN_MS = 550 + ((AUTO_GREEN_DISPLAY_VALUE - 1) * 4);
    AUTO_GREEN_MAX_MS = AUTO_GREEN_MIN_MS + 4;
    AUTO_GREEN_MS_ACTUAL = AUTO_GREEN_MIN_MS; // Show min for display
}

function GET_AUTO_GREEN_MS_WITH_RNG() {
    // Get actual MS value with smart RNG biasing towards middle values
    // Display 1: 550-554ms, middle = 552-553 (biased)
    // Display 50: 746-750ms, middle = 748-749 (biased)
    AUTO_GREEN_MIN_MS = 550 + ((AUTO_GREEN_DISPLAY_VALUE - 1) * 4);
    AUTO_GREEN_MAX_MS = AUTO_GREEN_MIN_MS + 4;
    
    // Smart RNG: bias towards middle values (positions 2 and 3 out of 5)
    // Weighted distribution: 10% min, 35% middle1, 35% middle2, 15% max-1, 5% max
    AUTO_GREEN_RANDOM_OFFSET = random(0, 99);
    if(AUTO_GREEN_RANDOM_OFFSET < 10) {
        // 10% chance: min value
        return AUTO_GREEN_MIN_MS;
    } else if(AUTO_GREEN_RANDOM_OFFSET < 45) {
        // 35% chance: first middle value (position 2)
        return AUTO_GREEN_MIN_MS + 2;
    } else if(AUTO_GREEN_RANDOM_OFFSET < 80) {
        // 35% chance: second middle value (position 3)
        return AUTO_GREEN_MIN_MS + 3;
    } else if(AUTO_GREEN_RANDOM_OFFSET < 95) {
        // 15% chance: second-to-max value (position 4)
        return AUTO_GREEN_MIN_MS + 4;
    }
    // 5% chance: max value (95-99)
    return AUTO_GREEN_MAX_MS;
}


combo FLICK_UP_RS_SMOOTH {
    set_val(PS4_RY, -50 + random(HOLD_RANDOM_MIN, HOLD_RANDOM_MAX));
    set_val(PS4_RX, 20 + random(HOLD_RANDOM_MIN, HOLD_RANDOM_MAX)); wait(TEMPO_MS_ACTUAL);
    set_val(PS4_RY, -100 + random(RANDOM_MIN, RANDOM_MAX));
    set_val(PS4_RX, 25 + random(RANDOM_MIN, RANDOM_MAX)); wait(300);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
}

