// ===== SHOOTING CONFIGURATION =====
int FLICK_UP_SHOOTING_ACTIVE = 1;
int TEMPO_MS = 39;
int CONTESTED_DELAY_DURATION = 80;
int TAP_SHOT_ACTIVE = 1;
int TURBO_MODE = 2; // 0: Hop Jumper, 1: Turbo Fade, 2: OFF
int RS_SHOOT_ENABLED = 0;
int RS_HOLD_TIME = 300;

// ===== CONTROL CONFIGURATION =====
int SQUARE_REMAP = 0;
int DEFENSE_ASSIST = 1;
int AUTO_QUICKSTOP_ACTIVE = 0;
int AUTO_QUICKSTOP_TRIGGERED = 0;

// ===== DRIBBLE CONFIGURATION =====
int DRIBBLE_ENABLED = 0;
int DRIBBLE_UP_FIRST_RUN = 1;
int METER_DUNK_TRIGGER = 0; // 0: OFF, 1: L1, 2: Circle/B

// ===== SHOT MECHANICS =====
int STICK_DOWN = 100;
int STICK_UP = -100;
int RX_OFFSET = 25;
int RANDOM_MIN = -5;
int RANDOM_MAX = 5;
int HOLD_RANDOM_MIN = -2;
int HOLD_RANDOM_MAX = 2;
int STICK_DOWN_VALUE = 100;
int STICK_UP_VALUE = -100;

// ===== RUNTIME VARIABLES =====
int IS_HOLDING = 0;
int HOLD_TIMER = 0;
int RS_IS_UP = 0;
int VALUE_HOLD_TIMER = 0;
int RAPID_CHANGE_TIMER = 0;
int SQUARE_BUTTON = 0;
int IS_CONTESTED = 0;
int TEMPO_DISPLAY_VALUE = 8; // Display value 1-25, default 8 = 39-40ms range
int TEMPO_MS_ACTUAL = 39; // Actual MS value used in combos (with RNG)
int AUTO_GREEN_DISPLAY_VALUE = 34; // Display value 1-50, default 34 = ~650ms range
int AUTO_GREEN_MS_ACTUAL = 650; // Actual MS value used in combos (with smart RNG)

// ===== LED COLOR CONFIGURATION =====
int LED_COLOR_SELECTION = 2; // 0: Yellow/Green, 1: Blue, 2: Orange (default), 3: Rainbow
int LED_R = 255;
int LED_G = 30;
int LED_B = 0;
int RAINBOW_STEP = 0;
int RAINBOW_TIMER = 0;

// ===== MENU SYSTEM =====
int MENU_OPEN = 0;
int CURRENT_PAGE = 1;
int TOTAL_PAGES = 13;
int SELECTION = 0;
int TOGGLE_TYPE = 0;
int PAGE_NAV = 0;
int FLASH_TOGGLE = 0;
int IS_XBOX = 0;
int WAS_MENU_OPEN = 0;
int CURRENT_BUILD = 1;

