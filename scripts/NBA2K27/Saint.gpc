        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08, 0x00, 0xbf, 0x00, 0x08, 0x83, 0xe8, 0x04, 0x30,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x14, 0x80, 0x02, 0x84, 0x40, 0x05, 0x00, 0x00, 0x50,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10, 0x00, 0x00, 0x00, 0x10, 0x00, 0x01, 0x00, 0x08,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x24, 0x00, 0x00, 0x00, 0x20, 0x01, 0x8b, 0x00, 0x28,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00, 0x20, 0x00, 0x08, 0x00, 0xc2, 0x04, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x04, 0x00, 0x40, 0x00, 0x40, 0x00, 0x10, 0x00, 0x08,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x50, 0x00, 0x60, 0x00, 0x20, 0x00, 0xaa, 0x00, 0x04,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x10, 0x00, 0x10, 0x00, 0x92, 0x00, 0x10,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x40, 0x10, 0x00, 0x00, 0x02,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x10, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    }
};


// ============================================================
// Timing Settings
// ============================================================

define NORMAL_MIN       = 100;
define NORMAL_MAX       = 1500;
define NORMAL_DEFAULT   = 300;

define FADE_MIN         = 300;
define FADE_MAX         = 2000;
define FADE_DEFAULT     = 500;

define GOTO_MIN         = 600;
define GOTO_MAX         = 2500;
define GOTO_DEFAULT     = 1000;

define STEP_SIZE        = 25;


// ============================================================
// Menu Profiles
// ============================================================

define PROFILE_NORMAL   = 0;
define PROFILE_FADE     = 1;
define PROFILE_GOTO     = 2;
define PROFILE_STAMINA  = 3;


// ============================================================
// Variables
// ============================================================

int normal_time;
int fade_time;
int goto_time;

int infinite_stamina;
int ground_control = 70;

int menu_active = FALSE;
int selected_profile = PROFILE_NORMAL;
int script_ready = FALSE;

int thousands;
int hundreds;
int tens;
int ones;

int progress_position;
int adjustment_step;

define IDLE_SNOW_COUNT = 24;
int idle_snow_x[IDLE_SNOW_COUNT];
int idle_snow_y[IDLE_SNOW_COUNT];
int idle_snow_speed[IDLE_SNOW_COUNT];
int idle_snow_size[IDLE_SNOW_COUNT];
int idle_snow_index;
int idle_snow_timer;


// ============================================================
// Initialization
// ============================================================

init {

    normal_time = get_pvar(
        SPVAR_1,
        NORMAL_MIN,
        NORMAL_MAX,
        NORMAL_DEFAULT
    );

    fade_time = get_pvar(
        SPVAR_2,
        FADE_MIN,
        FADE_MAX,
        FADE_DEFAULT
    );

    goto_time = get_pvar(
        SPVAR_3,
        GOTO_MIN,
        GOTO_MAX,
        GOTO_DEFAULT
    );

    selected_profile = get_pvar(
        SPVAR_4,
        PROFILE_NORMAL,
        PROFILE_STAMINA,
        PROFILE_NORMAL
    );

    infinite_stamina = get_pvar(
        SPVAR_5,
        0,
        1,
        1
    );

    idle_snow_init();
    cls_oled(OLED_BLACK);
    combo_run(LoadingScreen);
}


// ============================================================
// Main
// ============================================================

main {

    // Disable controls during loading
    if(!script_ready) {

        set_val(PS4_OPTIONS, 0);

        set_val(PS4_UP, 0);
        set_val(PS4_DOWN, 0);
        set_val(PS4_LEFT, 0);
        set_val(PS4_RIGHT, 0);

        set_val(PS4_R3, 0);
        set_val(PS4_SQUARE, 0);
    }

    else {

        // ----------------------------------------------------
        // Open or close menu
        // Hold L2 and press Options
        // ----------------------------------------------------

        if(get_val(PS4_L2) && event_press(PS4_OPTIONS)) {

            menu_active = !menu_active;

            combo_run(RumbleConfirm);

            if(menu_active) {
                show_menu();
            }
            else {
                draw_idle_screen();
            }
        }

        if(!menu_active) {

            idle_snow_timer = idle_snow_timer + get_rtime();

            if(idle_snow_timer >= 55) {
                idle_snow_step();
                idle_snow_timer = 0;
            }

            draw_idle_screen();
        }


        // ====================================================
        // Menu Mode
        // ====================================================

        if(menu_active) {

            // Previous profile
            if(event_press(PS4_UP)) {

                selected_profile = selected_profile - 1;

                if(selected_profile < PROFILE_NORMAL) {
                    selected_profile = PROFILE_STAMINA;
                }

                set_pvar(SPVAR_4, selected_profile);

                combo_run(RumbleConfirm);
                show_menu();
            }


            // Next profile
            if(event_press(PS4_DOWN)) {

                selected_profile = selected_profile + 1;

                if(selected_profile > PROFILE_STAMINA) {
                    selected_profile = PROFILE_NORMAL;
                }

                set_pvar(SPVAR_4, selected_profile);

                combo_run(RumbleConfirm);
                show_menu();
            }


            // Increase value / enable stamina
            if(event_press(PS4_RIGHT)) {

                adjustment_step = 1;

                if(get_val(PS4_L2)) {
                    adjustment_step = 5;
                }

                if(selected_profile == PROFILE_NORMAL) {

                    normal_time = normal_time + adjustment_step;

                    if(normal_time > NORMAL_MAX) {
                        normal_time = NORMAL_MAX;
                    }

                    set_pvar(SPVAR_1, normal_time);
                }

                else if(selected_profile == PROFILE_FADE) {

                    fade_time = fade_time + adjustment_step;

                    if(fade_time > FADE_MAX) {
                        fade_time = FADE_MAX;
                    }

                    set_pvar(SPVAR_2, fade_time);
                }

                else if(selected_profile == PROFILE_GOTO) {

                    goto_time = goto_time + adjustment_step;

                    if(goto_time > GOTO_MAX) {
                        goto_time = GOTO_MAX;
                    }

                    set_pvar(SPVAR_3, goto_time);
                }

                else {

                    infinite_stamina = 1;
                    set_pvar(SPVAR_5, infinite_stamina);
                }

                combo_run(RumbleConfirm);
                show_menu();
            }


            // Decrease value / disable stamina
            if(event_press(PS4_LEFT)) {

                adjustment_step = 1;

                if(get_val(PS4_L2)) {
                    adjustment_step = 5;
                }

                if(selected_profile == PROFILE_NORMAL) {

                    normal_time = normal_time - adjustment_step;

                    if(normal_time < NORMAL_MIN) {
                        normal_time = NORMAL_MIN;
                    }

                    set_pvar(SPVAR_1, normal_time);
                }

                else if(selected_profile == PROFILE_FADE) {

                    fade_time = fade_time - adjustment_step;

                    if(fade_time < FADE_MIN) {
                        fade_time = FADE_MIN;
                    }

                    set_pvar(SPVAR_2, fade_time);
                }

                else if(selected_profile == PROFILE_GOTO) {

                    goto_time = goto_time - adjustment_step;

                    if(goto_time < GOTO_MIN) {
                        goto_time = GOTO_MIN;
                    }

                    set_pvar(SPVAR_3, goto_time);
                }

                else {

                    infinite_stamina = 0;
                    set_pvar(SPVAR_5, infinite_stamina);
                }

                combo_run(RumbleConfirm);
                show_menu();
            }


            // Block menu controls from reaching the game
            set_val(PS4_OPTIONS, 0);

            set_val(PS4_UP, 0);
            set_val(PS4_DOWN, 0);
            set_val(PS4_LEFT, 0);
            set_val(PS4_RIGHT, 0);
        }


        // ====================================================
        // Gameplay Mode
        // ====================================================

        else {

            // ------------------------------------------------
            // Infinite stamina behavior
            // Based on the supplied script's movement control
            // ------------------------------------------------

            if(infinite_stamina) {

                if(
                    !combo_running(NormalSquare) &&
                    !combo_running(FadeSquare) &&
                    !combo_running(GotoStick)
                ) {

                    if(
                        abs(get_val(PS4_LX)) > 20 ||
                        abs(get_val(PS4_LY)) > 20
                    ) {

                        set_val(
                            PS4_LX,
                            (get_val(PS4_LX) * ground_control) / 100
                        );

                        set_val(
                            PS4_LY,
                            (get_val(PS4_LY) * ground_control) / 100
                        );
                    }

                    if(
                        abs(get_val(PS4_LX)) < 20 &&
                        abs(get_val(PS4_LY)) < 20
                    ) {

                        set_val(PS4_LX, 0);
                        set_val(PS4_LY, 0);
                    }
                }
            }


            // Goto timing
            // Press D-Pad Down
            if(event_press(PS4_DOWN)) {

                if(!combo_running(GotoStick)) {
                    combo_run(GotoStick);
                }
            }


            // Fade timing
            // Hold R2 and press R3
            if(get_val(PS4_R2) && event_press(PS4_R3)) {

                if(!combo_running(FadeSquare)) {

                    combo_stop(NormalSquare);
                    combo_run(FadeSquare);
                }
            }


            // Normal timing
            // Press R3 without holding R2
            else if(!get_val(PS4_R2) && event_press(PS4_R3)) {

                if(!combo_running(NormalSquare)) {

                    combo_stop(FadeSquare);
                    combo_run(NormalSquare);
                }
            }
        }
    }
}


// ============================================================
// Normal Timing Combo
// ============================================================

combo NormalSquare {

    set_val(PS4_SQUARE, 100);
    wait(normal_time);

    set_val(PS4_SQUARE, 0);
    wait(10);
}


// ============================================================
// Fade Timing Combo
// ============================================================

combo FadeSquare {

    set_val(PS4_SQUARE, 100);
    wait(fade_time);

    set_val(PS4_SQUARE, 0);
    wait(10);
}


// ============================================================
// Goto Timing Combo
// ============================================================

combo GotoStick {

    set_val(PS4_RY, -100);
    wait(goto_time);

    set_val(PS4_RY, 0);
    wait(10);
}


// ============================================================
// Confirmation Vibration
// ============================================================

combo RumbleConfirm {

    set_rumble(RUMBLE_A, 45);
    wait(90);

    set_rumble(RUMBLE_A, 0);
    wait(10);
}


// ============================================================
// Saint Button Autogreen Bitmap Loading Screen
// ============================================================

combo LoadingScreen {

    cls_oled(OLED_BLACK);

    image_oled(
        0,
        0,
        TRUE,
        TRUE,
        saint_logo[0]
    );

    wait(1800);


    // Ready confirmation
    cls_oled(OLED_BLACK);

    putc_oled(1, 82);
    putc_oled(2, 69);
    putc_oled(3, 65);
    putc_oled(4, 68);
    putc_oled(5, 89);

    puts_oled(
        39,
        24,
        OLED_FONT_MEDIUM,
        5,
        OLED_WHITE
    );

    set_rumble(RUMBLE_A, 45);
    wait(100);

    set_rumble(RUMBLE_A, 0);
    wait(500);

    script_ready = TRUE;

    draw_idle_screen();
}


// ============================================================
// Idle Screen
// ============================================================

function draw_idle_screen() {

    cls_oled(OLED_BLACK);

    idle_snow_draw();

    putc_oled(1, 83);
    putc_oled(2, 65);
    putc_oled(3, 73);
