// ============================================================
// Timing Menu Pages
// ============================================================

function display_normal_value() {

    draw_large_value(normal_time);

    progress_position =
        16 +
        (
            (normal_time - NORMAL_MIN) *
            94 /
            (NORMAL_MAX - NORMAL_MIN)
        );

    draw_progress_bar(progress_position);

    draw_small_number(NORMAL_MIN, 5, 42);
    draw_small_number(NORMAL_MAX, 101, 42);
}


function display_fade_value() {

    draw_large_value(fade_time);

    progress_position =
        16 +
        (
            (fade_time - FADE_MIN) *
            94 /
            (FADE_MAX - FADE_MIN)
        );

    draw_progress_bar(progress_position);

    draw_small_number(FADE_MIN, 5, 42);
    draw_small_number(FADE_MAX, 101, 42);
}


function display_goto_value() {

    draw_large_value(goto_time);

    progress_position =
        16 +
        (
            (goto_time - GOTO_MIN) *
            94 /
            (GOTO_MAX - GOTO_MIN)
        );

    draw_progress_bar(progress_position);

    draw_small_number(GOTO_MIN, 5, 42);
    draw_small_number(GOTO_MAX, 101, 42);
}


// ============================================================
// Stamina Menu Page
// ============================================================

function draw_stamina_value() {

    if(infinite_stamina) {

        putc_oled(1, 79);
        putc_oled(2, 78);

        puts_oled(
            47,
            21,
            OLED_FONT_LARGE,
            2,
            OLED_WHITE
        );

        rect_oled(
            20,
            39,
            88,
            7,
            1,
            OLED_WHITE
        );
    }

    else {

        putc_oled(1, 79);
        putc_oled(2, 70);
        putc_oled(3, 70);

        puts_oled(
            39,
            21,
            OLED_FONT_LARGE,
            3,
            OLED_WHITE
        );

        rect_oled(
            20,
            39,
            88,
            7,
            0,
            OLED_WHITE
        );
    }
}


// ============================================================
// Large Timing Value
// ============================================================

function draw_large_value(value) {

    thousands = value / 1000;
    hundreds  = (value / 100) % 10;
    tens      = (value / 10) % 10;
    ones      = value % 10;

    if(value >= 1000) {

        putc_oled(1, 48 + thousands);
        putc_oled(2, 48 + hundreds);
        putc_oled(3, 48 + tens);
        putc_oled(4, 48 + ones);

        puts_oled(
            27,
            17,
            OLED_FONT_LARGE,
            4,
            OLED_WHITE
        );
    }

    else {

        putc_oled(1, 48 + hundreds);
        putc_oled(2, 48 + tens);
        putc_oled(3, 48 + ones);

        puts_oled(
            35,
            17,
            OLED_FONT_LARGE,
            3,
            OLED_WHITE
        );
    }

    putc_oled(1, 77);
    putc_oled(2, 83);

    puts_oled(
        91,
        25,
        OLED_FONT_SMALL,
        2,
        OLED_WHITE
    );
}


// ============================================================
// Progress Bar
// ============================================================

function draw_progress_bar(position) {

    rect_oled(
        13,
        35,
        101,
        7,
        0,
        OLED_WHITE
    );

    rect_oled(
        16,
        38,
        position - 16,
        1,
        1,
        OLED_WHITE
    );

    line_oled(
        position,
        36,
        position,
        40,
        1,
        OLED_WHITE
    );
}


// ============================================================
// Small Number Display
// ============================================================

function draw_small_number(value, x, y) {

    thousands = value / 1000;
    hundreds  = (value / 100) % 10;
    tens      = (value / 10) % 10;
    ones      = value % 10;

    if(value >= 1000) {

        putc_oled(1, 48 + thousands);
        putc_oled(2, 48 + hundreds);
        putc_oled(3, 48 + tens);
        putc_oled(4, 48 + ones);

        puts_oled(
            x,
            y,
            OLED_FONT_SMALL,
            4,
            OLED_WHITE
        );
    }

    else {

        putc_oled(1, 48 + hundreds);
        putc_oled(2, 48 + tens);
        putc_oled(3, 48 + ones);

        puts_oled(
            x,
            y,
            OLED_FONT_SMALL,
            3,
            OLED_WHITE
        );
    }
}


                                  