    putc_oled(5, 84);

    puts_oled(
        49,
        7,
        OLED_FONT_SMALL,
        5,
        OLED_WHITE
    );

    putc_oled(1, 66);
    putc_oled(2, 85);
    putc_oled(3, 84);
    putc_oled(4, 84);
    putc_oled(5, 79);
    putc_oled(6, 78);

    puts_oled(
        37,
        23,
        OLED_FONT_MEDIUM,
        6,
        OLED_WHITE
    );

    putc_oled(1, 65);
    putc_oled(2, 85);
    putc_oled(3, 84);
    putc_oled(4, 79);
    putc_oled(5, 71);
    putc_oled(6, 82);
    putc_oled(7, 69);
    putc_oled(8, 69);
    putc_oled(9, 78);

    puts_oled(
        32,
