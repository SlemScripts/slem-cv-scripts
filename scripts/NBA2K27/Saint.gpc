        OLED_FONT_SMALL,
        9,
        OLED_WHITE
    );
}

// ============================================================
// Idle Snowfall Animation
// ============================================================

function idle_snow_init() {

    for(idle_snow_index = 0; idle_snow_index < IDLE_SNOW_COUNT; idle_snow_index++) {

        idle_snow_x[idle_snow_index] = random(2, 124);
        idle_snow_y[idle_snow_index] = random(-63, 63);
        idle_snow_speed[idle_snow_index] = random(1, 3);
        idle_snow_size[idle_snow_index] = random(1, 2);
    }

    idle_snow_timer = 0;
}


function idle_snow_step() {

    for(idle_snow_index = 0; idle_snow_index < IDLE_SNOW_COUNT; idle_snow_index++) {

        idle_snow_y[idle_snow_index] =
            idle_snow_y[idle_snow_index] +
            idle_snow_speed[idle_snow_index];

        if(idle_snow_index % 3 == 0) {
            idle_snow_x[idle_snow_index] = idle_snow_x[idle_snow_index] + 1;
        }
        else if(idle_snow_index % 3 == 1) {
            idle_snow_x[idle_snow_index] = idle_snow_x[idle_snow_index] - 1;
        }

        if(idle_snow_x[idle_snow_index] < 2) {
            idle_snow_x[idle_snow_index] = 124;
        }
        if(idle_snow_x[idle_snow_index] > 124) {
            idle_snow_x[idle_snow_index] = 2;
        }

        if(idle_snow_y[idle_snow_index] > 63) {
            idle_snow_x[idle_snow_index] = random(2, 124);
            idle_snow_y[idle_snow_index] = random(-18, -1);
            idle_snow_speed[idle_snow_index] = random(1, 3);
            idle_snow_size[idle_snow_index] = random(1, 2);
        }
    }
}


function idle_snow_draw() {

    for(idle_snow_index = 0; idle_snow_index < IDLE_SNOW_COUNT; idle_snow_index++) {

        if(idle_snow_y[idle_snow_index] >= 0 && idle_snow_y[idle_snow_index] <= 63) {

            if(idle_snow_size[idle_snow_index] == 1) {
                rect_oled(
                    idle_snow_x[idle_snow_index],
                    idle_snow_y[idle_snow_index],
                    1,
                    1,
                    1,
                    OLED_WHITE
                );
            }
            else {
                line_oled(
                    idle_snow_x[idle_snow_index] - 1,
                    idle_snow_y[idle_snow_index],
                    idle_snow_x[idle_snow_index] + 1,
                    idle_snow_y[idle_snow_index],
                    1,
                    OLED_WHITE
                );

                line_oled(
                    idle_snow_x[idle_snow_index],
                    idle_snow_y[idle_snow_index] - 1,
                    idle_snow_x[idle_snow_index],
                    idle_snow_y[idle_snow_index] + 1,
                    1,
                    OLED_WHITE
                );
            }
        }
    }
}


// ============================================================
// Improved Menu Screen
