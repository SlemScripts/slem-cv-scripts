int graph_width;
int x_start;
int mid_x;
int bar_pos;
init {
    flick_up_shooting_active = 1;
    delay_duration = 50;
    Delay_duration_Insta = 50;
    reverse_flick_mode = 1;      
    rs_shooting_active = 0;
    rs_hold_duration   = 300;
    Insta_shot_active    = 1;
    Insta_shot_duration  = 590;
    remap_square_active = 0;
    stabilization_variation = 57;
    dribbling_enabled = 0;
    lr_moves_selection = 0;
    ud_moves_selection = 0;
    autoQs = 0;  
    l2Qs   = 0;
    saver_on = 0;                
    saver_timer = 0;
    cls_oled(OLED_BLACK);
    dAssist = 0;
    quickstop_mode = 0;
}
main {
    if (get_console() == PIO_XB1) { isXbox = 1; } else { isXbox = 0; }
    if (startup && isLoadingScreen) {
        draw_picture(0, 0);
        LoadingTimeToRun += get_rtime();
        if (LoadingTimeToRun >= LoadingTimer) {
            cls_oled(OLED_BLACK);
            isLoadingScreen = 0;
            startup = 0;
            saver_on = 1;
            saver_timer = 80;    
        }
    } else {
        if (event_press(PS4_CIRCLE) && menu_enabled) {
            menu_enabled = 0;
            stop_all_runtime_combos();
            isHolding = 0;
            holdTimer = 0;
            combo_run(vibration_off);
            set_rgb(0,255,0);
            saver_on = 1;          
        }
        else if (!menu_enabled && FALSE && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = 1;
            stop_all_runtime_combos();
            isHolding = 0;
            holdTimer = 0;
            combo_run(vibration_on);
            set_rgb(0,0,255);
            saver_on = 0;          
        }
        if (menu_enabled) {
            if (page > numpgs) { page = numpgs; }
            if (page < 1)    { page = 1; }
            if (page == 1) { pageChg_s = 0; } else if (page == numpgs) { pageChg_s = 2; } else { pageChg_s = 1; }
            cls_oled(OLED_BLACK);
            rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE);
            line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);
            print(center_x(get_string_length(pageChg[pageChg_s]), OLED_FONT_SMALL_WIDTH), 4,  OLED_FONT_SMALL,  OLED_WHITE, pageChg[pageChg_s]);
            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL,  OLED_WHITE, menu_header[page - 1]);
            if (page == 4) {
                print(center_x(get_string_length(reverse_modes[reverse_flick_mode]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, reverse_modes[reverse_flick_mode]);
            } else if (page == 9) {
                print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[remap_square_active + 3]);
            } else if (page == 11) {
                print(center_x(get_string_length(quickstop_modes[quickstop_mode]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, quickstop_modes[quickstop_mode]);
            } else if (page == 13) {
                print(center_x(get_string_length(lr_dribble_moves[lr_moves_selection]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, lr_dribble_moves[lr_moves_selection]);
            } else if (page == 14) {
                print(center_x(get_string_length(ud_dribble_moves[ud_moves_selection]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, ud_dribble_moves[ud_moves_selection]);
            } else if (page != 2 && page != 3 && page != 7 && page != 8) {
                print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
            }
            print(center_x(get_string_length(item_tole[toleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_tole[toleType]);
            if (get_val(PS4_L2)) { set_val(PS4_UP,0); set_val(PS4_DOWN,0); set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0); }
            if (get_val(PS4_L2) && event_press(PS4_LEFT))  { page--; combo_run(vibration_valchg); }
            if (get_val(PS4_L2) && event_press(PS4_RIGHT)) { page++; combo_run(vibration_valchg); }
            if (page == 1) {
                menuSelection = flick_up_shooting_active; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { flick_up_shooting_active = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { flick_up_shooting_active = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 2) {
                menuSelection = 2; toleType = 0;
                NumberToString(delay_duration, FindDigits(delay_duration));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(delay_duration, 0, 300, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))    { delay_duration++; }
                    if (event_press(PS4_DOWN)) { delay_duration--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (delay_duration > 300) { delay_duration = 300; }
                if (delay_duration < 0)    { delay_duration = 0;    }
            }
            if (page == 3) {
                menuSelection = 2; toleType = 0;
                NumberToString(stabilization_variation, FindDigits(stabilization_variation));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(stabilization_variation, 10, 100, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))    { stabilization_variation++; }
                    if (event_press(PS4_DOWN)) { stabilization_variation--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (stabilization_variation > 100) { stabilization_variation = 100; }
                if (stabilization_variation < 10)  { stabilization_variation = 10;  }
            }
            if (page == 4) {
                menuSelection = reverse_flick_mode; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { reverse_flick_mode = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { reverse_flick_mode = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 5) {
                menuSelection = rs_shooting_active; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { rs_shooting_active = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { rs_shooting_active = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 6) {
                menuSelection = Insta_shot_active; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { Insta_shot_active = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { Insta_shot_active = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 7) {
                menuSelection = 2; toleType = 0;
                NumberToString(Insta_shot_duration, FindDigits(Insta_shot_duration));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(Insta_shot_duration, 100, 1000, 45);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP))    { Insta_shot_duration += 10; }
                        if (event_press(PS4_DOWN)) { Insta_shot_duration -= 10; }
                    } else {
                        if (event_press(PS4_UP))    { Insta_shot_duration += 1; }
                        if (event_press(PS4_DOWN)) { Insta_shot_duration -= 1; }
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (Insta_shot_duration > 1000) { Insta_shot_duration = 1000; }
                if (Insta_shot_duration < 100)  { Insta_shot_duration = 100;  }
            }
            if (page == 8) {
                menuSelection = 2; toleType = 0;
                NumberToString(Delay_duration_Insta, FindDigits(Delay_duration_Insta));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(Delay_duration_Insta, 0, 300, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))    { Delay_duration_Insta++; }
                    if (event_press(PS4_DOWN)) { Delay_duration_Insta--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (Delay_duration_Insta > 300) { Delay_duration_Insta = 300; }
                if (Delay_duration_Insta < 0)    { Delay_duration_Insta = 0;    }
            }
            if (page == 9) {
                menuSelection = remap_square_active; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { remap_square_active = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { remap_square_active = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 10) {
                menuSelection = dAssist; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { dAssist = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { dAssist = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 11) {
                menuSelection = quickstop_mode;
                print(center_x(get_string_length(quickstop_modes[quickstop_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, quickstop_modes[quickstop_mode]);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP)) { quickstop_mode++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { quickstop_mode--; combo_run(vibration_valchg); }
                }
                if (quickstop_mode > 2) { quickstop_mode = 0; }
                if (quickstop_mode < 0) { quickstop_mode = 2; }
                if (quickstop_mode == 0) { autoQs = 0; l2Qs = 0; }
                else if (quickstop_mode == 1) { autoQs = 1; l2Qs = 0; }
                else if (quickstop_mode == 2) { autoQs = 0; l2Qs = 1; }
            }
            if (page == 12) {
                menuSelection = dribbling_enabled; toleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))    { dribbling_enabled = 1; flashtole = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { dribbling_enabled = 0; flashtole = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 13) {
                menuSelection = lr_moves_selection; toleType = 1;
                print(center_x(get_string_length(lr_dribble_moves[lr_moves_selection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, lr_dribble_moves[lr_moves_selection]);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP)) { lr_moves_selection++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { lr_moves_selection--; combo_run(vibration_valchg); }
                }
                if (lr_moves_selection > 2) { lr_moves_selection = 0; }
                if (lr_moves_selection < 0) { lr_moves_selection = 2; }
            }
            if (page == 14) {
                menuSelection = ud_moves_selection; toleType = 1;
                print(center_x(get_string_length(ud_dribble_moves[ud_moves_selection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, ud_dribble_moves[ud_moves_selection]);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP)) { ud_moves_selection++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { ud_moves_selection--; combo_run(vibration_valchg); }
                }
                if (ud_moves_selection > 2) { ud_moves_selection = 0; }
                if (ud_moves_selection < 0) { ud_moves_selection = 2; }
            }
        } 
        if (!menu_enabled) {
            set_rgb(0,255,0);
            if (saver_on) {
                saver_timer += get_rtime();
                if (saver_timer >= 80) {
                    saver_step();
                    saver_timer = 0;
                }
            }
            if (remap_square_active == 0) {
                if (get_val(PS4_L3)) { set_val(PS4_SQUARE, 100); }
            } else {
                if (get_val(PS4_R3)) { set_val(PS4_SQUARE, 100); }
            }
            if (flick_up_shooting_active) {
                if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE)) {
                    set_val(PS4_SQUARE, 0);
                    if (reverse_flick_mode && get_val(PS4_R2)) {
                        set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                    } else {
                        set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                    }
                    set_val(PS4_RX, random(random_variation_min, random_variation_max));
                }
                if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE)) {
                    if (reverse_flick_mode && get_val(PS4_R2)) { combo_run(flick_up_rs_reversed); }
                    else { combo_run(flick_up_rs_smooth); }
                }
            }
            if (Insta_shot_active) {
                if ((remap_square_active == 0 && event_press(PS4_R3)) || (remap_square_active == 1 && event_press(PS4_L3))) {
                    if (reverse_flick_mode && get_val(PS4_R2)) { combo_run(Insta_shot_reversed); }
                    else { combo_run(Insta_shot_smooth); }
                }
            }
            if (rs_shooting_active) {
                if (!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
                    if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
                        if (!isHolding) {
                            isHolding = 1;
                            holdTimer = 0;
                            if (get_val(PS4_RY) < 0) { rs_is_up = 1; } else { rs_is_up = 0; }
                        }
                        holdTimer += get_rtime();
                    } else {
                        if (isHolding) {
                            if (holdTimer > rs_hold_duration) {
                                if (!rs_is_up) {
                                    combo_run(flick_up_rs_smooth);
                                } else {
                                    combo_run(flick_up_rs_reversed);
                                }
                            }
                            isHolding = 0;
                            holdTimer = 0;
                        }
                    }
                }
            }
            if (dAssist) {
                if(get_val(PS4_L2) > 50) {
                    set_val(PS4_RY, (get_val(PS4_RY) * 13) / 10);
                }
            }
            if (autoQs || l2Qs) {
                if (get_val(PS4_RX) < 5 && get_val(PS4_RX) > -5 && get_val(PS4_RY) < 5 && get_val(PS4_RY) > -5) {
                    if (!get_val(PS4_R3)) {
                        if (autoQs) {
                            if (get_val(PS4_L1) || get_val(PS4_R1)) {
                                set_val(PS4_LX, 0);
                                set_val(PS4_LY, 0);
                                set_val(PS4_L3, 100);
                                set_val(PS4_L3, 0);    
                            }
                        } else if (l2Qs) {
                            if (get_val(PS4_L2)) {
                                set_val(PS4_LX, 0);
                                set_val(PS4_LY, 0);
                                set_val(PS4_L3, 100);
                                set_val(PS4_L3, 0);            
                            }
                        }
                    }
                }
            }
            dribble_tick();
        } 
    } 
} 
function stop_all_runtime_combos() {
    combo_stop(flick_up_rs_smooth);
    combo_stop(flick_up_rs_reversed);
    combo_stop(Insta_shot_smooth);
    combo_stop(Insta_shot_reversed);
    combo_stop(B_RIGHT);
    combo_stop(B_LEFT);
    combo_stop(ESCAPE_RIGHT);
    combo_stop(ESCAPE_LEFT);
    combo_stop(MOMENTUM_RIGHT);
    combo_stop(MOMENTUM_LEFT);
    combo_stop(BTBSPAM_UP);
    combo_stop(BTBSPAM_DOWN);
    combo_stop(CURRY_UP);
    combo_stop(CURRY_DOWN);
    combo_stop(DBOOK_UP);
    combo_stop(DBOOK_DOWN);
    set_val(PS4_RX, 0);
    set_val(PS4_RY, 0);
}
function dribble_tick() {
    if (!dribbling_enabled) return;
    if (get_val(PS4_RIGHT)) {
        set_val(PS4_RIGHT, 0);
        if (lr_moves_selection == 0) combo_run(B_RIGHT);
        else if (lr_moves_selection == 1) combo_run(ESCAPE_RIGHT);
        else if (lr_moves_selection == 2) combo_run(MOMENTUM_RIGHT);
    } else {
        combo_stop(B_RIGHT);
        combo_stop(ESCAPE_RIGHT);
        combo_stop(MOMENTUM_RIGHT);
    }
    if (get_val(PS4_LEFT)) {
        set_val(PS4_LEFT, 0);
        if (lr_moves_selection == 0) combo_run(B_LEFT);
        else if (lr_moves_selection == 1) combo_run(ESCAPE_LEFT);
        else if (lr_moves_selection == 2) combo_run(MOMENTUM_LEFT);
    } else {
        combo_stop(B_LEFT);
        combo_stop(ESCAPE_LEFT);
        combo_stop(MOMENTUM_LEFT);
    }
    if (get_val(PS4_UP)) {
        set_val(PS4_UP, 0);
        if (ud_moves_selection == 0) combo_run(BTBSPAM_UP);
        else if (ud_moves_selection == 1) combo_run(CURRY_UP);
        else if (ud_moves_selection == 2) combo_run(DBOOK_UP);
    } else {
        combo_stop(BTBSPAM_UP);
        combo_stop(CURRY_UP);
        combo_stop(DBOOK_UP);
    }
    if (get_val(PS4_DOWN)) {
        set_val(PS4_DOWN, 0);
        if (ud_moves_selection == 0) combo_run(BTBSPAM_DOWN);
        else if (ud_moves_selection == 1) combo_run(CURRY_DOWN);
        else if (ud_moves_selection == 2) combo_run(DBOOK_DOWN);
    } else {
        combo_stop(BTBSPAM_DOWN);
        combo_stop(CURRY_DOWN);
        combo_stop(DBOOK_DOWN);
    }
}
            function draw_picture(x, y) {
                image_oled(x, y, TRUE, FALSE, picture[0]); 
            }
            function saver_step() {
                cls_oled(OLED_BLACK);

                // floating star field / hacker dots
                pixel_oled((sx % 118) + 4, 6, OLED_WHITE);
                pixel_oled(((sx * 2) % 118) + 4, 11, OLED_WHITE);
                pixel_oled(((sx * 3) % 118) + 4, 16, OLED_WHITE);
                pixel_oled(((sx * 4) % 118) + 4, 47, OLED_WHITE);
                pixel_oled(((sx * 5) % 118) + 4, 53, OLED_WHITE);
                pixel_oled(((sx * 6) % 118) + 4, 59, OLED_WHITE);

                // shooting star streaks
                line_oled(((sx * 2) % 100) + 6, 9,  ((sx * 2) % 100) + 20, 9, 1, OLED_WHITE);
                line_oled(((sx * 3) % 94) + 8, 55, ((sx * 3) % 94) + 27, 55, 1, OLED_WHITE);
                line_oled(((sx * 4) % 76) + 16, 3, ((sx * 4) % 76) + 29, 3, 1, OLED_WHITE);

                // subtle glitch scan bars behind text
                line_oled(12, 23, 34, 23, 1, OLED_WHITE);
                line_oled(94, 23, 116, 23, 1, OLED_WHITE);
                line_oled(18, 39, 42, 39, 1, OLED_WHITE);
                line_oled(86, 39, 110, 39, 1, OLED_WHITE);

                // readable centered wording
                print(center_x(get_string_length(saver_line1[0]), OLED_FONT_SMALL_WIDTH), 21, OLED_FONT_SMALL, OLED_WHITE, saver_line1[0]);
                print(center_x(get_string_length(saver_line2[0]), OLED_FONT_SMALL_WIDTH), 39, OLED_FONT_SMALL, OLED_WHITE, saver_line2[0]);

                // tiny tech pixels around text, not in the corners
                pixel_oled(37, 18, OLED_WHITE);
                pixel_oled(91, 18, OLED_WHITE);
                pixel_oled(31, 51, OLED_WHITE);
                pixel_oled(98, 51, OLED_WHITE);

                sx += svx;
                if (sx >= 118) { sx = 1; }
            }
            function map(val, in_min, in_max, out_min, out_max) {
                return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
            }
            function draw_x_graph(value, min_val, max_val, y_pos) {
                graph_width = 100;
                x_start = (OLED_WIDTH - graph_width) / 2;
                mid_x = x_start + graph_width / 2;
                bar_pos = map(value, min_val, max_val, 0, graph_width);
                line_oled(x_start, y_pos, x_start + graph_width, y_pos, 1, OLED_WHITE);
                line_oled(mid_x, y_pos - 3, mid_x, y_pos + 3, 1, OLED_WHITE);
                line_oled(x_start, y_pos - 2, x_start, y_pos + 2, 1, OLED_WHITE);
                line_oled(x_start + graph_width, y_pos - 2, x_start + graph_width, y_pos + 2, 1, OLED_WHITE);
                rect_oled(x_start, y_pos - 2, bar_pos, 4, 1, OLED_WHITE);
            }
            combo flick_up_rs_smooth {
                set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
                set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
                wait(delay_duration);
                set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
                set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
                wait(300);
                set_val(PS4_RY, 0);
                set_val(PS4_RX, 0);
            }
            combo flick_up_rs_reversed {
                set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
                set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
                wait(delay_duration);
                set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
                set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
                wait(300);
                set_val(PS4_RY, 0);
                set_val(PS4_RX, 0);
            }
            combo Insta_shot_smooth {
                set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                set_val(PS4_RX, random(random_variation_min, random_variation_max));
                wait(Insta_shot_duration);
                set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
                set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
                wait(Delay_duration_Insta); 
                set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
                set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
                wait(300);
                set_val(PS4_RY, 0);
                set_val(PS4_RX, 0);
            }
            combo Insta_shot_reversed {
                set_val(PS4_RY, STICK_UP_VALUE + random(random_hold_variation_min, random_hold_variation_max));
                set_val(PS4_RX, random(random_variation_min, random_variation_max));
                wait(Insta_shot_duration);
                set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
                set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
                wait(Delay_duration_Insta); 
                set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
                set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
                wait(30);
                set_val(PS4_RY, 0);
                set_val(PS4_RX, 0);
            }
            combo B_RIGHT {
                set_val(PS4_RX, -100);
                wait(200);
                set_val(PS4_RX, 0);
                set_val(PS4_L2, 100);
                set_val(PS4_RX, -100);
                wait(150);
                set_val(PS4_L2, 0);
                set_val(PS4_RX, 0);
                wait(150);
            }
            combo B_LEFT {
                set_val(PS4_RX, 100);
                wait(200);
                set_val(PS4_RX, 0);
                set_val(PS4_L2, 100);
                set_val(PS4_RX, 100);
                wait(150);
                set_val(PS4_L2, 0);
                set_val(PS4_RX, 0);
                wait(150);
            }
            combo ESCAPE_RIGHT {
                set_val(PS4_RY, 100);
                set_val(PS4_L2, 100);
                wait(200);
                set_val(PS4_RY, 0);
                set_val(PS4_L2, 0);
                wait(100);
            }
            combo ESCAPE_LEFT {
                set_val(PS4_RY, 100);
                set_val(PS4_L2, 100);
                wait(200);
                set_val(PS4_RY, 0);
                set_val(PS4_L2, 0);
                wait(100);
            }
            combo MOMENTUM_RIGHT {
                set_val(PS4_L2, 100);
                wait(100);
                set_val(PS4_LX, 100);
                set_val(PS4_L2, 0);
                wait(200);
                set_val(PS4_LX, 0);
                wait(100);
            }
            combo MOMENTUM_LEFT {
                set_val(PS4_L2, 100);
                wait(100);
                set_val(PS4_LX, -100);
                set_val(PS4_L2, 0);
                wait(200);
                set_val(PS4_LX, 0);
                wait(100);
            }
            combo BTBSPAM_UP {
                set_val(PS4_RX, 100);
