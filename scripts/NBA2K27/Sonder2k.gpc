// int flick_up_shooting_active = 1;
int flick_sequences_enabled = 0;
int delay_duration = 50;
int Delay_duration_Insta = 50;
int STICK_DOWN_VALUE = 100000;
int STICK_UP_VALUE = -100000;
int RX_UP_VALUE = 25;
int reverse_flick_mode = 1;
int Insta_shot_active = 1;
int Insta_shot_duration = 650;
int DL_Insta_shot_active = 1;
int DL_Insta_shot_duration = 650;
int DL_Delay_duration_Insta = 50;
int go_to_shot_duration = 2000;
int go_to_shot_active = 1;
int spot_take_active = 0;

// --- Fade L/R (ported from APEX_V2, Tempo follows Sonder's direct-ms/no-RNG logic) ---
int fadeL_active = 0;
int fadeL_timing = 400;   // ms, charge phase (same range/meaning as APEX FadeL Timing)
int fadeL_tempo  = 50;    // ms, gather phase (Sonder-style: direct ms, deterministic, no RNG)
int fadeR_active = 0;
int fadeR_timing = 400;
int fadeR_tempo  = 50;
define FADE_LAT = 25;     // LX lean needed to read a fade direction on R3

// --- Profile System (5 slots, ported from v7RC's auto-packing engine) ---
define PROFILE_COUNT = 5;
int active_profile = 0; // 0-4
int profile_flick_up[5];
int profile_delay[5];
int profile_reverse[5];
int profile_insta_active[5];
int profile_insta_dur[5];
int profile_insta_tempo[5];
int profile_dl_active[5];
int profile_dl_dur[5];
int profile_dl_tempo[5];
int profile_go_to_shot[5];
int profile_go_to_shot_active[5];
int profile_spot_take[5];
int profile_fadeL_active[5];
int profile_fadeL_timing[5];
int profile_fadeL_tempo[5];
int profile_fadeR_active[5];
int profile_fadeR_timing[5];
int profile_fadeR_tempo[5];
const string profile_labels[] = { "Profile 1", "Profile 2", "Profile 3", "Profile 4", "Profile 5" };
// --- End Profile System ---
// --- Idle screensaver state ---
int saver_on = 0;
int sx = 2, sy = 16;
int svx = 2, svy = 2;
int msg_w, line1_w, line2_w;
int saver_timer = 0;
const string saver_line1[] = { "Sonder V3" };
const string saver_line2[] = { "" };
const string tt_title[] = { "Sonder V3" };

// ===== Menu state =====
int startup = 1, numpgs = 25, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;

// ===== Menu labels =====
const string menu_header[] = { "Square Tempo", "Tempo Speed (ms)", "Turbo Shots", "Insta Shot", "Insta Speed (ms)", "Insta Tempo (ms)", "Auto No Dip", "Auto No Dip Speed (ms)", "Auto No Dip Tempo (ms)", "Go To Shot", "Go To Shot (ms)", "Spot Take", "Fade LEFT Shot", "FadeL Timing", "FadeL Tempo", "Fade RIGHT Shot", "FadeR Timing", "FadeR Tempo", "Profile Select", "Infinite Stamina", "Ground Control %", "Defense Boost", "Auto Contest", "Side Step Boost", "Zen Colour" };
const string auto_contest_label[] = {"OFF", "CONTEST", "LOCKDOWN"};
const string pageChg[] = {"---------L2+RIGHT->", "<-L2+LEFT--L2+RIGHT->", "<-L2+LEFT---------"};
const string item_toggle[] = {"L2 + UP/DOWN", "to change"};
const string onOff[] = {"OFF", "ON"};
const string ms[] = {"ms"};
const string reverse_modes[] = {"Hop Jumper", "Turbo Fade"};
const string spot_take_hint[] = {"Hold X"};

// display for Turbo Shots page
int isLoadingScreen = 1;
define LoadingTimer = 2000;
int LoadingTimeToRun = 0;

// Additional variables for graph
int graph_width;
int x_start;
int mid_x;
int bar_pos;
int infinite_stamina = 1;      // ON/OFF toggle
int ground_control = 70;       // % of stick strength (lower = less stamina drain)
int ground_stick_active = 1;   // must be ON
int shooting_active = 0;       // disables stamina control while shooting
int defense_boost_active = 0;  // Defense Boost: amplifies RS-Y while L2+R2 held
int auto_contest_mode = 0;     // Auto Contest: 0=OFF, 1=CONTEST, 2=LOCKDOWN
int side_step_boost_active = 0; // used by Auto Contest LOCKDOWN mode
int zen_colour = 3;             // idle LED colour index: 0=YELLOW,1=PURPLE,2=BLUE,3=GREEN,4=WHITE,5=RED,6=CYAN
const string zen_colour_names[] = {"YELLOW", "PURPLE", "BLUE", "GREEN", "WHITE", "RED", "CYAN"};
function APPLY_ZEN_COLOUR() {
if (zen_colour == 0) {
set_rgb(255, 153, 0);
} else if (zen_colour == 1) {
set_rgb(128, 0, 128);
} else if (zen_colour == 2) {
set_rgb(0, 0, 255);
} else if (zen_colour == 3) {
set_rgb(0, 255, 0);
} else if (zen_colour == 4) {
set_rgb(255, 255, 255);
} else if (zen_colour == 5) {
set_rgb(255, 0, 0);
} else if (zen_colour == 6) {
set_rgb(0, 255, 255);
}
}
// New flag for turbo fade
int is_turbo_fade = 0;
int l3_square_prev = 0, l3_square_guard = 0; // tracks L3 across the 1-frame gap before event_release(PS4_SQUARE) fires
int flick_up_shooting_active = 1;

// ===== Profile helpers =====
function save_profile() {
    profile_flick_up[active_profile]     = flick_up_shooting_active;
    profile_delay[active_profile]        = delay_duration;
    profile_reverse[active_profile]      = reverse_flick_mode;
    profile_insta_active[active_profile] = Insta_shot_active;
    profile_insta_dur[active_profile]    = Insta_shot_duration;
    profile_insta_tempo[active_profile]  = Delay_duration_Insta;
    profile_dl_active[active_profile]    = DL_Insta_shot_active;
    profile_dl_dur[active_profile]       = DL_Insta_shot_duration;
    profile_dl_tempo[active_profile]     = DL_Delay_duration_Insta;
    profile_go_to_shot[active_profile]   = go_to_shot_duration;
    profile_go_to_shot_active[active_profile] = go_to_shot_active;
    profile_spot_take[active_profile]    = spot_take_active;
    profile_fadeL_active[active_profile] = fadeL_active;
    profile_fadeL_timing[active_profile] = fadeL_timing;
    profile_fadeL_tempo[active_profile]  = fadeL_tempo;
    profile_fadeR_active[active_profile] = fadeR_active;
    profile_fadeR_timing[active_profile] = fadeR_timing;
    profile_fadeR_tempo[active_profile]  = fadeR_tempo;
}

function load_profile() {
    flick_up_shooting_active = profile_flick_up[active_profile];
    delay_duration            = profile_delay[active_profile];
    reverse_flick_mode        = profile_reverse[active_profile];
    Insta_shot_active         = profile_insta_active[active_profile];
    Insta_shot_duration       = profile_insta_dur[active_profile];
    Delay_duration_Insta      = profile_insta_tempo[active_profile];
    DL_Insta_shot_active      = profile_dl_active[active_profile];
    DL_Insta_shot_duration    = profile_dl_dur[active_profile];
    DL_Delay_duration_Insta   = profile_dl_tempo[active_profile];
    go_to_shot_duration       = profile_go_to_shot[active_profile];
    go_to_shot_active         = profile_go_to_shot_active[active_profile];
    spot_take_active          = profile_spot_take[active_profile];
    fadeL_active               = profile_fadeL_active[active_profile];
    fadeL_timing               = profile_fadeL_timing[active_profile];
    fadeL_tempo                = profile_fadeL_tempo[active_profile];
    fadeR_active                = profile_fadeR_active[active_profile];
    fadeR_timing                = profile_fadeR_timing[active_profile];
    fadeR_tempo                 = profile_fadeR_tempo[active_profile];
}

// ===== Persistent Save/Load (auto-packing spvar engine, ported from v7RC) =====
int spvar_current_bit, spvar_current_slot, spvar_current_value, spvar_tmp, spvar_bits;

function get_bit_count(val) {
    spvar_tmp = 0;
    while (val) { spvar_tmp++; val = abs(val >> 1); }
    return spvar_tmp;
}
function get_bit_count2(val1, val2) {
    spvar_tmp = max(get_bit_count(val1), get_bit_count(val2));
    if (is_signed2(val1, val2)) { spvar_tmp++; }
    return spvar_tmp;
}
function is_signed2(val1, val2) { return val1 < 0 || val2 < 0; }
function make_sign(bits) { return 1 << clamp(bits - 1, 0, 31); }
function make_full_mask(bits) {
    if (bits == 32) { return -1; }
    return 0x7FFFFFFF >> (31 - bits);
}
function make_sign_mask(bits) { return make_full_mask(bits - 1); }
function pack_i(val, bits) {
    if (val < 0) { return (abs(val) & make_sign_mask(bits)) | make_sign(bits); }
    return val & make_sign_mask(bits);
}
function unpack_i(val, bits) {
    if (val & make_sign(bits)) { return 0 - (val & make_sign_mask(bits)); }
    return val & make_sign_mask(bits);
}
function read_spvar_slot(slot) { return get_pvar(slot, 0x80000000, 0x7FFFFFFF, 0); }

function save_spvar(val, min, max) {
    spvar_bits = get_bit_count2(min, max);
    val = clamp(val, min, max);
    if (is_signed2(min, max)) { val = pack_i(val, spvar_bits); }
    val = val & make_full_mask(spvar_bits);
    if (spvar_bits >= 32 - spvar_current_bit) {
        spvar_current_value = spvar_current_value | (val << spvar_current_bit);
        set_pvar(spvar_current_slot, spvar_current_value);
        spvar_current_slot++;
        spvar_bits -= (32 - spvar_current_bit);
        val = val >> (32 - spvar_current_bit);
        spvar_current_bit = 0;
        spvar_current_value = 0;
    }
    spvar_current_value = spvar_current_value | (val << spvar_current_bit);
    spvar_current_bit += spvar_bits;
    if (!spvar_current_bit) { spvar_current_value = 0; }
    set_pvar(spvar_current_slot, spvar_current_value);
}

function read_spvar(min, max, def) {
    spvar_bits = get_bit_count2(min, max);
    spvar_current_value = (read_spvar_slot(spvar_current_slot) >> spvar_current_bit) & make_full_mask(spvar_bits);
    if (spvar_bits >= 32 - spvar_current_bit) {
        spvar_current_value = (spvar_current_value & make_full_mask(32 - spvar_current_bit)) | ((read_spvar_slot(spvar_current_slot + 1) & make_full_mask(spvar_bits - (32 - spvar_current_bit))) << (32 - spvar_current_bit));
    }
    spvar_current_bit += spvar_bits;
    spvar_current_value = spvar_current_value & make_full_mask(spvar_bits);
    if (spvar_current_bit >= 32) { spvar_current_slot++; spvar_current_bit -= 32; }
    if (is_signed2(min, max)) { spvar_current_value = unpack_i(spvar_current_value, spvar_bits); }
    if (spvar_current_value < min || spvar_current_value > max) { return def; }
    return spvar_current_value;
}

int prof_i;
function Save() {
    spvar_current_slot  = SPVAR_1;
    spvar_current_bit   = 0;
    spvar_current_value = 0;

    save_spvar(1, 0, 1);                  // save marker
    save_spvar(active_profile, 0, 4);     // active profile index

    for (prof_i = 0; prof_i < PROFILE_COUNT; prof_i++) {
        save_spvar(profile_flick_up[prof_i],     0, 1);
        save_spvar(profile_delay[prof_i],        0, 300);
        save_spvar(profile_reverse[prof_i],      0, 1);
        save_spvar(profile_insta_active[prof_i], 0, 1);
        save_spvar(profile_insta_dur[prof_i],     100, 1000);
        save_spvar(profile_insta_tempo[prof_i],   0, 300);
        save_spvar(profile_dl_active[prof_i],     0, 1);
        save_spvar(profile_dl_dur[prof_i],        100, 1000);
        save_spvar(profile_dl_tempo[prof_i],      0, 300);
        save_spvar(profile_go_to_shot[prof_i],    200, 3000);
        save_spvar(profile_go_to_shot_active[prof_i], 0, 1);
        save_spvar(profile_spot_take[prof_i],     0, 1);
        save_spvar(profile_fadeL_active[prof_i],  0, 1);
        save_spvar(profile_fadeL_timing[prof_i],  0, 9999);
        save_spvar(profile_fadeL_tempo[prof_i],   0, 300);
        save_spvar(profile_fadeR_active[prof_i],  0, 1);
        save_spvar(profile_fadeR_timing[prof_i],  0, 9999);
        save_spvar(profile_fadeR_tempo[prof_i],   0, 300);
    }

    // Global settings (not per-profile)
    save_spvar(infinite_stamina,        0, 1);
    save_spvar(ground_control,          10, 100);
    save_spvar(defense_boost_active,    0, 1);
    save_spvar(auto_contest_mode,       0, 2);
    save_spvar(side_step_boost_active,  0, 1);
    save_spvar(zen_colour,              0, 6);
}

function Load() {
    spvar_current_slot  = SPVAR_1;
    spvar_current_bit   = 0;
    spvar_current_value = 0;

    if (read_spvar(0, 1, 0) == 1) {
        active_profile = read_spvar(0, 4, 0);

        for (prof_i = 0; prof_i < PROFILE_COUNT; prof_i++) {
            profile_flick_up[prof_i]     = read_spvar(0, 1, 1);
            profile_delay[prof_i]        = read_spvar(0, 300, 50);
            profile_reverse[prof_i]      = read_spvar(0, 1, 1);
            profile_insta_active[prof_i] = read_spvar(0, 1, 1);
            profile_insta_dur[prof_i]    = read_spvar(100, 1000, 591);
            profile_insta_tempo[prof_i]  = read_spvar(0, 300, 49);
            profile_dl_active[prof_i]    = read_spvar(0, 1, 1);
            profile_dl_dur[prof_i]       = read_spvar(100, 1000, 591);
            profile_dl_tempo[prof_i]     = read_spvar(0, 300, 49);
            profile_go_to_shot[prof_i]   = read_spvar(200, 3000, 2000);
            profile_go_to_shot_active[prof_i] = read_spvar(0, 1, 1);
            profile_spot_take[prof_i]    = read_spvar(0, 1, 0);
            profile_fadeL_active[prof_i] = read_spvar(0, 1, 0);
            profile_fadeL_timing[prof_i] = read_spvar(0, 9999, 400);
            profile_fadeL_tempo[prof_i]  = read_spvar(0, 300, 50);
            profile_fadeR_active[prof_i] = read_spvar(0, 1, 0);
            profile_fadeR_timing[prof_i] = read_spvar(0, 9999, 400);
            profile_fadeR_tempo[prof_i]  = read_spvar(0, 300, 50);
        }

        // Global settings (not per-profile) — order must match Save()
        infinite_stamina       = read_spvar(0, 1, 1);
        ground_control          = read_spvar(10, 100, 70);
        defense_boost_active    = read_spvar(0, 1, 0);
        auto_contest_mode       = read_spvar(0, 2, 0);
        side_step_boost_active  = read_spvar(0, 1, 0);
        zen_colour              = read_spvar(0, 6, 3);

        load_profile(); // apply active profile's values
    } else {
        Save(); // first-time init: write defaults
    }
}

// ===== Init =====
init {
    active_profile = 0;
    for (prof_i = 0; prof_i < PROFILE_COUNT; prof_i++) {
        profile_flick_up[prof_i]     = 1;
        profile_delay[prof_i]        = 50;
        profile_reverse[prof_i]      = 1;
        profile_insta_active[prof_i] = 1;
        profile_insta_dur[prof_i]    = 591;
        profile_insta_tempo[prof_i]  = 49;
        profile_dl_active[prof_i]    = 1;
        profile_dl_dur[prof_i]       = 591;
        profile_dl_tempo[prof_i]     = 49;
        profile_go_to_shot[prof_i]   = 2000;
        profile_go_to_shot_active[prof_i] = 1;
        profile_spot_take[prof_i]    = 0;
        profile_fadeL_active[prof_i] = 0;
        profile_fadeL_timing[prof_i] = 400;
        profile_fadeL_tempo[prof_i]  = 50;
        profile_fadeR_active[prof_i] = 0;
        profile_fadeR_timing[prof_i] = 400;
        profile_fadeR_tempo[prof_i]  = 50;
    }

    Load(); // pulls saved profiles from flash, or writes defaults on first run

    saver_on = 0;
    saver_timer = 0;
    cls_oled(OLED_BLACK);
    APPLY_ZEN_COLOUR();
}

// ===== Main =====
main {
// Console detect
if (get_console() == PIO_XB1) {
isXbox = 1;
} else {
isXbox = 0;
}

// ===== STARTUP / LOADING =====

LoadingTimeToRun += get_rtime();
if (LoadingTimeToRun >= LoadingTimer) {
cls_oled(OLED_BLACK);
isLoadingScreen = 0;
startup = 0;
saver_on = 1;
saver_timer = 80; // draw a saver frame soon
}
combo_run(Infinite_Stamina_Control);

if (get_val(PS4_SQUARE) || get_val(PS4_L3)
    || combo_running(Insta_shot_smooth)
    || combo_running(Insta_shot_reversed)
    || combo_running(DL_Insta_shot_smooth)
    || combo_running(DL_Insta_shot_reversed)) {
    shooting_active = 1;
} else if (!combo_running(flick_up_rs_smooth)
        && !combo_running(flick_up_rs_reversed)
        && !combo_running(Insta_shot_smooth)
        && !combo_running(Insta_shot_reversed)
        && !combo_running(DL_Insta_shot_smooth)
        && !combo_running(DL_Insta_shot_reversed)
        && !combo_running(shot_fade_L)
        && !combo_running(shot_fade_R)
        && !combo_running(go_to_shot_insta)
        && !combo_running(spot_take_combo)) {
    shooting_active = 0;
}

// ===== Menu open/close =====
if (event_press(PS4_CIRCLE) && menu_enabled) { // CLOSE MENU
menu_enabled = 0;
save_profile(); // commit live values into active profile slot
Save(); // persist all 5 profiles to flash
combo_run(vibration_off);
APPLY_ZEN_COLOUR();
saver_on = 1; // enable saver when leaving menu
} else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) { // OPEN MENU
menu_enabled = 1;
page = 1;
combo_run(vibration_on);
set_rgb(0,0,255);
saver_on = 0; // pause saver while menu is up
}

// ===== MENU RENDER & INPUT =====
if (menu_enabled) {
cls_oled(OLED_BLACK);
rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE);
line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);
print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageChg[pageChg_s]);
print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

// pages with numeric edit: 2,5,6,8,9,10
if (page == 3) { // Turbo Shots page shows reverse_modes
print(center_x(get_string_length(reverse_modes[reverse_flick_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, reverse_modes[reverse_flick_mode]);
} else if (page == 12) { // Spot Take page shows ON/OFF, plus Hold X hint when active
if (spot_take_active) {
print(center_x(get_string_length(spot_take_hint[0]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, spot_take_hint[0]);
} else {
print(center_x(get_string_length(onOff[0]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[0]);
}
} else if (page == 19) { // Profile Select page shows profile name
print(center_x(get_string_length(profile_labels[active_profile]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, profile_labels[active_profile]);
} else if (page == 23) { // Auto Contest page shows OFF/CONTEST/LOCKDOWN
print(center_x(get_string_length(auto_contest_label[auto_contest_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, auto_contest_label[auto_contest_mode]);
} else if (page == 25) { // Zen Colour page shows colour name
print(center_x(get_string_length(zen_colour_names[zen_colour]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, zen_colour_names[zen_colour]);
} else if (page != 2 && page != 5 && page != 6 && page != 8 && page != 9 && page != 11 && page != 14 && page != 15 && page != 17 && page != 18 && page != 21) { // other non-numeric pages show ON/OFF
print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
}
print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_toggle[toggleType]);

if (page == 1) {
pageChg_s = 0;
} else if (page == numpgs) {
pageChg_s = 2;
} else {
pageChg_s = 1;
}
if (page > numpgs) {
page = numpgs;
}
if (page < 1) {
page = 1;
}
if (get_val(PS4_L2)) {
set_val(PS4_UP,0);
set_val(PS4_DOWN,0);
set_val(PS4_LEFT,0);
set_val(PS4_RIGHT,0);
}
if (get_val(PS4_L2) && event_press(PS4_LEFT)) {
page--;
combo_run(vibration_valchg);
}
if (get_val(PS4_L2) && event_press(PS4_RIGHT)) {
page++;
combo_run(vibration_valchg);
}

// Page 1: Square Tempo (Auto Green toggle)
if (page == 1) {
menuSelection = flick_up_shooting_active;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
flick_up_shooting_active = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
flick_up_shooting_active = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

// Page 2: Tempo Speed (ms) -> delay_duration
if (page == 2) {
menuSelection = 2;
toggleType = 0;
NumberToString(delay_duration, FindDigits(delay_duration));
draw_x_graph(delay_duration, 0, 300, 45);
if (get_val(PS4_L2)) {
if (event_press(PS4_UP)) {
delay_duration++;
}
if (event_press(PS4_DOWN)) {
delay_duration--;
}
if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
combo_run(vibration_valchg);
combo_run(flashedit);
}
}
if (delay_duration > 300) {
delay_duration = 300;
}
if (delay_duration < 0) {
delay_duration = 0;
}
}

// Page 3: Turbo Shots (reverse_flick_mode ON/OFF)
if (page == 3) {
menuSelection = reverse_flick_mode;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
reverse_flick_mode = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
reverse_flick_mode = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

// Page 4: Insta Shot (R3)
if (page == 4) {
menuSelection = Insta_shot_active;
toggleType = 0;
if (get_val(PS4_L2) && event_press(PS4_UP)) {
Insta_shot_active = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
Insta_shot_active = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

