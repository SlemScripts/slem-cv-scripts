} // end menu_enabled

// ===== Gameplay logic (no menu) =====
if (!menu_enabled) {
// idle visuals
APPLY_ZEN_COLOUR();

// run saver every ~80ms only when outside the menu
if (saver_on) {
saver_timer += get_rtime();
if (saver_timer >= 80) {
saver_step();
saver_timer = 0;
}
}

// L3 hardcoded as Square remap
if (get_val(PS4_L3)) {
set_val(PS4_SQUARE, 100);
}
// l3_square_guard covers this frame AND the next, since event_release(PS4_SQUARE)
// fires one frame after L3 actually releases -- checking get_val(PS4_L3) alone
// at that point would already read 0 and fail to suppress it
l3_square_guard = get_val(PS4_L3) || l3_square_prev;
l3_square_prev = get_val(PS4_L3);

// Detect press of Square for flag (only for the physical Square button, not the L3 remap)
if (event_press(PS4_SQUARE) && !l3_square_guard) {
if (reverse_flick_mode && get_val(PS4_R2)) {
is_turbo_fade = 1;
} else {
is_turbo_fade = 0;
}
}

// Auto Green (flick-up) logic — skips Square presses that came from the L3 remap,
// so L3 passes through as a real Square press instead of being converted to a flick shot
if (flick_up_shooting_active) {
if (!l3_square_guard && get_val(PS4_SQUARE)) {
set_val(PS4_SQUARE, 0);
if (is_turbo_fade) {
set_val(PS4_RY, STICK_UP_VALUE);
} else {
set_val(PS4_RY, STICK_DOWN_VALUE);
}
set_val(PS4_RX, 0);
}
if (!l3_square_guard && event_release(PS4_SQUARE)) {
if (is_turbo_fade) {
combo_run(flick_up_rs_reversed);
} else {
combo_run(flick_up_rs_smooth);
}
is_turbo_fade = 0;
}
}
// D-PAD DOWN → Go To Shot Insta (priority)
if (go_to_shot_active && event_press(PS4_DOWN)) {
    combo_run(go_to_shot_insta);
}

// Insta Shot Logic (R3 — L3 is fully consumed by the Square remap above)
// Fade L/R (ported from APEX): same R3/L3 trigger, but if R2 is held and
// the left stick is leaned past FADE_LAT, fire the directional fade combo
// instead. Fade runs off its own toggle, independent of Insta_shot_active —
// only the plain Insta Shot fallback below still respects that toggle.
if (event_press(PS4_R3)) {
if (!combo_running(shot_fade_L) && !combo_running(shot_fade_R) &&
get_val(PS4_R2) > 20 && (fadeL_active || fadeR_active) && abs(get_val(PS4_LX)) >= FADE_LAT) {
if (get_val(PS4_LX) < 0 && fadeL_active) {
combo_run(shot_fade_L);
} else if (get_val(PS4_LX) > 0 && fadeR_active) {
combo_run(shot_fade_R);
} else if (Insta_shot_active) {
if (reverse_flick_mode && get_val(PS4_R2)) {
combo_run(Insta_shot_reversed);
} else {
combo_run(Insta_shot_smooth);
}
}
} else if (Insta_shot_active) {
if (reverse_flick_mode && get_val(PS4_R2)) {
combo_run(Insta_shot_reversed);
} else {
combo_run(Insta_shot_smooth);
}
}
}

// Auto No Dip Logic (D-Pad Left) — separate speed/tempo
if (DL_Insta_shot_active) {
if (event_press(PS4_LEFT)) {
if (reverse_flick_mode && get_val(PS4_R2)) {
combo_run(DL_Insta_shot_reversed);
} else {
combo_run(DL_Insta_shot_smooth);
}
}
}

// Spot Take (spams Cross/A at 19ms while held)
if (spot_take_active) {
if (get_val(PS4_CROSS)) {
combo_run(spot_take_combo);
}
}

// Defense Boost: amplify RS-Y push while L2+R2 are both held
if (defense_boost_active) {
if (get_val(PS4_L2) > 20 && get_val(PS4_R2) > 20) {
set_val(PS4_RY, (get_val(PS4_RY) * 13) / 10);
}
}

// Auto Contest: only active in a defensive stance (L2 held)
if (auto_contest_mode && get_val(PS4_L2)) {
if (auto_contest_mode == 1) {
// CONTEST: hold R2 to raise hands
if (get_val(PS4_R2)) {
set_val(PS4_TRIANGLE, 100);
}
}
if (auto_contest_mode == 2) {
// LOCKDOWN: same auto-contest, plus optional side-step snap
if (get_val(PS4_R2)) {
set_val(PS4_TRIANGLE, 100);
if (side_step_boost_active) {
if (get_val(PS4_LX) > 20) {
set_val(PS4_LX, 100);
}
if (get_val(PS4_LX) < -20) {
set_val(PS4_LX, -100);
}
}
}
}
}
} // end !menu_enabled
} // end big else (post-startup)


// ===== OLED helpers =====


function saver_step() {
cls_oled(OLED_BLACK);
print(sx, sy, OLED_FONT_SMALL, OLED_WHITE, saver_line1[0]);

msg_w = (get_string_length(saver_line1[0]) - 1) * OLED_FONT_SMALL_WIDTH;

sx += svx;
sy += svy;

if (sx <= 1 || sx >= (OLED_WIDTH - msg_w - 1)) {
svx = -svx;
}
if (sy <= 1 || sy >= (OLED_HEIGHT - 14 - 1)) {
svy = -svy;
}
}
// New function for mapping values
function map(val, in_min, in_max, out_min, out_max) {
return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

// New function to draw X-axis graph
function draw_x_graph(value, min_val, max_val, y_pos) {
graph_width = 100;
x_start = (OLED_WIDTH - graph_width) / 2;
mid_x = x_start + graph_width / 2;
bar_pos = map(value, min_val, max_val, 0, graph_width);

// Draw axis line
line_oled(x_start, y_pos, x_start + graph_width, y_pos, 1, OLED_WHITE);

// Draw center tick
line_oled(mid_x, y_pos - 3, mid_x, y_pos + 3, 1, OLED_WHITE);

// Draw left tick
line_oled(x_start, y_pos - 2, x_start, y_pos + 2, 1, OLED_WHITE);

// Draw right tick
line_oled(x_start + graph_width, y_pos - 2, x_start + graph_width, y_pos + 2, 1, OLED_WHITE);

// Draw bar from start to position
rect_oled(x_start, y_pos - 2, bar_pos, 4, 1, OLED_WHITE);
}

// ===== Combos =====
combo flick_up_rs_smooth {
set_val(PS4_RY, -50);
set_val(PS4_RX, 20);
wait(delay_duration);
set_val(PS4_RY, -100);
set_val(PS4_RX, 25);
wait(301);
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}

combo flick_up_rs_reversed {
set_val(PS4_RY, 50);
set_val(PS4_RX, -20);
wait(delay_duration);
set_val(PS4_RY, 100);
set_val(PS4_RX, -25);
wait(301);
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}
combo Infinite_Stamina_Control {
    if (infinite_stamina
        && ground_stick_active
        && !shooting_active
        && !get_val(PS4_SQUARE)
        && !get_val(PS4_L3)
        && !get_val(PS4_R3)
        && !combo_running(Insta_shot_smooth)
        && !combo_running(Insta_shot_reversed)
        && !combo_running(flick_up_rs_smooth)
        && !combo_running(flick_up_rs_reversed)
        && !combo_running(DL_Insta_shot_smooth)
        && !combo_running(DL_Insta_shot_reversed)
        && !combo_running(shot_fade_L)
        && !combo_running(shot_fade_R)
        && !combo_running(go_to_shot_insta)
        && !combo_running(spot_take_combo)
    ) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        } else {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}
combo Insta_shot_smooth {

// Initial pull
set_val(PS4_RY, STICK_DOWN_VALUE);
set_val(PS4_RX, 0);
wait(Insta_shot_duration);

// Gather / settle
set_val(PS4_RY, -55);
set_val(PS4_RX, 18);
wait(Delay_duration_Insta);

// FINAL SNAP – NO RANDOMNESS
set_val(PS4_RY, -100);
set_val(PS4_RX, 25);
wait(260);

// Release
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}
combo go_to_shot_insta {

    set_val(PS4_RY, STICK_UP_VALUE);
    set_val(PS4_RX, 0);
    wait(go_to_shot_duration);

    set_val(PS4_RY, 55);
    set_val(PS4_RX, -18);
    wait(Delay_duration_Insta);

    set_val(PS4_RY, 100);
    set_val(PS4_RX, -25);
    wait(260);

    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}


combo Insta_shot_reversed {

    // Initial pull
    set_val(PS4_RY, STICK_UP_VALUE);
    set_val(PS4_RX, 0);
    wait(871);

    // Gather
    set_val(PS4_RY, 55);
    set_val(PS4_RX, -18);
    wait(Delay_duration_Insta);

    // FINAL SNAP
    set_val(PS4_RY, 100);
    set_val(PS4_RX, -25);
    wait(500);

    // Release
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

// ===== Fade L/R combos (ported from APEX_V2's shot_fade) =====
// Reverse-flick fade shape: UP flick charges the turbo fade (Timing), glide
// rhythm (Tempo), then a fixed-length DOWN release with no RNG at all —
// matches Sonder's deterministic combo style (see Insta_shot_smooth above).
combo shot_fade_L {
set_val(PS4_RY, STICK_UP_VALUE);
set_val(PS4_RX, -8);
wait(fadeL_timing);

set_val(PS4_RY, 50);
set_val(PS4_RX, -22);
wait(fadeL_tempo);

set_val(PS4_RY, STICK_DOWN_VALUE);
set_val(PS4_RX, -22);
wait(300);

set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}

combo shot_fade_R {
set_val(PS4_RY, STICK_UP_VALUE);
set_val(PS4_RX, 8);
wait(fadeR_timing);

set_val(PS4_RY, 50);
set_val(PS4_RX, 22);
wait(fadeR_tempo);

set_val(PS4_RY, STICK_DOWN_VALUE);
set_val(PS4_RX, 22);
wait(300);

set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}

// ===== Auto No Dip combos (D-Pad Left, separate speed/tempo) =====
combo DL_Insta_shot_smooth {

// Initial pull
set_val(PS4_RY, STICK_DOWN_VALUE);
set_val(PS4_RX, 0);
wait(DL_Insta_shot_duration);

// Gather / settle
set_val(PS4_RY, -55);
set_val(PS4_RX, 18);
wait(DL_Delay_duration_Insta);

// FINAL SNAP – NO RANDOMNESS
set_val(PS4_RY, -100);
set_val(PS4_RX, 25);
wait(260);

// Release
set_val(PS4_RY, 0);
set_val(PS4_RX, 0);
}

combo DL_Insta_shot_reversed {

    // Initial pull
    set_val(PS4_RY, STICK_UP_VALUE);
    set_val(PS4_RX, 0);
    wait(871);

    // Gather
    set_val(PS4_RY, 55);
    set_val(PS4_RX, -18);
    wait(DL_Delay_duration_Insta);

    // FINAL SNAP
    set_val(PS4_RY, 100);
    set_val(PS4_RX, -25);
    wait(500);

    // Release
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

// ===== Spot Take (from MDM script, retimed to 19ms) =====
combo spot_take_combo {
set_val(PS4_CROSS, 100);
wait(18);
set_val(PS4_CROSS, 0);
wait(18);
set_val(PS4_CROSS, 100);
wait(18);
set_val(PS4_CROSS, 0);
wait(18);
set_val(PS4_CROSS, 100);
wait(18);
set_val(PS4_CROSS, 0);
}

// ===== UI effects =====
combo flashtog {
if (!flashtoggle) {
set_rgb(255, 0, 0);
} else {
set_rgb(0, 255, 0);
}
wait(1000);
set_rgb(0, 0, 255);
}

combo flashedit {
set_rgb(0, 0, 0);
wait(150);
set_rgb(0, 0, 255);
}

combo vibration_on {
set_rumble(RUMBLE_A, 100);
wait(200);
set_rumble(RUMBLE_A, 0);
}

combo vibration_off {
set_rumble(RUMBLE_A, 50);
wait(200);
set_rumble(RUMBLE_A, 0);
}

combo vibration_valchg {
set_rumble(RUMBLE_A, 50);
wait(50);
set_rumble(RUMBLE_A, 0);
}

// ===== Small helpers =====
function center_x(f_chars, f_font) {
return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

int bufferIndex, digitIndex, charIndex;
function NumberToString(f_val, f_digits) {
bufferIndex = 1;
digitIndex = 10000;
if (f_val < 0) {
putc_oled(bufferIndex, 45);
bufferIndex += 1;
f_val = abs(f_val);
}
for (charIndex = 5; charIndex >= 1; charIndex--) {
if (f_digits >= charIndex) {
putc_oled(bufferIndex, (f_val / digitIndex) + 48);
f_val %= digitIndex;
bufferIndex++;
if (charIndex == 4) {
putc_oled(bufferIndex, 44);
bufferIndex++;
}
}
digitIndex /= 10;
}
putc_oled(bufferIndex, 109); // 'm'
bufferIndex++;
putc_oled(bufferIndex, 115); // 's'
bufferIndex++;
puts_oled(center_x(bufferIndex + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_WHITE);
}

function NumberToStringPct(f_val, f_digits) {
bufferIndex = 1;
digitIndex = 10000;
if (f_val < 0) {
putc_oled(bufferIndex, 45);
bufferIndex += 1;
f_val = abs(f_val);
}
for (charIndex = 5; charIndex >= 1; charIndex--) {
if (f_digits >= charIndex) {
putc_oled(bufferIndex, (f_val / digitIndex) + 48);
f_val %= digitIndex;
bufferIndex++;
if (charIndex == 4) {
putc_oled(bufferIndex, 44);
bufferIndex++;
}
}
digitIndex /= 10;
}
putc_oled(bufferIndex, 37); // '%'
bufferIndex++;
puts_oled(center_x(bufferIndex + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_WHITE);
}

int logVal;
function FindDigits(num) {
logVal = 0;
do {
num /= 10;
logVal++;
} while (num);
return logVal;
}

int stringLength;
function get_string_length(offset) {
stringLength = 0;
while (duint8(offset++)) {
stringLength++;
}
return stringLength + 1;
}
