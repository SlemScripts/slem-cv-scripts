save_profile(); // stash current live settings into current slot
active_profile++;
if (active_profile > 4) {
active_profile = 0;
}
load_profile(); // pull in new slot's settings
combo_run(vibration_valchg);
combo_run(flashedit);
}
if (event_press(PS4_DOWN)) {
save_profile();
active_profile--;
if (active_profile < 0) {
active_profile = 4;
}
load_profile();
combo_run(vibration_valchg);
combo_run(flashedit);
}
}
