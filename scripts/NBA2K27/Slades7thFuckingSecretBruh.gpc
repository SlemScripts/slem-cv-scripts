// ============================================================
// SLADE's SECRET
// CODED BY SLADE
//
// Are you prepared to discover Slade's Secret?
// ============================================================

int star_x[30];
int star_y[30];
int star_speed[30];
int star_brightness[30];
int stars_initialized = 0;
int star_i = 0;
int flick_up_shooting_active = 1;
int flick_sequences_enabled = 0;
int delay_duration = 40;
int Delay_duration_Insta = 40;
int STICK_DOWN_VALUE = 100;
int STICK_UP_VALUE = -100;
int RX_UP_VALUE = 25;
int random_variation_min = -3;
int random_variation_max = 3;
int random_hold_variation_min = -1;
int random_hold_variation_max = 1;

int reverse_flick_mode = 1;
int rs_shooting_active = 0;
int rs_hold_duration = 300;

int Insta_shot_active = 1;
int Insta_shot_duration = 650;

int isHolding = 0;
int holdTimer = 0;
int rs_is_up = 0;
int remap_square_active = 0;

int zen_light_color = 0;
int rainbow_timer = 0;
int rainbow_phase = 0;

int dunk_mode = 0;
int dunk_active = 0;
int spot_take_active = 0;

define MAX_SAMPLES = 300;
define SAMPLE_INTERVAL = 10;
int macro_data[300];
int rec_start_hold_timer = 0;
int reset_combo_hold_timer = 0;
int reset_down_tap_count = 0;
int reset_down_tap_timer = 0;
int macro_length = 0;
int record_mode = 0;
int playback_mode = 0;
int macro_timer = 0;
int macro_index = 0;
const string rec_ready_str[]   = { "RECORD READY" };
const string rec_wait_str[]    = { "WAITING INPUT" };
const string recording_str[]   = { "RECORDING" };
const string playing_str[]     = { "PLAYING" };
int reset_display_timer = 0;
const string reset_success_str[]   = { "SUCCESSFULLY RESET" };
const string hold_rec_str[]    = { "L1+R1+TRI" };
const string hold_rec_sub[]    = { "TO RECORD" };
const string hold_reset_str[]  = { "L1+R1+DOWN" };
const string hold_reset_sub[]  = { "2x DOWN" };
int any_input = 0;
int macro_mask = 0;
int macro_clx = 0;
int macro_cly = 0;
int macro_crx = 0;
int macro_cry = 0;
int compress_temp = 0;
int decompress_val = 0;
int macro_trigger_btn = 0;
int macro_pressed = 0;
int physical_square = 0;
int post_release_timer = 0;
int macro_shoot_duration = 0;
int macro_shoot_reversed = 0;
int playback_shooting_active = 0;
int playback_shoot_timer = 0;
int playback_shoot_duration = 0;
int playback_reversed = 0;

int infinite_stamina = 0;
int flip_l2_active = 0;
int tmp_l1 = 0;
int tmp_l2 = 0;
int ground_control = 70;
int ground_stick_active = 1;
int square_shooting_in_progress = 0;
int rs_shooting_in_progress = 0;

int frame_time;

int saver_on = 0;
int sx = 10, sy = 8;
int svx = 2, svy = 1;
int msg_w, line1_w, line2_w;
int saver_timer = 0;
const string saver_line1[] = { "L2 + OPTIONS" };
const string saver_line2[] = { "CHANGE SETTINGS" };
const string saver_line3[] = { "L1+R1+TRI" };
const string saver_line4[] = { "START MACRO" };

const string load_l1[] = { "SLADE'S" };
const string load_l2[] = { "SECRET" };
const string load_l3[] = { "CODED BY SLADE" };
const string load_l4[] = { "Are you prepared?" };

int startup = 1, numpgs = 11, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;

// Animation Variables
int anim_active = 0;
int anim_frame = 0;
int anim_timer = 0;
int hx = 115;
int hy = 30;
int px = 20;
int py = 55;

const string menu_header[] = {
    "Tempo AI",
    "Tempo Speed (ms)",
    "RS Shooting",
    "Remap Square",
    "Zen Light",
    "Dunk Mode",
    "Spot Take",
    "Infinite Stamina",
    "ESCAPE",
    "MACRO",
    "FLIP L2"
};

const string pageChg[]    = { "---------L2+RIGHT->", "<-L2+LEFT--L2+RIGHT->", "<-L2+LEFT---------" };
const string item_toggle[] = { "L2 + UP/DOWN", "to change" };
const string onOff[]      = { "OFF", "ON", "", "L3", "R3", "Touchpad" };
const string ms[]         = { "ms" };

const string zen_light_colors[] = { "Blue", "Purple", "White", "Red", "Green", "Yellow", "Rainbow" };
const string dunk_modes[]       = { "Circle Hold", "L1 Hold", "RS Down" };

const string macro_btn_modes[]  = { "L1", "R1", "Left Dpad", "Right Dpad", "Up Dpad", "Down Dpad", "L1+R1", "Touchpad" };

int isLoadingScreen = 1;
define LoadingTimer = 2000;
int LoadingTimeToRun = 0;
int blink_timer = 0;
int blink_state = 1;
define BLINK_INTERVAL = 120;

int graph_width;
int x_start;
int mid_x;
int bar_pos;

init {
    if (get_pvar(SPVAR_10, 0, 32767, 0) != 8474) {
        set_pvar(SPVAR_1, 1);
        set_pvar(SPVAR_2, 40);
        set_pvar(SPVAR_4, 0);
        set_pvar(SPVAR_5, 0);
        set_pvar(SPVAR_6, 0);
        set_pvar(SPVAR_7, 0);
        set_pvar(SPVAR_8, 2);
        set_pvar(SPVAR_9, 0);
        set_pvar(SPVAR_10, 8474);
        set_pvar(SPVAR_13, 0);
    }
    flick_up_shooting_active = get_pvar(SPVAR_1, 0, 1, 1);
    delay_duration = get_pvar(SPVAR_2, 0, 300, 40);
    rs_shooting_active = get_pvar(SPVAR_4, 0, 1, 0);
    remap_square_active = get_pvar(SPVAR_5, 0, 2, 0);
    infinite_stamina = get_pvar(SPVAR_6, 0, 1, 0);
    zen_light_color = get_pvar(SPVAR_7, 0, 6, 0);
    dunk_mode = get_pvar(SPVAR_8, 0, 2, 2);
    spot_take_active = get_pvar(SPVAR_9, 0, 1, 0);
    flick_sequences_enabled = get_pvar(SPVAR_11, 0, 1, 0);
    macro_trigger_btn = get_pvar(SPVAR_13, 0, 7, 0);
    Insta_shot_active = 1;
    Insta_shot_duration = 650;
    dunk_active = 0;
    ground_control = 70;
    ground_stick_active = 1;
    square_shooting_in_progress = 0;
    rs_shooting_in_progress = 0;
    rainbow_timer = 0;
    rainbow_phase = 0;
    saver_on = 0;
    saver_timer = 0;
    draw_picture(0, 0);
}

main {
    physical_square = get_val(PS4_SQUARE);
    if (get_console() == PIO_XB1) { isXbox = 1; } else { isXbox = 0; }

    if (startup && isLoadingScreen) {
        LoadingTimeToRun += get_rtime();
        blink_timer += get_rtime();
        if (blink_timer >= BLINK_INTERVAL) {
            blink_timer = 0;
            blink_state = !blink_state;
            if (blink_state) {
                draw_picture(0, 0);
            } else {
                cls_oled(OLED_BLACK);
            }
        }
        if (LoadingTimeToRun >= LoadingTimer) {
            cls_oled(OLED_BLACK);
            isLoadingScreen = 0;
            startup = 0;
            saver_on = 1;
            saver_timer = 80;
        }
    } else {
        combo_run(Movement_Control);
        frame_time = get_rtime();

        if (get_val(PS4_L1) && get_val(PS4_R1) && get_val(PS4_TRIANGLE)
            && record_mode == 0 && playback_mode == 0
            && !menu_enabled) {
            rec_start_hold_timer += frame_time;
            set_val(PS4_L1, 0);
            set_val(PS4_R1, 0);
            set_val(PS4_TRIANGLE, 0);
            if (rec_start_hold_timer >= 3000) {
                record_mode = 1;
                macro_length = 0;
                macro_index = 0;
                macro_timer = 0;
                macro_shoot_duration = 0;
                macro_shoot_reversed = 0;
                playback_mode = 0;
                rec_start_hold_timer = 0;
                combo_run(vibration_valchg);
            }
        } else {
            if (record_mode == 0 && playback_mode == 0) {
                rec_start_hold_timer = 0;
            }
        }

        if (get_val(PS4_L1) && get_val(PS4_R1) && get_val(PS4_TRIANGLE)
            && !menu_enabled
            && record_mode == 0 && playback_mode == 0) {
            set_val(PS4_L1, 0);
            set_val(PS4_R1, 0);
            set_val(PS4_TRIANGLE, 0);
        }

        if (get_val(PS4_L1) && get_val(PS4_R1) && !menu_enabled
            && (record_mode > 0 || playback_mode > 0)) {
            set_val(PS4_L1, 0);
            set_val(PS4_R1, 0);
        }

        if (get_val(PS4_L1) && get_val(PS4_R1)
            && record_mode == 0 && playback_mode == 0
            && !menu_enabled
            && reset_display_timer <= 0) {
            if (event_press(PS4_DOWN)) {
                reset_down_tap_count++;
                reset_down_tap_timer = 0;
                set_val(PS4_DOWN, 0);
            }
            if (reset_down_tap_count > 0) {
                reset_down_tap_timer += frame_time;
                set_val(PS4_L1, 0);
                set_val(PS4_R1, 0);
                if (reset_down_tap_timer > 1000) {
                    reset_down_tap_count = 0;
                    reset_down_tap_timer = 0;
                }
                if (reset_down_tap_count >= 2) {
                    macro_length = 0;
                    macro_index = 0;
                    macro_timer = 0;
                    macro_shoot_duration = 0;
                    macro_shoot_reversed = 0;
                    playback_shooting_active = 0;
                    playback_shoot_timer = 0;
                    playback_shoot_duration = 0;
                    playback_reversed = 0;
                    playback_mode = 0;
                    reset_down_tap_count = 0;
                    reset_down_tap_timer = 0;
                    reset_display_timer = 2000;
                    combo_run(vibration_valchg);
                }
            }
        } else {
            reset_combo_hold_timer = 0;
        }

        if (reset_display_timer > 0) {
            set_val(PS4_TOUCH, 0);
        }

        if (record_mode == 1) {
            if (!get_val(PS4_L1) && !get_val(PS4_R1)) {
                record_mode = 3;
            }
        }

        if (record_mode == 3) {
            if (physical_square > 50) {
                record_mode = 2;
                macro_index = 0;
                macro_timer = SAMPLE_INTERVAL;
            }
        }

        if (record_mode == 2) {
            macro_shoot_duration += frame_time;
            if (get_val(PS4_R2)) {
                macro_shoot_reversed = 1;
            }
            if (physical_square <= 50) {
                record_mode = 4;
                post_release_timer = 0;
            }
        }

        if (record_mode == 4) {
            post_release_timer += frame_time;
            if (post_release_timer >= 450) {
                macro_length = macro_index;
                record_mode = 0;
                combo_run(vibration_off);
            }
        }

        macro_pressed = 0;
        if (macro_trigger_btn == 0) {
            if (get_val(PS4_L1)) macro_pressed = 1;
        } else if (macro_trigger_btn == 1) {
            if (get_val(PS4_R1)) macro_pressed = 1;
        } else if (macro_trigger_btn == 2) {
            if (get_val(PS4_LEFT)) macro_pressed = 1;
        } else if (macro_trigger_btn == 3) {
            if (get_val(PS4_RIGHT)) macro_pressed = 1;
        } else if (macro_trigger_btn == 4) {
            if (get_val(PS4_UP)) macro_pressed = 1;
        } else if (macro_trigger_btn == 5) {
            if (get_val(PS4_DOWN) && !(get_val(PS4_L1) && get_val(PS4_R1))) macro_pressed = 1;
        } else if (macro_trigger_btn == 6) {
            if (get_val(PS4_L1) && get_val(PS4_R1) && !get_val(PS4_CROSS) && !get_val(PS4_DOWN)) macro_pressed = 1;
        } else if (macro_trigger_btn == 7) {
            if (get_val(PS4_TOUCH)) macro_pressed = 1;
        }

        if (rec_start_hold_timer > 0) macro_pressed = 0;
        if (reset_combo_hold_timer > 0) macro_pressed = 0;

        if (!menu_enabled && record_mode == 0) {
            if (macro_pressed) {
                if (macro_length > 0 && playback_mode == 0) {
                    playback_mode = 1;
                    macro_index = 0;
                    macro_timer = 0;
                    if (macro_shoot_duration > 0) {
                        playback_shooting_active = 1;
                        playback_shoot_timer = 0;
                        playback_shoot_duration = macro_shoot_duration;
                        playback_reversed = macro_shoot_reversed;
                    } else {
                        playback_shooting_active = 0;
                    }
                }
            }
        }

        if (playback_mode == 1 || (macro_pressed && macro_length > 0)) {
            if (macro_trigger_btn == 0)      set_val(PS4_L1, 0);
            else if (macro_trigger_btn == 1) set_val(PS4_R1, 0);
            else if (macro_trigger_btn == 2) set_val(PS4_LEFT, 0);
            else if (macro_trigger_btn == 3) set_val(PS4_RIGHT, 0);
            else if (macro_trigger_btn == 4) set_val(PS4_UP, 0);
            else if (macro_trigger_btn == 5) set_val(PS4_DOWN, 0);
            else if (macro_trigger_btn == 6) { set_val(PS4_L1, 0); set_val(PS4_R1, 0); }
            else if (macro_trigger_btn == 7) set_val(PS4_TOUCH, 0);
        }

        if (playback_mode == 1) {
            macro_timer += frame_time;
            if (macro_timer >= SAMPLE_INTERVAL) {
                macro_timer = 0;
                macro_index++;
                if (macro_index >= macro_length) {
                    playback_mode = 0;
                }
            }

            if (playback_mode == 1) {
                macro_mask = macro_data[macro_index];

                if (macro_mask & 1)    set_val(PS4_SQUARE, 100);
                if (macro_mask & 2)    set_val(PS4_TRIANGLE, 100);
                if (macro_mask & 4)    set_val(PS4_CIRCLE, 100);
                if (macro_mask & 8)    set_val(PS4_CROSS, 100);
                if (macro_mask & 16)   set_val(PS4_L1, 100);
                if (macro_mask & 32)   set_val(PS4_R1, 100);
                if (macro_mask & 64)   set_val(PS4_L2, 100);
                if (macro_mask & 128)  set_val(PS4_R2, 100);
                if (macro_mask & 256)  set_val(PS4_UP, 100);
                if (macro_mask & 512)  set_val(PS4_DOWN, 100);
                if (macro_mask & 1024) set_val(PS4_LEFT, 100);
                if (macro_mask & 2048) set_val(PS4_RIGHT, 100);

                macro_clx = (macro_mask >> 12) & 31;
                macro_cly = (macro_mask >> 17) & 31;
                macro_crx = (macro_mask >> 22) & 31;
                macro_cry = (macro_mask >> 27) & 31;

                macro_clx = decompress_axis(macro_clx);
                macro_cly = decompress_axis(macro_cly);
                macro_crx = decompress_axis(macro_crx);
                macro_cry = decompress_axis(macro_cry);

                if (macro_clx != 0) set_val(PS4_LX, macro_clx);
                if (macro_cly != 0) set_val(PS4_LY, macro_cly);
                if (!combo_running(flick_up_rs_smooth) && !combo_running(flick_up_rs_reversed)) {
                    if (macro_crx != 0) set_val(PS4_RX, macro_crx);
                    if (macro_cry != 0) set_val(PS4_RY, macro_cry);
                }
            }
        }

        if (playback_shooting_active) {
            playback_shoot_timer += get_rtime();
            if (playback_shoot_timer < playback_shoot_duration) {
                set_val(PS4_SQUARE, 0);
                if (playback_reversed) {
                    set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                } else {
                    set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                }
                set_val(PS4_RX, random(random_variation_min, random_variation_max));
            } else {
                playback_shooting_active = 0;
                if (playback_reversed) {
                    combo_run(flick_up_rs_reversed);
                } else {
                    combo_run(flick_up_rs_smooth);
                }
            }
        }

        if (event_press(PS4_CIRCLE) && menu_enabled) {
            set_pvar(SPVAR_1, flick_up_shooting_active);
            set_pvar(SPVAR_2, delay_duration);
            set_pvar(SPVAR_4, rs_shooting_active);
            set_pvar(SPVAR_5, remap_square_active);
            set_pvar(SPVAR_6, infinite_stamina);
            set_pvar(SPVAR_7, zen_light_color);
            set_pvar(SPVAR_8, dunk_mode);
            set_pvar(SPVAR_9, spot_take_active);
            set_pvar(SPVAR_11, flick_sequences_enabled);
            set_pvar(SPVAR_13, macro_trigger_btn);
            menu_enabled = 0;
            combo_run(vibration_off);
            
            // Trigger custom shooting animation
            anim_active = 1;
            anim_frame = 0;
            anim_timer = 0;
            saver_on = 0;
            cls_oled(OLED_BLACK);
        }
        else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = 1;
            combo_run(vibration_on);
            set_rgb(0, 0, 255);
            saver_on = 0;
            anim_active = 0; // Stop anim if reopening menu early
        }

        if (menu_enabled) {
            cls_oled(OLED_BLACK);
            draw_stars_background();
            line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);

            if (page == 1) { pageChg_s = 0; }
            else if (page == numpgs) { pageChg_s = 2; }
            else { pageChg_s = 1; }
            if (page > numpgs) { page = numpgs; }
            if (page < 1) { page = 1; }

            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageChg[pageChg_s]);
            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

            if (page == 4) {
                print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[remap_square_active + 3]);
            } else if (page == 5) {
                print(center_x(get_string_length(zen_light_colors[zen_light_color]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, zen_light_colors[zen_light_color]);
            } else if (page == 6) {
                print(center_x(get_string_length(dunk_modes[dunk_mode]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, dunk_modes[dunk_mode]);
            } else if (page == 9) {
                print(center_x(get_string_length(onOff[flick_sequences_enabled]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[flick_sequences_enabled]);
            } else if (page == 10) {
                print(center_x(get_string_length(macro_btn_modes[macro_trigger_btn]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, macro_btn_modes[macro_trigger_btn]);
            } else if (page != 2) {
                print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                      30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
            }
            print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_toggle[toggleType]);

            if (get_val(PS4_L2)) { set_val(PS4_UP,0); set_val(PS4_DOWN,0); set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0); }
            if (get_val(PS4_L2) && event_press(PS4_LEFT) && page > 1) { page--; combo_run(vibration_valchg); }
            if (get_val(PS4_L2) && event_press(PS4_RIGHT) && page < numpgs) { page++; combo_run(vibration_valchg); }

            if (page == 1) {
                menuSelection = flick_up_shooting_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { flick_up_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { flick_up_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 2) {
                menuSelection = 2; toggleType = 0;
                NumberToString(delay_duration, FindDigits(delay_duration));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(delay_duration, 0, 300, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { delay_duration++; }
                    if (event_press(PS4_DOWN)) { delay_duration--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
                }
                if (delay_duration > 300) { delay_duration = 300; }
                if (delay_duration < 0)   { delay_duration = 0; }
            }
            if (page == 3) {
                menuSelection = rs_shooting_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { rs_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { rs_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 4) {
                menuSelection = remap_square_active; toggleType = 1;
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { remap_square_active++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { remap_square_active--; combo_run(vibration_valchg); }
                }
                if (remap_square_active > 2) { remap_square_active = 0; }
                if (remap_square_active < 0) { remap_square_active = 2; }
            }
            if (page == 5) {
                menuSelection = zen_light_color; toggleType = 1;
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { zen_light_color++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { zen_light_color--; combo_run(vibration_valchg); }
                }
                if (zen_light_color > 6) { zen_light_color = 0; }
                if (zen_light_color < 0) { zen_light_color = 6; }
            }
            if (page == 6) {
                menuSelection = dunk_mode; toggleType = 1;
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { dunk_mode++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { dunk_mode--; combo_run(vibration_valchg); }
                }
                if (dunk_mode > 2) { dunk_mode = 0; }
                if (dunk_mode < 0) { dunk_mode = 2; }
            }
            if (page == 7) {
                menuSelection = spot_take_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { spot_take_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { spot_take_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 8) {
                menuSelection = infinite_stamina; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { infinite_stamina = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { infinite_stamina = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 9) {
                menuSelection = flick_sequences_enabled; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { flick_sequences_enabled = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { flick_sequences_enabled = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
            if (page == 10) {
                menuSelection = macro_trigger_btn; toggleType = 1;
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP))   { macro_trigger_btn++; combo_run(vibration_valchg); }
                    if (event_press(PS4_DOWN)) { macro_trigger_btn--; combo_run(vibration_valchg); }
                }
                if (macro_trigger_btn > 7) { macro_trigger_btn = 0; }
                if (macro_trigger_btn < 0) { macro_trigger_btn = 7; }
            }
            if (page == 11) {
                menuSelection = flip_l2_active; toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP))   { flip_l2_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) { flip_l2_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
            }
        }

        if (!menu_enabled) {
            dunk_active = 0;
            if (flip_l2_active) {
                tmp_l1 = get_val(PS4_L1);
                tmp_l2 = get_val(PS4_L2);
                set_val(PS4_L1, tmp_l2);
                set_val(PS4_L2, tmp_l1);
            }

            if (dunk_mode == 0) {
                if (get_val(PS4_CIRCLE)) {
                    set_val(PS4_RY, 100);
                    set_val(PS4_R2, 100);
                    dunk_active = 1;
                } else if (event_release(PS4_CIRCLE)) {
                    set_val(PS4_RY, 0);
                    set_val(PS4_R2, 0);
                }
            } else if (dunk_mode == 1) {
                if (get_val(PS4_L1)) {
                    set_val(PS4_RY, 100);
                    set_val(PS4_R2, 100);
                    dunk_active = 1;
                } else if (event_release(PS4_L1)) {
                    set_val(PS4_RY, 0);
                    set_val(PS4_R2, 0);
                }
            } else if (dunk_mode == 2 && get_val(PS4_RY) > 50) {
                dunk_active = 1;
            }

            if (record_mode == 1 || record_mode == 3) {
                set_rgb(255, 128, 0);
            } else if (record_mode == 2 || record_mode == 4) {
                set_rgb(255, 0, 0);
            } else {
                apply_zen_light();
                if (zen_light_color == 6) {
                    rainbow_timer += frame_time;
                    if (rainbow_timer >= 100) {
                        rainbow_timer = 0;
                        rainbow_phase++;
                        if (rainbow_phase > 11) { rainbow_phase = 0; }
                    }
                }
            }

            if (reset_display_timer > 0) {
                reset_display_timer -= frame_time;
                saver_on = 0;
                cls_oled(OLED_BLACK);
                draw_stars_background();
                print(center_x(get_string_length(reset_success_str[0]), OLED_FONT_SMALL_WIDTH), 28, OLED_FONT_SMALL, OLED_WHITE, reset_success_str[0]);
            } else if (record_mode > 0) {
                saver_on = 0;
                cls_oled(OLED_BLACK);
                draw_stars_background();

                if (record_mode == 1 || record_mode == 3) {
                    print(center_x(get_string_length(rec_ready_str[0]), OLED_FONT_MEDIUM_WIDTH), 18, OLED_FONT_MEDIUM, OLED_WHITE, rec_ready_str[0]);
                    print(center_x(get_string_length(rec_wait_str[0]), OLED_FONT_SMALL_WIDTH), 38, OLED_FONT_SMALL, OLED_WHITE, rec_wait_str[0]);
                } else if (record_mode == 2 || record_mode == 4) {
                    print(center_x(get_string_length(recording_str[0]), OLED_FONT_MEDIUM_WIDTH), 15, OLED_FONT_MEDIUM, OLED_WHITE, recording_str[0]);
                    draw_x_graph(macro_index, 0, MAX_SAMPLES, 45);
                }
            } else if (rec_start_hold_timer >= 250) {
                saver_on = 0;
                cls_oled(OLED_BLACK);
                draw_stars_background();
                print(center_x(get_string_length(hold_rec_str[0]), OLED_FONT_MEDIUM_WIDTH), 8, OLED_FONT_MEDIUM, OLED_WHITE, hold_rec_str[0]);
                print(center_x(get_string_length(hold_rec_sub[0]), OLED_FONT_SMALL_WIDTH), 28, OLED_FONT_SMALL, OLED_WHITE, hold_rec_sub[0]);
                draw_x_graph(rec_start_hold_timer, 0, 3000, 48);
            } else if (reset_combo_hold_timer >= 250) {
                saver_on = 0;
                cls_oled(OLED_BLACK);
                draw_stars_background();
                print(center_x(get_string_length(hold_reset_str[0]), OLED_FONT_MEDIUM_WIDTH), 8, OLED_FONT_MEDIUM, OLED_WHITE, hold_reset_str[0]);
                print(center_x(get_string_length(hold_reset_sub[0]), OLED_FONT_SMALL_WIDTH), 28, OLED_FONT_SMALL, OLED_WHITE, hold_reset_sub[0]);
                draw_x_graph(reset_combo_hold_timer, 0, 4000, 48);
            } else if (anim_active) {
                // Run our custom shooting animation
                anim_timer += frame_time;
                if (anim_timer >= 150) {
                    anim_timer = 0;
                    anim_frame++;
                    if (anim_frame > 12) {
                        anim_active = 0;
                        saver_on = 1;
                        saver_timer = 80;
                    }
                }
                
                if (anim_active) {
                    cls_oled(OLED_BLACK);
                    draw_stars_background();
                    draw_hoop(hx, hy);
                    
                    if (anim_frame <= 1) {
                        draw_stickman(px, py, 0);
                        draw_basketball(px + 10, py - 12);
                    } else if (anim_frame == 2) {
                        draw_stickman(px, py - 5, 1);
                        draw_basketball(px + 14, py - 25);
                    } else if (anim_frame == 3) {
                        draw_stickman(px, py, 2);
                        draw_basketball(px + 35, py - 35);
                    } else if (anim_frame == 4) {
                        draw_stickman(px, py, 2);
                        draw_basketball(px + 60, py - 30);
                    } else if (anim_frame == 5) {
                        draw_stickman(px, py, 2);
                        draw_basketball(px + 82, py - 15);
                    } else if (anim_frame == 6) {
                        draw_stickman(px, py, 2);
                        draw_basketball(hx - 6, hy - 4);
                    } else if (anim_frame == 7) {
                        draw_stickman(px, py, 0);
                        draw_basketball(hx - 6, hy + 8);
                    } else if (anim_frame == 8) {
                        draw_stickman(px, py, 0);
                        draw_basketball(hx - 6, hy + 22);
                    } else if (anim_frame > 8) {
                        draw_stickman(px, py, 0);
                        draw_basketball(hx - 6, hy + 35);
                    }
                }
            } else {
                if (saver_on) {
                    saver_timer += frame_time;
                    if (saver_timer >= 80) {
                        saver_step();
                        saver_timer = 0;
                    }
                } else {
                    saver_on = 1;
                    saver_timer = 80;
                }
            }

            if (remap_square_active == 0) {
                if (get_val(PS4_L3))    { set_val(PS4_SQUARE, 100); }
            } else if (remap_square_active == 1) {
                if (get_val(PS4_R3))    { set_val(PS4_SQUARE, 100); }
            } else if (remap_square_active == 2) {
                if (get_val(PS4_TOUCH)) { set_val(PS4_SQUARE, 100); }
            }

            if (flick_up_shooting_active && !dunk_active) {
                if (!(remap_square_active == 0 && get_val(PS4_L3))
                    && !(remap_square_active == 1 && get_val(PS4_R3))
                    && !(remap_square_active == 2 && get_val(PS4_TOUCH))
                    && get_val(PS4_SQUARE)) {
                    set_val(PS4_SQUARE, 0);
                    square_shooting_in_progress = 1;
                    if (reverse_flick_mode && get_val(PS4_R2)) {
                        set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                    } else {
                        set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                    }
                    set_val(PS4_RX, random(random_variation_min, random_variation_max));
                }
                if (!(remap_square_active == 0 && get_val(PS4_L3))
                    && !(remap_square_active == 1 && get_val(PS4_R3))
                    && !(remap_square_active == 2 && get_val(PS4_TOUCH))
                    && event_release(PS4_SQUARE)) {
                    if (reverse_flick_mode && get_val(PS4_R2)) { combo_run(flick_up_rs_reversed); }
                    else                                       { combo_run(flick_up_rs_smooth); }
                    square_shooting_in_progress = 0;
                }
            }

            if (Insta_shot_active) {
                if ((remap_square_active == 0 && event_press(PS4_R3))
                 || (remap_square_active == 1 && event_press(PS4_L3))
                 || (remap_square_active == 2 && event_press(PS4_R3))) {
                    if (reverse_flick_mode && get_val(PS4_R2)) { combo_run(Insta_shot_reversed); }
                    else                                       { combo_run(Insta_shot_smooth); }
                }
            }

            if (rs_shooting_active) {
                if (!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
                    if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
                        if (!isHolding) {
                            isHolding = 1;
                            rs_shooting_in_progress = 1;
                            holdTimer = 0;
                            if (get_val(PS4_RY) < 0) { rs_is_up = 1; } else { rs_is_up = 0; }
                        }
                        holdTimer += frame_time;
                    } else {
                        if (isHolding) {
                            if (holdTimer > rs_hold_duration) {
                                if (!rs_is_up) { combo_run(flick_up_rs_smooth); }
                                else           { combo_run(flick_up_rs_reversed); }
                            }
                            isHolding = 0;
                            rs_shooting_in_progress = 0;
                            holdTimer = 0;
                        }
                    }
                }
            }

            if (spot_take_active) {
                if (get_val(PS4_CROSS)) {
                    combo_run(spot_take_combo);
                } else {
                    combo_stop(spot_take_combo);
                }
            }

            if (flick_sequences_enabled) {
                if (get_val(PS4_UP)) {
                    set_val(PS4_UP, 0);
                    combo_run(Flick_Sequence_01_Loop);
                } else {
                    combo_stop(Flick_Sequence_01_Loop);
                }
                if (get_val(PS4_RIGHT)) {
                    set_val(PS4_RIGHT, 0);
                    combo_run(Flick_Sequence_02);
                } else {
                    combo_stop(Flick_Sequence_02);
                }
                if (get_val(PS4_DOWN)) {
                    set_val(PS4_DOWN, 0);
                    combo_run(Flick_Sequence_03);
                } else {
                    combo_stop(Flick_Sequence_03);
                }
                if (get_val(PS4_LEFT)) {
                    set_val(PS4_LEFT, 0);
                    combo_run(Flick_Sequence_04);
                } else {
                    combo_stop(Flick_Sequence_04);
                }
            }

            if (record_mode == 2 || record_mode == 4) {
                macro_timer += frame_time;
                if (macro_timer >= SAMPLE_INTERVAL) {
                    macro_timer = 0;
                    if (macro_index < MAX_SAMPLES) {
                        macro_mask = 0;
                        if (get_val(PS4_SQUARE)   > 50) macro_mask |= 1;
                        if (get_val(PS4_TRIANGLE) > 50) macro_mask |= 2;
                        if (get_val(PS4_CIRCLE)   > 50) macro_mask |= 4;
                        if (get_val(PS4_CROSS)    > 50) macro_mask |= 8;
                        if (get_val(PS4_L1)       > 50) macro_mask |= 16;
                        if (get_val(PS4_R1)       > 50) macro_mask |= 32;
                        if (get_val(PS4_L2)       > 50) macro_mask |= 64;
                        if (get_val(PS4_R2)       > 50) macro_mask |= 128;
                        if (get_val(PS4_UP)       > 50) macro_mask |= 256;
                        if (get_val(PS4_DOWN)     > 50) macro_mask |= 512;
                        if (get_val(PS4_LEFT)     > 50) macro_mask |= 1024;
                        if (get_val(PS4_RIGHT)    > 50) macro_mask |= 2048;

                        macro_clx = compress_axis(get_val(PS4_LX));
                        macro_cly = compress_axis(get_val(PS4_LY));
                        macro_crx = compress_axis(get_val(PS4_RX));
                        macro_cry = compress_axis(get_val(PS4_RY));

                        macro_mask |= (macro_clx << 12);
                        macro_mask |= (macro_cly << 17);
                        macro_mask |= (macro_crx << 22);
                        macro_mask |= (macro_cry << 27);

                        macro_data[macro_index] = macro_mask;
                        macro_index++;
                    } else {
                        macro_length = MAX_SAMPLES;
                        record_mode = 0;
                        combo_run(vibration_off);
                    }
                }
            }
        }
    }
}

combo Movement_Control {
    if (infinite_stamina && ground_stick_active && !dunk_active &&
        !square_shooting_in_progress && !rs_shooting_in_progress && !get_val(PS4_SQUARE) &&
        !combo_running(flick_up_rs_smooth) && !combo_running(flick_up_rs_reversed) &&
        !combo_running(Insta_shot_smooth) && !combo_running(Insta_shot_reversed)) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        }
        if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

function compress_axis(val) {
    compress_temp = val + 100;
    if (compress_temp < 0)   { compress_temp = 0; }
    if (compress_temp > 200) { compress_temp = 200; }
    return compress_temp / 8;
}

function decompress_axis(c_val) {
    if (c_val == 12 || c_val == 13) {
        return 0;
    }
    decompress_val = (c_val * 8) - 100;
    if (decompress_val < -100) { decompress_val = -100; }
    if (decompress_val > 100)  { decompress_val = 100; }
    return decompress_val;
}

function apply_zen_light() {
    if (zen_light_color == 0)      { set_rgb(0, 0, 255); }
    else if (zen_light_color == 1) { set_rgb(128, 0, 128); }
    else if (zen_light_color == 2) { set_rgb(255, 255, 255); }
    else if (zen_light_color == 3) { set_rgb(255, 0, 0); }
    else if (zen_light_color == 4) { set_rgb(0, 255, 0); }
    else if (zen_light_color == 5) { set_rgb(255, 255, 0); }
    else if (zen_light_color == 6) {
        if (rainbow_phase == 0)       { set_rgb(255, 0, 0); }
        else if (rainbow_phase == 1)  { set_rgb(255, 64, 0); }
        else if (rainbow_phase == 2)  { set_rgb(255, 128, 0); }
        else if (rainbow_phase == 3)  { set_rgb(255, 192, 0); }
        else if (rainbow_phase == 4)  { set_rgb(255, 255, 0); }
        else if (rainbow_phase == 5)  { set_rgb(128, 255, 0); }
        else if (rainbow_phase == 6)  { set_rgb(0, 255, 0); }
        else if (rainbow_phase == 7)  { set_rgb(0, 255, 128); }
        else if (rainbow_phase == 8)  { set_rgb(0, 255, 255); }
        else if (rainbow_phase == 9)  { set_rgb(0, 128, 255); }
        else if (rainbow_phase == 10) { set_rgb(0, 0, 255); }
        else if (rainbow_phase == 11) { set_rgb(128, 0, 255); }
    }
}

function draw_stars_background() {
    // Animated moving stars - scrolling left like the Tempo file
    if (!stars_initialized) {
        star_i = 0;
        while (star_i < 30) {
            star_x[star_i] = random(0, 127);
            star_y[star_i] = random(0, 63);
            star_speed[star_i] = random(1, 3);
            star_brightness[star_i] = random(0, 1);
            star_i = star_i + 1;
        }
        stars_initialized = 1;
    }
    star_i = 0;
    while (star_i < 30) {
        if (star_brightness[star_i]) {
            pixel_oled(star_x[star_i], star_y[star_i], OLED_WHITE);
        }
        star_x[star_i] = star_x[star_i] - star_speed[star_i];
        if (star_x[star_i] < 0) {
            star_x[star_i] = 127;
            star_y[star_i] = random(0, 63);
            star_speed[star_i] = random(1, 3);
        }
        star_i = star_i + 1;
    }
}

function draw_basketball(bx, by) {
    pixel_oled(bx - 1, by - 4, OLED_WHITE); pixel_oled(bx, by - 4, OLED_WHITE); pixel_oled(bx + 1, by - 4, OLED_WHITE);
    pixel_oled(bx - 3, by - 3, OLED_WHITE); pixel_oled(bx - 2, by - 3, OLED_WHITE); pixel_oled(bx + 2, by - 3, OLED_WHITE); pixel_oled(bx + 3, by - 3, OLED_WHITE);
    pixel_oled(bx - 4, by - 2, OLED_WHITE); pixel_oled(bx + 4, by - 2, OLED_WHITE);
    pixel_oled(bx - 4, by - 1, OLED_WHITE); pixel_oled(bx + 4, by - 1, OLED_WHITE);
    pixel_oled(bx - 4, by,     OLED_WHITE); pixel_oled(bx + 4, by,     OLED_WHITE);
    pixel_oled(bx - 4, by + 1, OLED_WHITE); pixel_oled(bx + 4, by + 1, OLED_WHITE);
    pixel_oled(bx - 4, by + 2, OLED_WHITE); pixel_oled(bx + 4, by + 2, OLED_WHITE);
    pixel_oled(bx - 3, by + 3, OLED_WHITE); pixel_oled(bx - 2, by + 3, OLED_WHITE); pixel_oled(bx + 2, by + 3, OLED_WHITE); pixel_oled(bx + 3, by + 3, OLED_WHITE);
    pixel_oled(bx - 1, by + 4, OLED_WHITE); pixel_oled(bx, by + 4, OLED_WHITE); pixel_oled(bx + 1, by + 4, OLED_WHITE);
    
    pixel_oled(bx - 1, by - 3, OLED_WHITE);
    pixel_oled(bx - 2, by - 2, OLED_WHITE);
    pixel_oled(bx - 2, by - 1, OLED_WHITE);
    pixel_oled(bx - 2, by,     OLED_WHITE);
    pixel_oled(bx - 2, by + 1, OLED_WHITE);
    pixel_oled(bx - 2, by + 2, OLED_WHITE);
    pixel_oled(bx - 1, by + 3, OLED_WHITE);
    
    pixel_oled(bx - 3, by, OLED_WHITE);
    pixel_oled(bx - 1, by, OLED_WHITE);
    pixel_oled(bx,     by, OLED_WHITE);
    pixel_oled(bx + 1, by, OLED_WHITE);
    pixel_oled(bx + 2, by, OLED_WHITE);
    pixel_oled(bx + 3, by, OLED_WHITE);
}

function draw_stickman(sx, sy, pose) {
    rect_oled(sx - 2, sy - 20, 5, 5, OLED_WHITE, OLED_WHITE); // Head
    line_oled(sx, sy - 15, sx, sy - 5, 1, OLED_WHITE); // Body
    line_oled(sx, sy - 5, sx - 5, sy, 1, OLED_WHITE); // Leg L
    line_oled(sx, sy - 5, sx + 5, sy, 1, OLED_WHITE); // Leg R
    
    if (pose == 0) {
        line_oled(sx, sy - 12, sx + 5, sy - 8, 1, OLED_WHITE);
        line_oled(sx + 5, sy - 8, sx + 10, sy - 15, 1, OLED_WHITE);
    } else if (pose == 1) {
        line_oled(sx, sy - 12, sx + 8, sy - 20, 1, OLED_WHITE);
        line_oled(sx + 8, sy - 20, sx + 12, sy - 25, 1, OLED_WHITE);
    } else if (pose == 2) {
        line_oled(sx, sy - 12, sx + 12, sy - 16, 1, OLED_WHITE);
    }
}

function draw_hoop(dhx, dhy) {
    rect_oled(dhx, dhy - 15, 2, 30, OLED_WHITE, OLED_WHITE); // backboard
    line_oled(dhx - 12, dhy, dhx, dhy, 1, OLED_WHITE); // rim
    line_oled(dhx - 12, dhy, dhx - 8, dhy + 10, 1, OLED_WHITE); // net L
    line_oled(dhx, dhy, dhx - 4, dhy + 10, 1, OLED_WHITE); // net R
    line_oled(dhx - 8, dhy + 10, dhx - 4, dhy + 10, 1, OLED_WHITE); // net B
}

function draw_picture(x, y) {
    cls_oled(OLED_BLACK);
    rect_oled(40, 5,  48, 8,  OLED_WHITE, OLED_WHITE);
    line_oled(88, 5, 48, 58, 4, OLED_WHITE);
}

function draw_star(ds_x, ds_y) {
    pixel_oled(ds_x,     ds_y,     OLED_WHITE);
    pixel_oled(ds_x - 2, ds_y,     OLED_WHITE);
    pixel_oled(ds_x + 2, ds_y,     OLED_WHITE);
    pixel_oled(ds_x,     ds_y - 2, OLED_WHITE);
    pixel_oled(ds_x,     ds_y + 2, OLED_WHITE);
    pixel_oled(ds_x - 1, ds_y - 1, OLED_WHITE);
    pixel_oled(ds_x + 1, ds_y - 1, OLED_WHITE);
    pixel_oled(ds_x - 1, ds_y + 1, OLED_WHITE);
    pixel_oled(ds_x + 1, ds_y + 1, OLED_WHITE);
}

function saver_step() {
    cls_oled(OLED_BLACK);
    draw_stars_background();
    
    // Add decorative static basketballs in background while screensaver bounces
    draw_basketball(15, 40);
    draw_basketball(110, 35);

    msg_w = (get_string_length(saver_line1[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    line1_w = (get_string_length(saver_line2[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    if (line1_w > msg_w) { msg_w = line1_w; }
    line1_w = (get_string_length(saver_line3[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    if (line1_w > msg_w) { msg_w = line1_w; }
    line1_w = (get_string_length(saver_line4[0]) - 1) * OLED_FONT_SMALL_WIDTH;
    if (line1_w > msg_w) { msg_w = line1_w; }

    rect_oled(sx - 4, sy - 4, msg_w + 8, 42, OLED_BLACK, OLED_WHITE);
    pixel_oled(sx - 4,         sy - 4,  OLED_BLACK);
    pixel_oled(sx + msg_w + 3, sy - 4,  OLED_BLACK);
    pixel_oled(sx - 4,         sy + 37, OLED_BLACK);
    pixel_oled(sx + msg_w + 3, sy + 37, OLED_BLACK);

    print(sx, sy,      OLED_FONT_SMALL, OLED_WHITE, saver_line1[0]);
    print(sx, sy + 10, OLED_FONT_SMALL, OLED_WHITE, saver_line2[0]);
    print(sx, sy + 20, OLED_FONT_SMALL, OLED_WHITE, saver_line3[0]);
    print(sx, sy + 30, OLED_FONT_SMALL, OLED_WHITE, saver_line4[0]);

    sx += svx;
    sy += svy;

    if (sx <= 5 || sx >= (OLED_WIDTH - msg_w - 5)) { svx = -svx; }
    if (sy <= 5 || sy >= (OLED_HEIGHT - 42 - 3))   { svy = -svy; }
}

function map(val, in_min, in_max, out_min, out_max) {
    return (val - in_min) * (out_max - out_min) / (in_max - in_min) + out_min;
}

function draw_x_graph(value, min_val, max_val, y_pos) {
    graph_width = 100;
    x_start = (OLED_WIDTH - graph_width) / 2;
    mid_x = x_start + graph_width / 2;
    bar_pos = map(value, min_val, max_val, 0, graph_width);
    line_oled(x_start, y_pos, x_start + graph_width, y_pos, 1, OLED_WHITE);
    line_oled(mid_x, y_pos - 3, mid_x, y_pos + 3, 1, OLED_WHITE);
    line_oled(x_start, y_pos - 2, x_start, y_pos + 2, 1, OLED_WHITE);
    line_oled(x_start + graph_width, y_pos - 2, x_start + graph_width, y_pos + 2, 1, OLED_WHITE);
    rect_oled(x_start, y_pos - 2, bar_pos, 4, OLED_WHITE, OLED_WHITE);
}

