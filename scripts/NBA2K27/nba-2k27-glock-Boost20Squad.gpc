function showRhythmText() {
    vm_tctrl(20); if (timeOffset <= 0) {
        for (jumpState = 0; jumpState < sizeof(discordURL2); jumpState++) {
            putc_oled(1, discordURL2[jumpState]);
            puts_oled(9 * jumpState - scrollCounter, 13, OLED_FONT_MEDIUM, 1, OLED_WHITE);
            timeOffset = 30;
        } scrollCounter++; validityCheck = validityCheck + 1;
    }
}

function handleTempoMenu() {
    if (menuSelection == 0) {
        print(centerText(getStringLength(sub_menu_tempo[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_tempo[menuSelection]);
        print(centerText(getStringLength(onOffText[tempoShotActive]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOffText[tempoShotActive]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[1]); }
        else { print(centerText(getStringLength(itemToggleXB[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[1]); }
        if (get_val(PS4_L2) && (event_press(PS4_RIGHT) || event_press(PS4_LEFT))) {
            tempoShotActive = !tempoShotActive;
            savedTempoShot[currentProfile] = tempoShotActive;
            if (tempoShotActive) { 
                if (autoGreenEnabled) { 
                    autoGreenEnabled = 0;
                    savedAutoGreen[currentProfile] = 0;
                    cls_oled(0); 
                    print(centerText(getStringLength(mutualExclusionMessage[0]), OLED_FONT_SMALL_WIDTH), 30, OLED_FONT_SMALL, OLED_WHITE, mutualExclusionMessage[0]); 
                    combo_run(notificationDelay); 
                } 
            }
            SaveProfileSettings();
            feedbackIndicator = tempoShotActive; combo_run(vibrationFeedback); combo_run(flashFeedback);
        }
    } else if (menuSelection == 1) {
        print(centerText(getStringLength(sub_menu_tempo[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_tempo[menuSelection]);
        print(centerText(getStringLength(onOffText[fadeFlickActive]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOffText[fadeFlickActive]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[1]); }
        else { print(centerText(getStringLength(itemToggleXB[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[1]); }
        if (get_val(PS4_L2) && (event_press(PS4_RIGHT) || event_press(PS4_LEFT))) {
            fadeFlickActive = !fadeFlickActive;
            toggleValue = fadeFlickActive;
            savedFadeFlick[currentProfile] = fadeFlickActive;
            SaveProfileSettings();
            feedbackIndicator = fadeFlickActive;
            combo_run(vibrationFeedback);
            combo_run(flashFeedback);
        }
    } else if (menuSelection == 2) {
        print(centerText(getStringLength(sub_menu_tempo[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_tempo[menuSelection]);
        displayNumber(flickDelayTime, countDigits(flickDelayTime)); print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, msText[0]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[0]); }
        else { print(centerText(getStringLength(itemToggleXB[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[0]); }
        if (get_val(PS4_L2)) {
            if (event_press(PS4_UP)) flickDelayTime++; if (event_press(PS4_DOWN)) flickDelayTime--;
            if (event_press(PS4_RIGHT)) flickDelayTime += 5; if (event_press(PS4_LEFT)) flickDelayTime -= 5;
            if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_RIGHT) || event_press(PS4_LEFT)) {
                savedFlickDelay[currentProfile] = flickDelayTime;
                SaveProfileSettings();
                combo_run(vibrationFeedback); combo_run(flashFeedback);
            }
        } flickDelayTime = clamp(flickDelayTime, 10, 200);
    }
    handleSubmenuNavigation(2);
}

function handleGreenMenu() {
    if (menuSelection == 0) {
        print(centerText(getStringLength(sub_menu_green[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_green[menuSelection]);
        print(centerText(getStringLength(onOffText[autoGreenEnabled]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOffText[autoGreenEnabled]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[1]); }
        else { print(centerText(getStringLength(itemToggleXB[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[1]); }
        if (get_val(PS4_L2) && (event_press(PS4_RIGHT) || event_press(PS4_LEFT))) {
            autoGreenEnabled = !autoGreenEnabled;
            savedAutoGreen[currentProfile] = autoGreenEnabled;
            if (autoGreenEnabled) { 
                if (tempoShotActive) { 
                    tempoShotActive = 0;
                    savedTempoShot[currentProfile] = 0;
                    cls_oled(0); 
                    print(centerText(getStringLength(mutualExclusionMessage[1]), OLED_FONT_SMALL_WIDTH), 30, OLED_FONT_SMALL, OLED_WHITE, mutualExclusionMessage[1]); 
                    combo_run(notificationDelay); 
                } 
            }
            SaveProfileSettings();
            feedbackIndicator = autoGreenEnabled; combo_run(vibrationFeedback); combo_run(flashFeedback);
        }
    } else if (menuSelection == 1) {
        print(centerText(getStringLength(sub_menu_green[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_green[menuSelection]);
        displayNumber(catchShotTiming, countDigits(catchShotTiming)); print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, msText[0]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[0]); }
        else { print(centerText(getStringLength(itemToggleXB[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[0]); }
        if (get_val(PS4_L2)) {
            if (event_press(PS4_UP)) catchShotTiming++; if (event_press(PS4_DOWN)) catchShotTiming--;
            if (event_press(PS4_RIGHT)) catchShotTiming += 5; if (event_press(PS4_LEFT)) catchShotTiming -= 5;
            if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_RIGHT) || event_press(PS4_LEFT)) {
                savedCatchTiming[currentProfile] = catchShotTiming;
                SaveProfileSettings();
                combo_run(vibrationFeedback);
            }
        } catchShotTiming = clamp(catchShotTiming, 1, 999);
    } else if (menuSelection == 2) {
        print(centerText(getStringLength(sub_menu_green[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_green[menuSelection]);
        displayNumber(jumpShotTiming, countDigits(jumpShotTiming)); print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, msText[0]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[0]); }
        else { print(centerText(getStringLength(itemToggleXB[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[0]); }
         if (get_val(PS4_L2)) {
            if (event_press(PS4_UP)) jumpShotTiming++; if (event_press(PS4_DOWN)) jumpShotTiming--;
            if (event_press(PS4_RIGHT)) jumpShotTiming += 5; if (event_press(PS4_LEFT)) jumpShotTiming -= 5;
            if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_RIGHT) || event_press(PS4_LEFT)) {
                savedJumpTiming[currentProfile] = jumpShotTiming;
                SaveProfileSettings();
                combo_run(vibrationFeedback);
            }
        } jumpShotTiming = clamp(jumpShotTiming, 1, 999);
    } else if (menuSelection == 3) {
        print(centerText(getStringLength(sub_menu_green[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_green[menuSelection]);
        displayNumber(moveShotTiming, countDigits(moveShotTiming)); print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, msText[0]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[0]); }
        else { print(centerText(getStringLength(itemToggleXB[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[0]); }
        if (get_val(PS4_L2)) {
            if (event_press(PS4_UP)) moveShotTiming++; if (event_press(PS4_DOWN)) moveShotTiming--;
            if (event_press(PS4_RIGHT)) moveShotTiming += 5; if (event_press(PS4_LEFT)) moveShotTiming -= 5;
            if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_RIGHT) || event_press(PS4_LEFT)) {
                savedMoveTiming[currentProfile] = moveShotTiming;
                SaveProfileSettings();
                combo_run(vibrationFeedback);
            }
        } moveShotTiming = clamp(moveShotTiming, 1, 999);
    } else if (menuSelection == 4) {
        print(centerText(getStringLength(sub_menu_green[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_green[menuSelection]);
        displayNumber(ftShotTiming, countDigits(ftShotTiming)); print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, msText[0]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[0]); }
        else { print(centerText(getStringLength(itemToggleXB[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[0]); }
        if (get_val(PS4_L2)) {
            if (event_press(PS4_UP)) ftShotTiming++; if (event_press(PS4_DOWN)) ftShotTiming--;
            if (event_press(PS4_RIGHT)) ftShotTiming += 5; if (event_press(PS4_LEFT)) ftShotTiming -= 5;
            if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_RIGHT) || event_press(PS4_LEFT)) {
                savedFtTiming[currentProfile] = ftShotTiming;
                SaveProfileSettings();
                combo_run(vibrationFeedback);
            }
        } ftShotTiming = clamp(ftShotTiming, 1, 999);
    }
    handleSubmenuNavigation(4);
}

