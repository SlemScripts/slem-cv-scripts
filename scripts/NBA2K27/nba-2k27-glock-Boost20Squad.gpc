function handleQuickStopMenu() {
    if (menuSelection == 0) {
        print(centerText(getStringLength(sub_menu_autoqs[0]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_autoqs[0]);
        print(centerText(getStringLength(onOffText[quickstopOn]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOffText[quickstopOn]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[1]); }
        else { print(centerText(getStringLength(itemToggleXB[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[1]); }
        if (get_val(PS4_L2) && (event_press(PS4_RIGHT) || event_press(PS4_LEFT))) {
            quickstopOn = !quickstopOn;
            savedQuickstop[currentProfile] = quickstopOn;
            SaveProfileSettings();
            feedbackIndicator = quickstopOn; combo_run(vibrationFeedback); combo_run(flashFeedback);
        }
    } else if (menuSelection == 1) {
        print(centerText(getStringLength(sub_menu_autoqs[1]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_autoqs[1]);
        print(centerText(getStringLength(qsTypeText[qsVariant]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, qsTypeText[qsVariant]);
        if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[1]); }
        else { print(centerText(getStringLength(itemToggleXB[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[1]); }
        if (get_val(PS4_L2) && (event_press(PS4_RIGHT) || event_press(PS4_LEFT))) {
            qsVariant = !qsVariant;
            savedQsVariant[currentProfile] = qsVariant;
            SaveProfileSettings();
            feedbackIndicator = TRUE; combo_run(vibrationFeedback); combo_run(flashFeedback);
        }
    }
    handleSubmenuNavigation(1);
}

