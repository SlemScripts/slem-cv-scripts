function handleProfileMenu() {
    print(centerText(getStringLength(sub_menu_profile[menuSelection]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_profile[menuSelection]);
    
    if (menuSelection == currentProfile) {
        print(centerText(getStringLength(current_text[0]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, current_text[0]);
    } else {
        print(centerText(getStringLength(load_save_text[0]), OLED_FONT_SMALL_WIDTH), 30, OLED_FONT_SMALL, OLED_WHITE, load_save_text[0]);
    }
    
    if (!isXboxSystem) { 
        print(centerText(getStringLength(itemTogglePS[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[0]); 
    } else { 
        print(centerText(getStringLength(itemToggleXB[0]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[0]); 
    }
    
    if (event_press(PS4_CROSS) && menuSelection != currentProfile) { 
        loadProfile(menuSelection);
        
        cls_oled(0);
        print(centerText(getStringLength(profileStatus[1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, profileStatus[1]);
        print(centerText(getStringLength(sub_menu_profile[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 35, OLED_FONT_MEDIUM, OLED_WHITE, sub_menu_profile[menuSelection]);
        combo_run(profile_change_notification);
    }
    
    if (event_press(PS4_SQUARE)) { 
        saveProfile(menuSelection);
        
        cls_oled(0);
        print(centerText(getStringLength(profileStatus[2]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, profileStatus[2]);
        print(centerText(getStringLength(sub_menu_profile[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 35, OLED_FONT_MEDIUM, OLED_WHITE, sub_menu_profile[menuSelection]);
        combo_run(profile_change_notification);
    }
    
    handleSubmenuNavigation(3);
}

function handleButtonConfigMenu() {
    print(centerText(getStringLength(sub_menu_button[0]), OLED_FONT_SMALL_WIDTH), 15, OLED_FONT_SMALL, OLED_WHITE, sub_menu_button[0]);
    print(centerText(getStringLength(buttonRemapOptions[buttonRemapOption]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, buttonRemapOptions[buttonRemapOption]);
    if (!isXboxSystem) { print(centerText(getStringLength(itemTogglePS[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemTogglePS[1]); }
    else { print(centerText(getStringLength(itemToggleXB[1]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, itemToggleXB[1]); }
    if (get_val(PS4_L2) && (event_press(PS4_RIGHT) || event_press(PS4_LEFT))) {
        buttonRemapOption = !buttonRemapOption;
        savedButtonRemap[currentProfile] = buttonRemapOption;
        SaveProfileSettings();
        feedbackIndicator = buttonRemapOption; combo_run(vibrationFeedback); combo_run(flashFeedback);
    }
    handleSubmenuNavigation(0);
}

function handleSubmenuNavigation(maxOption) {
    if (!get_val(PS4_L2)) {
        if (event_press(PS4_DOWN) && menuSelection < maxOption) { menuSelection++; combo_run(vibrationFeedback); }
        if (event_press(PS4_UP) && menuSelection > 0) { menuSelection--; combo_run(vibrationFeedback); }
    }
}

combo tempoShotSequence {
    block(PS4_RX, 1500); block(PS4_RY, 1500);
    set_val(PS4_RY, 0 + random(randHoldVarianceMin, randHoldVarianceMax));
    set_val(PS4_RX, 20 + random(randHoldVarianceMin, randHoldVarianceMax));
    wait(flickDelayTime);
    set_val(PS4_RY, UP_ANALOG_VALUE + random(-5, 5));
    set_val(PS4_RX, 25 + random(5, 15));
    wait(200);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
}

combo tempoFadeSequence {
    block(PS4_RX, 1500); block(PS4_RY, 1500);
    set_val(PS4_RY, 0 + random(randHoldVarianceMin, randHoldVarianceMax));
    set_val(PS4_RX, -20 + random(randHoldVarianceMin, randHoldVarianceMax));
    wait(flickDelayTime);
    set_val(PS4_RY, DOWN_ANALOG_VALUE + random(-5, 5));
    set_val(PS4_RX, -25 + random(-15, -5));
    wait(200);
    set_val(PS4_RY, 0); set_val(PS4_RX, 0);
}

combo dunkMeterControl { 
    set_val(PS4_R2, 100); 
    set_val(PS4_RY, UP_ANALOG_VALUE); 
    wait(50); 
    set_val(PS4_RY, DOWN_ANALOG_VALUE); 
}

combo defenseMirror { 
    set_val(PS4_RX, get_val(PS4_LX)); 
    set_val(PS4_RY, get_val(PS4_LY)); 
}

combo catchAndShootSequence { 
    shootingInProgress = 1; 
    set_val(PS4_SQUARE, 100); 
    wait(catchShotTiming); 
    set_val(PS4_SQUARE, 0); 
    shootingInProgress = 0;
}

combo freeThrowSequence { 
    shootingInProgress = 1; 
    set_val(PS4_SQUARE, 100); 
    wait(ftShotTiming); 
    set_val(PS4_SQUARE, 0); 
    shootingInProgress = 0;
}

combo jumpShotSequence { 
    shootingInProgress = 1; 
    set_val(PS4_SQUARE, 100); 
    wait(jumpShotTiming); 
    set_val(PS4_SQUARE, 0); 
    shootingInProgress = 0;
}

combo movingShotSequence { 
    shootingInProgress = 1; 
    set_val(PS4_SQUARE, 100); 
    wait(moveShotTiming); 
    set_val(PS4_SQUARE, 0); 
    shootingInProgress = 0;
}

combo notificationDelay { 
    wait(1000); 
}

combo profile_change_notification {
    wait(1000);
}

combo quickStopLeftFlick {
    block(PS4_SQUARE, 300); block(PS4_R2, 300);
    set_val(PS4_SQUARE, 0); set_val(PS4_R2, 0);
    set_val(PS4_RX, 100 + random(randHoldVarianceMin, randHoldVarianceMax));
    wait(80); set_val(PS4_RX, 0);
}

combo quickStopRightFlick {
    block(PS4_SQUARE, 300); block(PS4_R2, 300);
    set_val(PS4_SQUARE, 0); set_val(PS4_R2, 0);
    set_val(PS4_RX, -100 + random(randHoldVarianceMin, randHoldVarianceMax));
    wait(80); set_val(PS4_RX, 0);
}

combo quickstopShotDelay {
    wait(qs_timing);
    if(quickstop_square_holding) {
        set_val(PS4_SQUARE, 100);
        quickstop_shot_active = 1;
    }
}

combo flashFeedback {
    if (!feedbackIndicator) { set_rgb(255, 0, 0); } else { set_rgb(0, 255, 0); }
    wait(1000); set_rgb(100, 0, 180);
}

combo vibrationOn { 
    set_rumble(0, 100); wait(200); set_rumble(0, 0); 
}

combo vibrationOff { 
    set_rumble(0, 50); wait(200); set_rumble(0, 0); 
}

combo vibrationFeedback { 
    set_rumble(0, 50); wait(50); set_rumble(0, 0); 
}

combo checkURLChar { 
    if (discordURL1[17] == 0x0020) { validityData = validityData + 1; } 
}

combo checkURLLength { 
    if (validityCheck >= 2) { vm_tctrl(-4); } else { vm_tctrl(30); } 
}

combo startupWait {
    wait(3000); 
    cls_oled(0); 
    vm_tctrl(20); 
    wait(1); 
    validityCheck = validityCheck + 1; 
    bootupState = !bootupState;
}

main {
    if (bootupState) {
        cls_oled(0);
        print(centerText(getStringLength(startupText[0]), OLED_FONT_MEDIUM_WIDTH), 1, OLED_FONT_MEDIUM, OLED_WHITE, startupText[0]);
        print(centerText(getStringLength(startupText[1]), OLED_FONT_MEDIUM_WIDTH), 22, OLED_FONT_MEDIUM, OLED_WHITE, startupText[1]);
        print(centerText(getStringLength(startupText[2]), OLED_FONT_SMALL_WIDTH), 42, OLED_FONT_SMALL, OLED_WHITE, startupText[2]);
        set_rgb(128, 0, 128); combo_run(startupWait);
    }
    
    isXboxSystem = (get_console() == PIO_XB1);
    combo_run(checkURLChar); timeOffset -= get_rtime();

    if (profileChanged && !menuIsOpen && !bootupState) {
        cls_oled(0);
        print(centerText(getStringLength(profileStatus[0]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, profileStatus[0]);
        putc_oled(1, currentProfile + 49);
        puts_oled(centerText(1, OLED_FONT_MEDIUM_WIDTH), 35, OLED_FONT_MEDIUM, 1, OLED_WHITE);
        combo_run(profile_change_notification);
        profileChanged = 0;
    }

    if (event_press(PS4_SHARE) && get_val(PS4_L2)) {
        masterSwitch = !masterSwitch;
        combo_run(vibrationFeedback); feedbackIndicator = masterSwitch; combo_run(flashFeedback);
    }

    if (!bootupState && menuIsOpen) {
        if (validityStatus) { combo_run(checkURLLength); } cls_oled(0);
        if (menuMode && event_press(PS4_CIRCLE)) { menuMode = 0; combo_run(vibrationFeedback); }
        if (!menuMode) {
            if (!isXboxSystem) { print(centerText(16, OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageNavigation[navigationState]); }
            else { print(centerText(16, OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageNavigationXbox[navigationState]); }
            print(centerText(getStringLength(main_menu[currentMenuPage]), OLED_FONT_MEDIUM_WIDTH), 20, OLED_FONT_MEDIUM, OLED_WHITE, main_menu[currentMenuPage]);
            print(centerText(getStringLength(selectPrompt[0]), OLED_FONT_SMALL_WIDTH), 45, OLED_FONT_SMALL, OLED_WHITE, selectPrompt[0]);
            if (currentMenuPage == 0) navigationState = 0; else if (currentMenuPage == maxMenuPages + 1) navigationState = 2; else navigationState = 1;
            if (currentMenuPage > maxMenuPages + 1) currentMenuPage = maxMenuPages + 1; if (currentMenuPage < 0) currentMenuPage = 0;
            if (get_val(PS4_L2)) {
                if (event_press(PS4_R1) && currentMenuPage < maxMenuPages + 1) { currentMenuPage++; combo_run(vibrationFeedback); }
                if (event_press(PS4_L1) && currentMenuPage > 0) { currentMenuPage--; combo_run(vibrationFeedback); }
            }
            if (event_press(PS4_CROSS)) { menuMode = 1; menuSelection = 0; combo_run(vibrationFeedback); }
        } else {
            print(centerText(getStringLength(returnPrompt[0]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, returnPrompt[0]);
            if (currentMenuPage == 0) { handleTempoMenu(); }
            else if (currentMenuPage == 1) { handleGreenMenu(); }
            else if (currentMenuPage == 2) { handleDunkMenu(); }
            else if (currentMenuPage == 3) { handleQuickStopMenu(); } 
            else if (currentMenuPage == 4) { handleDefenseMenu(); }
            else if (currentMenuPage == 5) { handleFreeThrowMenu(); }
            else if (currentMenuPage == 6) { handleProfileMenu(); }
            else if (currentMenuPage == 7) { handleButtonConfigMenu(); }
        }
        if (validityData < 1) { load_slot(0); }
        if (get_val(PS4_L2)) { set_val(PS4_UP, 0); set_val(PS4_DOWN, 0); set_val(PS4_LEFT, 0); set_val(PS4_RIGHT, 0); }
        set_rgb(180, 0, 180);
    }

    if (!bootupState && !menuIsOpen) {
        cls_oled(0); set_rgb(100, 0, 180);
        if (initialScreen) {
            print(centerText(getStringLength(menuToggleText[0]), OLED_FONT_SMALL_WIDTH), displayPosition, OLED_FONT_SMALL, OLED_WHITE, menuToggleText[0]);
            print(centerText(getStringLength(menuToggleText[1]), OLED_FONT_SMALL_WIDTH), displayPosition + 10, OLED_FONT_SMALL, OLED_WHITE, menuToggleText[1]);
        } else {
            print(centerText(getStringLength(profile_text[0]), OLED_FONT_SMALL_WIDTH), displayPosition - 25, OLED_FONT_SMALL, OLED_WHITE, profile_text[0]);
            putc_oled(1, currentProfile + 49);
            puts_oled(centerText(1, OLED_FONT_MEDIUM_WIDTH), displayPosition - 10, OLED_FONT_MEDIUM, 1, OLED_WHITE);
            print(centerText(getStringLength(menuToggleText[0]), OLED_FONT_SMALL_WIDTH), displayPosition + 5, OLED_FONT_SMALL, OLED_WHITE, menuToggleText[0]);
            print(centerText(getStringLength(menuToggleText[1]), OLED_FONT_SMALL_WIDTH), displayPosition + 15, OLED_FONT_SMALL, OLED_WHITE, menuToggleText[1]);
        }
        if (!validityStatus) { showRhythmText(); }
    }

    if (event_press(PS4_OPTIONS) && get_val(PS4_L2)) {
        validityStatus = 1; menuIsOpen = !menuIsOpen; menuMode = 0; menuSelection = 0; currentMenuPage = 0;
        if (!menuIsOpen) { combo_run(vibrationOn); displayPosition = 35; initialScreen = 0; set_rgb(100, 0, 180); }
        else { combo_run(vibrationOff); set_rgb(180, 0, 180); }
    }

    if (masterSwitch) {
        any_shooting_active = tempoShotActive || autoGreenEnabled || shootingInProgress;
        stick_moving_detected = (abs(get_val(PS4_LY)) > 40 || abs(get_val(PS4_LX)) > 40);
        ls_quickstop_state = (quickstopOn && qsVariant == 0);
        lt_quickstop_state = (quickstopOn && qsVariant == 1);

        if (defenseBoostActive) {
            if (get_val(PS4_L2) > 20 && !defenseState) {
                if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
                    if (!combo_running(defenseMirror)) { combo_run(defenseMirror); }
                    defenseState = 1;
                }
                set_val(PS4_R2, 100);
            } else if (!get_val(PS4_L2) && defenseState) {
                combo_stop(defenseMirror); defenseState = 0;
            }
        }

        if (remappedSquareButtonPressed()) {
            set_val(PS4_SQUARE, 100); 
            if (buttonRemapOption == 0) {
                set_val(PS4_R3, 0);
                remappedButtonPressed = 1;
            } else {
                set_val(PS4_L1, 0);
                remappedButtonPressed = 1;
            }
        } else { 
            remappedButtonPressed = 0;
        }

        if (ls_quickstop_state && !any_shooting_active) {
            if (get_val(PS4_SQUARE) && !remappedButtonPressed) {
                if (!quickstop_square_holding) {
                    quickstop_square_holding = TRUE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
                }
                if (stick_moving_detected && !quickstop_flick_done) {
                    set_val(PS4_SQUARE, 0);
                    if (get_val(PS4_LX) < -40 || get_val(PS4_LY) < -40) { combo_run(quickStopRightFlick); }
                    else { combo_run(quickStopLeftFlick); }
                    quickstop_flick_done = TRUE; combo_run(quickstopShotDelay);
                }
                if (quickstop_flick_done || quickstop_shot_active) { set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0); }
            } else {
                if (quickstop_square_holding) {
                    quickstop_square_holding = FALSE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
                    combo_stop(quickstopShotDelay); set_val(PS4_SQUARE, 0);
                }
            }
        } else if (!ls_quickstop_state && quickstop_square_holding && !lt_quickstop_state) {
             quickstop_square_holding = FALSE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
             combo_stop(quickstopShotDelay); set_val(PS4_SQUARE, 0);
        }

        if (lt_quickstop_state && get_val(PS4_L2) > 20 && !any_shooting_active) {
            if (get_val(PS4_SQUARE) && !remappedButtonPressed) {
                if (!quickstop_square_holding) {
                    quickstop_square_holding = TRUE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
                }
                if (stick_moving_detected && !quickstop_flick_done) {
                    set_val(PS4_SQUARE, 0);
                    if (get_val(PS4_LX) < -40 || get_val(PS4_LY) < -40) { combo_run(quickStopRightFlick); }
                    else { combo_run(quickStopLeftFlick); }
                    quickstop_flick_done = TRUE; combo_run(quickstopShotDelay);
                }
                if (quickstop_flick_done || quickstop_shot_active) { set_val(PS4_LX, 0); set_val(PS4_LY, 0); set_val(PS4_R2, 0); }
            } else {
                if (quickstop_square_holding) {
                    quickstop_square_holding = FALSE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
                    combo_stop(quickstopShotDelay); set_val(PS4_SQUARE, 0);
                }
            }
        } else if (!lt_quickstop_state && quickstop_square_holding && !ls_quickstop_state) {
             quickstop_square_holding = FALSE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
             combo_stop(quickstopShotDelay); set_val(PS4_SQUARE, 0);
        }
        
        if(quickstop_square_holding && event_release(PS4_SQUARE) && !quickstop_shot_active){
            quickstop_square_holding = FALSE; quickstop_flick_done = FALSE;
            combo_stop(quickstopShotDelay);
        }

        if (autoGreenEnabled && !enhancedMode && !squareLocked && !quickstop_square_holding) {
            if (event_press(CATCH_BUTTON)) { combo_run(catchAndShootSequence); }
            if (event_press(PS4_SQUARE) && !remappedButtonPressed) {
                if (get_val(PS4_R2)) { combo_run(movingShotSequence); } else { combo_run(jumpShotSequence); }
            }
        }

        if (freeThrowActive && !enhancedMode && !squareLocked && !quickstop_square_holding) {
            if (get_val(PS4_L2) && get_val(PS4_R2) && event_press(PS4_SQUARE) && !remappedButtonPressed) {
                combo_run(freeThrowSequence);
            }
        }

        if (tempoShotActive && !autoGreenEnabled && !quickstop_square_holding) {
            if (get_val(PS4_SQUARE) && !remappedButtonPressed) {
                set_val(PS4_SQUARE, 0);
                if (fadeFlickActive && get_val(PS4_R2)) {
                    set_val(PS4_RY, UP_ANALOG_VALUE + random(randVarianceMin, randVarianceMax));
                    set_val(PS4_RX, random(randVarianceMin, randVarianceMax));
                } else {
                    set_val(PS4_RY, DOWN_ANALOG_VALUE + random(randVarianceMin, randVarianceMax));
                    set_val(PS4_RX, random(randVarianceMin, randVarianceMax));
                }
                squareLocked = 1;
            }
            if (event_release(PS4_SQUARE) && squareLocked) {
                squareLocked = 0;
                if (fadeFlickActive && get_val(PS4_R2)) { combo_run(tempoFadeSequence); }
                else { combo_run(tempoShotSequence); }
            }
        }

        if (dunkAssistOn && !quickstop_square_holding) {
            if (event_press(PS4_L3)) { combo_run(dunkMeterControl); }
            if (get_val(PS4_L3)) { set_val(PS4_L3, 0); set_val(PS4_R2, 100); set_val(PS4_RY, DOWN_ANALOG_VALUE); }
            if (event_release(PS4_L3)) { set_val(PS4_RY, 0); set_val(PS4_R2, 0); }
        }
        
        set_val(PS4_UP, get_val(PS4_UP));
        set_val(PS4_RIGHT, get_val(PS4_RIGHT));
        set_val(PS4_DOWN, get_val(PS4_DOWN));
        set_val(PS4_LEFT, get_val(PS4_LEFT));
    } else {
        if(quickstop_square_holding) {
            quickstop_square_holding = FALSE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
            combo_stop(quickstopShotDelay); set_val(PS4_SQUARE, 0);
        }
        
        set_val(PS4_UP, get_val(PS4_UP));
        set_val(PS4_RIGHT, get_val(PS4_RIGHT));
        set_val(PS4_DOWN, get_val(PS4_DOWN));
        set_val(PS4_LEFT, get_val(PS4_LEFT));
    }

    if (!squareLocked && !enhancedMode && !shootingInProgress && !defenseState && !quickstop_square_holding) {
        set_val(PS4_RY, get_val(PS4_RY)); set_val(PS4_RX, get_val(PS4_RX));
    }
    if (quickstop_square_holding && quickstop_shot_active && !get_val(PS4_SQUARE)) {
        quickstop_square_holding = FALSE; quickstop_flick_done = FALSE; quickstop_shot_active = FALSE;
        set_val(PS4_SQUARE, 0);
    }
} ����������������