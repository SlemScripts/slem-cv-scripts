            if (event_press(PS4_RIGHT)) ftShotTiming += 5; if (event_press(PS4_LEFT)) ftShotTiming -= 5;
            if (event_press(PS4_UP) || event_press(PS4_DOWN) || event_press(PS4_RIGHT) || event_press(PS4_LEFT)) {
