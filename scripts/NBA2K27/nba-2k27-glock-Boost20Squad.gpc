    timingPreset = 2;
}

function centerText(textLength, fontWidth) { return (OLED_WIDTH / 2) - ((textLength * fontWidth) / 2); }
function displayNumber(value, digits) {
    bufPos = 1; numericPos = 10000;
    if (value < 0) { putc_oled(bufPos, 45); bufPos += 1; value = abs(value); }
    for (charPosition = 5; charPosition >= 1; charPosition--) {
        if (digits >= charPosition) {
            putc_oled(bufPos, (value / numericPos) + 48); value %= numericPos; bufPos++;
            if (charPosition == 4) { putc_oled(bufPos, 44); bufPos++; }
        } numericPos /= 10;
    }
    puts_oled(centerText(bufPos + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufPos - 1, OLED_WHITE);
}
function countDigits(num) {
    counterValue = 0; do { num /= 10; counterValue++; } while (num); return counterValue;
}
function getStringLength(offset) {
    textLength = 0; while (duint8(offset++)) { textLength++; } return textLength;
}

function remappedSquareButtonPressed() {
    if (buttonRemapOption == 0) {
        return get_val(PS4_R3);
    }
    return get_val(PS4_L1);
}

function loadProfile(profileNum) {
    currentProfile = profileNum;
    
    tempoShotActive = savedTempoShot[currentProfile];
    fadeFlickActive = savedFadeFlick[currentProfile];
    autoGreenEnabled = savedAutoGreen[currentProfile];
    dunkAssistOn = savedDunkAssist[currentProfile];
    quickstopOn = savedQuickstop[currentProfile];
    qsVariant = savedQsVariant[currentProfile];
    defenseBoostActive = savedDefenseMode[currentProfile];
    freeThrowActive = savedFreeThrow[currentProfile];
    catchShotTiming = savedCatchTiming[currentProfile];
    jumpShotTiming = savedJumpTiming[currentProfile];
    moveShotTiming = savedMoveTiming[currentProfile];
    ftShotTiming = savedFtTiming[currentProfile];
    flickDelayTime = savedFlickDelay[currentProfile];
    buttonRemapOption = savedButtonRemap[currentProfile];
    
    if (tempoShotActive && autoGreenEnabled) {
        autoGreenEnabled = 0;
        savedAutoGreen[currentProfile] = 0;
    }
    
    SaveProfileSettings();
    profileChanged = 1;
}

function saveProfile(profileNum) {
    savedTempoShot[profileNum] = tempoShotActive;
    savedFadeFlick[profileNum] = fadeFlickActive;
    savedAutoGreen[profileNum] = autoGreenEnabled;
    savedDunkAssist[profileNum] = dunkAssistOn;
    savedQuickstop[profileNum] = quickstopOn;
    savedQsVariant[profileNum] = qsVariant;
    savedDefenseMode[profileNum] = defenseBoostActive;
    savedFreeThrow[profileNum] = freeThrowActive;
    savedCatchTiming[profileNum] = catchShotTiming;
    savedJumpTiming[profileNum] = jumpShotTiming;
    savedMoveTiming[profileNum] = moveShotTiming;
    savedFtTiming[profileNum] = ftShotTiming;
    savedFlickDelay[profileNum] = flickDelayTime;
    savedButtonRemap[profileNum] = buttonRemapOption;
    
    SaveProfileSettings();
    profileChanged = 1;
}

