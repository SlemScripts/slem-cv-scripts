// ===== Menu state =====
int startup = 1, numpgs = 7, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;

// ===== Menu labels =====
const string menu_header[] = { "Infinite Stamina", "Tempo Speed (ms)", "Stability", "RS Hold (ms)", "Insta Speed (ms)", "Insta Tempo (ms)", "Go-To (ms)" };
const string pageChg[] = {"L2 + RIGHT", "L2 LEFT / RIGHT", "L2 + LEFT"};
const string item_toggle[] = {"L2 + UP/DOWN", "to change"};
const string onOff[] = {"OFF", "ON", "", "L3", "R3"};
const string ms[] = {"ms"};
const string reverse_modes[] = {"Hop Jumper", "Turbo Fade"};

// display for Turbo Shots page
int isLoadingScreen = 1;
define LoadingTimer = 5000;
int LoadingTimeToRun = 0;

// Additional variables for graph
int graph_width;
int x_start;
int mid_x;
int bar_pos;
int intro_bar_pos;
int anim_frame;
int ball_x;
int ball_y;
int star_tick = 0, star_timer = 0;
int intro_x = 20, intro_y = 24, intro_vx = 2, intro_vy = 1;
int idle_x = 6, idle_y = 16, idle_vx = 2, idle_vy = 1;
int bounce_timer = 0;
int rgb_timer = 0, rgb_phase = 0;
int infinite_stamina = 0;      // ON/OFF toggle
int ground_control = 70;       // % of stick strength (lower = less stamina drain)
int ground_stick_active = 1;   // must be ON
int shooting_active = 0;       // disables stamina while shooting
// New flag for turbo fade
int is_turbo_fade = 0;

// ===== Init =====
init {
flick_up_shooting_active = 1;
delay_duration = 60;
Delay_duration_Insta = 60;
reverse_flick_mode = 1;
rs_shooting_active = 0;
rs_hold_duration = 500;
Insta_shot_active = 1;
Insta_shot_duration = 615;
go_to_duration = 2030;
remap_square_active = 0;
stabilization_variation = 300000;
saver_on = 0;
saver_timer = 0;
star_tick = 0; star_timer = 0;
intro_x = 20; intro_y = 24; intro_vx = 2; intro_vy = 1;
idle_x = 6; idle_y = 16; idle_vx = 2; idle_vy = 1;
bounce_timer = 0;
rgb_timer = 0; rgb_phase = 0;
cls_oled(OLED_BLACK);
}

// ===== Main =====
main {
// Console detect
if (get_console() == PIO_XB1) {
isXbox = 1;
} else {
isXbox = 0;
}
update_star_tick();
update_rgb_rainbow();

// ===== STARTUP / LOADING =====

if (isLoadingScreen) {
LoadingTimeToRun += get_rtime();
draw_startup_screen();
if (LoadingTimeToRun >= LoadingTimer) {
cls_oled(OLED_BLACK);
isLoadingScreen = 0;
startup = 0;
saver_on = 1;
saver_timer = 80; // draw a saver frame soon
}
}
combo_run(Infinite_Stamina_Control);

if (get_val(PS4_SQUARE)
    || combo_running(Insta_shot_reversed)) {   //  ADD THIS
    shooting_active = 1;
} else if (!combo_running(flick_up_rs_smooth)
        && !combo_running(flick_up_rs_reversed)
        && !combo_running(Insta_shot_smooth)
        && !combo_running(Insta_shot_reversed)) { //  ADD THIS
    shooting_active = 0;
}
// ===== Menu open/close =====
if (event_press(PS4_CIRCLE) && menu_enabled) { // CLOSE MENU
menu_enabled = 0;
combo_run(vibration_off);
update_rgb_rainbow();
saver_on = 1; // enable saver when leaving menu
} else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) { // OPEN MENU
menu_enabled = 1;
page = 1;
combo_run(vibration_on);
update_rgb_rainbow();
saver_on = 0; // pause saver while menu is up
}

// ===== MENU RENDER & INPUT =====
if (menu_enabled) {
cls_oled(OLED_BLACK);
draw_values_basketball_background();

if (page == 1) {
pageChg_s = 0;
} else if (page == numpgs) {
pageChg_s = 2;
} else {
pageChg_s = 1;
}

if (page > numpgs) page = numpgs;
if (page < 1) page = 1;

print(center_x(get_string_length(pageChg[pageChg_s]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageChg[pageChg_s]);
print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

if (page == 1) {
menuSelection = infinite_stamina;
toggleType = 0;
print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
} else {
toggleType = 0;
if (page == 2) {
NumberToString(delay_duration, FindDigits(delay_duration));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
} else if (page == 3) {
StabilityToString(stabilization_variation);
} else if (page == 4) {
NumberToString(rs_hold_duration, FindDigits(rs_hold_duration));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
} else if (page == 5) {
NumberToString(Insta_shot_duration, FindDigits(Insta_shot_duration));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
} else if (page == 6) {
NumberToString(Delay_duration_Insta, FindDigits(Delay_duration_Insta));
print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
} else if (page == 7) {
GoToToString(go_to_duration);
}
}

print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_toggle[toggleType]);

if (get_val(PS4_L2)) {
set_val(PS4_UP,0);
set_val(PS4_DOWN,0);
set_val(PS4_LEFT,0);
set_val(PS4_RIGHT,0);
}

if (get_val(PS4_L2) && event_press(PS4_LEFT)) {
page--;
combo_run(vibration_valchg);
}
if (get_val(PS4_L2) && event_press(PS4_RIGHT)) {
page++;
combo_run(vibration_valchg);
}

if (page == 1) {
if (get_val(PS4_L2) && event_press(PS4_UP)) {
infinite_stamina = 1;
flashtoggle = 1;
combo_run(vibration_valchg);
combo_run(flashtog);
}
if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
infinite_stamina = 0;
flashtoggle = 0;
combo_run(vibration_valchg);
combo_run(flashtog);
}
}

if (page == 2 && get_val(PS4_L2)) {
if (event_press(PS4_UP)) delay_duration++;
if (event_press(PS4_DOWN)) delay_duration--;
if (delay_duration > 300) delay_duration = 300;
if (delay_duration < 0) delay_duration = 0;
if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
}

if (page == 3 && get_val(PS4_L2)) {
if (get_val(PS4_R1)) {
if (event_press(PS4_UP)) stabilization_variation += 10000;
if (event_press(PS4_DOWN)) stabilization_variation -= 10000;
} else {
if (event_press(PS4_UP)) stabilization_variation += 1000;
if (event_press(PS4_DOWN)) stabilization_variation -= 1000;
}
if (stabilization_variation > 500000) stabilization_variation = 500000;
if (stabilization_variation < 1000) stabilization_variation = 1000;
if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
}

if (page == 4 && get_val(PS4_L2)) {
if (get_val(PS4_R1)) {
if (event_press(PS4_UP)) rs_hold_duration += 10;
if (event_press(PS4_DOWN)) rs_hold_duration -= 10;
} else {
if (event_press(PS4_UP)) rs_hold_duration++;
if (event_press(PS4_DOWN)) rs_hold_duration--;
}
if (rs_hold_duration > 1000) rs_hold_duration = 1000;
if (rs_hold_duration < 0) rs_hold_duration = 0;
if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
}

if (page == 5 && get_val(PS4_L2)) {
if (get_val(PS4_R1)) {
if (event_press(PS4_UP)) Insta_shot_duration += 10;
if (event_press(PS4_DOWN)) Insta_shot_duration -= 10;
} else {
if (event_press(PS4_UP)) Insta_shot_duration++;
if (event_press(PS4_DOWN)) Insta_shot_duration--;
}
if (Insta_shot_duration > 1000) Insta_shot_duration = 1000;
if (Insta_shot_duration < 100) Insta_shot_duration = 100;
if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
}

if (page == 6 && get_val(PS4_L2)) {
if (event_press(PS4_UP)) Delay_duration_Insta++;
if (event_press(PS4_DOWN)) Delay_duration_Insta--;
if (Delay_duration_Insta > 300) Delay_duration_Insta = 300;
if (Delay_duration_Insta < 0) Delay_duration_Insta = 0;
if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
}

if (page == 7 && get_val(PS4_L2)) {
if (get_val(PS4_R1)) {
if (event_press(PS4_UP)) go_to_duration += 10;
if (event_press(PS4_DOWN)) go_to_duration -= 10;
} else {
if (event_press(PS4_UP)) go_to_duration++;
if (event_press(PS4_DOWN)) go_to_duration--;
}
if (go_to_duration > 4000) go_to_duration = 4000;
if (go_to_duration < 500) go_to_duration = 500;
if (event_press(PS4_UP) || event_press(PS4_DOWN)) { combo_run(vibration_valchg); combo_run(flashedit); }
}
} // end menu_enabled

// ===== Gameplay logic (no menu) =====
if (!menu_enabled) {
// idle visuals
update_rgb_rainbow();

// run saver every ~80ms only when outside the menu
if (saver_on) {
saver_timer += get_rtime();
if (saver_timer >= 80) {
saver_step();
saver_timer = 0;
}
}

// L3/R3 Remap Logic for Square
if (remap_square_active == 0) {
if (get_val(PS4_L3)) {
set_val(PS4_SQUARE, 100);
}
} else {
if (get_val(PS4_R3)) {
set_val(PS4_SQUARE, 100);
}
}

// Detect press of Square for flag
if (event_press(PS4_SQUARE) && !(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
if (reverse_flick_mode && get_val(PS4_R2)) {
is_turbo_fade = 1;
} else {
is_turbo_fade = 0;
}
}

// Auto Green (flick-up) logic
if (flick_up_shooting_active) {
if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE)) {
set_val(PS4_SQUARE, 0);
if (is_turbo_fade) {
set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
} else {
set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
}
set_val(PS4_RX, random(random_variation_min, random_variation_max));
}
if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE)) {
if (is_turbo_fade) {
combo_run(flick_up_rs_reversed);
} else {
combo_run(flick_up_rs_smooth);
}
is_turbo_fade = 0;
}
}
// D-PAD DOWN -> Go To Shot Insta (priority)
if (event_press(PS4_DOWN)) {
    combo_run(go_to_shot_insta);
    
}



// 2. Normal Insta Shot logic
if (Insta_shot_active) {
    if ((remap_square_active == 0 && event_press(PS4_R3)) ||
        (remap_square_active == 1 && event_press(PS4_L3))) {

        if (reverse_flick_mode && get_val(PS4_R2)) {
            combo_run(Insta_shot_reversed);
        } else {
            combo_run(Insta_shot_smooth);
        }
    }
}

// Insta Shot Logic (R3/L3 depending on remap)
if (Insta_shot_active) {
if ((remap_square_active == 0 && event_press(PS4_R3)) || (remap_square_active == 1 && event_press(PS4_L3))) {
if (reverse_flick_mode && get_val(PS4_R2)) {
combo_run(Insta_shot_reversed);
} else {
combo_run(Insta_shot_smooth);
}
}
}

// RS Shooting (detect manual stick hold)
if (rs_shooting_active) {
if (!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
if (!isHolding) {
isHolding = 1;
holdTimer = 0;
if (get_val(PS4_RY) < 0) {
rs_is_up = 1;
} else {
rs_is_up = 0;
}
}
holdTimer += get_rtime();
} else {
if (isHolding) {
if (holdTimer > rs_hold_duration) {
if (!rs_is_up) {
combo_run(flick_up_rs_smooth);
} else {
combo_run(flick_up_rs_reversed);
}
}
isHolding = 0;
holdTimer = 0;
}
}
}
}
} // end !menu_enabled
} // end big else (post-startup)


// ===== OLED helpers =====


function saver_step() {
draw_tt_scripture_screen();
}

function update_star_tick() {
star_timer += get_rtime();
if (star_timer >= 120) {
star_tick++;
if (star_tick > 11) star_tick = 0;
star_timer = 0;
}
}

function update_intro_bounce() {
bounce_timer += get_rtime();
if (bounce_timer >= 80) {
intro_x += intro_vx;
intro_y += intro_vy;
if (intro_x <= 0 || intro_x >= 62) intro_vx = -intro_vx;
if (intro_y <= 0 || intro_y >= 54) intro_vy = -intro_vy;
bounce_timer = 0;
}
}

function step_idle_bounce() {
idle_x += idle_vx;
idle_y += idle_vy;
if (idle_x <= 0 || idle_x >= 38) idle_vx = -idle_vx;
if (idle_y <= 0 || idle_y >= 44) idle_vy = -idle_vy;
}

