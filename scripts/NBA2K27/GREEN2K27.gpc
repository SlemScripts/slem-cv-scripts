    set_pvar(SPVAR_4, 1);
    set_pvar(SPVAR_11, 1);
    set_pvar(SPVAR_12, 2);
    set_pvar(SPVAR_24, 0);
        set_pvar(SPVAR_40, GEN_HASH);
    }
