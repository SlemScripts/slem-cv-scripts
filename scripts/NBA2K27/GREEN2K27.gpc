function _ude() { if (_du > 0 || _dd > 0 || _dl > 0 || _dr > 0) { _de = 1; } else { _de = 0; } }
function _dpd(c, t) {
    _tdt = t;
    _cdt = c;
    line_oled(8, 58, 119, 58, 1, OLED_WHITE);
    if (_tdt > 1) {
        _dtx = 8 + (_cdt * 111) / (_tdt - 1);
    } else {
        _dtx = 63;
    }
    rect_oled(_dtx - 2, 56, 5, 5, 1, OLED_WHITE);
}
function _dtp(x, y, o) {
    if (o) {
        rect_oled(x, y, 8, 8, 1, OLED_WHITE);
    } else {
        rect_oled(x, y, 8, 8, 1, OLED_WHITE);
        rect_oled(x + 1, y + 1, 6, 6, 1, OLED_BLACK);
    }
}
function _dch(x, y) {
    line_oled(x, y, x + 4, y + 4, 1, OLED_WHITE);
    line_oled(x + 4, y + 4, x, y + 8, 1, OLED_WHITE);
    line_oled(x, y, x, y + 8, 1, OLED_WHITE);
}
combo _mc {
    if (_is && _gsa && !_mdo && !_ssp && !_rsp && !get_val(PS4_SQUARE) && !combo_running(_furs) && !combo_running(_furr) && !combo_running(_tss) && !combo_running(_tsr) && !combo_running(_ruc) && !combo_running(_rdc)) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            _mt = _mt + get_rtime() + (_tc1 / _tc1) - 1;
            if (_is == 1) {
                _gcc = _gcn;
            } else if (_is == 2) {
                if (_mt <= _rdl) { _gcc = _gcx; }
                else if (_mt <= _rdl + _rdr) { _gcc = _gcx - ((_gcx - _gcn) * (_mt - _rdl) / _rdr); }
                else { _gcc = _gcn; }
            }
            set_val(PS4_LX, (get_val(PS4_LX) * _gcc) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * _gcc) / 100);
        } else { _mt = 0; _gcc = _gcx; }
        if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) { set_val(PS4_LX, 0); set_val(PS4_LY, 0); }
    }
}
function _aoc() { set_rgb(0, 255, 0); }
function _ulm(o) { if (o) { _aoc(); } else { set_rgb(0, 0, 0); } }
function _dis() {
    cls_oled(0);
    _mft += get_rtime();
    _txt += get_rtime();
    if (_mph == 0) {
        _mfl += 2; if (_mfl >= 32) { _mfl = 32; _mph = 1; _mft = 0; }
    } else if (_mph == 1) {
        if (_mft >= 20) { _mft = 0; _mfl += 1; if (_mfl >= 36) { _mph = 2; _exf = 0; _mft = 0; } }
    } else if (_mph == 2) {
        if (_mft >= 35) { _mft = 0; _exf += 1; if (_exf >= 14) { _mph = 3; _mft = 0; } }
    } else if (_mph == 3) {
        _mfl -= 2; if (_mfl <= 0) { _mfl = 0; _mph = 4; _mft = 0; }
    } else {
        if (_mft >= 1500) { _mft = 0; _mph = 0; }
    }
    rect_oled(10, 12, 12, 40, 1, OLED_WHITE);
    if (_mfl > 0) rect_oled(12, 52 - _mfl, 8, _mfl, 1, OLED_BLACK);
    rect_oled(12, 20, 8, 1, 1, OLED_BLACK);
    if (_mph == 2) {
        if (_exf < 3) {
            rect_oled(4, 8, 3, 3, 1, OLED_WHITE);
            rect_oled(24, 8, 3, 3, 1, OLED_WHITE);
            rect_oled(2, 14, 4, 2, 1, OLED_WHITE);
            rect_oled(25, 14, 4, 2, 1, OLED_WHITE);
            rect_oled(14, 8, 4, 2, 1, OLED_WHITE);
        }
        if (_exf < 10) {
            _mfr = _exf + 1;
            rect_oled(15 - _mfr * 2, 12 - _mfr * 2, 2, 2, 1, OLED_WHITE);
            rect_oled(17 + _mfr * 2, 12 - _mfr * 2, 2, 2, 1, OLED_WHITE);
            pixel_oled(8 - _mfr * 3, 14 + _mfr, 1);
            pixel_oled(24 + _mfr * 3, 14 + _mfr, 1);
            pixel_oled(16, 11 - _mfr * 3, 1);
            pixel_oled(11 - _mfr * 3, 13 - _mfr * 2, 1);
            pixel_oled(22 + _mfr * 3, 13 - _mfr * 2, 1);
            pixel_oled(7 - _mfr * 2, 16 + _mfr * 2, 1);
            pixel_oled(25 + _mfr * 2, 16 + _mfr * 2, 1);
        }
    }
    if (_txt >= 2500) { _txt = 0; _txs = !_txs; }
    if (!_txs) print(36, 20, OLED_FONT_MEDIUM, OLED_WHITE, _gn[0]);
    else print(36, 20, OLED_FONT_MEDIUM, OLED_WHITE, _bw[0]);
    print(36, 42, OLED_FONT_SMALL, OLED_WHITE, _UL[0]);
}
function _ait() { if (_it) { if (get_val(PS4_L2) > 0) { set_val(PS4_L2, 100); } if (get_val(PS4_R2) > 0) { set_val(PS4_R2, 100); } } }
function _hmd() {
    if (_md > 0) {
        if (_md == 1) { if (get_val(PS4_L1)) { set_val(PS4_RY, 100); set_val(PS4_R2, 100); _mdo = 1; } else if (event_release(PS4_L1)) { set_val(PS4_RY, 0); set_val(PS4_R2, 0); _mdo = 0; } }
        else if (_md == 2) { if (get_val(PS4_CIRCLE)) { set_val(PS4_RY, 100); set_val(PS4_R2, 100); _mdo = 1; } else if (event_release(PS4_CIRCLE)) { set_val(PS4_RY, 0); set_val(PS4_R2, 0); _mdo = 0; } }
    } else if (_mdo) { set_val(PS4_RY, 0); set_val(PS4_R2, 0); _mdo = 0; }
}
function _hst() { if (_sp && get_val(PS4_CROSS) && !_me) { combo_run(_stc); } }
function _gtm() { return random(_tmn[_d1], _tmx[_d1]) + (_tc3 / _tc3) - 1; }
function _gam() { return random(_asmn[_ags], _asmx[_ags]); }
function _gtb() { return random(_tbmn[_tbs], _tbmx[_tbs]); }
function _trv() {
    if (_rv && get_val(PS4_SQUARE)) {
        if (!_sqh) { _sqh = 1; _shs = _ct; _va = 0; _vt = 0; }
        else { _hd = _ct - _shs; if (_hd >= _hpm[_rvs] && !_vt) { set_rumble(RUMBLE_A, 100); _va = 1; _vt = 1; } }
    } else if (!get_val(PS4_SQUARE)) { if (_va) { set_rumble(RUMBLE_A, 0); _va = 0; } _sqh = 0; _vt = 0; }
}
