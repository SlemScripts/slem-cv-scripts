define GEN_HASH = 17902;
function InitializeGeneratorSettings() {
    if (get_pvar(SPVAR_40, 0, 32767, 0) != GEN_HASH) {
    set_pvar(SPVAR_3, 0);
    set_pvar(SPVAR_9, 0);
    set_pvar(SPVAR_10, 2);
    set_pvar(SPVAR_5, 1);
    set_pvar(SPVAR_27, 1);
    set_pvar(SPVAR_2, 0);
