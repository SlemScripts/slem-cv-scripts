    _tbmx[0]=740; _tbmx[1]=760; _tbmx[2]=780; _tbmx[3]=800; _tbmx[4]=820;
    InitializeGeneratorSettings();
    _lpv();
    _ude();
    _zi = 0;
    while (_zi < 15) {
        _zx[_zi] = random(0, 127);
        _zy[_zi] = random(2, 50);
        _zi = _zi + 1;
    }
    _aoc();
    vm_tctrl(-2);
    _fdph = 1; _fdtm = 0;
    cls_oled(0);
    image_oled(0, 0, TRUE, TRUE, _LOGO[0]);
}
