        print(
            center_x(get_string_length(DRIBBLE_DOWN_NAMES[selection]), OLED_FONT_MEDIUM_WIDTH),
            30, OLED_FONT_MEDIUM, OLED_WHITE,
            DRIBBLE_DOWN_NAMES[selection]
        );
