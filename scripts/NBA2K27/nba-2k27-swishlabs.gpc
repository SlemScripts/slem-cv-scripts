combo Unlimited_Stamina_Control {
    if (unlimited_stamina && stamina_stick_active && !dunk_guard) {
        if (abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * stamina_ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * stamina_ground_control) / 100);
        }
        if (abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

function center_x(f_chars, f_font) {
    return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

int bufferIndex, digitIndex, charIndex;
function NumberToString(f_val, f_digits) {
    bufferIndex = 1;
    digitIndex = 10000;
    if (f_val < 0) { putc_oled(bufferIndex, 45); bufferIndex += 1; f_val = abs(f_val); }
    for (charIndex = 5; charIndex >= 1; charIndex--) {
        if (f_digits >= charIndex) {
            putc_oled(bufferIndex, (f_val / digitIndex) + 48);
            f_val %= digitIndex;
            bufferIndex++;
            if (charIndex == 4) { putc_oled(bufferIndex, 44); bufferIndex++; }
        }
        digitIndex /= 10;
    }
    puts_oled(center_x(bufferIndex + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_WHITE);
}

int logVal;
function FindDigits(num) {
    logVal = 0;
    do { num /= 10; logVal++; } while (num);
    return logVal;
}

int stringLength;
function get_string_length(offset) {
    stringLength = 0;
    while (duint8(offset++)) { stringLength++; }
    return stringLength + 1;
}

function saver_step() {
    starfield_step();
    cls_oled(OLED_BLACK);
    starfield_draw();

    print(saver_brand_x, saver_brand_y, OLED_FONT_MEDIUM, OLED_WHITE, brand_txt[0]);

    if (isXbox) {
        print(saver_line1_x, saver_line1_y, OLED_FONT_SMALL, OLED_WHITE, saver_line1_xb[0]);
    } else {
        print(saver_line1_x, saver_line1_y, OLED_FONT_SMALL, OLED_WHITE, saver_line1_ps[0]);
    }
    print(saver_line2_x, saver_line2_y, OLED_FONT_SMALL, OLED_WHITE, saver_line2_any[0]);
}

function saver_init_static() {
    saver_brand_x = center_x(get_string_length(brand_txt[0]), OLED_FONT_MEDIUM_WIDTH);
    saver_brand_y = 10;

    if (isXbox) {
        saver_line1_x = center_x(get_string_length(saver_line1_xb[0]), OLED_FONT_SMALL_WIDTH);
    } else {
        saver_line1_x = center_x(get_string_length(saver_line1_ps[0]), OLED_FONT_SMALL_WIDTH);
    }
    saver_line2_x = center_x(get_string_length(saver_line2_any[0]), OLED_FONT_SMALL_WIDTH);

    saver_line1_y = 30;
    saver_line2_y = 42;
}

function DISPLAY_DRIBBLE_UP_NAME(selection) {
    if (selection >= 0 && selection < 4) {
        print(
            center_x(get_string_length(DRIBBLE_UP_NAMES[selection]), OLED_FONT_MEDIUM_WIDTH),
            30, OLED_FONT_MEDIUM, OLED_WHITE,
            DRIBBLE_UP_NAMES[selection]
        );
    }
}

