define DRIB_MOVE_MAX = 272;




// ---- New from Binds NBA 2K26 V2: Dunk trigger/style names ----

define PVAR_BASE = 30;
define PVAR_OFFSET = 3;

function SaveProfile(idx) {
    p_start = PVAR_BASE + (idx - 1) * PVAR_OFFSET;
    val0 = 0;
    val1 = 0;

    if(flick_up_shooting_active) val0 = val0 | 1;
    if(reverse_flick_mode)       val0 = val0 | 2;
    if(meter_dunk_active)        val0 = val0 | 8;
    val0 = val0 | (remap_square_active << 7);
    
    set_pvar(p_start, val0);

    val1 = delay_duration; 
    val1 = val1 | (stabilization_variation << 9);
    set_pvar(p_start + 1, val1);
}

function LoadProfile(idx) {
    p_start = PVAR_BASE + (idx - 1) * PVAR_OFFSET;
    val0 = get_pvar(p_start, -2147483648, 2147483647, 0);
    val1 = get_pvar(p_start + 1, -2147483648, 2147483647, 0);

    flick_up_shooting_active = (val0 & 1);
    reverse_flick_mode       = (val0 >> 1) & 1;
    meter_dunk_active        = (val0 >> 3) & 1;
    remap_square_active      = (val0 >> 7) & 3;

    // ---- Guard against out-of-range values from stale/older saved profiles ----
    if (meter_dunk_active < 0 || meter_dunk_active > 1) { meter_dunk_active = 0; }
    if (remap_square_active < 0 || remap_square_active > 1) { remap_square_active = 1; }

    delay_duration = val1 & 511;
    stabilization_variation = (val1 >> 9) & 127;
}

init {
    current_profile = get_pvar(PVAR_PROFILE_SLOT, PROFILE_MIN, PROFILE_MAX, 1);
    LoadProfile(current_profile);
    profile_sel = current_profile;
    last_menu_page = get_pvar(PVAR_LAST_PAGE, 1, numpgs, 1);

    smart_timing_enabled = get_pvar(PVAR_SMART_TIMING, 0, 1, 0);
    smart_fade_offset    = get_pvar(PVAR_SMART_FADE,   0, 100, 30);
    smart_quick_offset   = get_pvar(PVAR_SMART_QUICK,  0, 100, 20);
    shotlog_enabled      = get_pvar(PVAR_SHOTLOG,      0, 1,   0);
    shot_vibe_enabled    = get_pvar(PVAR_SHOT_VIBE,    0, 1,   0);
    shot_vibe_ms         = get_pvar(PVAR_SHOT_VIBE_MS, 100, 1500, 500);
    fade_vibe_enabled    = get_pvar(PVAR_FADE_VIBE,    0, 1,   0);
    fade_vibe_ms         = get_pvar(PVAR_FADE_VIBE_MS, 100, 1500, 500);
    nodip_enabled        = get_pvar(PVAR_NODIP_ON,     0, 1,   0);
    nodip_tempo_ms       = get_pvar(PVAR_NODIP_MS,     120, 420, 270);
    auto_stand_on        = get_pvar(PVAR_AUTO_STAND,   0, 1, 0);
    auto_fade_on         = get_pvar(PVAR_AUTO_FADE,    0, 1, 0);
    auto_nodip_on        = get_pvar(PVAR_AUTO_NODIP,   0, 1, 0);
    auto_speed_ms        = get_pvar(PVAR_AUTO_SPEED,   100, 1000, 500);
    auto_tempo_ms        = get_pvar(PVAR_AUTO_TEMPO_A, 0, 300, 50);
    btn_shot_on          = get_pvar(PVAR_BTN_SHOT_ON,  0, 1,   0);
    btn_shot_hold_ms     = get_pvar(PVAR_BTN_SHOT_MS,  0, 1000, 500);

    // ---- Load new global settings (Dunk / Soft Trigger) ----
    tk_at_on            = get_pvar(PVAR_SOFT_TRIGGER,    0, 1,    1);
    slam_enabled_l1     = 0;
    slam_trig_l1        = get_pvar(PVAR_SLAM_TRIG_L1,    0, 1,    0);
    slam_style_l1       = get_pvar(PVAR_SLAM_STYLE_L1,   0, 3,    1);
    slam_enabled_o      = 0;
    slam_trig_o         = get_pvar(PVAR_SLAM_TRIG_O,     0, 1,    1);
    slam_style_o        = get_pvar(PVAR_SLAM_STYLE_O,    0, 3,    1);
    dunk_meter_on       = get_pvar(PVAR_DUNK_METER_ON,   0, 1,    0);
    dribble_on          = get_pvar(PVAR_DRIBBLE_ON,      0, 1,    0);
    drib_up             = get_pvar(PVAR_DRIB_UP,         0, DRIB_MOVE_MAX, 0);
    drib_dn             = get_pvar(PVAR_DRIB_DN,         0, DRIB_MOVE_MAX, 0);
    drib_lf             = get_pvar(PVAR_DRIB_LF,         0, DRIB_MOVE_MAX, 0);
    drib_rt             = get_pvar(PVAR_DRIB_RT,         0, DRIB_MOVE_MAX, 0);
    dunk_hold_dur       = get_pvar(PVAR_DUNK_HOLD,       1, 2000, 700);
    dunk_hold_dur_o     = get_pvar(PVAR_DUNK_HOLD_O,     1, 2000, 700);
    fade_toggle         = get_pvar(PVAR_FADE_TOGGLE,     0, 1,    1);
    fade_delay_ms       = get_pvar(PVAR_FADE_MS,         0, 300,  42);

    // ---- Force factory defaults exactly once ----
    // Soft Triggers and the shot button (R3) both need to already be ON
    // out of the box. A stale PVAR slot reused from an older script build
    // (or a fresh, never-written slot) reads back as 0, which silently
    // undoes both of those defaults on first load. This runs once ever per
    // device -- after it fires, the stamp is set and normal saved settings
    // (including a user's own later choice to switch back to L3 or turn
    // Soft Triggers off) are respected from then on.
    if (get_pvar(PVAR_DEFAULTS_STAMP, 0, 1, 0) == 0) {
        tk_at_on = 1;
        set_pvar(PVAR_SOFT_TRIGGER, 1);
        remap_square_active = 1; // R3
        for (dstamp_i = PROFILE_MIN; dstamp_i <= PROFILE_MAX; dstamp_i++) {
            dstamp_p = PVAR_BASE + (dstamp_i - 1) * PVAR_OFFSET;
            dstamp_v0 = get_pvar(dstamp_p, -2147483648, 2147483647, 0);
            dstamp_v0 = (dstamp_v0 & ~(3 << 7)) | (1 << 7);
            set_pvar(dstamp_p, dstamp_v0);
        }
        set_pvar(PVAR_DEFAULTS_STAMP, 1);
    }

    // ---- Load saved custom dunk bind (defaults to R2+L1) ----
    bind_name_idx = get_pvar(PVAR_DUNK_BIND, 0, 10, 0);
    if (bind_name_idx == 0)      { dunk_bind_btn = PS4_L1; }
    else if (bind_name_idx == 1) { dunk_bind_btn = PS4_CIRCLE; }
    else if (bind_name_idx == 2) { dunk_bind_btn = PS4_L2; }
    else if (bind_name_idx == 3) { dunk_bind_btn = PS4_TRIANGLE; }
    else if (bind_name_idx == 4) { dunk_bind_btn = PS4_SQUARE; }
    else if (bind_name_idx == 5) { dunk_bind_btn = PS4_R1; }
    else if (bind_name_idx == 6) { dunk_bind_btn = PS4_CROSS; }
    else if (bind_name_idx == 7) { dunk_bind_btn = PS4_UP; }
    else if (bind_name_idx == 8) { dunk_bind_btn = PS4_DOWN; }
    else if (bind_name_idx == 9) { dunk_bind_btn = PS4_LEFT; }
    else if (bind_name_idx == 10){ dunk_bind_btn = PS4_RIGHT; }

    set_rgb(TEAL_R, TEAL_G, TEAL_B);
    saver_on = 0;
    saver_timer = 0;
    cls_oled(OLED_BLACK);

    starfield_init();
    saver_on = 1;
    saver_timer = 0;
    ssp = 0;
    bb_x = bb_start_x; bb_y = bb_start_y; bb_vx = 5; bb_vy = -3; bb_tk = 0;
    bb_state = 0; bb_reset_t = 0;
    meter_fill = 0; meter_green = 0; meter_flash_t = 0; spark_t = 0;
}
main {
    set_rgb(TEAL_R, TEAL_G, TEAL_B);

    if (get_console() == PIO_XB1) { isXbox = 1; } else { isXbox = 0; }

    {
        if (event_press(PS4_CIRCLE) && menu_enabled && !np_active && !info_active && bind_cap_mode == 0) {
            if (menu_mode == 1) {
                menu_mode = 0;
                combo_run(vibration_valchg);
                set_val(PS4_CIRCLE, 0);
            } else {
                menu_enabled = 0;
                combo_run(vibration_off);
                set_rgb(0, 255, 0);
                saver_on = 1;
                saver_init_static();
                last_menu_page = page;
                
                SaveProfile(current_profile);
                set_pvar(PVAR_LAST_PAGE, last_menu_page);
                set_pvar(PVAR_PROFILE_SLOT, current_profile);

                // ---- Persist new global settings ----
                set_pvar(PVAR_SOFT_TRIGGER,    tk_at_on);
                set_pvar(PVAR_SLAM_EN_L1,      slam_enabled_l1);
                set_pvar(PVAR_SLAM_TRIG_L1,    slam_trig_l1);
                set_pvar(PVAR_SLAM_STYLE_L1,   slam_style_l1);
                set_pvar(PVAR_SLAM_EN_O,       slam_enabled_o);
                set_pvar(PVAR_SLAM_TRIG_O,     slam_trig_o);
                set_pvar(PVAR_SLAM_STYLE_O,    slam_style_o);
                set_pvar(PVAR_DUNK_METER_ON,   dunk_meter_on);
                set_pvar(PVAR_DRIBBLE_ON,      dribble_on);
                set_pvar(PVAR_DRIB_UP,         drib_up);
                set_pvar(PVAR_DRIB_DN,         drib_dn);
                set_pvar(PVAR_DRIB_LF,         drib_lf);
                set_pvar(PVAR_DRIB_RT,         drib_rt);
                set_pvar(PVAR_DUNK_HOLD,       dunk_hold_dur);
                set_pvar(PVAR_DUNK_HOLD_O,     dunk_hold_dur_o);
                set_pvar(PVAR_FADE_TOGGLE,     fade_toggle);
                set_pvar(PVAR_FADE_MS,         fade_delay_ms);
                set_pvar(PVAR_SMART_TIMING,    smart_timing_enabled);
                set_pvar(PVAR_SMART_FADE,      smart_fade_offset);
                set_pvar(PVAR_SMART_QUICK,     smart_quick_offset);
                set_pvar(PVAR_SHOTLOG,         shotlog_enabled);
                set_pvar(PVAR_SHOT_VIBE,       shot_vibe_enabled);
                set_pvar(PVAR_SHOT_VIBE_MS,    shot_vibe_ms);
                set_pvar(PVAR_FADE_VIBE,       fade_vibe_enabled);
                set_pvar(PVAR_FADE_VIBE_MS,    fade_vibe_ms);
                set_pvar(PVAR_NODIP_ON,        nodip_enabled);
                set_pvar(PVAR_NODIP_MS,        nodip_tempo_ms);
                set_pvar(PVAR_AUTO_STAND,      auto_stand_on);
                set_pvar(PVAR_AUTO_FADE,       auto_fade_on);
                set_pvar(PVAR_AUTO_NODIP,      auto_nodip_on);
                set_pvar(PVAR_AUTO_SPEED,      auto_speed_ms);
                set_pvar(PVAR_AUTO_TEMPO_A,    auto_tempo_ms);
                set_pvar(PVAR_BTN_SHOT_ON,     btn_shot_on);
                set_pvar(PVAR_BTN_SHOT_MS,     btn_shot_hold_ms);
                set_pvar(PVAR_DUNK_BIND,       bind_name_idx);
            }
        }
        else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = last_menu_page;
            
            category_index = 0;
            for (i = 0; i < NUM_CATEGORIES; i++) {
                if (page >= CAT_START[i] && page < (CAT_START[i] + CAT_COUNT[i])) {
                    category_index = i;
                }
            }
            
            menu_mode = 0; 
            menu_scroll_y = category_index * 10;

            combo_run(vibration_on);
            set_rgb(0, 0, 255);
            saver_on = 0;
        }

        if (menu_enabled) {
            dt_menu = get_rtime();
            repeat_update(dt_menu);
            starfield_step();
            cls_oled(OLED_BLACK);
            starfield_draw();

            set_val(PS4_UP, 0); set_val(PS4_DOWN, 0); 
            set_val(PS4_LEFT, 0); set_val(PS4_RIGHT, 0); 
            if (bind_cap_mode == 0) {
                set_val(PS4_CROSS, 0); set_val(PS4_CIRCLE, 0);
            }

            if (menu_mode == 0) {
                menu_target_y = category_index * 25;
                if (menu_scroll_y < menu_target_y) menu_scroll_y = menu_scroll_y + 2;
                if (menu_scroll_y > menu_target_y) menu_scroll_y = menu_scroll_y - 2;

                for(i = 0; i < NUM_CATEGORIES; i++) {
                    c_y = 25 + (i * 25) - menu_scroll_y;
                    
                    if (c_y >= -15 && c_y <= 70) {
                        str_len = get_string_length(CATEGORIES[i]);
                        
                        if (i == category_index) {
                             x_pos = center_x(str_len, OLED_FONT_MEDIUM_WIDTH);
                             print(x_pos, c_y, OLED_FONT_MEDIUM, OLED_WHITE, CATEGORIES[i]);
                             line_oled(39, c_y + 19, 89, c_y + 19, 3, OLED_WHITE);
                        } else {
                             x_pos = center_x(str_len, OLED_FONT_SMALL_WIDTH);
                             print(x_pos, c_y + 3, OLED_FONT_SMALL, OLED_WHITE, CATEGORIES[i]);
                        }
                    }
                }
                
                if (event_press(PS4_UP)) { 
                    category_index--; 
                    if(category_index < 0) category_index = NUM_CATEGORIES - 1; 
                    combo_run(vibration_valchg); 
                }
                if (event_press(PS4_DOWN)) { 
                    category_index++; 
                    if(category_index > (NUM_CATEGORIES - 1)) category_index = 0; 
                    combo_run(vibration_valchg); 
                }
                if (event_press(PS4_CROSS)) {
                    menu_mode = 1; 
                    if (last_menu_page >= CAT_START[category_index] && last_menu_page < (CAT_START[category_index] + CAT_COUNT[category_index])) {
                        page = last_menu_page;
                    } else {
                        page = CAT_START[category_index];
                    }
                    combo_run(vibration_valchg);
                }
            } else {
                p_len = get_string_length(menu_header[page - 1]);
                p_x = center_x(p_len, OLED_FONT_SMALL_WIDTH);
                print(p_x, 10, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);
                
                print(2, 25, OLED_FONT_SMALL, OLED_WHITE, ARROW_L[0]);
                print(115, 25, OLED_FONT_SMALL, OLED_WHITE, ARROW_R[0]);

                dot_count = CAT_COUNT[category_index];
                dot_start_x = 64 - ((dot_count * 10) / 2); 
                p_idx = page - CAT_START[category_index];
                
                for(i = 0; i < dot_count; i++) {
                    if (i == p_idx) {
                        rect_oled(dot_start_x + (i * 10), 58, 5, 5, 1, 1);
                    } else {
                        rect_oled(dot_start_x + (i * 10) + 1, 59, 3, 3, 1, 1);
                    }
                }

                if (event_press(PS4_LEFT) && !np_active && !info_active && bind_cap_mode == 0) { 
                    page--; 
                    if (page < CAT_START[category_index]) page = CAT_START[category_index] + CAT_COUNT[category_index] - 1; 
                    combo_run(vibration_valchg); 
                }
                if (event_press(PS4_RIGHT) && !np_active && !info_active && bind_cap_mode == 0) { 
                    page++; 
                    if (page >= CAT_START[category_index] + CAT_COUNT[category_index]) page = CAT_START[category_index]; 
                    combo_run(vibration_valchg); 
                }
                
                if ((event_press(PS4_LEFT) || event_press(PS4_RIGHT)) && !np_active && !info_active && bind_cap_mode == 0) {
                        last_menu_page = page;
                        set_pvar(PVAR_LAST_PAGE, last_menu_page);
                }

                if (event_press(PS4_TRIANGLE) && !np_active && !info_active) {
                    info_active = 1;
                    info_page = 0;
                    combo_run(vibration_valchg);
                }

                if (!info_active) {
                if (page == 1) {
                    menuSelection = flick_up_shooting_active;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { flick_up_shooting_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { flick_up_shooting_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 2) {
                    if (np_confirmed && np_tid == 1) { delay_duration = clamp(np_result, 0, 300); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(delay_duration, FindDigits(delay_duration));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(delay_duration, 0, 300, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { delay_duration++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { delay_duration--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (delay_duration > 300) { delay_duration = 300; }
                    if (delay_duration < 0) { delay_duration = 0; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 1; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                if (page == 3) {
                    menuSelection = remap_square_active;
                    if (isXbox) {
                        print(
                            center_x(get_string_length(remap_modes_xb[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                            30, OLED_FONT_MEDIUM, OLED_WHITE,
                            remap_modes_xb[menuSelection]
                        );
                    } else {
                        print(
                            center_x(get_string_length(remap_modes_ps[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                            30, OLED_FONT_MEDIUM, OLED_WHITE,
                            remap_modes_ps[menuSelection]
                        );
                    }
                    if (event_press(PS4_UP)) { remap_square_active = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { remap_square_active = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 4) {
                    menuSelection = smart_timing_enabled;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { smart_timing_enabled = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { smart_timing_enabled = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 5) {
                    if (np_confirmed && np_tid == 2) { smart_fade_offset = clamp(np_result, 0, 100); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(smart_fade_offset, FindDigits(smart_fade_offset));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(smart_fade_offset, 0, 100, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { smart_fade_offset++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { smart_fade_offset--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (smart_fade_offset > 100) { smart_fade_offset = 100; }
                    if (smart_fade_offset < 0) { smart_fade_offset = 0; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 2; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                if (page == 6) {
                    if (np_confirmed && np_tid == 3) { smart_quick_offset = clamp(np_result, 0, 100); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(smart_quick_offset, FindDigits(smart_quick_offset));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(smart_quick_offset, 0, 100, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { smart_quick_offset++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { smart_quick_offset--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (smart_quick_offset > 100) { smart_quick_offset = 100; }
                    if (smart_quick_offset < 0) { smart_quick_offset = 0; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 3; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                if (page == 7) {
                    menuSelection = shot_vibe_enabled;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { shot_vibe_enabled = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { shot_vibe_enabled = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 8) {
                    if (np_confirmed && np_tid == 4) { shot_vibe_ms = clamp(np_result, 100, 1500); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(shot_vibe_ms, FindDigits(shot_vibe_ms));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(shot_vibe_ms, 100, 1500, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { shot_vibe_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { shot_vibe_ms--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (shot_vibe_ms > 1500) { shot_vibe_ms = 1500; }
                    if (shot_vibe_ms < 100) { shot_vibe_ms = 100; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 4; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }


                if (page == 14) {
                    menuSelection = fade_toggle;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { fade_toggle = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { fade_toggle = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 15) {
                    if (np_confirmed && np_tid == 5) { fade_delay_ms = clamp(np_result, 0, 300); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(fade_delay_ms, FindDigits(fade_delay_ms));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(fade_delay_ms, 0, 300, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { fade_delay_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { fade_delay_ms--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (fade_delay_ms > 300) { fade_delay_ms = 300; }
                    if (fade_delay_ms < 0) { fade_delay_ms = 0; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 16; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                if (page == 16) {
                    menuSelection = reverse_flick_mode;
                    print(
                        center_x(get_string_length(reverse_modes[reverse_flick_mode]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        reverse_modes[reverse_flick_mode]
                    );
                    if (event_press(PS4_UP)) { reverse_flick_mode = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { reverse_flick_mode = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 17) {
                    menuSelection = fade_vibe_enabled;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { fade_vibe_enabled = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { fade_vibe_enabled = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 18) {
                    if (np_confirmed && np_tid == 15) { fade_vibe_ms = clamp(np_result, 100, 1500); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(fade_vibe_ms, FindDigits(fade_vibe_ms));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(fade_vibe_ms, 100, 1500, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { fade_vibe_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { fade_vibe_ms--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (fade_vibe_ms > 1500) { fade_vibe_ms = 1500; }
                    if (fade_vibe_ms < 100) { fade_vibe_ms = 100; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 15; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                if (page == 20) {
                    menuSelection = nodip_enabled;
                    print(
                        center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH),
                        30, OLED_FONT_MEDIUM, OLED_WHITE,
                        onOff[menuSelection]
                    );
                    if (event_press(PS4_UP)) { nodip_enabled = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { nodip_enabled = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 21) {
                    if (np_confirmed && np_tid == 6) { nodip_tempo_ms = clamp(np_result, 120, 420); np_confirmed = 0; }
                    if (!np_active) {
                    menuSelection = 2;
                    NumberToString(nodip_tempo_ms, FindDigits(nodip_tempo_ms));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(nodip_tempo_ms, 120, 420, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { nodip_tempo_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { nodip_tempo_ms--; }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (nodip_tempo_ms > 420) { nodip_tempo_ms = 420; }
                    if (nodip_tempo_ms < 120) { nodip_tempo_ms = 120; }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 6; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                // offset calc 66 32 105 32 110 32 100 32 115 → total 663
                if (page == 24) {
                    // Custom Dunk Bind — hold R2 + press any button, release R2 to save
                    if (bind_cap_mode == 0) {
                        // Show the current bind
                        if (isXbox) {
                            print(24, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_xb[0]);
                            print(64, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_xb[bind_name_idx]);
                        } else {
                            print(24, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_ps[0]);
                            print(64, 22, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_ps[bind_name_idx]);
                        }
                        print(center_x(get_string_length(bind_hint1[0]), OLED_FONT_SMALL_WIDTH), 44, OLED_FONT_SMALL, OLED_WHITE, bind_hint1[0]);

                        // Holding R2 arms capture (also locks menu nav so captured
                        // presses don't flip pages / exit the menu)
                        if (get_ival(PS4_R2) > 20) {
                            bind_cap_mode = 2;
                            bind_cap_btn = dunk_bind_btn;
                            bind_cap_name_idx = 11;   // "?" until a button is pressed
                            combo_run(vibration_valchg);
                        }
                    } else {
                        print(center_x(get_string_length(bind_locked[0]), OLED_FONT_SMALL_WIDTH), 6, OLED_FONT_SMALL, OLED_WHITE, bind_locked[0]);

                        if (get_ival(PS4_R2) > 20) {
                            // Physical input via get_ival (menu zeroes get_val).
                            // Keep scanning while R2 is held — pressing a different
                            // button before release just overwrites the pending bind.
                            if (get_ival(PS4_L1) > 20)            { bind_cap_btn = PS4_L1;       bind_cap_name_idx = 0; }
                            else if (get_ival(PS4_CIRCLE) > 20)   { bind_cap_btn = PS4_CIRCLE;   bind_cap_name_idx = 1; }
                            else if (get_ival(PS4_L2) > 20)       { bind_cap_btn = PS4_L2;       bind_cap_name_idx = 2; }
                            else if (get_ival(PS4_TRIANGLE) > 20) { bind_cap_btn = PS4_TRIANGLE; bind_cap_name_idx = 3; }
                            else if (get_ival(PS4_SQUARE) > 20)   { bind_cap_btn = PS4_SQUARE;   bind_cap_name_idx = 4; }
                            else if (get_ival(PS4_R1) > 20)       { bind_cap_btn = PS4_R1;       bind_cap_name_idx = 5; }
                            else if (get_ival(PS4_CROSS) > 20)    { bind_cap_btn = PS4_CROSS;    bind_cap_name_idx = 6; }
                            else if (get_ival(PS4_UP) > 20)       { bind_cap_btn = PS4_UP;       bind_cap_name_idx = 7; }
                            else if (get_ival(PS4_DOWN) > 20)     { bind_cap_btn = PS4_DOWN;     bind_cap_name_idx = 8; }
                            else if (get_ival(PS4_LEFT) > 20)     { bind_cap_btn = PS4_LEFT;     bind_cap_name_idx = 9; }
                            else if (get_ival(PS4_RIGHT) > 20)    { bind_cap_btn = PS4_RIGHT;    bind_cap_name_idx = 10; }

                            if (bind_cap_name_idx == 11) {
                                print(center_x(get_string_length(bind_cap_listen[0]), OLED_FONT_SMALL_WIDTH), 26, OLED_FONT_SMALL, OLED_WHITE, bind_cap_listen[0]);
                            } else {
                                if (isXbox) {
                                    print(24, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_xb[0]);
                                    print(64, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_xb[bind_cap_name_idx]);
                                } else {
                                    print(24, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_r2_ps[0]);
                                    print(64, 24, OLED_FONT_MEDIUM, OLED_WHITE, bind_btn_names_ps[bind_cap_name_idx]);
                                }
                            }
                            print(center_x(get_string_length(bind_cap_apply[0]), OLED_FONT_SMALL_WIDTH), 46, OLED_FONT_SMALL, OLED_WHITE, bind_cap_apply[0]);
                        } else {
                            // R2 released — save if a button was captured, else just exit
                            if (bind_cap_name_idx != 11) {
                                dunk_bind_btn = bind_cap_btn;
                                bind_name_idx = bind_cap_name_idx;
                                set_pvar(PVAR_DUNK_BIND, bind_name_idx);
                            }
                            bind_cap_mode = 0;
                            combo_run(vibration_valchg);
                        }
                    }
                }




                // ---- Auto Stand Still (Shooting) ----
                if (page == 9) {
                    menuSelection = auto_stand_on;
                    print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
                    if (event_press(PS4_UP)) { auto_stand_on = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { auto_stand_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }
                // ---- Auto Speed / Tempo (Shooting, shared) ----
                if (page == 10) {
                    if (np_confirmed && np_tid == 17) { auto_speed_ms = clamp(np_result, 100, 1000); np_confirmed = 0; }
                    if (!np_active) {
                    NumberToString(auto_speed_ms, FindDigits(auto_speed_ms));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(auto_speed_ms, 100, 1000, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { auto_speed_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { auto_speed_ms--; }
                    if (auto_speed_ms > 1000) auto_speed_ms = 1000;
                    if (auto_speed_ms < 100) auto_speed_ms = 100;
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 17; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }
                if (page == 11) {
                    if (np_confirmed && np_tid == 18) { auto_tempo_ms = clamp(np_result, 0, 300); np_confirmed = 0; }
                    if (!np_active) {
                    NumberToString(auto_tempo_ms, FindDigits(auto_tempo_ms));
                    print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                    draw_x_graph(auto_tempo_ms, 0, 300, 45);
                    if (event_press(PS4_UP) || repeat_up_due()) { auto_tempo_ms++; }
                    if (event_press(PS4_DOWN) || repeat_down_due()) { auto_tempo_ms--; }
                    if (auto_tempo_ms > 300) auto_tempo_ms = 300;
                    if (auto_tempo_ms < 0) auto_tempo_ms = 0;
                    if (event_press(PS4_UP) || event_press(PS4_DOWN) || repeat_up_due() || repeat_down_due()) {
                        combo_run(vibration_valchg); combo_run(flashedit);
                    }
                    if (event_press(PS4_CROSS) && !np_x_last) { np_active = 1; np_tid = 18; np_x_last = 1; np_len = 0; np_d0 = -1; np_d1 = -1; np_d2 = -1; np_d3 = -1; np_d4 = -1; np_d5 = -1; }
                    if (!event_press(PS4_CROSS)) { np_x_last = 0; }
                    }
                }

                // ---- Button Shot (Shooting category) ----
                if (page == 12) {
                    menuSelection = btn_shot_on;
                    print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
                    if (event_press(PS4_UP)) { btn_shot_on = 1; flashtoggle = 1; combo_run(vibration_valchg); combo_run(flashtog); }
                    if (event_press(PS4_DOWN)) { btn_shot_on = 0; flashtoggle = 0; combo_run(vibration_valchg); combo_run(flashtog); }
                }

                if (page == 13) {
                    if (np_confirmed && np_tid == 19) { btn_shot_hold_ms = clamp(np_result, 0, 1000); np_confirmed = 0; }
