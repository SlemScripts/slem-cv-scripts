// ==== Smart Timing (shot-context release offset) ====
// Reads the same way as a manual "off-dribble" or "fade" read: nudges the
// release earlier for a quick off-dribble pull-up, later for a fade, and
// leaves a stand-still shot untouched. Applies to Turbo Shot, Fade Shot,
// and Go-To Shot alike since they all release through the same combos.
int smart_timing_enabled = 0;
int rs_recent_timer = 0;
int shot_offset = 0;
int effective_wait = 0;
int smart_fade_offset = 30;
int smart_quick_offset = 20;

// ==== Imported from Binds NBA 2K26 V2 ====
// -- Soft Trigger (Misc) --
int tk_at_on = 1;

// ---- Dribble moves (D-pad slots) ----
int dribble_on = 0;

// ==== Button Shot ====
// A completely different kind of shot helper from everything else in this
// script -- it never touches the right stick at all. It watches how long
// you physically hold Square, and once that crosses the threshold below,
// it clamps Square to released for the rest of your hold. The game only
// ever sees a hold exactly that many milliseconds long, no matter how much
// longer you keep the real button pressed -- useful for a hold-length shot
// timing style rather than a stick-flick one.
int btn_shot_on = 0;
int btn_shot_hold_ms = 500;
int btn_hold_elapsed = 0;
int btn_shot_locked = 0;
int drib_up = 0;
int drib_dn = 0;
int drib_lf = 0;
int drib_rt = 0;
int drib_busy = 0;


// -- Dunk (Contact / Normal slam system) --
int dunk_meter_on = 0;
int dunk_bind_btn = PS4_L1;
int bind_cap_mode = 0;
int bind_cap_btn = PS4_L1;
int bind_name_idx = 0;
int bind_cap_name_idx = 0;
int dunk_hold_dur = 700; int dunk_hold_ms_l1 = 0; int dunk_fired_l1 = 0;
int dunk_hold_dur_o = 700;
int slam_enabled_l1 = 0;
int slam_enabled_o = 0;
int slam_trig_l1 = 0;
int slam_trig_o = 1;
int slam_style_l1 = 1;
int slam_style_o = 1;

int fade_toggle = 1;
int fade_delay_ms = 42;
int fade_intent = 0;

// ==== Release Timing Feedback ====
// A standalone hold-timer that watches Square (post-remap) regardless of
// whether Turbo/Button Rhythm shooting itself is on. Two things read off
// this same timer: a small on-screen log of your last few release times,
// and an optional one-shot rumble that fires once you've held past a
// tunable point, as a "let go now" cue while you're learning your timing.
int shot_press_ms = 0;
int shot_charging = 0;
int shotlog_enabled = 0;
int shotlog_normal_ms = 0;
int shotlog_fade_ms = 0;
int shotlog_nodip_ms = 0;
int shotlog_last_ms = 0;
int shotlog_last_type = 0;
int shot_log_nodip = 0;
int nodip_enabled = 0;
int nodip_tempo_ms = 270;

// ---- Automation (from V8-style L3/R3 auto shot) ----
int auto_stand_on = 0;
int auto_fade_on = 0;
int auto_nodip_on = 0;
int auto_speed_ms = 500;   // stand/fade auto hold (your green ~500ms)
int auto_tempo_ms = 50;    // delay before full flick
int auto_nodip_ms = 440;   // no-dip auto hold (your green ~440ms)
int auto_stick = 0;

int shot_vibe_enabled = 0;
int shot_vibe_ms = 500;
int shot_vibe_fired = 0;
int fade_vibe_enabled = 0;
int fade_vibe_ms = 500;
int fade_vibe_fired = 0;

int meter_dunk_active = 0;
int r2_recent_ms = 0;

int last_menu_page = 1;
