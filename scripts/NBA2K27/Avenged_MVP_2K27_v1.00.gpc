// "Let go" cue for the Release Timing Feedback system -- a short double
// pulse on the other motor so it reads as distinct from the menu-click
// rumble above, felt while a shot is still being held.
// "Let go" cue for a normal shot -- single pulse.
combo shot_vibe_pulse {
    set_rumble(RUMBLE_B, 100);
    wait(90);
    set_rumble(RUMBLE_B, 0);
}

// "Let go" cue for a fade -- double pulse, so it feels distinct from the
// normal-shot cue above.
combo fade_vibe_pulse {
    set_rumble(RUMBLE_B, 100);
    wait(70);
    set_rumble(RUMBLE_B, 0);
    wait(60);
    set_rumble(RUMBLE_B, 100);
    wait(70);
    set_rumble(RUMBLE_B, 0);
}

function center_x(f_chars, f_font) {
    return (OLED_WIDTH / 2) - ((f_chars * f_font) / 2);
}

// Centers text like normal, but nudges it left only if it would run
// under the hoop graphic. Never pushes text off the left edge.
function center_x_left(f_chars, f_font) {
    cxs_x = (OLED_WIDTH / 2) - ((f_chars * f_font) / 2) + 3;
    cxs_edge = cxs_x + (f_chars * f_font);
    if (cxs_edge > TXT_ZONE_R) {
        cxs_x = cxs_x - (cxs_edge - TXT_ZONE_R);
    }
    if (cxs_x < TXT_ZONE_L) { cxs_x = TXT_ZONE_L; }
    return cxs_x;
}

int bufferIndex, digitIndex, charIndex;
function NumberToString(f_val, f_digits) {
    bufferIndex = 1;
    digitIndex = 10000;
    if (f_val < 0) { putc_oled(bufferIndex, 45); bufferIndex += 1; f_val = abs(f_val); }
    for (charIndex = 5; charIndex >= 1; charIndex--) {
        if (f_digits >= charIndex) {
            putc_oled(bufferIndex, (f_val / digitIndex) + 48);
            f_val %= digitIndex;
            bufferIndex++;
            if (charIndex == 4) { putc_oled(bufferIndex, 44); bufferIndex++; }
        }
        digitIndex /= 10;
    }
    puts_oled(center_x(bufferIndex + 1, OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, bufferIndex - 1, OLED_WHITE);
}

int logVal;
function FindDigits(num) {
    logVal = 0;
    do { num /= 10; logVal++; } while (num);
    return logVal;
}

int stringLength;
function get_string_length(offset) {
    stringLength = 0;
    while (duint8(offset++)) { stringLength++; }
    return stringLength + 1;
}

// Vertical 2K shot meter (left) - fills during flight, solid on green

function draw_shot_meter() {
    rect_oled(METER_X - 1, METER_Y - 1, METER_W + 2, METER_H + 2, 0, OLED_WHITE);
    rect_oled(METER_X, METER_Y, METER_W, METER_H, 1, OLED_BLACK);
    if (meter_green && meter_flash_t > 0) {
        rect_oled(METER_X, METER_Y, METER_W, METER_H, 1, OLED_WHITE);
    } else if (meter_fill > 0) {
        if (meter_fill > METER_MAX) meter_fill = METER_MAX;
        rect_oled(METER_X, METER_Y + METER_H - meter_fill, METER_W, meter_fill, 1, OLED_WHITE);
    }
    // Green window ticks near top
    line_oled(METER_X - 2, METER_Y + 3, METER_X + METER_W + 1, METER_Y + 3, 1, OLED_WHITE);
    line_oled(METER_X - 2, METER_Y + 6, METER_X + METER_W + 1, METER_Y + 6, 1, OLED_WHITE);
}

// Sparkler / firework dots around the top of the meter when green
function draw_sparks() {
    if (spark_t <= 0) return;
    // burst pattern around meter top
    pixel_oled(METER_X - 3, METER_Y - 2 + ((spark_t) % 3), 1);
    pixel_oled(METER_X + METER_W + 2, METER_Y - 1 + ((spark_t / 2) % 3), 1);
    pixel_oled(METER_X + 2, METER_Y - 4, 1);
    pixel_oled(METER_X + 5, METER_Y - 3, 1);
    pixel_oled(METER_X - 1, METER_Y + 1, 1);
    pixel_oled(METER_X + METER_W + 1, METER_Y + 2, 1);
    pixel_oled(METER_X + 1, METER_Y - 5 + ((spark_t / 3) % 2), 1);
    pixel_oled(METER_X + 6, METER_Y - 2, 1);
    pixel_oled(METER_X - 4, METER_Y + 3, 1);
    pixel_oled(METER_X + METER_W + 3, METER_Y + 4, 1);
    if ((spark_t / 2) % 2 == 0) {
        pixel_oled(METER_X + 3, METER_Y - 6, 1);
        pixel_oled(METER_X + 4, METER_Y - 5, 1);
        pixel_oled(METER_X - 2, METER_Y - 3, 1);
        pixel_oled(METER_X + METER_W + 4, METER_Y - 1, 1);
    }
}

// Last page: proper grim reaper with draped cowl + scythe (not a pointed peak)
function draw_reaper_page() {
    // Full-screen original bitmap (not line art)
    image_oled(0, 0, OLED_WHITE, TRUE, addr(AVNG_REAPER_IMG));
    // Brand footer only
    print(center_x(get_string_length(REAPER_L1[0]), OLED_FONT_SMALL_WIDTH), 54, OLED_FONT_SMALL, OLED_WHITE, REAPER_L1[0]);
}










// Draws an integer at an arbitrary x/y using OLED_FONT_SMALL -- unlike
// NumberToString() elsewhere in this file, which always centers on one
// fixed row, this takes real coordinates so several values can share
// one screen.
function draw_ms_val(f_val, f_x, f_y) {
    bufferIndex = 1;
    digitIndex = 10000;
    if (f_val < 0) { putc_oled(bufferIndex, 45); bufferIndex += 1; f_val = abs(f_val); }
    for (charIndex = 5; charIndex >= 1; charIndex--) {
        if (FindDigits(f_val) >= charIndex) {
            putc_oled(bufferIndex, (f_val / digitIndex) + 48);
            f_val %= digitIndex;
            bufferIndex++;
        }
        digitIndex /= 10;
    }
    puts_oled(f_x, f_y, OLED_FONT_SMALL, bufferIndex - 1, OLED_WHITE);
}

// Live idle-screen readout for Release Timing Feedback -- takes over the
// spot the bounce/shoot screensaver normally occupies while Shot Log is
// switched on, so it's actually visible while playing rather than buried
// in a menu page. Whichever row matches what you're currently holding
// counts up live; the other two keep showing their last recorded value.
function draw_shotlog() {
    cls_oled(OLED_BLACK);
    line_oled(4, 2, 123, 2, 1, OLED_WHITE);
    line_oled(4, 12, 123, 12, 1, OLED_WHITE);
    print(center_x(get_string_length(RLG_TITLE[0]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, RLG_TITLE[0]);

    print(8, 16, OLED_FONT_SMALL, OLED_WHITE, RLG_NORMAL[0]);
    if (shot_charging && !fade_intent && !shot_log_nodip) { draw_ms_val(shot_press_ms, 60, 16); }
    else { draw_ms_val(shotlog_normal_ms, 60, 16); }
    print(96, 16, OLED_FONT_SMALL, OLED_WHITE, ms[0]);

    print(8, 25, OLED_FONT_SMALL, OLED_WHITE, RLG_FADE[0]);
    if (shot_charging && fade_intent) { draw_ms_val(shot_press_ms, 60, 25); }
    else { draw_ms_val(shotlog_fade_ms, 60, 25); }
    print(96, 25, OLED_FONT_SMALL, OLED_WHITE, ms[0]);

    print(8, 34, OLED_FONT_SMALL, OLED_WHITE, RLG_NODIP[0]);
    if (shot_charging && !fade_intent && shot_log_nodip) { draw_ms_val(shot_press_ms, 60, 34); }
    else { draw_ms_val(shotlog_nodip_ms, 60, 34); }
    print(96, 34, OLED_FONT_SMALL, OLED_WHITE, ms[0]);

    line_oled(4, 46, 123, 46, 1, OLED_WHITE);

    print(8, 50, OLED_FONT_SMALL, OLED_WHITE, RLG_LAST[0]);
    if (shotlog_last_type == 1) { print(40, 50, OLED_FONT_SMALL, OLED_WHITE, RLG_FADE[0]); }
    else if (shotlog_last_type == 2) { print(40, 50, OLED_FONT_SMALL, OLED_WHITE, RLG_NODIP[0]); }
    else { print(40, 50, OLED_FONT_SMALL, OLED_WHITE, RLG_NORMAL[0]); }
    draw_ms_val(shotlog_last_ms, 80, 50);
    print(112, 50, OLED_FONT_SMALL, OLED_WHITE, ms[0]);
}

function saver_step() {
    cls_oled(OLED_BLACK);
    line_oled(4,   2,  123,  2,  2, OLED_WHITE);
    line_oled(4,  50,  123, 50,  2, OLED_WHITE);
    line_oled(4,   2,    4, 50,  2, OLED_WHITE);
    line_oled(123, 2,  123, 50,  2, OLED_WHITE);
    line_oled(8,   6,  119,  6,  1, OLED_WHITE);
    line_oled(8,  46,  119, 46,  1, OLED_WHITE);
    line_oled(8,   6,    8, 46,  1, OLED_WHITE);
    line_oled(119, 6,  119, 46,  1, OLED_WHITE);
    line_oled(0,   0,   10,  0,  1, OLED_WHITE);
    line_oled(0,   0,    0,  8,  1, OLED_WHITE);
    line_oled(117, 0,  127,  0,  1, OLED_WHITE);
    line_oled(127, 0,  127,  8,  1, OLED_WHITE);
    line_oled(0,  63,   10, 63,  1, OLED_WHITE);
    line_oled(0,  55,    0, 63,  1, OLED_WHITE);
    line_oled(117,63,  127, 63,  1, OLED_WHITE);
    line_oled(127,55,  127, 63,  1, OLED_WHITE);
    // Footer hint on text pages only (not basketball page / not reaper)
    if (ssp >= 1 && ssp <= 4) {
        if (isXbox) {
            print(center_x(get_string_length(saver_line1_xb[0]), OLED_FONT_SMALL_WIDTH), 54, OLED_FONT_SMALL, OLED_WHITE, saver_line1_xb[0]);
        } else {
            print(center_x(get_string_length(saver_line1_ps[0]), OLED_FONT_SMALL_WIDTH), 54, OLED_FONT_SMALL, OLED_WHITE, saver_line1_ps[0]);
        }
    }

    // ===== PAGE 0: Basketball + meter + GREEN + sparks only =====
    if (ssp == 0) {
        hcd = hcd + 1;
        if (hcd >= 110) { ssp = 1; hcd = 0; }
    }
    // ===== PAGE 1: Avenged MVP / 2K27 =====
    else if (ssp == 1) {
        rv_tx = center_x_left(get_string_length(L1_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw = (get_string_length(L1_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        rv_tx2 = center_x_left(get_string_length(L1B_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw2 = (get_string_length(L1B_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        print(rv_tx, 15, OLED_FONT_SMALL, OLED_WHITE, L1_TXT[0]);
        print(rv_tx2, 32, OLED_FONT_SMALL, OLED_WHITE, L1B_TXT[0]);
        if (hcd < 12) {
            rv_px = (hcd * rv_tw) / 12; rect_oled(rv_tx + rv_px, 14, rv_tw - rv_px + 2, 10, 1, OLED_BLACK);
            rv_px2 = (hcd * rv_tw2) / 12; rect_oled(rv_tx2 + rv_px2, 31, rv_tw2 - rv_px2 + 2, 10, 1, OLED_BLACK);
        }
        hcd = hcd + 1; if (hcd >= 57) { ssp = 2; hcd = 0; }
    }
    // ===== PAGE 2: Discord =====
    else if (ssp == 2) {
        rv_tx = center_x_left(get_string_length(L2A_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw = (get_string_length(L2A_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        rv_tx2 = center_x_left(get_string_length(L2B_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw2 = (get_string_length(L2B_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        rv_tx3 = center_x_left(get_string_length(L2C_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw3 = (get_string_length(L2C_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        print(rv_tx, 11, OLED_FONT_SMALL, OLED_WHITE, L2A_TXT[0]);
        print(rv_tx2, 22, OLED_FONT_SMALL, OLED_WHITE, L2B_TXT[0]);
        print(rv_tx3, 33, OLED_FONT_SMALL, OLED_WHITE, L2C_TXT[0]);
        if (hcd < 12) {
            rv_px = (hcd * rv_tw) / 12; rect_oled(rv_tx + rv_px, 10, rv_tw - rv_px + 2, 10, 1, OLED_BLACK);
            rv_px2 = (hcd * rv_tw2) / 12; rect_oled(rv_tx2 + rv_px2, 21, rv_tw2 - rv_px2 + 2, 10, 1, OLED_BLACK);
            rv_px3 = (hcd * rv_tw3) / 12; rect_oled(rv_tx3 + rv_px3, 32, rv_tw3 - rv_px3 + 2, 10, 1, OLED_BLACK);
        }
        hcd = hcd + 1; if (hcd >= 57) { ssp = 3; hcd = 0; }
    }
    // ===== PAGE 3: Credits =====
    else if (ssp == 3) {
        rv_tx = center_x_left(get_string_length(CR_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw = (get_string_length(CR_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        print(rv_tx, 20, OLED_FONT_SMALL, OLED_WHITE, CR_TXT[0]);
        if (hcd < 12) { rv_px = (hcd * rv_tw) / 12; rect_oled(rv_tx + rv_px, 19, rv_tw - rv_px + 2, 10, 1, OLED_BLACK); }
        hcd = hcd + 1; if (hcd >= 57) { ssp = 4; hcd = 0; }
    }
    // ===== PAGE 4: Names =====
    else if (ssp == 4) {
        rv_tx = center_x_left(get_string_length(N1_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw = (get_string_length(N1_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        rv_tx2 = center_x_left(get_string_length(N2_TXT[0]), OLED_FONT_SMALL_WIDTH);
        rv_tw2 = (get_string_length(N2_TXT[0]) - 1) * OLED_FONT_SMALL_WIDTH;
        print(rv_tx, 15, OLED_FONT_SMALL, OLED_WHITE, N1_TXT[0]);
        print(rv_tx2, 32, OLED_FONT_SMALL, OLED_WHITE, N2_TXT[0]);
        if (hcd < 12) {
            rv_px = (hcd * rv_tw) / 12; rect_oled(rv_tx + rv_px, 14, rv_tw - rv_px + 2, 10, 1, OLED_BLACK);
            rv_px2 = (hcd * rv_tw2) / 12; rect_oled(rv_tx2 + rv_px2, 31, rv_tw2 - rv_px2 + 2, 10, 1, OLED_BLACK);
        }
        hcd = hcd + 1; if (hcd >= 57) { ssp = 5; hcd = 0; }
    }
    // ===== PAGE 5 LAST: Reaper =====
    else if (ssp == 5) {
        draw_reaper_page();
        hcd = hcd + 1; if (hcd >= 70) { ssp = 0; hcd = 0; }
    }

    if (ssp == 0) {
        // Logo-quality page (circle player + hoop) + animated ball + filling meter
        image_oled(0, 0, OLED_WHITE, TRUE, addr(AVNG_BBALL_LOGO));
        draw_shot_meter();

        bb_tk = bb_tk + 1;
        if (bb_tk >= 2) {
            bb_tk = 0;

            if (bb_state == 0) {
                bb_vy = bb_vy + 1;
                bb_x = bb_x + bb_vx;
                bb_y = bb_y + bb_vy;

                meter_fill = ((bb_x - bb_start_x) * METER_MAX) / (HOOP_RIM_CX - bb_start_x + 1);
                if (meter_fill < 0) meter_fill = 0;
                if (meter_fill > METER_MAX) meter_fill = METER_MAX;

                if (bb_vy > 0 && bb_y >= HOOP_RIM_Y - 3 && bb_y <= HOOP_RIM_Y + 6 && bb_x >= HOOP_RIM_L - 2 && bb_x <= HOOP_RIM_R + 3) {
                    bb_state = 1;
                    bb_x = HOOP_RIM_CX;
                    bb_vx = 0;
                    bb_vy = 2;
                    meter_fill = METER_MAX;
                    meter_green = 1;
                    meter_flash_t = 40;
                    spark_t = 28;
                }
                else if (bb_vy > 0 && bb_x >= HOOP_RIM_L - 4 && bb_y >= HOOP_RIM_Y - 2 && bb_y <= HOOP_NET_BOT + 2) {
                    bb_state = 1;
                    bb_x = HOOP_RIM_CX;
                    bb_vx = 0;
                    bb_vy = 2;
                    meter_fill = METER_MAX;
                    meter_green = 1;
                    meter_flash_t = 40;
                    spark_t = 28;
                }

                if (bb_y >= BB_MAXY || bb_x >= BB_MAXX) {
                    bb_state = 3;
                    bb_reset_t = 0;
                }
            }
            else if (bb_state == 1) {
                bb_vy = bb_vy + 1;
                bb_y = bb_y + bb_vy;
                if (meter_flash_t > 0) meter_flash_t = meter_flash_t - 1;
                if (spark_t > 0) spark_t = spark_t - 1;
                if (bb_y >= HOOP_NET_BOT + 2) {
                    bb_y = HOOP_NET_BOT + 2;
                    bb_vy = -3;
                    bb_state = 4;
                }
            }
            else if (bb_state == 4) {
                bb_vy = bb_vy + 1;
                bb_y = bb_y + bb_vy;
                if (meter_flash_t > 0) meter_flash_t = meter_flash_t - 1;
                if (spark_t > 0) spark_t = spark_t - 1;
                if (bb_vy >= 0 && bb_y >= HOOP_NET_BOT) {
                    bb_state = 3;
                    bb_reset_t = 0;
                }
            }
            else if (bb_state == 3) {
                bb_reset_t = bb_reset_t + 1;
                if (meter_flash_t > 0) meter_flash_t = meter_flash_t - 1;
                if (spark_t > 0) spark_t = spark_t - 1;
                if (bb_reset_t >= 12) {
                    bb_x = bb_start_x;
                    bb_y = bb_start_y;
                    bb_vx = 5;
                    bb_vy = -3;
                    bb_state = 0;
                    meter_fill = 0;
                    meter_green = 0;
                    meter_flash_t = 0;
                    spark_t = 0;
                }
            }
        }

        // Ball on top of logo
        if (bb_state != 3) {
            for (bb_dy = -BB_R; bb_dy <= BB_R; bb_dy++) {
                bb_rr = (BB_R * BB_R) - (bb_dy * bb_dy);
                for (bb_dx = -BB_R; bb_dx <= BB_R; bb_dx++) {
                    if ((bb_dx * bb_dx) <= bb_rr) {
                        pixel_oled(bb_x + bb_dx, bb_y + bb_dy, 1);
                    }
                }
            }
            line_oled(bb_x, bb_y - BB_R + 1, bb_x, bb_y + BB_R - 1, 1, OLED_BLACK);
            line_oled(bb_x - BB_R + 1, bb_y, bb_x + BB_R - 1, bb_y, 1, OLED_BLACK);
        }

        if (spark_t > 0) {
            draw_sparks();
        }

        if (meter_green && meter_flash_t > 0) {
            print(center_x(get_string_length(GREEN_TXT[0]), OLED_FONT_SMALL_WIDTH), 54, OLED_FONT_SMALL, OLED_WHITE, GREEN_TXT[0]);
        }
    }

}

function saver_init_static() {
    // retained for call sites
}


function repeat_update(dt) {
    if (get_val(PS4_L2) && get_val(PS4_UP)) {
        if (!rpt_up_held) { rpt_up_held = 1; rpt_up_bucket = 0; rpt_up_total = 0; }
        rpt_up_bucket += dt;
        rpt_up_total += dt;
    } else {
        rpt_up_held = 0; rpt_up_bucket = 0; rpt_up_total = 0;
    }
    if (get_val(PS4_L2) && get_val(PS4_DOWN)) {
        if (!rpt_dn_held) { rpt_dn_held = 1; rpt_dn_bucket = 0; rpt_dn_total = 0; }
        rpt_dn_bucket += dt;
        rpt_dn_total += dt;
    } else {
        rpt_dn_held = 0; rpt_dn_bucket = 0; rpt_dn_total = 0;
    }
}

function repeat_up_due() {
    if (!rpt_up_held) return 0;
    if (rpt_up_total < REPEAT_INITIAL_MS) return 0;

    if (rpt_up_total >= REPEAT_ACCEL_AT) { rpt_rate_up = REPEAT_RATE_FAST; }
    else { rpt_rate_up = REPEAT_RATE_SLOW; }

    if (rpt_up_bucket >= rpt_rate_up) {
        rpt_up_bucket -= rpt_rate_up;
        return 1;
    }
    return 0;
}

function repeat_down_due() {
    if (!rpt_dn_held) return 0;
    if (rpt_dn_total < REPEAT_INITIAL_MS) return 0;

    if (rpt_dn_total >= REPEAT_ACCEL_AT) { rpt_rate_dn = REPEAT_RATE_FAST; }
    else { rpt_rate_dn = REPEAT_RATE_SLOW; }

    if (rpt_dn_bucket >= rpt_rate_dn) {
        rpt_dn_bucket -= rpt_rate_dn;
        return 1;
    }
    return 0;
}





