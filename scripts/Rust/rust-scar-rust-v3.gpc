function UpdateCrouchBtn() {
    CROUCH_BTN = XB1_B;
    if(SwapEnabled[1]) {
        CROUCH_BTN = BTN_LIST[SwapWith[1]];
        return;
    }

    for(rm_i = 0; rm_i < 10; rm_i++) {
        if(!RemapEnabled[rm_i]) continue;
        if(RemapSrc[rm_i] == XB1_B) { CROUCH_BTN = RemapDst[rm_i]; return; }
        if(RemapDst[rm_i] == XB1_B) { CROUCH_BTN = RemapSrc[rm_i];
            return; }
    }
}

function InitBtnList() {
    BTN_LIST[0]  = XB1_A;    BTN_LIST[1]  = XB1_B;
    BTN_LIST[2]  = XB1_X;    BTN_LIST[3]  = XB1_Y;
    BTN_LIST[4]  = XB1_LB;   BTN_LIST[5]  = XB1_RB;
    BTN_LIST[6]  = XB1_LT;
    BTN_LIST[7]  = XB1_RT;
    BTN_LIST[8]  = XB1_LS;   BTN_LIST[9]  = XB1_RS;
    BTN_LIST[10] = XB1_UP;   BTN_LIST[11] = XB1_DOWN;
    BTN_LIST[12] = XB1_LEFT; BTN_LIST[13] = XB1_RIGHT;
    BTN_LIST[14] = XB1_VIEW; BTN_LIST[15] = XB1_MENU;
}

function InitRemaps() {
    for(rm_i = 0; rm_i < 10; rm_i++) {
        RemapEnabled[rm_i] = FALSE;
        RemapSrc[rm_i] = XB1_A;
        RemapDst[rm_i] = XB1_A;
    }
}

#define BTN_COUNT = 16
int SwapWith[BTN_COUNT];
int SwapEnabled[BTN_COUNT];
int used_pair[BTN_COUNT];
function ApplyButtonSwaps() {
    for(i = 0; i < BTN_COUNT; i++) {
        used_pair[i] = FALSE;
    }
    for(i = 0; i < BTN_COUNT; i++) {
        if(!SwapEnabled[i]) continue;
        j = SwapWith[i];
        if(j < 0) continue;
        if(j >= BTN_COUNT) continue;
        if(i == j) continue;
        if(used_pair[i] || used_pair[j]) continue;
        b1 = BTN_LIST[i];
        b2 = BTN_LIST[j];
        v1 = get_val(b1);
        v2 = get_val(b2);
        set_val(b1, v2);
        set_val(b2, v1);
        used_pair[i] = TRUE;
        used_pair[j] = TRUE;
    }
}

int btn1, btn2;
int v1, v2;
int w;
function ApplyRemaps() {
    for(i = 0; i < 64; i++) {
        remap_used[i] = FALSE;
    }
    for(rm_i = 0; rm_i < 10; rm_i++) {
        if(!RemapEnabled[rm_i]) continue;
        btn1 = RemapDst[rm_i];
        btn2 = RemapSrc[rm_i];
        if(btn1 == btn2) continue;
        if(remap_used[btn1] || remap_used[btn2]) continue;
        v1 = get_val(btn1);
        v2 = get_val(btn2);
        set_val(btn1, v2);
        set_val(btn2, v1);
        remap_used[btn1] = TRUE;
        remap_used[btn2] = TRUE;
    }
}

int __prev_out[64];
function PostPress(int btn) {
    return (get_val(btn) > 50 && __prev_out[btn] <= 50);
}

function UpdatePostPressPrev() {
    __prev_out[XB1_A]    = get_val(XB1_A);
    __prev_out[XB1_B]    = get_val(CROUCH_BTN);
    __prev_out[XB1_X]    = get_val(XB1_X);
    __prev_out[XB1_Y]    = get_val(XB1_Y);
    __prev_out[XB1_LB]   = get_val(XB1_LB);
    __prev_out[XB1_RB]   = get_val(XB1_RB);
    __prev_out[XB1_LS]   = get_val(XB1_LS);
    __prev_out[XB1_RS]   = get_val(XB1_RS);
    __prev_out[XB1_UP]   = get_val(XB1_UP);
    __prev_out[XB1_DOWN] = get_val(XB1_DOWN);
    __prev_out[XB1_LEFT] = get_val(XB1_LEFT);
    __prev_out[XB1_RIGHT]= get_val(XB1_RIGHT);
    __prev_out[XB1_VIEW] = get_val(XB1_VIEW);
    __prev_out[XB1_MENU] = get_val(XB1_MENU);
    __prev_out[XB1_LT]   = get_val(XB1_LT);
    __prev_out[XB1_RT]   = get_val(XB1_RT);
}

