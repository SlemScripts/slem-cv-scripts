define INTERNAL_DZ     = 2;
define CLASSIC_COMP    = 12;
define SMOOTH_SLOW     = 70;
define SMOOTH_FAST     = 20;
define SPEED_THRESHOLD = 10;
int prev_out_x, prev_out_y;
int prev_in_x, prev_in_y;
int av, s, tri, boost, compv, outv, scaled, speed, smooth_pct;

int HOLD_DELAY = 275;
int HOLD_RATE  = 75;
int next_rep_right = 0;
int next_rep_left  = 0;
function iabs(v) { if(v < 0) return(-v); return(v); }
function isign(v) { if(v < 0) return(-1); if(v > 0) return(1); return(0);
}

function dz_remap(v, dz) {
    av = iabs(v);
    if(av <= dz) return(0);
    scaled = ((av - dz) * 100) / (100 - dz);
    return(scaled * isign(v));
}
function classic_comp(v) {
    av = iabs(v); s = isign(v);
    tri = 50 - iabs(av - 50);
    boost = (CLASSIC_COMP * tri) / 50;
    compv = (CLASSIC_COMP * av) / 200;
    outv = av + boost - compv;
    if(outv > 100) outv = 100;
    return(outv * s);
}
function vel_smooth(v, axis) {
    if(axis == 0) {
        speed = iabs(v - prev_in_x);
        if(speed <= SPEED_THRESHOLD) smooth_pct = SMOOTH_SLOW;
        else smooth_pct = SMOOTH_FAST;
        outv = ((prev_out_x * smooth_pct) + (v * (100 - smooth_pct))) / 100;
        prev_in_x = v; prev_out_x = outv;
    } else {
        speed = iabs(v - prev_in_y);
        if(speed <= SPEED_THRESHOLD) smooth_pct = SMOOTH_SLOW;
        else smooth_pct = SMOOTH_FAST;
        outv = ((prev_out_y * smooth_pct) + (v * (100 - smooth_pct))) / 100;
        prev_in_y = v; prev_out_y = outv;
    }
    return(outv);
}



