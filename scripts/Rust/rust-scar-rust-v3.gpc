    wait(90);
    set_val(4,100);
    set_val(10,applyRecoilToRightStickY(29,recoilStrengthPct));
    set_val(9,applyRecoilToRightStickX(-1,recoilStrengthPct));
    wait(90);
    set_val(4,0);
    set_val(10,applyRecoilToRightStickY(29,recoilStrengthPct));
    set_val(9,applyRecoilToRightStickX(-1,recoilStrengthPct));
