function PrintBtnName(x, y, idx) {
    if(idx == 0)       print(x, y, 0, OLED_FONT_SMALL, BTN_A[0]);
    else if(idx == 1)  print(x, y, 0, OLED_FONT_SMALL, BTN_B[0]);
    else if(idx == 2)  print(x, y, 0, OLED_FONT_SMALL, BTN_X[0]);
    else if(idx == 3)  print(x, y, 0, OLED_FONT_SMALL, BTN_Y[0]);
    else if(idx == 4)  print(x, y, 0, OLED_FONT_SMALL, BTN_LB[0]);
    else if(idx == 5)  print(x, y, 0, OLED_FONT_SMALL, BTN_RB[0]);
    else if(idx == 6)  print(x, y, 0, OLED_FONT_SMALL, BTN_LT[0]);
    else if(idx == 7)  print(x, y, 0, OLED_FONT_SMALL, BTN_RT[0]);
    else if(idx == 8)  print(x, y, 0, OLED_FONT_SMALL, BTN_LS[0]);
    else if(idx == 9)  print(x, y, 0, OLED_FONT_SMALL, BTN_RS[0]);
    else if(idx == 10) print(x, y, 0, OLED_FONT_SMALL, BTN_UP[0]);
    else if(idx == 11) print(x, y, 0, OLED_FONT_SMALL, BTN_DOWN[0]);
    else if(idx == 12) print(x, y, 0, OLED_FONT_SMALL, BTN_LEFT[0]);
    else if(idx == 13) print(x, y, 0, OLED_FONT_SMALL, BTN_RIGHT[0]);
    else if(idx == 14) print(x, y, 0, OLED_FONT_SMALL, BTN_VIEW[0]);
    else if(idx == 15) print(x, y, 0, OLED_FONT_SMALL, BTN_MENU[0]);
}

