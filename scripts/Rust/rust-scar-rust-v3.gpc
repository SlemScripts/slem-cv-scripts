    lx = RAW_LX;

    if (lx > STRAFE_LX_THRESH || lx < -STRAFE_LX_THRESH)
        return STRAFE_SKS_4X_STAND;

    return 0;
}

function STRAFE_SKS_4X_CROUCH() {

    lx = RAW_LX;

    if (lx > STRAFE_LX_THRESH || lx < -STRAFE_LX_THRESH)
        return STRAFE_SKS_4X_CROUCH;

    return 0;
}

function STRAFE_AK_4X_STAND() {

    lx = RAW_LX;

    if (lx > STRAFE_LX_THRESH || lx < -STRAFE_LX_THRESH)
        return STRAFE_AK_4X_STAND;

    return 0;
}



