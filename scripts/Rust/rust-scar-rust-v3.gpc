function hiprecoil() {
    if (screen == 0 && HipfireRecoil && get_val(XB1_RT) > 70 && get_val(XB1_LT) <= 70 && CurrentWeapon != 27) {


        if(CurrentWeapon == 3 && CurrentStatus == 0 && !combo_running(AK_StandHip)) combo_restart(AK_StandHip);
        if(CurrentWeapon == 3 && CurrentStatus == 1 && !combo_running(AK_CrouchedHip)) combo_restart(AK_CrouchedHip);


        if(CurrentWeapon == 2 && CurrentStatus == 0 && !combo_running(AK_StandHip)) combo_restart(AK_StandHip);
        if(CurrentWeapon == 2 && CurrentStatus == 1 && !combo_running(AK_CrouchedHip)) combo_restart(AK_CrouchedHip);


        if(CurrentWeapon == 8 && CurrentStatus == 0 && !combo_running(MP5_StandHip)) combo_restart(MP5_StandHip);
        if(CurrentWeapon == 8 && CurrentStatus == 1 && !combo_running(MP5_CrouchedHip)) combo_restart(MP5_CrouchedHip);


        if(CurrentWeapon == 0 && CurrentStatus == 0 && !combo_running(TOMMY_StandHip)) combo_restart(TOMMY_StandHip);
        if(CurrentWeapon == 0 && CurrentStatus == 1 && !combo_running(TOMMY_CrouchHip)) combo_restart(TOMMY_CrouchHip);


        if(CurrentWeapon == 12 && CurrentStatus == 0 && !combo_running(LR_StandHOLO_HIP)) combo_restart(LR_StandHOLO_HIP);
        if(CurrentWeapon == 12 && CurrentStatus == 1 && !combo_running(LR_CrouchedHOLO_HIP)) combo_restart(LR_CrouchedHOLO_HIP);
    }
}
combo M92_S{
    set_val(10,applyRecoilToRightStickY(35,recoilStrengthPct));
    set_val(9,applyRecoilToRightStickX(random(0,-1),recoilStrengthPct));
    set_val(4,100);
    wait(10);
    set_val(4,0);
    wait(10);
}

combo M92_C{
    set_val(10,applyRecoilToRightStickY(256,recoilStrengthPct));
    set_val(9,applyRecoilToRightStickX(random(0,-1),recoilStrengthPct));
    set_val(4,100);
    wait(10);
    set_val(4,0);
    wait(10);
}

define STAND_RECOIL_XX  = -1;
define STAND_RECOIL_YX  = 84;
combo M92_Stand {

    set_val(XB1_RT, 100);
    set_val(XB1_LT, 100);
    set_val(XB1_RX, STAND_RECOIL_XX + AddToCombosRX());
    set_val(XB1_RY, STAND_RECOIL_YX + AddToCombosRY());
    wait(FIRE_RATE);

    set_val(XB1_RT, 0);
    wait(FIRE_RATE);
}

define RECOIL_YY  = 60;
define RECOIL_XY  = 0;
combo M92_Crouched {

    set_val(XB1_RT, 100);
    set_val(XB1_LT, 100);
    set_val(XB1_RX, RECOIL_XY + AddToCombosRX());
    set_val(XB1_RY, RECOIL_YY + AddToCombosRY());
    wait(FIRE_RATE);

    set_val(XB1_RT, 0);
    wait(FIRE_RATE);
}

