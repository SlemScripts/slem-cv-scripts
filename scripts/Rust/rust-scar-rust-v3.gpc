int RX_SCALE_DEN  = 100;
int RY_SCALE_DEN  = 100;
int SMOOTH_DEN    = 25;
int SCALE_NUM     = 100;
int RY_SCALE_NUM  = 25;
int RX_SCALE_NUM  = 25;
int axis_val;
int axis_mix;
int adj_scaled;
function ApplyAxisAdjust(int axis, int adjust) {


    if (axis == XB1_RY) {
        axis_val = AddToCombosRY();
    } else {
        axis_val = AddToCombosRX();
    }


    if (axis_val >  90) axis_val =  80;
    if (axis_val < -90) axis_val = -80;


    if (axis == XB1_RY) {
        adj_scaled = (adjust * SCALE_NUM) / RY_SCALE_DEN;
        adj_scaled = (adj_scaled * RY_SCALE_NUM) / SMOOTH_DEN;
    } else {
        adj_scaled = (adjust * SCALE_NUM) / RX_SCALE_DEN;
        adj_scaled = (adj_scaled * RX_SCALE_NUM) / SMOOTH_DEN;
    }


    axis_mix = 100 - abs(axis_val);

    set_val(
        axis,
        clamp(axis_val + (adj_scaled * axis_mix / 100), -100, 100)
    );
}
function StrafeAddRY() {

    lx = RAW_LX;

    if (lx > STRAFE_LX_THRESH || lx < -STRAFE_LX_THRESH)
        return STRAFE_RY_AMOUNT;

    return 0;
}

int STRAFE_RY_AMOUNT = 2.65;
int STRAFE_RY_AMOUNT2 = 2.25;
int STRAFE_RY_AMOUNT3 = 1.25;
int STRAFE_LX_THRESH2 = 11;
int STRAFE_LX_THRESH3 = 11;
combo AK_StandHip {

    ApplyAxisAdjust(XB1_RY, random(42, 46) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, -1.7);
    wait(300);

    ApplyAxisAdjust(XB1_RY, random(41, 45) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-7.7, -8.7));
    wait(400);

    ApplyAxisAdjust(XB1_RY, random(41, 48) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-11, -13));
    wait(400);

    ApplyAxisAdjust(XB1_RY, random(41, 47) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-11, -13));
    wait(400);

    ApplyAxisAdjust(XB1_RY, random(41, 48) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-10, -12));
    wait(200);

    ApplyAxisAdjust(XB1_RY, random(41, 47) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-9, -11));
    wait(200);

    ApplyAxisAdjust(XB1_RY, random(41.65, 47) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-9, -12));
    wait(500);

    ApplyAxisAdjust(XB1_RY, random(41, 48) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-2, -12.65));
    wait(150);

    ApplyAxisAdjust(XB1_RY, random(41, 48) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-12, -13));
    wait(200);

    ApplyAxisAdjust(XB1_RY, random(41.5, 45) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-12, -15));
    wait(200);

    ApplyAxisAdjust(XB1_RY, random(41, 44) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-12, -15));
    wait(200);

    ApplyAxisAdjust(XB1_RY, random(39.5, 42) + StrafeAddRY());
    ApplyAxisAdjust(XB1_RX, random(-13, -15));
    wait(800);
}

