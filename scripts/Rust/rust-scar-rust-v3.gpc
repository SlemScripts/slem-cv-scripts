init {
	load_elapsed = 0;



	altSmoothingToggle[0] = 0;
	altSmoothingToggle[1] = 0;
	altSmoothingToggle[2] = 0;
	altSmoothingToggle[3] = 0;
	altSmoothingToggle[4] = 0;

	recoilAxisEnabledXY[0] = 1;
	recoilAxisEnabledXY[1] = 1;


	InitBtnList();
	InitRemaps();
	for(i = 0; i < BTN_COUNT; i++) { SwapWith[i] = i; SwapEnabled[i] = FALSE; }
	remap_init_done = TRUE;



    vm_tctrl(-7);
    BASE_HIP_X = DEF_HIP_SENS;
    BASE_HIP_Y = DEF_HIP_SENS;
    BASE_1X_X  = DEF_1X_SENS;
    BASE_1X_Y  = DEF_1X_SENS;
    BASE_4X_X  = DEF_4X_SENS;
    BASE_4X_Y  = DEF_4X_SENS;

    BASE_HIP_X = clamp(BASE_HIP_X, SENS_MIN, SENS_MAX);
    BASE_HIP_Y = clamp(BASE_HIP_Y, SENS_MIN, SENS_MAX);
    BASE_1X_X  = clamp(BASE_1X_X,  SENS_MIN, SENS_MAX);
    BASE_1X_Y  = clamp(BASE_1X_Y,  SENS_MIN, SENS_MAX);
    BASE_4X_X  = clamp(BASE_4X_X,  SENS_MIN, SENS_MAX);
    BASE_4X_Y  = clamp(BASE_4X_Y,  SENS_MIN, SENS_MAX);

    set_led(1, 0);set_led(2, 0);set_led(3, 0);
    BASE_HIP_X = get_pvar(SPVAR_1, SENS_MIN, SENS_MAX, DEF_HIP_SENS);
    BASE_1X_X  = get_pvar(SPVAR_2, SENS_MIN, SENS_MAX, DEF_1X_SENS);
    BASE_4X_X  = get_pvar(SPVAR_3, SENS_MIN, SENS_MAX, DEF_4X_SENS);
    BASE_HIP_Y = get_pvar(SPVAR_4, SENS_MIN, SENS_MAX, DEF_HIP_SENS);
    if (BASE_HIP_Y == 85 || BASE_HIP_Y == 100) { BASE_HIP_Y = DEF_HIP_SENS; set_pvar(SPVAR_4, BASE_HIP_Y);
    }

    BASE_1X_Y  = get_pvar(SPVAR_9,  SENS_MIN, SENS_MAX, DEF_1X_SENS);
    BASE_4X_Y  = get_pvar(SPVAR_10, SENS_MIN, SENS_MAX, DEF_4X_SENS);
    CurrentDeadzoneX = get_pvar(SPVAR_11, DZ_MIN, DZ_MAX, DEF_DZ_X);
    CurrentDeadzoneY = get_pvar(SPVAR_12, DZ_MIN, DZ_MAX, DEF_DZ_Y);

    BASE_HIP_X = clamp(BASE_HIP_X, SENS_MIN, SENS_MAX);
    BASE_HIP_Y = clamp(BASE_HIP_Y, SENS_MIN, SENS_MAX);
    BASE_1X_X  = clamp(BASE_1X_X,  SENS_MIN, SENS_MAX);
    BASE_1X_Y  = clamp(BASE_1X_Y,  SENS_MIN, SENS_MAX);
    BASE_4X_X  = clamp(BASE_4X_X,  SENS_MIN, SENS_MAX);
    BASE_4X_Y  = clamp(BASE_4X_Y,  SENS_MIN, SENS_MAX);

    CurrentDeadzoneX = clamp(CurrentDeadzoneX, DZ_MIN, DZ_MAX);
    CurrentDeadzoneY = clamp(CurrentDeadzoneY, DZ_MIN, DZ_MAX);
}

int YTapCount = 0;
int YTapAge = 0;
int YDoubleTapWindow = 250;
main {

    sens_raw_rx = get_val(XB1_RX);
    sens_raw_ry = get_val(XB1_RY);





    UpdateCrouchBtn();

    RecoilControl();

        hiprecoil();

    ApplyButtonSwaps();
    if(screen == 0) {
        ApplyRemaps();
    }

    if (screen == 0 && bUpdateDisplay) {
        UpdateScreen();
        bUpdateDisplay = FALSE;
    }
    else if (screen == 1) UpdateValues();
    else if (screen == 2) UpdateSens();
    else if (screen == 3) UpdateRemaps();
    else if (screen == 4) UpdateQuickSwaps();
    else if (screen == 5) {
        UpdateRemapMenu();
        if (!weapon_locked) {
            weapon_lock   = CurrentWeapon;
            weapon_locked = TRUE;
        }
        CurrentWeapon = weapon_lock;
        set_val(XB1_UP, 0); set_val(XB1_DOWN, 0); set_val(XB1_LEFT, 0);
        set_val(XB1_RIGHT, 0);
        set_val(XB1_RT, 0); set_val(XB1_LT, 0); set_val(XB1_RB, 0); set_val(XB1_LB, 0);
    }


    if(screen != 0) {
        set_val(XB1_LX, 0); set_val(XB1_LY, 0);
        set_val(XB1_RX, 0); set_val(XB1_RY, 0);
        set_val(XB1_LT, 0); set_val(XB1_RT, 0);
        set_val(XB1_UP, 0); set_val(XB1_DOWN, 0); set_val(XB1_LEFT, 0); set_val(XB1_RIGHT, 0);
        set_val(XB1_A, 0); set_val(CROUCH_BTN, 0);
        set_val(XB1_X, 0); set_val(XB1_Y, 0);
        set_val(XB1_LB, 0); set_val(XB1_RB, 0); set_val(XB1_LS, 0); set_val(XB1_RS, 0);
        set_val(XB1_VIEW, 0); set_val(XB1_MENU, 0); set_val(XB1_XBOX, 0);
    }

    prev_LT = get_val(XB1_LT);
    prev_RT = get_val(XB1_RT);
    RAW_LX = get_val(XB1_LX);
    if (event_press(XB1_RS) && event_press(XB1_LS)) {
        spinning = !spinning;
    }
    if (spinning) {
        spinTimer += get_rtime();
        if (spinStage == 0) {
            set_val(XB1_RX, 100);
            if (spinTimer >= 400) { spinTimer = 0; spinStage = 1;
            }
        } else if (spinStage == 1) {
            set_val(XB1_UP, 100);
            if (spinTimer >= 120) { spinTimer = 0; spinStage = 2;
            }
        } else if (spinStage == 2) {
            if (spinTimer >= 1000) { spinTimer = 0;
            spinStage = 3; }
        } else if (spinStage == 3) {
            set_val(CROUCH_BTN, 100);
            if (spinTimer >= 120) { spinTimer = 0; spinStage = 0;
            }
        }
    }


    if (get_val(XB1_RB) > 65) {
        if (event_press(XB1_UP))    { combo_stop_all(); CurrentWeapon = qs_up;    bUpdateDisplay = TRUE; }
        if (event_press(XB1_DOWN))  { combo_stop_all(); CurrentWeapon = qs_down;  bUpdateDisplay = TRUE; }
        if (event_press(XB1_LEFT))  { combo_stop_all(); CurrentWeapon = qs_left;  bUpdateDisplay = TRUE; }
        if (event_press(XB1_RIGHT)) { combo_stop_all(); CurrentWeapon = qs_right; bUpdateDisplay = TRUE; }
    }


    playerMoved = (abs(get_val(XB1_LX)) > 20 || abs(get_val(XB1_LY)) > 20);
    if(bDebounceTimer > 0) {
        bDebounceTimer -= get_rtime();
        if(bDebounceTimer < 0) bDebounceTimer = 0;
    }

    if(event_press(XB1_UP) || event_press(XB1_DOWN) || event_press(XB1_X)) {
        bDebounceTimer = 200;
    }

YTapAge += get_rtime();

if(event_press(XB1_Y)) {
    if(YTapCount == 0) {
        YTapCount = 1;
        YTapAge = 0;
    } else if(YTapCount == 1 && YTapAge <= YDoubleTapWindow && !updating) {
        searchinginAnInventory = FALSE;
        inventoryLocked = FALSE; invMoveTimer = 0; flickState = 0; flickTimer = 0;
        CurrentStatus ^= 1;
        crouchHoldTimer = 0;
        crouchHoldFired = FALSE;
        bUpdateDisplay = TRUE;
        YTapCount = 0;
        YTapAge = 0;
    }
}

if(YTapCount == 1 && YTapAge > YDoubleTapWindow) {
    YTapCount = 0;
    YTapAge = 0;
}

    if(event_press(XB1_LS)) { searchinginAnInventory = FALSE; inventoryLocked = FALSE; invMoveTimer = 0; flickState = 0;
    flickTimer = 0; }
    if(event_press(XB1_X) && !searchinginAnInventory) { searchinginAnInventory = TRUE; inventoryLocked = FALSE; invMoveTimer = 0;
    flickState = 0; flickTimer = 0; }
    if(event_press(XB1_RS) && !searchinginAnInventory) { searchinginAnInventory = TRUE; inventoryLocked = FALSE;
    invMoveTimer = 0; flickState = 0; flickTimer = 0; }

    anyDpad = event_press(XB1_UP) || event_press(XB1_DOWN) ||
    event_press(XB1_LEFT) || event_press(XB1_RIGHT);
    if(searchinginAnInventory) {
        if(playerMoved && (event_press(XB1_LEFT) || event_press(XB1_RIGHT))) { searchinginAnInventory = FALSE;
        inventoryLocked = FALSE; invMoveTimer = 0; }
        else if(anyDpad) { inventoryLocked = TRUE;
        }
    } else {
        if(event_press(XB1_UP) || event_press(XB1_DOWN)) { searchinginAnInventory = TRUE;
        inventoryLocked = TRUE; }
    }

    if(searchinginAnInventory && !inventoryLocked) {
        if(abs(get_val(XB1_LX)) > 90 || abs(get_val(XB1_LY)) > 90) {
            invMoveTimer += get_rtime();
            if(invMoveTimer > 80) { searchinginAnInventory = FALSE; invMoveTimer = 0;
            }
        } else { invMoveTimer = 0;
        }
    }

    if(abs(get_val(XB1_LX)) > 60 || abs(get_val(XB1_LY)) > 60) {
        if(flickState == 0) { flickState = 1;
        flickTimer = 0; }
        else if(flickState == 2 && searchinginAnInventory) { inventoryLocked = TRUE;
        flickState = 0; }
    } else if(abs(get_val(XB1_LX)) < 20 && abs(get_val(XB1_LY)) < 20) {
        if(flickState == 1) { flickState = 2;
        flickTimer = 0; }
    }

    if(flickState > 0) {
        flickTimer += get_rtime();
        if(flickTimer > 300) { flickState = 0; flickTimer = 0;
        }
    }

    if (screen == 0 && RapidCrouchSpam_ON && get_val(XB1_RT) > 10) {
        combo_run(RapidCrouchSpam_Combo);
    } else {
        combo_stop(RapidCrouchSpam_Combo);
    }


    if (screen == 0 && RapidCrouchSpam_ON && get_val(XB1_RT) > 10) {

    }
    else if (BHoldCrouchMode) {
        searchinginAnInventory = FALSE;
        inventoryLocked = FALSE;
        invMoveTimer = 0;
        flickState = 0;
        flickTimer = 0;
        bDebounceTimer = 0;
        crouchHoldTimer = 0;
        crouchHoldFired = FALSE;

        if (get_val(CROUCH_BTN) > 50) {
            if (CurrentStatus != CROUCH) { CurrentStatus = CROUCH;
            combo_stop_all(); bUpdateDisplay = TRUE; }
        } else {
            if (CurrentStatus != STAND) { CurrentStatus = STAND;
            combo_stop_all(); bUpdateDisplay = TRUE; }
        }
    } else if (bDebounceTimer <= 0) {
        if (searchinginAnInventory) {
            if (PostPress(CROUCH_BTN)) { searchinginAnInventory = FALSE;
            inventoryLocked = FALSE; invMoveTimer = 0; }
        } else {
            if (!HoldCrouch275) {
                if (PostPress(CROUCH_BTN)) { CurrentStatus ^= 1;
                combo_stop_all(); bUpdateDisplay = TRUE; }
            } else {
                if (get_val(CROUCH_BTN) > 50) {
                    if (!crouchHoldFired) {
                        crouchHoldTimer += get_rtime();
                        if (crouchHoldTimer >= 275) { crouchHoldFired = TRUE; crouchHoldTimer = 0; CurrentStatus ^= 1; combo_stop_all(); bUpdateDisplay = TRUE;
                        }
                    }
                } else { crouchHoldTimer = 0;
                crouchHoldFired = FALSE; }
            }
        }
    }
if (get_val(XB1_LT) && event_press(XB1_MENU)) { currentlyUpdatingValues = TRUE;
updating = TRUE; screen = 1; bUpdateDisplay = TRUE; }
    if (currentlyUpdatingValues && get_val(XB1_LT) < 10) { set_led(1, 1);
    }




        if(get_val(XB1_RT) > 70 && get_val(XB1_LT) > 70)


    if (get_val(XB1_RT) < 10)
        combo_stop_all();
    if (CurrentStatus == 1) stanceIsStanding = 0;
    else stanceIsStanding = 1;

rightStickSensitivityPct = 100;
weaponCategory = 0; weaponIndex = 2;
    if(CurrentWeapon == 1) {
        weaponCategory = 0; weaponIndex = 0;
    } else if (CurrentWeapon == 3) {
        weaponCategory = 1; weaponIndex = 1;
    } else if (CurrentWeapon == 5) {
        weaponCategory = 0; weaponIndex = 6;
    } else if (CurrentWeapon >= 9 && CurrentWeapon <= 11) {
        weaponCategory = 0;
        weaponIndex = 4;
    } else if (CurrentWeapon == 18) {
        weaponCategory = 1;
        weaponIndex = 2;
    } else if (CurrentWeapon == 25) {
        weaponCategory = 1;
        weaponIndex = 0;
    } else if (CurrentWeapon == 20) {
        weaponCategory = 1;
        weaponIndex = 0;
    }

    if(get_val(XB1_RT) > 10) {

        if (!HipfireRecoil && get_val(XB1_LT) < 10) {

        } else {


            if (CurrentWeapon != 0 && CurrentWeapon != 2 && CurrentWeapon != 4 &&
                CurrentWeapon != 6 && CurrentWeapon != 7 && CurrentWeapon != 8 &&
               
                CurrentWeapon != 9 && CurrentWeapon != 10 && CurrentWeapon != 13 && CurrentWeapon != 12 &&
                CurrentWeapon != 14 && CurrentWeapon != 15 && CurrentWeapon != 16 &&
                CurrentWeapon != 17 && CurrentWeapon != 19 && CurrentWeapon != 20 &&
                CurrentWeapon != 21 && CurrentWeapon != 22 && CurrentWeapon != 23 &&
   
                CurrentWeapon != 24 && CurrentWeapon != 26 && CurrentWeapon != 27 && CurrentWeapon != 28)
            {

            }
        }
    } else {
        recoilComboState = -1;
        combo_stop_all();
    }


adsComboAllowed = FALSE;
    ads4XComboAllowed = FALSE;

    current_sens_mul_x = BASE_HIP_X;
    current_sens_mul_y = BASE_HIP_Y;
    if (CurrentWeapon >= 0 && CurrentWeapon <= 26 &&
       (CurrentWeapon != 3 && CurrentWeapon != 5 && CurrentWeapon != 7 && CurrentWeapon != 10 && CurrentWeapon != 11 && CurrentWeapon != 21 && CurrentWeapon != 1)) {
        adsComboAllowed = TRUE;
    }


    if (CurrentWeapon == 3 || CurrentWeapon == 5 || CurrentWeapon == 7 ||
        CurrentWeapon == 11 || CurrentWeapon == 10 || CurrentWeapon == 21 || CurrentWeapon == 1) {
        ads4XComboAllowed = TRUE;
    }

    if (get_val(XB1_LT) > 10) {
        if (ads4XComboAllowed) {
            current_sens_mul_x = BASE_4X_X;
            current_sens_mul_y = BASE_4X_Y;
        } else if (adsComboAllowed) {
            current_sens_mul_x = BASE_1X_X;
            current_sens_mul_y = BASE_1X_Y;
        }
    }

    sens_mod_rx = get_val(XB1_RX);
    sens_mod_ry = get_val(XB1_RY);
    if(screen == 0) {
        sens_combo_dx = sens_mod_rx - sens_raw_rx;
        sens_combo_dy = sens_mod_ry - sens_raw_ry;

        sens_raw_rx_dz = dz_remap(sens_raw_rx, CurrentDeadzoneX);
        sens_raw_ry_dz = dz_remap(sens_raw_ry, CurrentDeadzoneY);
        if(current_sens_mul_x != 100) {
            sens_player_rx = (sens_raw_rx_dz * current_sens_mul_x) / 100;
        } else {
            sens_player_rx = sens_raw_rx_dz;
        }

        if(current_sens_mul_y != 100) {
            sens_player_ry = (sens_raw_ry_dz * current_sens_mul_y) / 100;
        } else {
            sens_player_ry = sens_raw_ry_dz;
        }


        // Vertical compensation: makes Y match X feel better (game vertical is often slower)
        if(VERT_COMP_PCT != 100) {
            sens_player_ry = (sens_player_ry * VERT_COMP_PCT) / 100;
            sens_player_ry = clamp(sens_player_ry, -100, 100);
        }

        sens_abs = iabs(sens_combo_dx);
        if(sens_abs > 100) sens_abs = 100;
        if(sens_abs > 0) sens_player_rx = (sens_player_rx * (100 - sens_abs)) / 100;
        sens_final_rx = sens_player_rx + sens_combo_dx;
        sens_final_rx = clamp(sens_final_rx, -100, 100);

        sens_abs = iabs(sens_combo_dy);
        if(sens_abs > 100) sens_abs = 100;
        if(sens_abs > 0) sens_player_ry = (sens_player_ry * (100 - sens_abs)) / 100;
        sens_final_ry = sens_player_ry + sens_combo_dy;
        sens_final_ry = clamp(sens_final_ry, -100, 100);

        set_val(XB1_RX, sens_final_rx);
        set_val(XB1_RY, sens_final_ry);
    }

    UpdatePostPressPrev();
}
int adsComboAllowed = FALSE;
int ads4XComboAllowed = FALSE;
int hipMul = 100;
int adsMul = 100;
int ads4XMul = 100;
int RY = 0;
int RX = 0;
int HOLOoverrideBoost = 125;
int SCOPE2_OverrideBoost = 185;
int SCOPE4X_OverrideBoost = 175;
int SCOPE2_OverrideBoost2 = 75;
int hipMultiplier = 100;
int adsMultiplier = 100;
int RecoilAssistRX = 100;
int RecoilAssistRY = 100;
int AssistMin = 50;
int AssistMax = 80;
            int specific_combo_active = FALSE;

define WEAPON_MIN = 0;
define WEAPON_MAX = 30;

define HOLD_DELAY_MS = 450;
define HOLD_REPEAT_MS = 160;

function StepWeapon(dir) {

    if(dir > 0) {
        if(CurrentWeapon < WEAPON_MAX) CurrentWeapon = CurrentWeapon + 1;
    } else {
        if(CurrentWeapon > WEAPON_MIN) CurrentWeapon = CurrentWeapon - 1;
    }


}
int right_last_ptime = 0;
int left_last_ptime  = 0;

function UpdateValues()
{
    if (screen != 1) return;
    
    if(event_press(XB1_RIGHT)) {
        StepWeapon(1);
        right_last_ptime = get_ptime(XB1_RIGHT);
        bUpdateDisplay = TRUE;
    }
    else if(get_val(XB1_RIGHT)) {
        if(get_ptime(XB1_RIGHT) > HOLD_DELAY_MS) {
            if((get_ptime(XB1_RIGHT) - right_last_ptime) >= HOLD_REPEAT_MS) {
                if(CurrentWeapon < WEAPON_MAX) StepWeapon(1);
                right_last_ptime = get_ptime(XB1_RIGHT);
                bUpdateDisplay = TRUE;
            }
        }
    } else {
        right_last_ptime = 0;
    }

    if(event_press(XB1_LEFT)) {
        StepWeapon(-1);
        left_last_ptime = get_ptime(XB1_LEFT);
        bUpdateDisplay = TRUE;
    }
    else if(get_val(XB1_LEFT)) {
        if(get_ptime(XB1_LEFT) > HOLD_DELAY_MS) {
            if((get_ptime(XB1_LEFT) - left_last_ptime) >= HOLD_REPEAT_MS) {
                if(CurrentWeapon > WEAPON_MIN) StepWeapon(-1);
                left_last_ptime = get_ptime(XB1_LEFT);
                bUpdateDisplay = TRUE;
            }
        }
    } else {
        left_last_ptime = 0;
    }

    if (event_press(XB1_RT)) { weapon_lock = CurrentWeapon; screen = 2; bUpdateDisplay = TRUE; return; }
    if (event_press(XB1_LT)) { weapon_lock = CurrentWeapon; screen = 5; bUpdateDisplay = TRUE; return; }
    if (event_press(XB1_Y)) { currentlyUpdatingValues = FALSE; screen = 0; set_led(1, 0); updating = FALSE; bUpdateDisplay = TRUE; return; }

    if (bUpdateDisplay) {
        cls_oled(0);
        print(5, 30, 0, OLED_FONT_MEDIUM, Weapons[CurrentWeapon]);
        bUpdateDisplay = FALSE;
    }
}


int button_index;
int capture_idx = -1;
function UpdateRemapMenu() {
    if(screen != 5) return;
    
    if(event_press(XB1_Y)) { currentlyUpdatingValues = FALSE; screen = 0; set_led(1, 0); updating = FALSE; bUpdateDisplay = TRUE; return; }

    if(event_press(XB1_UP))   { remap_edit_field = 0; bUpdateDisplay = TRUE; }
    if(event_press(XB1_DOWN)) { remap_edit_field = 1; bUpdateDisplay = TRUE; }
    if(event_press(XB1_LEFT)) { button_index = button_index - 1; if(button_index < 0) button_index = BTN_COUNT - 1; bUpdateDisplay = TRUE; }
    if(event_press(XB1_RIGHT)) { button_index = button_index + 1; if(button_index >= BTN_COUNT) button_index = 0; bUpdateDisplay = TRUE; }

    if(event_press(XB1_RB)) {
        A = button_index; oldB = SwapWith[A];
        SwapWith[A] = SwapWith[A] + 1; if(SwapWith[A] >= BTN_COUNT) SwapWith[A] = 0;
        B = SwapWith[A];
        if(oldB != A) { SwapWith[oldB] = oldB; SwapEnabled[oldB] = FALSE; }
        oldA = SwapWith[B];
        if(oldA != B) { SwapWith[oldA] = oldA; SwapEnabled[oldA] = FALSE; }
        SwapWith[A] = B; SwapWith[B] = A; SwapEnabled[A] = TRUE; SwapEnabled[B] = TRUE;
        bUpdateDisplay = TRUE;
    }
    if(event_press(XB1_LB)) {
        A = button_index; oldB = SwapWith[A];
        SwapWith[A] = SwapWith[A] - 1; if(SwapWith[A] < 0) SwapWith[A] = BTN_COUNT - 1;
        B = SwapWith[A];
        if(oldB != A) { SwapWith[oldB] = oldB; SwapEnabled[oldB] = FALSE; }
        oldA = SwapWith[B];
        if(oldA != B) { SwapWith[oldA] = oldA; SwapEnabled[oldA] = FALSE; }
        SwapWith[A] = B; SwapWith[B] = A; SwapEnabled[A] = TRUE; SwapEnabled[B] = TRUE;
        bUpdateDisplay = TRUE;
    }
    if(event_press(XB1_A)) {
        A = button_index; B = SwapWith[A];
        if(B == A) SwapEnabled[A] = !SwapEnabled[A];
        else { SwapEnabled[A] = !SwapEnabled[A]; SwapEnabled[B] = SwapEnabled[A]; }
        bUpdateDisplay = TRUE;
    }
    if(event_press(XB1_X)) {
        A = button_index; B = SwapWith[A]; SwapEnabled[A] = FALSE;
        if(B != A) { SwapEnabled[B] = FALSE; SwapWith[B] = B; }
        SwapWith[A] = A;
        bUpdateDisplay = TRUE;
    }

    if(event_press(XB1_RT)) { screen = 1; bUpdateDisplay = TRUE; return; }
    if(event_press(XB1_LT)) { screen = 4; bUpdateDisplay = TRUE; return; }

    if (bUpdateDisplay) {
        cls_oled(0);
        if(SwapEnabled[button_index])
            if(remap_edit_field == 0) print(0, 28, 0, OLED_FONT_SMALL, TXT_ARROW[0]);
        if(remap_edit_field == 1) print(0, 46, 0, OLED_FONT_SMALL, TXT_ARROW[0]);

        print(10, 28, 0, OLED_FONT_SMALL, TXT_BUTTON[0]); PrintBtnName(60, 28, button_index);
        print(10, 46, 0, OLED_FONT_SMALL, TXT_USES[0]);   PrintBtnName(60, 46, SwapWith[button_index]);
        bUpdateDisplay = FALSE;
    }
}

int remap_index = 0;
function UpdateRemaps() {
    if (screen != 3) return;
    
    if (event_press(XB1_UP))   { remap_index = remap_index - 1; if (remap_index < 0) remap_index = 2; bUpdateDisplay = TRUE; }
    if (event_press(XB1_DOWN)) { remap_index = remap_index + 1; if (remap_index > 2) remap_index = 0; bUpdateDisplay = TRUE; }

    if (event_press(XB1_A)) {
        if (remap_index == 0) HipfireRecoil   = !HipfireRecoil;
        if (remap_index == 1) HoldCrouch275   = !HoldCrouch275;
        if (remap_index == 2) BHoldCrouchMode = !BHoldCrouchMode;
        if (BHoldCrouchMode) HoldCrouch275 = FALSE;
        bUpdateDisplay = TRUE;
    }

    if (event_press(XB1_RT)) { screen = 4; bUpdateDisplay = TRUE; return; }
    if (event_press(XB1_LT)) { screen = 2; bUpdateDisplay = TRUE; return; }
    if (event_press(XB1_Y))  { currentlyUpdatingValues = FALSE; screen = 0; set_led(1, 0); updating = FALSE; bUpdateDisplay = TRUE; return; }

    if (bUpdateDisplay) {
        cls_oled(0);
        if (remap_index == 0) {
            print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]);
            print(10, 30, 0, OLED_FONT_SMALL, TXT_HIPRECOIL[0]);
            if (HipfireRecoil) print(92, 30, 0, OLED_FONT_SMALL, TXT_ON[0]); else print(92, 30, 0, OLED_FONT_SMALL, TXT_OFF[0]);
        } else if (remap_index == 1) {
            print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]);
            print(10, 30, 0, OLED_FONT_SMALL, TXT_HOLDCROUCH[0]);
            if (HoldCrouch275) print(92, 30, 0, OLED_FONT_SMALL, TXT_ON[0]); else print(92, 30, 0, OLED_FONT_SMALL, TXT_OFF[0]);
        } else if (remap_index == 2) {
            print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]);
            print(10, 30, 0, OLED_FONT_SMALL, TXT_BHOLDCROUCH[0]);
            if (BHoldCrouchMode) print(92, 30, 0, OLED_FONT_SMALL, TXT_ON[0]); else print(92, 30, 0, OLED_FONT_SMALL, TXT_OFF[0]);
        }
        bUpdateDisplay = FALSE;
    }
}

function UpdateSens() {
    if (screen != 2) return;
    
    if (event_press(XB1_UP)) { sens_item = sens_item - 1; if (sens_item < 0) sens_item = 7; bUpdateDisplay = TRUE; }
    if (event_press(XB1_DOWN)) { sens_item = sens_item + 1; if (sens_item > 7) sens_item = 0; bUpdateDisplay = TRUE; }

    if (event_press(XB1_RIGHT)) {
        next_rep_right = get_rtime() + HOLD_DELAY;
        if (sens_item == 0) { BASE_HIP_X = clamp(BASE_HIP_X + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_1, BASE_HIP_X); }
        else if (sens_item == 1) { BASE_HIP_Y = clamp(BASE_HIP_Y + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_4, BASE_HIP_Y); }
        else if (sens_item == 2) { BASE_1X_X  = clamp(BASE_1X_X  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_2, BASE_1X_X); }
        else if (sens_item == 3) { BASE_1X_Y  = clamp(BASE_1X_Y  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_9, BASE_1X_Y); }
        else if (sens_item == 4) { BASE_4X_X  = clamp(BASE_4X_X  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_3, BASE_4X_X); }
        else if (sens_item == 5) { BASE_4X_Y  = clamp(BASE_4X_Y  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_10, BASE_4X_Y); }
        else if (sens_item == 6) { CurrentDeadzoneX = clamp(CurrentDeadzoneX + DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_11, CurrentDeadzoneX); }
        else if (sens_item == 7) { CurrentDeadzoneY = clamp(CurrentDeadzoneY + DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_12, CurrentDeadzoneY); }
        bUpdateDisplay = TRUE;
    }
    else if (get_val(XB1_RIGHT) && next_rep_right > 0 && get_rtime() >= next_rep_right) {
        next_rep_right = get_rtime() + HOLD_RATE;
        if (sens_item == 0) { BASE_HIP_X = clamp(BASE_HIP_X + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_1, BASE_HIP_X); }
        else if (sens_item == 1) { BASE_HIP_Y = clamp(BASE_HIP_Y + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_4, BASE_HIP_Y); }
        else if (sens_item == 2) { BASE_1X_X  = clamp(BASE_1X_X  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_2, BASE_1X_X); }
        else if (sens_item == 3) { BASE_1X_Y  = clamp(BASE_1X_Y  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_9, BASE_1X_Y); }
        else if (sens_item == 4) { BASE_4X_X  = clamp(BASE_4X_X  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_3, BASE_4X_X); }
        else if (sens_item == 5) { BASE_4X_Y  = clamp(BASE_4X_Y  + SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_10, BASE_4X_Y); }
        else if (sens_item == 6) { CurrentDeadzoneX = clamp(CurrentDeadzoneX + DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_11, CurrentDeadzoneX); }
        else if (sens_item == 7) { CurrentDeadzoneY = clamp(CurrentDeadzoneY + DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_12, CurrentDeadzoneY); }
        bUpdateDisplay = TRUE;
    }
    else if (!get_val(XB1_RIGHT)) { next_rep_right = 0; }

    if (event_press(XB1_LEFT)) {
        next_rep_left = get_rtime() + HOLD_DELAY;
        if (sens_item == 0) { BASE_HIP_X = clamp(BASE_HIP_X - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_1, BASE_HIP_X); }
        else if (sens_item == 1) { BASE_HIP_Y = clamp(BASE_HIP_Y - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_4, BASE_HIP_Y); }
        else if (sens_item == 2) { BASE_1X_X  = clamp(BASE_1X_X  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_2, BASE_1X_X); }
        else if (sens_item == 3) { BASE_1X_Y  = clamp(BASE_1X_Y  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_9, BASE_1X_Y); }
        else if (sens_item == 4) { BASE_4X_X  = clamp(BASE_4X_X  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_3, BASE_4X_X); }
        else if (sens_item == 5) { BASE_4X_Y  = clamp(BASE_4X_Y  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_10, BASE_4X_Y); }
        else if (sens_item == 6) { CurrentDeadzoneX = clamp(CurrentDeadzoneX - DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_11, CurrentDeadzoneX); }
        else if (sens_item == 7) { CurrentDeadzoneY = clamp(CurrentDeadzoneY - DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_12, CurrentDeadzoneY); }
        bUpdateDisplay = TRUE;
    }
    else if (get_val(XB1_LEFT) && next_rep_left > 0 && get_rtime() >= next_rep_left) {
        next_rep_left = get_rtime() + HOLD_RATE;
        if (sens_item == 0) { BASE_HIP_X = clamp(BASE_HIP_X - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_1, BASE_HIP_X); }
        else if (sens_item == 1) { BASE_HIP_Y = clamp(BASE_HIP_Y - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_4, BASE_HIP_Y); }
        else if (sens_item == 2) { BASE_1X_X  = clamp(BASE_1X_X  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_2, BASE_1X_X); }
        else if (sens_item == 3) { BASE_1X_Y  = clamp(BASE_1X_Y  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_9, BASE_1X_Y); }
        else if (sens_item == 4) { BASE_4X_X  = clamp(BASE_4X_X  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_3, BASE_4X_X); }
        else if (sens_item == 5) { BASE_4X_Y  = clamp(BASE_4X_Y  - SENS_STEP, SENS_MIN, SENS_MAX); set_pvar(SPVAR_10, BASE_4X_Y); }
        else if (sens_item == 6) { CurrentDeadzoneX = clamp(CurrentDeadzoneX - DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_11, CurrentDeadzoneX); }
        else if (sens_item == 7) { CurrentDeadzoneY = clamp(CurrentDeadzoneY - DZ_STEP, DZ_MIN, DZ_MAX); set_pvar(SPVAR_12, CurrentDeadzoneY); }
        bUpdateDisplay = TRUE;
    }
    else if (!get_val(XB1_LEFT)) { next_rep_left = 0; }

    if (event_press(XB1_RT)) { screen = 3; bUpdateDisplay = TRUE; return; }
    if (event_press(XB1_LT)) { screen = 1; bUpdateDisplay = TRUE; return; }
    if (event_press(XB1_Y))  { currentlyUpdatingValues = FALSE; screen = 0; set_led(1, 0); updating = FALSE; bUpdateDisplay = TRUE; return; }

    if (bUpdateDisplay) {
        cls_oled(0);
        if (sens_item == 0) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_HIP_X[0]); print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[BASE_HIP_X - 1]); }
        else if (sens_item == 1) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_HIP_Y[0]); print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[BASE_HIP_Y - 1]); }
        else if (sens_item == 2) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_1X_X[0]); print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[BASE_1X_X - 1]); }
        else if (sens_item == 3) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_1X_Y[0]); print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[BASE_1X_Y - 1]); }
        else if (sens_item == 4) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_4X_X[0]); print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[BASE_4X_X - 1]); }
        else if (sens_item == 5) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_4X_Y[0]); print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[BASE_4X_Y - 1]); }
        else if (sens_item == 6) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_DZ_X[0]); if(CurrentDeadzoneX == 0) print(92, 30, 0, OLED_FONT_SMALL, TXT_ZERO[0]); else print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[CurrentDeadzoneX - 1]); }
        else if (sens_item == 7) { print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]); print(10, 30, 0, OLED_FONT_SMALL, TXT_DZ_Y[0]); if(CurrentDeadzoneY == 0) print(92, 30, 0, OLED_FONT_SMALL, TXT_ZERO[0]); else print(92, 30, 0, OLED_FONT_SMALL, TXT_NUM[CurrentDeadzoneY - 1]); }
        bUpdateDisplay = FALSE;
    }
}



function UpdateQuickSwaps() {
    if (screen != 4) return;
    
    w = qs_up;
    if(qs_item == 1) w = qs_left;
    else if(qs_item == 2) w = qs_down;
    else if(qs_item == 3) w = qs_right;

    if(!qs_edit) {
        if(event_press(XB1_UP))   { qs_item = qs_item - 1; if(qs_item < 0) qs_item = 3; bUpdateDisplay = TRUE; }
        if(event_press(XB1_DOWN)) { qs_item = qs_item + 1; if(qs_item > 3) qs_item = 0; bUpdateDisplay = TRUE; }
        if(event_press(XB1_A))    { qs_edit = TRUE; qs_weapon_edit = w; bUpdateDisplay = TRUE; }
    } else {
        if(event_press(XB1_LEFT))  { qs_weapon_edit = qs_weapon_edit - 1; if(qs_weapon_edit < 0) qs_weapon_edit = 26; bUpdateDisplay = TRUE; }
        if(event_press(XB1_RIGHT)) { qs_weapon_edit = qs_weapon_edit + 1; if(qs_weapon_edit > 26) qs_weapon_edit = 0; bUpdateDisplay = TRUE; }

        if(event_press(XB1_A)) {
            if(qs_item == 0) { qs_up = qs_weapon_edit; set_pvar(SPVAR_5, qs_up); }
            else if(qs_item == 1) { qs_left = qs_weapon_edit; set_pvar(SPVAR_8, qs_left); }
            else if(qs_item == 2) { qs_down = qs_weapon_edit; set_pvar(SPVAR_7, qs_down); }
            else if(qs_item == 3) { qs_right = qs_weapon_edit; set_pvar(SPVAR_6, qs_right); }
            qs_edit = FALSE;
            bUpdateDisplay = TRUE;
        }
    }

    if(event_press(XB1_RT)) { qs_edit = FALSE; screen = 5; bUpdateDisplay = TRUE; return; }
    if(event_press(XB1_LT)) { qs_edit = FALSE; screen = 3; bUpdateDisplay = TRUE; return; }
    if(event_press(XB1_Y))  { qs_edit = FALSE; currentlyUpdatingValues = FALSE; screen = 0; set_led(1, 0); updating = FALSE; bUpdateDisplay = TRUE; return; }

    if (bUpdateDisplay) {
        cls_oled(0);
        if(qs_item == 0) print(10, 30, 0, OLED_FONT_SMALL, TXT_QS_BIND[0]);
        else if(qs_item == 1) print(10, 30, 0, OLED_FONT_SMALL, TXT_QS_BIND[1]);
        else if(qs_item == 2) print(10, 30, 0, OLED_FONT_SMALL, TXT_QS_BIND[2]);
        else if(qs_item == 3) print(10, 30, 0, OLED_FONT_SMALL, TXT_QS_BIND[3]);

        print(0, 30, 0, OLED_FONT_SMALL, TXT_ARROW[0]);
        if(!qs_edit) { print(70, 30, 0, OLED_FONT_SMALL, Weapons[w]); } 
        else { print(70, 30, 0, OLED_FONT_SMALL, Weapons[qs_weapon_edit]); }
        bUpdateDisplay = FALSE;
    }
}




function UpdateScreen() {
    cls_oled(0);

    

    print(5, 30, 0, OLED_FONT_MEDIUM, Weapons[CurrentWeapon]);
    if (CurrentStatus & 1) {
        print(5, 50, 0, OLED_FONT_MEDIUM, Status[1]);
    } else {
        print(5, 50, 0, OLED_FONT_MEDIUM, Status[0]);
    }
}
int loading = TRUE;

function passthroughUnlessSuppressed(inputValue){
    if(suppressRightStickOutput){
        return 0
    }
    else{
        return inputValue
    }
    return inputValue
}

function applyRecoilToRightStickY(f_val,f_str){
    strafeRecoilBonusPct=0;
    recoilSmoothingY=100;
    smoothingColumnOffset=0;
    if(altSmoothingToggle[0]==1){
        smoothingColumnOffset=2;
    }
    else{
        smoothingColumnOffset=0;
    }
    if(weaponCategory==0)recoilSmoothingY=smoothingAutoWeapons[weaponIndex][smoothingColumnOffset + 1];
    else if(weaponCategory==1)recoilSmoothingY=smoothingSemiWeapons[weaponIndex][smoothingColumnOffset + 1];
    else if(weaponCategory==2)recoilSmoothingY=smoothingExtraWeapons[weaponIndex][smoothingColumnOffset + 1];
    if(get_val(7)< 50){
        recoilSmoothingY=((recoilSmoothingY - 100)/ 2)+ 85;
    }
    if(abs(get_val(11))>=50 || abs(get_val(12))>=50){
        strafeRecoilBonusPct=strafeBonusPctByWeaponAndStance[weaponIndex][stanceIsStanding];
    }
    userAxisProcessed=get_val(10);
    if(abs(userAxisProcessed)> rightStickDeadzone){
        if(userAxisProcessed > 0)userAxisProcessed=(userAxisProcessed - rightStickDeadzone)* rightStickSensitivityPct /(100 - rightStickDeadzone);
        else userAxisProcessed=(userAxisProcessed + rightStickDeadzone)* rightStickSensitivityPct /(100 - rightStickDeadzone);
            }
    else{
        userAxisProcessed=0;
    }
    if(recoilAxisEnabledXY[1]==0){
        recoilAxisDelta=0;
    }
    else{
        recoilAxisDelta=(f_val * f_str)/ 100;
        recoilAxisDelta=recoilAxisDelta + strafeRecoilBonusPct;
        recoilAxisDelta=(recoilAxisDelta * recoilSmoothingY)/ 100;
        if(abs(userAxisProcessed)> 100)axisHeadroomPct=0;
        else axisHeadroomPct=100 - abs(userAxisProcessed);
        recoilAxisDelta=(recoilAxisDelta * axisHeadroomPct)/ 100;
        recoilAxisDelta=(recoilAxisDelta * axisScalePctXY[1])/ 100;
    }
    axisOutput=userAxisProcessed + recoilAxisDelta;
    if(axisOutput > 100)return 100;
    if(axisOutput < -100)return -100;
    return axisOutput;
}

function applyRecoilToRightStickX(f_val,f_str){
    recoilSmoothingX=100;
    smoothingColumnOffset=0;
    if(altSmoothingToggle[0]==1){
        smoothingColumnOffset=2;
    }
    else{
        smoothingColumnOffset=0;
    }
    if(weaponCategory==0)recoilSmoothingX=smoothingAutoWeapons[weaponIndex][smoothingColumnOffset];
    else if(weaponCategory==1)recoilSmoothingX=smoothingSemiWeapons[weaponIndex][smoothingColumnOffset];
    else if(weaponCategory==2)recoilSmoothingX=smoothingExtraWeapons[weaponIndex][smoothingColumnOffset];
    if(get_val(7)< 50){
        recoilSmoothingX=((recoilSmoothingX - 100)/ 2)+ 90;
    }
    userAxisProcessed=get_val(9);
    if(abs(userAxisProcessed)> rightStickDeadzone){
        if(userAxisProcessed > 0)userAxisProcessed=(userAxisProcessed - rightStickDeadzone)* rightStickSensitivityPct /(100 - rightStickDeadzone);
        else userAxisProcessed=(userAxisProcessed + rightStickDeadzone)* rightStickSensitivityPct /(100 - rightStickDeadzone);
            }
    else{
        userAxisProcessed=0;
    }
    if(recoilAxisEnabledXY[0]==0){
        recoilAxisDelta=0;
    }
    else{
        recoilAxisDelta=(f_val * f_str)/ 100;
        recoilAxisDelta=(recoilAxisDelta * recoilSmoothingX)/ 100;
        if(abs(userAxisProcessed)> 100)axisHeadroomPct=0;
        else axisHeadroomPct=100 - abs(userAxisProcessed);
        recoilAxisDelta=(recoilAxisDelta * axisHeadroomPct)/ 100;
        recoilAxisDelta=(recoilAxisDelta * axisScalePctXY[0])/ 100;
    }
    axisOutput=userAxisProcessed + recoilAxisDelta;
    if(axisOutput > 100)return 100;
    if(axisOutput < -100)return -100;
    return axisOutput;
}


function AddToCombosRX() {
    RX = get_val(XB1_RX);
    RX = dz_remap(RX, INTERNAL_DZ);
    RX = classic_comp(RX);
    RX = vel_smooth(RX, 0);
    return RX;
}

function AddToCombosRY() {
    RY = get_val(XB1_RY);
    RY = dz_remap(RY, INTERNAL_DZ);
    RY = classic_comp(RY);
    RY = vel_smooth(RY, 1);
    return RY;
}

