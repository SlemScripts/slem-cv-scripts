function STRAFE_LR_4X_CROUCH() {

    lx = RAW_LX;

    if (lx > STRAFE_LX_THRESH || lx < -STRAFE_LX_THRESH)
        return STRAFE_LR_4X_CROUCH;

    return 0;
}

