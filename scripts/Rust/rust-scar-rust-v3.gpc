  int FinalRY;
  int FinalRX;
function RY_Math(RawValue, Strength) {


    if (abs(get_val(XB1_RX)) > 20 || abs(get_val(XB1_RY)) > 20) return RawValue;


    FinalRY = (RawValue * Strength) / 100;


    FinalRY = (FinalRY * smooth_scale) / 100;


    if (abs(get_val(XB1_RY)) > 20) {
        FinalRY = (FinalRY * (100 - abs(get_val(XB1_RY)))) / 100;
    }

    return FinalRY + strafeRYBoost;
}

function RX_Math(RawValue, Strength) {

    if (abs(get_val(XB1_RX)) > 20 || abs(get_val(XB1_RY)) > 20) return RawValue;

    FinalRX = (RawValue * Strength) / 100;
    FinalRX = (FinalRX * smooth_scale) / 100;

    if (abs(get_val(XB1_RX)) > 20) {
        FinalRX = (FinalRX * (100 - abs(get_val(XB1_RX)))) / 100;
    }

    return FinalRX;
}

